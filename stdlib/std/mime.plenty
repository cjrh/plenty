# Media types (RFC 9110 section 8.3.1): `type/subtype` with `; name=value`
# parameters, token or quoted-string values, and the extension table used by
# std.http.files. Names are stored in lowercase, so `==` compares two parsed
# values without case. See book/src/design/stdlib/mime.md.
import std.bytes
from std.bytes import Bytes, BytesError

pub enum MimeError:
    # The text is not a media type, or a name or value is not allowed.
    Invalid
    Allocation(AllocError)

pub class Param:
    # Lowercase token.
    pub name: str
    # Unquoted and unescaped; lowercase for `charset`.
    pub value: str

pub class MediaType:
    _type: str
    _subtype: str
    _params: list[Param]

    pub def type_name(self) -> &str:
        &self._type

    pub def subtype(self) -> &str:
        &self._subtype

    pub def params(self) -> &list[Param]:
        &self._params

    # The value of the parameter `name`, compared without case.
    pub def param(self, name: &strview) -> Option[str]:
        for item in &self._params:
            if same_ascii(&item.name, name):
                return Some(item.value)
        Nothing

    # The structured syntax suffix after the last `+`, such as `json` in
    # `application/ld+json`.
    pub def suffix(self) -> Result[Option[str], AllocError]:
        match self._subtype.rfind("+"):
            case Some(plus):
                # rfind returns a scalar index strictly below the subtype length.
                start = unchecked:
                    plus + 1
                Ok(Some(self._subtype.slice(start, len(self._subtype))?))
            case Nothing:
                Ok(Nothing)

    # `type/subtype` without parameters.
    pub def essence(self) -> Result[str, AllocError]:
        "/".join(&[self._type, self._subtype]?)

    pub def is_wildcard(self) -> bool:
        self._type == "*" or self._subtype == "*"

    # True when `self` falls within the media range `pattern`: `*/*` matches
    # every type, `text/*` every `text` subtype, and each pattern parameter
    # must be present in `self` with the same value.
    pub def matches(self, pattern: &MediaType) -> bool:
        if pattern._type != "*" and pattern._type != self._type:
            return False
        if pattern._subtype != "*" and pattern._subtype != self._subtype:
            return False
        for wanted in &pattern._params:
            match self.param(&wanted.name):
                case Some(value):
                    if value != wanted.value:
                        return False
                case Nothing:
                    return False
        True

    # Adds the parameter, or replaces the value of one with the same name.
    # `name` must be a token; `value` may be any text without control
    # characters other than tab.
    pub def set_param(self: &mut MediaType, name: &strview, value: &str) -> Result[(), MimeError]:
        if not token_text(name) or not value_text(value):
            return Err(MimeError.Invalid)
        lower = name.lower().map_error(MimeError.Allocation)?
        stored = value.lower().map_error(MimeError.Allocation)? if lower == "charset" else *value
        for index in range(len(self._params)):
            if self._params[index].name == lower:
                self._params[index] = Param(lower, stored)
                return Ok(())
        self._params.append(Param(lower, stored)).map_error(MimeError.Allocation)?
        Ok(())

    # Removes the parameter `name`, compared without case; False when absent.
    pub def remove_param(self: &mut MediaType, name: &strview) -> bool:
        for index in range(len(self._params)):
            if same_ascii(&self._params[index].name, name):
                drop(self._params.pop(index))
                return True
        False

    # Canonical text: lowercase names, `; ` before each parameter, and a
    # quoted-string for a value that is not a token.
    pub def to_string(self) -> Result[str, AllocError]:
        mut parts = list[str].with_capacity(format_parts(len(self._params))?)?
        parts.append(self._type)?
        parts.append("/")?
        parts.append(self._subtype)?
        for item in &self._params:
            parts.append("; ")?
            parts.append(item.name)?
            parts.append("=")?
            parts.append(quoted(&item.value)?)?
        "".join(&parts)

# Three essence fragments and four fragments per parameter. Overflow is an
# unrepresentable allocation request, before any formatting allocation.
def format_parts(params: i64) -> Result[i64, AllocError]:
    size = checked:
        3 + 4 * params
    match size:
        case Ok(value):
            Ok(value)
        case Err(_):
            Err(AllocError.CapacityOverflow)

def lifted[T](result: Result[T, BytesError]) -> Result[T, MimeError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(BytesError.Allocation(cause)):
            Err(MimeError.Allocation(cause))
        case Err(_):
            Err(MimeError.Invalid)

# tchar = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." /
#         "^" / "_" / "`" / "|" / "~" / DIGIT / ALPHA
def tchar(code: i64) -> bool:
    if (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122):
        return True
    code == 33 or (code >= 35 and code <= 39) or code == 42 or code == 43 or code == 45 or code == 46 or code == 94 or code == 95 or code == 96 or code == 124 or code == 126

def ows(code: i64) -> bool:
    code == 32 or code == 9

# qdtext and the escaped byte of a quoted-pair, without `"` and `\`: tab,
# space, visible ASCII and obs-text (every byte of a non-ASCII scalar).
def text_byte(code: i64) -> bool:
    code == 9 or (code >= 32 and code != 127)

def scalar_code(scalar: &strview) -> i64:
    match ord(scalar):
        case Ok(code):
            i64(code)
        case Err(_):
            -1

def token_text(text: &strview) -> bool:
    if text.byte_len() == 0:
        return False
    for scalar in text:
        if not tchar(scalar_code(&scalar)):
            return False
    True

def value_text(text: &strview) -> bool:
    for scalar in text:
        if not text_byte(scalar_code(&scalar)):
            return False
    True

def ascii_folded(code: i64) -> i64:
    if code >= 65 and code <= 90:
        # ASCII uppercase is 65..90, hence folded is 97..122.
        unchecked:
            code + 32
    else:
        code

# ASCII comparison without case; parameter names are ASCII tokens.
def same_ascii(left: &strview, right: &strview) -> bool:
    same_ascii_bytes(left.as_bytes(), right.as_bytes())

def same_ascii_bytes(left: &[u8], right: &[u8]) -> bool:
    if len(left) != len(right):
        return False
    for index in range(len(left)):
        first = i64(left[index])
        second = i64(right[index])
        if first >= 128 or second >= 128 or ascii_folded(first) != ascii_folded(second):
            return False
    True

def quoted(value: &strview) -> Result[str, AllocError]:
    if token_text(value):
        return value[:]
    escaped = value.replace("\\", "\\\\")?.replace("\"", "\\\"")?
    "".join(&["\"", escaped, "\""]?)

def token_end(data: &[u8], start: i64, stop: i64) -> i64:
    mut index = start
    while index < stop and tchar(i64(data[index])):
        # 0 <= index < stop <= len(data) <= i64.MAX.
        unchecked:
            index += 1
    index

def ows_end(data: &[u8], start: i64, stop: i64) -> i64:
    mut index = start
    while index < stop and ows(i64(data[index])):
        # 0 <= index < stop <= len(data) <= i64.MAX.
        unchecked:
            index += 1
    index

def lowered(data: &[u8], start: i64, stop: i64) -> Result[str, MimeError]:
    text = lifted(std.bytes.to_text(&data[start:stop]))?
    text.lower().map_error(MimeError.Allocation)

# Parses `type/subtype *( OWS ";" OWS [ name=value ] )`, allowing OWS around
# the whole text. Type, subtype and parameter names, and the value of
# `charset`, are stored in lowercase; other values keep their case. A
# repeated parameter name is an error.
pub def parse(text: &strview) -> Result[MediaType, MimeError]:
    data = text.as_bytes()
    mut stop = len(data)
    while stop > 0:
        # stop is a positive buffer endpoint.
        last = unchecked:
            stop - 1
        if not ows(i64(data[last])):
            break
        stop = last
    start = ows_end(data, 0, stop)
    slash = token_end(data, start, stop)
    if slash == start or slash == stop or data[slash] != 47u8:
        return Err(MimeError.Invalid)
    # The slash check proves slash < stop <= i64.MAX.
    subtype_start = unchecked:
        slash + 1
    subtype_end = token_end(data, subtype_start, stop)
    if subtype_end == subtype_start:
        return Err(MimeError.Invalid)
    type_name = lowered(data, start, slash)?
    subtype = lowered(data, subtype_start, subtype_end)?
    mut params = list[Param]().map_error(MimeError.Allocation)?
    mut index = subtype_end
    while index < stop:
        index = ows_end(data, index, stop)
        if data[index] != 59u8:
            return Err(MimeError.Invalid)
        # index points at a semicolon before stop.
        after_separator = unchecked:
            index + 1
        index = ows_end(data, after_separator, stop)
        if index == stop or data[index] == 59u8:
            continue
        name_end = token_end(data, index, stop)
        if name_end == index or name_end == stop or data[name_end] != 61u8:
            return Err(MimeError.Invalid)
        name = lowered(data, index, name_end)?
        # name_end points at an equals sign before stop.
        unchecked:
            index = name_end + 1
        mut value = ""
        if index < stop and data[index] == 34u8:
            # 0 <= index < stop; reserve only the remaining input.
            remaining = unchecked:
                stop - index
            mut unquoted = std.bytes.with_capacity(remaining).map_error(MimeError.Allocation)?
            unchecked:
                index += 1
            mut closed = False
            while index < stop:
                byte = data[index]
                # The loop guard proves index < stop.
                unchecked:
                    index += 1
                if byte == 34u8:
                    closed = True
                    break
                if byte == 92u8:
                    if index == stop or not text_byte(i64(data[index])):
                        return Err(MimeError.Invalid)
                    unquoted.push(data[index]).map_error(MimeError.Allocation)?
                    # The preceding escape validation proves index < stop.
                    unchecked:
                        index += 1
                elif text_byte(i64(byte)):
                    unquoted.push(byte).map_error(MimeError.Allocation)?
                else:
                    return Err(MimeError.Invalid)
            if not closed:
                return Err(MimeError.Invalid)
            value = lifted(unquoted.to_text())?
        else:
            value_end = token_end(data, index, stop)
            if value_end == index:
                return Err(MimeError.Invalid)
            value = lifted(std.bytes.to_text(&data[index:value_end]))?
            index = value_end
        for item in &params:
            if item.name == name:
                return Err(MimeError.Invalid)
        if name == "charset":
            value = value.lower().map_error(MimeError.Allocation)?
        params.append(Param(name, value)).map_error(MimeError.Allocation)?
    Ok(MediaType(type_name, subtype, params))

# A media type without parameters. Both names must be tokens.
pub def new(type_name: &strview, subtype: &strview) -> Result[MediaType, MimeError]:
    if not token_text(type_name) or not token_text(subtype):
        return Err(MimeError.Invalid)
    params = list[Param]().map_error(MimeError.Allocation)?
    Ok(MediaType(type_name.lower().map_error(MimeError.Allocation)?, subtype.lower().map_error(MimeError.Allocation)?, params))

# Extensions

# The fixed extension table: each row is an extension and its Content-Type.
def table(index: i64) -> Option[(str, str)]:
    match index:
        case 0:
            Some(("html", "text/html; charset=utf-8"))
        case 1:
            Some(("htm", "text/html; charset=utf-8"))
        case 2:
            Some(("css", "text/css; charset=utf-8"))
        case 3:
            Some(("js", "text/javascript; charset=utf-8"))
        case 4:
            Some(("mjs", "text/javascript; charset=utf-8"))
        case 5:
            Some(("json", "application/json"))
        case 6:
            Some(("txt", "text/plain; charset=utf-8"))
        case 7:
            Some(("csv", "text/csv; charset=utf-8"))
        case 8:
            Some(("xml", "application/xml"))
        case 9:
            Some(("svg", "image/svg+xml"))
        case 10:
            Some(("png", "image/png"))
        case 11:
            Some(("jpg", "image/jpeg"))
        case 12:
            Some(("jpeg", "image/jpeg"))
        case 13:
            Some(("gif", "image/gif"))
        case 14:
            Some(("webp", "image/webp"))
        case 15:
            Some(("ico", "image/vnd.microsoft.icon"))
        case 16:
            Some(("wasm", "application/wasm"))
        case 17:
            Some(("pdf", "application/pdf"))
        case 18:
            Some(("woff2", "font/woff2"))
        case 19:
            Some(("woff", "font/woff"))
        case _:
            Nothing

# The Content-Type for a file extension given without its dot, compared
# without ASCII case, or Nothing when the table has no entry.
pub def from_extension(extension: &strview) -> Option[str]:
    lookup(extension.as_bytes())

def lookup(text: &[u8]) -> Option[str]:
    mut index = 0
    while True:
        match table(index):
            case Some(row):
                extension, content_type = row
                if same_ascii_bytes(text, extension.as_bytes()):
                    return Some(content_type)
            case Nothing:
                return Nothing
        # table returns Nothing at 20, before the counter can grow further.
        unchecked:
            index += 1
    Nothing

# The Content-Type for the extension of the file name or path `name`, or
# application/octet-stream when it has none in the table. Allocates nothing.
pub def from_file_name(name: &strview) -> str:
    data = name.as_bytes()
    match std.bytes.rfind_byte(data, 46u8):
        case Some(dot):
            # The found dot byte is strictly below len(data).
            start = unchecked:
                dot + 1
            match lookup(&data[start:]):
                case Some(found):
                    found
                case Nothing:
                    "application/octet-stream"
        case Nothing:
            "application/octet-stream"
