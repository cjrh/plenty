# DEFLATE, zlib, gzip and Brotli compression over std.bytes buffers and std.io
# streams. The codecs are bundled in the runtime; this module owns the
# buffering, the output limit and the trailing-data policy. See
# book/src/design/stdlib/compress.md.
import std.bytes
from std.bytes import Bytes
from std.io import StreamError

pub enum Format:
    Deflate
    Zlib
    Gzip
    Brotli

pub enum CompressError:
    OutOfRange
    Corrupt
    Checksum
    Truncated
    TrailingData
    LimitExceeded
    Allocation(AllocError)

# Pending output and input buffers are fixed at this size.
const window: i64 = 16384
# The first byte of every gzip member.
const gzip_magic: u8 = 31u8
const sync_flush: i64 = 2
const finish_flush: i64 = 4

def kind(format: Format, decoding: bool) -> u8:
    base = match format:
        case Format.Deflate:
            1u8
        case Format.Zlib:
            2u8
        case Format.Gzip:
            3u8
        case Format.Brotli:
            7u8
    if decoding:
        if base == 7u8:
            return 8u8
        # The non-Brotli tags are 1..=3, so decoding tags are 4..=6.
        unchecked:
            return base + 3u8
    base

# A codec state: a `Bytes` whose bytes are the codec's pending output, which a
# step never grows past the capacity reserved here. A zero capacity leaves no
# output room, so `step` and `flush` could never make progress.
def codec(kind: u8, level: i64, capacity: i64) -> Result[Bytes, CompressError]:
    if capacity < 1:
        return Err(CompressError.OutOfRange)
    match __compress_new(kind, level, capacity):
        case Ok(storage):
            Ok(__bytes_adopt(storage))
        case Err(cause):
            Err(CompressError.Allocation(cause))

# Feeds `input` to the codec: a count in 0..=len(input), or a negative
# code for `failed`. Both native engines bound consumption by the offered
# view and pending output by the reserved capacity; callers rely on this.
def stepped(state: &mut Bytes, input: &[u8]) -> i64:
    __compress_step(state, input)

# The runtime's negative step and flush results.
def failed(code: i64) -> CompressError:
    match code:
        case -2:
            CompressError.Checksum
        case -3:
            CompressError.Allocation(AllocError.OutOfMemory)
        case _:
            CompressError.Corrupt

# How a reader reports each failure through the Reader protocol;
# Decompressor.failure keeps the precise cause.
pub def stream_error(error: CompressError) -> StreamError:
    match error:
        case CompressError.Truncated:
            StreamError.UnexpectedEof
        case CompressError.OutOfRange:
            StreamError.OutOfRange
        case CompressError.Allocation(cause):
            StreamError.Allocation(cause)
        case _:
            StreamError.Io(IoError.InvalidInput)

def streamed[T](result: Result[T, CompressError]) -> Result[T, StreamError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(stream_error(error))

def interrupted(cause: &StreamError) -> bool:
    match cause:
        case StreamError.Interrupted:
            True
        case _:
            False

def leveled(format: Format, level: i64) -> Result[(), CompressError]:
    maximum = match format:
        case Format.Brotli:
            11
        case _:
            9
    if level < 0 or level > maximum:
        return Err(CompressError.OutOfRange)
    Ok(())

# Exact decoded progress, including across gzip members. Representation
# exhaustion is output beyond the limit too, never a wrapped/saturated count.
# Callers keep 0 <= produced <= limit and amount >= 0.
def output_total(produced: i64, amount: i64, limit: i64) -> Result[i64, CompressError]:
    total = checked:
        produced + amount
    match total:
        case Ok(value):
            if value > limit:
                return Err(CompressError.LimitExceeded)
            Ok(value)
        case Err(_):
            Err(CompressError.LimitExceeded)

# A decoder with its output limit and the policy for what follows a stream:
# a further gzip member is decoded, anything else is TrailingData. The caller
# empties the pending output before each step. Readers that own their input
# use it directly, as std.archive does for zip entries.
pub class Inflater:
    _state: Bytes
    _gzip: bool
    _limit: i64
    _produced: i64

    # Consumes from `input` and leaves new output pending in the state.
    # Returns the count consumed. 0 with pending output means the output
    # window is full: drain it and call again. 0 with no output means more input
    # is needed.
    pub def step(self: &mut Inflater, input: &[u8]) -> Result[i64, CompressError]:
        if __compress_ended(self._state):
            if len(input) == 0:
                return Ok(0)
            if not self._gzip or input[0] != gzip_magic:
                return Err(CompressError.TrailingData)
            __compress_restart(self._state)
        consumed = stepped(&mut self._state, input)
        if consumed < 0:
            return Err(failed(consumed))
        produced = self._state.len()
        self._produced = output_total(self._produced, produced, self._limit)?
        # Codecs consume or produce whenever input and output room remain.
        if len(input) != 0 and consumed == 0 and produced == 0 and not __compress_ended(self._state):
            return Err(CompressError.Corrupt)
        Ok(consumed)

    # Whether the input seen so far is a complete stream.
    pub def complete(self) -> bool:
        __compress_ended(self._state)

    # The output of the last step, at most 16384 bytes.
    pub def output(self) -> &Bytes:
        &self._state

    pub def clear(self: &mut Inflater) -> ():
        self._state.clear()

pub def inflater(format: Format, limit: NonNegative[i64]) -> Result[Inflater, CompressError]:
    state = codec(kind(format, True), 0, window)?
    gzip = match format:
        case Format.Gzip:
            True
        case _:
            False
    Ok(Inflater(state, gzip, limit.get(), 0))

# Compresses all data: DEFLATE levels 0-9, Brotli qualities 0-11.
pub def compress(format: Format, data: &[u8], level: i64) -> Result[Bytes, CompressError]:
    leveled(format, level)?
    mut state = codec(kind(format, False), level, window)?
    mut out = std.bytes.empty().map_error(CompressError.Allocation)?
    mut at = 0
    total = len(data)
    while at < total:
        consumed = stepped(&mut state, &data[at:total])
        if consumed < 0:
            return Err(failed(consumed))
        # Native consumption is in 0..=total-at, so the new cursor <= total.
        unchecked:
            at += consumed
        out.extend(&state).map_error(CompressError.Allocation)?
        state.clear()
    while True:
        done = __compress_flush(state, finish_flush)
        if done < 0:
            return Err(failed(done))
        out.extend(&state).map_error(CompressError.Allocation)?
        state.clear()
        if done == 1:
            return Ok(out)

# Decompresses all of `data`, which must hold exactly one stream (or, for
# gzip, a sequence of members). More than `limit` output bytes is
# LimitExceeded; nothing is returned on any error.
pub def decompress(format: Format, data: &[u8], limit: NonNegative[i64]) -> Result[Bytes, CompressError]:
    mut decoder = inflater(format, limit)?
    mut out = std.bytes.empty().map_error(CompressError.Allocation)?
    mut at = 0
    total = len(data)
    while at < total or not decoder.complete():
        consumed = decoder.step(&data[at:total])?
        produced = decoder._state.len()
        # Native consumption is in 0..=total-at, so the new cursor <= total.
        unchecked:
            at += consumed
        out.extend(&decoder._state).map_error(CompressError.Allocation)?
        decoder._state.clear()
        if at == total and consumed == 0 and produced == 0:
            break
    if not decoder.complete():
        return Err(CompressError.Truncated)
    Ok(out)

# The CRC-32 (as in gzip and zip) of `data`, continuing from `seed`; start
# from 0.
pub def crc32(seed: i64, data: &[u8]) -> Result[i64, CompressError]:
    if seed < 0 or seed > 4294967295:
        return Err(CompressError.OutOfRange)
    Ok(__compress_crc32(seed, data))

# A Writer that compresses into `inner`. Input is accepted once the codec has
# consumed it; output reaches `inner` on later writes, `flush` and `finish`.
# Call `finish` to write the stream's end: dropping the compressor without
# it leaves `inner` with an incomplete stream.
pub class Compressor[W]:
    pub inner: W
    _state: Bytes
    _start: i64
    _finished: bool

    # Delivers pending output. A failure keeps the undelivered tail, so a
    # later call resumes exactly where this one stopped.
    def drain(self: &mut Compressor[W]) -> Result[(), StreamError]:
        total = self._state.len()
        while self._start < total:
            match self.inner.write(&self._state[self._start:total]):
                case Ok(count):
                    if count == 0:
                        return Err(StreamError.WriteZero)
                    # 0 <= _start <= total <= window; validate progress before
                    # advancing so retries retain the exact undelivered tail.
                    unchecked:
                        if count < 0 or count > total - self._start:
                            return Err(StreamError.InvalidProgress)
                        self._start += count
                case Err(cause):
                    if not interrupted(&cause):
                        return Err(cause)
        self._state.clear()
        self._start = 0
        Ok(())

    pub def write(self: &mut Compressor[W], source: &[u8]) -> Result[i64, StreamError]:
        if self._finished or __compress_ended(self._state):
            return Err(StreamError.Io(IoError.Closed))
        if len(source) == 0:
            return Ok(0)
        while True:
            self.drain()?
            consumed = stepped(&mut self._state, source)
            if consumed < 0:
                return Err(stream_error(failed(consumed)))
            if consumed > 0:
                return Ok(consumed)
            # Nothing consumed: the step filled the output buffer first.
            if self._state.len() == 0:
                return Err(StreamError.InvalidProgress)

    # Runs one flush mode until the codec reports it complete. An ended
    # codec (finish failed while delivering) has nothing left to flush.
    def flushed(self: &mut Compressor[W], mode: i64) -> Result[(), StreamError]:
        while True:
            self.drain()?
            if __compress_ended(self._state):
                return Ok(())
            done = __compress_flush(self._state, mode)
            if done < 0:
                return Err(stream_error(failed(done)))
            if done == 1:
                return self.drain()

    # Delivers everything written so far as complete blocks, then flushes
    # `inner`. Frequent flushes cost compression ratio.
    pub def flush(self: &mut Compressor[W]) -> Result[(), StreamError]:
        if not self._finished:
            self.flushed(sync_flush)?
        self.drain()?
        self.inner.flush()

    # Writes the stream's end and checksum, then flushes `inner`. Later
    # writes report IoError.Closed. After a failure, call it again to resume.
    pub def finish(self: &mut Compressor[W]) -> Result[(), StreamError]:
        if not self._finished:
            self.flushed(finish_flush)?
            self._finished = True
        self.drain()?
        self.inner.flush()

pub def compressor[W](format: Format, inner: W, level: i64) -> Result[Compressor[W], CompressError]:
    leveled(format, level)?
    state = codec(kind(format, False), level, window)?
    Ok(Compressor(inner, state, 0, False))

# A Reader of the decompressed contents of `inner`. A failure other than an
# inner read error ends the stream: every later read repeats it, and
# `failure` names the precise cause. Bytes already returned may precede a
# checksum failure, which gzip and zlib detect only at the stream's end.
pub class Decompressor[R]:
    pub inner: R
    _decoder: Inflater
    _start: i64
    _input: Bytes
    _in_start: i64
    _in_stop: i64
    _eof: bool
    _failure: Option[CompressError]

    pub def failure(self) -> Option[CompressError]:
        self._failure

    def fail(self: &mut Decompressor[R], error: CompressError) -> Result[i64, StreamError]:
        self._failure = Some(error)
        Err(stream_error(error))

    pub def read(self: &mut Decompressor[R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        if not (0 <= start and start <= stop and stop <= buffer.len()):
            __trap("read: start/stop outside buffer")
        match self._failure:
            case Some(error):
                return Err(stream_error(error))
            case Nothing:
                pass
        if start == stop:
            return Ok(0)
        while True:
            # The output cursor stays in 0..=state.len() <= window.
            pending = unchecked:
                self._decoder._state.len() - self._start
            if pending > 0:
                # The caller's destination range was validated above.
                mut count = unchecked:
                    stop - start
                if count > pending:
                    count = pending
                # count <= pending, hence _start+count <= state.len().
                unchecked:
                    buffer.overwrite(start, &self._decoder._state[self._start:self._start + count])
                    self._start += count
                if self._start == self._decoder._state.len():
                    self._decoder._state.clear()
                    self._start = 0
                return Ok(count)
            if self._in_start == self._in_stop:
                # Brotli can consume the final compressed byte before emitting
                # a long back-reference. Drain the codec before requesting more
                # input or treating transport EOF as a truncated stream.
                if not self._decoder.complete():
                    match self._decoder.step(&self._input[self._in_start:self._in_stop]):
                        case Ok(_):
                            if self._decoder._state.len() > 0:
                                continue
                        case Err(error):
                            return self.fail(error)
                if self._eof:
                    if self._decoder.complete():
                        return Ok(0)
                    return self.fail(CompressError.Truncated)
                size = self._input.len()
                # Inner errors leave this reader intact, so Interrupted and
                # other transient failures can be retried.
                count = self.inner.read(&mut self._input, 0, size)?
                if count < 0 or count > size:
                    return Err(StreamError.InvalidProgress)
                self._in_start = 0
                self._in_stop = count
                if count == 0:
                    self._eof = True
            else:
                match self._decoder.step(&self._input[self._in_start:self._in_stop]):
                    case Ok(consumed):
                        # Native consumption <= _in_stop-_in_start; both
                        # cursors remain inside the fixed input window.
                        unchecked:
                            self._in_start += consumed
                    case Err(error):
                        return self.fail(error)

pub def decompressor[R](format: Format, inner: R, limit: NonNegative[i64]) -> Result[Decompressor[R], CompressError]:
    decoder = inflater(format, limit)?
    mut input = std.bytes.with_capacity(window).map_error(CompressError.Allocation)?
    input.resize(window, 0u8).map_error(CompressError.Allocation)?
    Ok(Decompressor(inner, decoder, 0, input, 0, 0, False, Nothing))
