# Rooted copy API modelled on Python shutil.copytree/copy2, with explicit
# limits and no-follow contracts; implemented directly in Plenty.
from std.path import Path, from_bytes
from std.time import Timestamp
import std.bytes
import std.secrets
from std.io import FileStream, Reader, StreamError, write_all
from std.sync import CancellationToken
from std.secrets import SecretsError
from std.bytes import Bytes

pub enum FsError:
    Io(IoError)
    Stream(StreamError)
    Allocation(AllocError)
    Entropy(SecretsError)
    InvalidInput
    Limit
    Cancelled
    Replaced
    Collisions
    UnsupportedType
    Overlap
    InvalidLimits

def fs_io[T](result: Result[T, IoError]) -> Result[T, FsError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(FsError.Io(error))

def fs_alloc[T](result: Result[T, AllocError]) -> Result[T, FsError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(FsError.Allocation(error))

def fs_stream[T](result: Result[T, StreamError]) -> Result[T, FsError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(FsError.Stream(error))

def fs_secret(result: Result[str, SecretsError]) -> Result[str, FsError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(FsError.Entropy(error))

# These handles anchor every child operation to an opened directory. Names
# contain exactly one nonempty component (neither dot nor dot-dot).
pub class Root:
    _handle: File

    pub def open_dir(self, name: &Path) -> Result[Root, IoError]:
        Ok(Root(__fs_child(self._handle, name.as_bytes())?))

    pub def read_file(self, name: &Path) -> Result[FileStream, IoError]:
        Ok(FileStream(__fs_read_file(self._handle, name.as_bytes())?))

    pub def create_dir(self, name: &Path, unix_mode: u32 = 0o700u32) -> Result[(), IoError]:
        valid_unix_mode(unix_mode)?
        __fs_make_dir(self._handle, name.as_bytes(), unix_mode)

    pub def create_file(self, name: &Path, unix_mode: u32 = 0o600u32) -> Result[FileStream, IoError]:
        valid_unix_mode(unix_mode)?
        Ok(FileStream(__fs_create_file(self._handle, name.as_bytes(), unix_mode)?))

    pub def set_unix_mode(self, unix_mode: u32) -> Result[(), IoError]:
        valid_unix_mode(unix_mode)?
        __fs_set_unix_mode(self._handle, unix_mode)

    pub def remove_file(self, name: &Path) -> Result[(), IoError]:
        __fs_remove_file(self._handle, name.as_bytes())

    pub def remove_dir(self, name: &Path) -> Result[(), IoError]:
        __fs_remove_dir(self._handle, name.as_bytes())

    pub def move(self, source: &Path, destination: &Path) -> Result[(), IoError]:
        __fs_move(self._handle, source.as_bytes(), destination.as_bytes())

    pub def names(self) -> Result[Names, IoError]:
        Ok(Names(ReadDir(__fs_root_entries(self._handle)?)))

    def duplicate(self) -> Result[Root, IoError]:
        Ok(Root(__fs_duplicate_root(self._handle)?))

# Only ordinary permission bits; no accidental file-type, set-ID or sticky bits.
def valid_unix_mode(unix_mode: u32) -> Result[(), IoError]:
    if unix_mode > 0o777u32:
        return Err(IoError.InvalidInput)
    Ok(())

# Changes the held inode, never a replacement reached through its old pathname.
pub def set_file_unix_mode(stream: &FileStream, unix_mode: u32) -> Result[(), IoError]:
    valid_unix_mode(unix_mode)?
    __fs_set_unix_mode(stream.file, unix_mode)

pub def root(path: &Path) -> Result[Root, IoError]:
    Ok(Root(__fs_root(path.as_bytes())?))

pub class Names:
    _directory: ReadDir

    pub def next(self: &mut Names) -> Result[Option[Path], IoError]:
        match self._directory.next()?:
            case Some(entry):
                Ok(Some(entry.file_name()?))
            case Nothing:
                Ok(Nothing)

    pub def close(self: &mut Names) -> Result[(), IoError]:
        self._directory.close()

# An unnamed inode: neither cancellation nor destruction unlinks a path that
# another process could have replaced. Publication adds one name atomically.
pub class TempFile:
    pub stream: FileStream
    _root: Root
    _published: bool

    pub def publish(self: &mut TempFile, name: &Path) -> Result[(), IoError]:
        if self._published:
            return Err(IoError.InvalidInput)
        __fs_publish(self.stream.file, self._root._handle, name.as_bytes())?
        self._published = True
        Ok(())

    pub def close(self: &mut TempFile) -> Result[(), StreamError]:
        self.stream.close()

    # Publication and unlink are separate operations; require a stable parent.
    # Compare against the still-open original, never just its remembered path.
    pub def remove_published(self: &mut TempFile, name: &Path) -> Result[(), FsError]:
        if not self._published:
            return Err(FsError.InvalidInput)
        current = match self._root.read_file(name):
            case Ok(stream):
                stream
            case Err(IoError.System(2i32)):
                return Ok(())
            case Err(error):
                return Err(FsError.Io(error))
        original = fs_io(file_metadata(&self.stream))?
        found = fs_io(file_metadata(&current))?
        if original.unix_device() != found.unix_device() or original.unix_inode() != found.unix_inode():
            return Err(FsError.Replaced)
        fs_io(self._root.remove_file(name))?
        Ok(())

pub def temporary_file(parent: &Root) -> Result[TempFile, IoError]:
    owner = parent.duplicate()?
    stream = FileStream(__fs_anonymous(parent._handle)?)
    Ok(TempFile(stream, owner, False))

pub class TempDir:
    _parent: Root
    _root: Root
    _name: Path
    _active: bool

    pub def name(self) -> &Path:
        &self._name

    pub def root(self) -> &Root:
        &self._root

    pub def cleanup(self: &mut TempDir) -> Result[(), FsError]:
        if not self._active:
            return Ok(())
        if not fs_io(__fs_same_dir(self._root._handle, self._parent._handle, self._name.as_bytes()))?:
            return Err(FsError.Replaced)
        fs_io(self._parent.remove_dir(&self._name))?
        self._active = False
        Ok(())

    pub def keep(self: &mut TempDir) -> ():
        self._active = False

    # Traverse the held directory, not a replacement opened through its name.
    pub def cleanup_tree(self: &mut TempDir, max_entries: Positive[i64], max_depth: Positive[i64] __max(64), cancel: &CancellationToken) -> Result[(), FsError]:
        if max_depth > 64:
            __trap("TempDir.cleanup_tree: max_depth is above 64")
        if not self._active:
            return Ok(())
        if not fs_io(__fs_same_dir(self._root._handle, self._parent._handle, self._name.as_bytes()))?:
            return Err(FsError.Replaced)
        mut budget = Budget(max_entries.get())
        delete_open_directory(&self._parent, &self._name, &self._root, &mut budget, max_depth.get(), cancel)?
        self._active = False
        Ok(())

    def __del__(self) -> ():
        drop(self.cleanup())

# Deterministic exclusive creation is also useful when a caller already has
# an unpredictable name. Parent/name allocation precedes mkdir.
pub def temporary_dir_named(parent: &Root, name: &Path) -> Result[TempDir, FsError]:
    owner = fs_io(parent.duplicate())?
    saved = fs_alloc(name.copy())?
    child = Root(fs_io(__fs_make_temporary_dir(parent._handle, name.as_bytes()))?)
    Ok(TempDir(owner, child, saved, True))

pub def temporary_dir(parent: &Root, prefix: &Path, attempts: Positive[i64] __max(1024)) -> Result[TempDir, FsError]:
    if attempts > 1024:
        __trap("std.fs.temporary_dir: attempts is above 1024")
    if len(prefix.as_bytes()) > 200:
        return Err(FsError.InvalidInput)
    for index in range(len(prefix.as_bytes())):
        byte = prefix.as_bytes()[index]
        if byte == 0u8 or byte == 47u8:
            return Err(FsError.InvalidInput)
    for _ in range(attempts.get()):
        token = fs_secret(std.secrets.token_hex(16))?
        mut bytes = fs_alloc(copy(prefix.as_bytes()))?
        suffix = fs_io(encode_utf8(&token))?
        for index in range(len(suffix)):
            fs_alloc(bytes.append(suffix[index]))?
        name = from_bytes(bytes)
        match temporary_dir_named(parent, &name):
            case Ok(owner):
                return Ok(owner)
            case Err(error):
                match error:
                    case FsError.Io(IoError.System(code)):
                        if code != 17i32:
                            return Err(FsError.Io(IoError.System(code)))
                    case _:
                        return Err(error)
    Err(FsError.Collisions)

pub enum CopyMetadata:
    ContentsOnly
    PermissionsAndTimes

# Copy contents to an existing unnamed target, with one caller-owned buffer.
def transfer[R: Reader](source: &mut R, target: &mut FileStream, scratch: &mut Bytes, max_bytes: i64, cancel: &CancellationToken) -> Result[i64, FsError]:
    # Validated progress and the byte budget keep 0 <= total <= max_bytes.
    unchecked:
        mut total = 0
        while True:
            if cancel.is_cancelled():
                return Err(FsError.Cancelled)
            count = match source.read(scratch, 0, 8192):
                case Ok(value):
                    value
                case Err(StreamError.Interrupted):
                    continue
                case Err(error):
                    return Err(FsError.Stream(error))
            if cancel.is_cancelled():
                return Err(FsError.Cancelled)
            if count < 0 or count > 8192:
                return Err(FsError.Stream(StreamError.InvalidProgress))
            if count == 0:
                fs_stream(target.flush())?
                return Ok(total)
            if count > max_bytes - total:
                return Err(FsError.Limit)
            match write_all(target, &scratch[:count]):
                case Ok(_):
                    total += count
                case Err(partial):
                    return Err(FsError.Stream(partial.cause))
        Ok(total)

def copy_buffer() -> Result[Bytes, FsError]:
    mut scratch = fs_alloc(std.bytes.with_capacity(8192))?
    fs_alloc(scratch.resize(8192, 0u8))?
    Ok(scratch)

# Reader has no source filesystem metadata. The unnamed target vanishes on failure.
pub def copy_from[R: Reader](source: &mut R, parent: &Root, destination: &Path, max_bytes: NonNegative[i64], cancel: &CancellationToken) -> Result[i64, FsError]:
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    mut scratch = copy_buffer()?
    mut target = fs_io(temporary_file(parent))?
    total = transfer(source, &mut target.stream, &mut scratch, max_bytes.get(), cancel)?
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    fs_io(target.publish(destination))?
    Ok(total)

def observe_copy_metadata(handle: &File, preserve: CopyMetadata) -> Result[Option[Metadata], FsError]:
    if preserve == CopyMetadata.ContentsOnly:
        Ok(Nothing)
    else:
        Ok(Some(Metadata(fs_io(__fs_file_metadata(handle))?)))

def apply_copy_metadata(handle: &File, observation: &Option[Metadata]) -> Result[(), FsError]:
    match observation:
        case Some(metadata):
            fs_io(__fs_apply_copy_metadata(handle, metadata._owner))
        case Nothing:
            Ok(())

def copy_open_file(input: &mut FileStream, parent: &Root, destination: &Path, scratch: &mut Bytes, max_bytes: i64, cancel: &CancellationToken, preserve: CopyMetadata) -> Result[i64, FsError]:
    observation = observe_copy_metadata(input.file, preserve)?
    mut target = fs_io(temporary_file(parent))?
    total = transfer(input, &mut target.stream, scratch, max_bytes, cancel)?
    apply_copy_metadata(target.stream.file, &observation)?
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    fs_io(target.publish(destination))?
    Ok(total)

pub def copy_file(parent: &Root, source: &Path, destination: &Path, max_bytes: NonNegative[i64], cancel: &CancellationToken, preserve: CopyMetadata = CopyMetadata.ContentsOnly) -> Result[i64, FsError]:
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    mut input = fs_io(parent.read_file(source))?
    mut scratch = copy_buffer()?
    copy_open_file(&mut input, parent, destination, &mut scratch, max_bytes.get(), cancel, preserve)

pub class CopyLimits:
    pub max_entries: i64
    pub max_depth: i64
    pub max_bytes: i64
    pub max_open_handles: i64

pub def copy_limits() -> CopyLimits:
    CopyLimits(10000, 32, 67108864, 128)

# Setup never created the destination; Partial leaves it for explicit inspection
# and remove_tree. Earlier successful children stay copied on any later failure.
pub enum TreeCopyError:
    Setup(FsError)
    Partial(FsError)
    Entry(Path, i64, FsError)

class CopyBudget:
    entries: i64
    bytes: i64
    destination_device: u64
    destination_inode: u64

    def step(self: &mut CopyBudget) -> Result[(), FsError]:
        # The validated initial entry budget is nonnegative; zero returns before decrement.
        unchecked:
            if self.entries == 0:
                return Err(FsError.Limit)
            self.entries -= 1
            Ok(())

def prepare_copy_directory(source: &Root, target: &Root, name: &Path) -> Result[(Root, Root), FsError]:
    child = fs_io(source.open_dir(name))?
    fs_io(target.create_dir(name))?
    output = fs_io(target.open_dir(name))?
    Ok((child, output))

def copy_directory(source: &Root, target: &Root, scratch: &mut Bytes, budget: &mut CopyBudget, limits: &CopyLimits, level: i64, cancel: &CancellationToken, preserve: CopyMetadata) -> Result[(), TreeCopyError]:
    # Depth stays in 1..64 (reported child level <= 65); successful copies fit bytes remaining.
    unchecked:
        if cancel.is_cancelled():
            return Err(TreeCopyError.Partial(FsError.Cancelled))
        observation = observe_copy_metadata(source._handle, preserve).map_error(TreeCopyError.Partial)?
        mut names = fs_io(source.names()).map_error(TreeCopyError.Partial)?
        while True:
            if cancel.is_cancelled():
                return Err(TreeCopyError.Partial(FsError.Cancelled))
            match fs_io(names.next()).map_error(TreeCopyError.Partial)?:
                case Nothing:
                    break
                case Some(name):
                    match budget.step():
                        case Err(error):
                            return Err(TreeCopyError.Entry(name, level + 1, error))
                        case Ok(_):
                            pass
                    metadata = match fs_io(__fs_child_metadata(source._handle, name.as_bytes())):
                        case Ok(owner):
                            Metadata(owner)
                        case Err(error):
                            return Err(TreeCopyError.Entry(name, level + 1, error))
                    if metadata.is_dir():
                        # A bind mount can hide source ancestry from dot-dot walks.
                        # Stop before entering the original destination parent.
                        if metadata.unix_device() == budget.destination_device and metadata.unix_inode() == budget.destination_inode:
                            return Err(TreeCopyError.Entry(name, level + 1, FsError.Overlap))
                        if level == limits.max_depth or 3 * (level + 1) + 8 > limits.max_open_handles:
                            return Err(TreeCopyError.Entry(name, level + 1, FsError.Limit))
                        opened = match prepare_copy_directory(source, target, &name):
                            case Ok(pair):
                                pair
                            case Err(error):
                                return Err(TreeCopyError.Entry(name, level + 1, error))
                        child, output = opened
                        match copy_directory(&child, &output, scratch, budget, limits, level + 1, cancel, preserve):
                            case Ok(_):
                                pass
                            case Err(TreeCopyError.Partial(error)):
                                return Err(TreeCopyError.Entry(name, level + 1, error))
                            case Err(error):
                                return Err(error)
                    elif metadata.is_file():
                        mut input = match fs_io(source.read_file(&name)):
                            case Ok(stream):
                                stream
                            case Err(error):
                                return Err(TreeCopyError.Entry(name, level + 1, error))
                        match copy_open_file(&mut input, target, &name, scratch, budget.bytes, cancel, preserve):
                            case Ok(count):
                                budget.bytes -= count
                            case Err(error):
                                return Err(TreeCopyError.Entry(name, level + 1, error))
                    else:
                        return Err(TreeCopyError.Entry(name, level + 1, FsError.UnsupportedType))
        fs_io(names.close()).map_error(TreeCopyError.Partial)?
        apply_copy_metadata(target._handle, &observation).map_error(TreeCopyError.Partial)?
        Ok(())

# Only newly-created destinations are accepted. No recursive rollback is hidden
# in error handling: cleanup has its own budgets and can itself fail.
pub def copy_tree(source_parent: &Root, source: &Path, destination_parent: &Root, destination: &Path, limits: &CopyLimits, cancel: &CancellationToken, preserve: CopyMetadata = CopyMetadata.ContentsOnly) -> Result[i64, TreeCopyError]:
    # Validated positive entries and the nonnegative consumed byte budget bound both differences.
    unchecked:
        if limits.max_entries < 1 or limits.max_depth < 1 or limits.max_depth > 64 or limits.max_bytes < 0 or limits.max_open_handles < 11:
            return Err(TreeCopyError.Setup(FsError.InvalidLimits))
        if cancel.is_cancelled():
            return Err(TreeCopyError.Setup(FsError.Cancelled))
        input = fs_io(source_parent.open_dir(source)).map_error(TreeCopyError.Setup)?
        if fs_io(__fs_is_within(input._handle, destination_parent._handle)).map_error(TreeCopyError.Setup)?:
            return Err(TreeCopyError.Setup(FsError.Overlap))
        destination_metadata = Metadata(fs_io(__fs_file_metadata(destination_parent._handle)).map_error(TreeCopyError.Setup)?)
        mut scratch = copy_buffer().map_error(TreeCopyError.Setup)?
        fs_io(destination_parent.create_dir(destination)).map_error(TreeCopyError.Setup)?
        output = fs_io(destination_parent.open_dir(destination)).map_error(TreeCopyError.Partial)?
        mut budget = CopyBudget(limits.max_entries - 1, limits.max_bytes, destination_metadata.unix_device(), destination_metadata.unix_inode())
        copy_directory(&input, &output, &mut scratch, &mut budget, limits, 1, cancel, preserve)?
        if cancel.is_cancelled():
            return Err(TreeCopyError.Partial(FsError.Cancelled))
        Ok(limits.max_bytes - budget.bytes)

class Budget:
    remaining: i64

    def step(self: &mut Budget) -> Result[(), FsError]:
        # Only strictly positive remaining budgets reach the decrement.
        unchecked:
            if self.remaining <= 0:
                return Err(FsError.Limit)
            self.remaining -= 1
            Ok(())

def delete_children(parent: &Root, name: &Path, budget: &mut Budget, depth: i64, cancel: &CancellationToken) -> Result[(), FsError]:
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    budget.step()?
    if depth == 0:
        return Err(FsError.Limit)
    child = fs_io(parent.open_dir(name))?
    delete_directory_contents(parent, name, &child, budget, depth, cancel)?
    Ok(())

def delete_open_directory(parent: &Root, name: &Path, child: &Root, budget: &mut Budget, depth: i64, cancel: &CancellationToken) -> Result[(), FsError]:
    if cancel.is_cancelled():
        return Err(FsError.Cancelled)
    budget.step()?
    if depth == 0:
        return Err(FsError.Limit)
    delete_directory_contents(parent, name, child, budget, depth, cancel)

def delete_directory_contents(parent: &Root, name: &Path, child: &Root, budget: &mut Budget, depth: i64, cancel: &CancellationToken) -> Result[(), FsError]:
    # Private callers require depth in 1..64; recursion decrements at most to zero.
    unchecked:
        mut names = fs_io(child.names())?
        while True:
            if cancel.is_cancelled():
                return Err(FsError.Cancelled)
            match fs_io(names.next())?:
                case Nothing:
                    break
                case Some(leaf):
                    match child.open_dir(&leaf):
                        case Ok(directory):
                            drop(directory)
                            delete_children(child, &leaf, budget, depth - 1, cancel)?
                        case Err(error):
                            match error:
                                case IoError.System(code):
                                    if code != 20i32 and code != 40i32:
                                        return Err(FsError.Io(IoError.System(code)))
                                case _:
                                    return Err(FsError.Io(error))
                            budget.step()?
                            fs_io(child.remove_file(&leaf))?
        if not fs_io(__fs_same_dir(child._handle, parent._handle, name.as_bytes()))?:
            return Err(FsError.Replaced)
        fs_io(parent.remove_dir(name))

# Explicit recursive removal only: a budget/cancellation/error leaves already
# removed entries removed. Symlinks are unlinked, never traversed.
pub def remove_tree(parent: &Root, name: &Path, max_entries: Positive[i64], max_depth: Positive[i64] __max(64), cancel: &CancellationToken) -> Result[(), FsError]:
    if max_depth > 64:
        __trap("std.fs.remove_tree: max_depth is above 64")
    mut budget = Budget(max_entries.get())
    delete_children(parent, name, &mut budget, max_depth.get(), cancel)

# Byte matching (not Unicode): star matches any sequence and question-mark
# exactly one byte. All other bytes are literal, including dot and brackets.
def matches_name(pattern: &list[u8], name: &list[u8], budget: &mut Budget) -> Result[bool, FsError]:
    # Pattern/name cursors advance only below their lengths; retry never exceeds name length.
    unchecked:
        mut p = 0
        mut n = 0
        mut star = -1
        mut retry = 0
        while n < len(name):
            budget.step()?
            if p < len(pattern) and pattern[p] == 42u8:
                star = p
                p += 1
                retry = n
            elif p < len(pattern) and (pattern[p] == 63u8 or pattern[p] == name[n]):
                p += 1
                n += 1
            elif star >= 0:
                retry += 1
                n = retry
                p = star + 1
            else:
                return Ok(False)
        while p < len(pattern) and pattern[p] == 42u8:
            budget.step()?
            p += 1
        Ok(p == len(pattern))

pub def glob(parent: &Root, pattern: &Path, max_entries: NonNegative[i64], max_matches: NonNegative[i64], max_steps: NonNegative[i64]) -> Result[list[Path], FsError]:
    if len(pattern.as_bytes()) > 4096:
        return Err(FsError.InvalidInput)
    for index in range(len(pattern.as_bytes())):
        byte = pattern.as_bytes()[index]
        if byte == 0u8 or byte == 47u8:
            return Err(FsError.InvalidInput)
    mut scan_budget = Budget(max_entries.get())
    mut match_budget = Budget(max_steps.get())
    mut result = fs_alloc(list[Path].new())?
    mut names = fs_io(parent.names())?
    while True:
        match fs_io(names.next())?:
            case Nothing:
                return Ok(result)
            case Some(name):
                scan_budget.step()?
                if matches_name(pattern.as_bytes(), name.as_bytes(), &mut match_budget)?:
                    if len(result) == max_matches.get():
                        return Err(FsError.Limit)
                    fs_alloc(result.append(name))?
    Ok(result)

pub enum FileType:
    File
    Directory
    Symlink
    Other

def file_type(code: u8) -> FileType:
    if code == 8u8:
        FileType.File
    elif code == 4u8:
        FileType.Directory
    elif code == 10u8:
        FileType.Symlink
    else:
        FileType.Other

pub class Permissions:
    pub readonly: bool
    pub unix_mode: u32

pub class Metadata:
    _owner: FsMetadata

    pub def file_type(self) -> FileType:
        file_type(u8.wrapping_from(__fs_metadata_field(self._owner, 0)))

    pub def is_file(self) -> bool:
        self.file_type() == FileType.File

    pub def is_dir(self) -> bool:
        self.file_type() == FileType.Directory

    pub def is_symlink(self) -> bool:
        self.file_type() == FileType.Symlink

    pub def size(self) -> u64:
        __fs_metadata_field(self._owner, 1)

    pub def permissions(self) -> Permissions:
        Permissions(__fs_metadata_field(self._owner, 2) != 0u64, u32.wrapping_from(__fs_metadata_field(self._owner, 3)))

    def time(self, field: u8) -> Option[Timestamp]:
        # Only metadata slots 8, 11 or 14 are passed here, so field + 2 fits u8.
        unchecked:
            if __fs_metadata_field(self._owner, field) == 0u64:
                return Nothing
            Some(Timestamp(i64.wrapping_from(__fs_metadata_field(self._owner, field + 1u8)), u32.wrapping_from(__fs_metadata_field(self._owner, field + 2u8))))

    pub def modified(self) -> Option[Timestamp]:
        self.time(8)

    pub def accessed(self) -> Option[Timestamp]:
        self.time(11)

    pub def created(self) -> Option[Timestamp]:
        self.time(14)

    pub def unix_changed(self) -> Timestamp:
        Timestamp(i64.wrapping_from(__fs_metadata_field(self._owner, 17)), u32.wrapping_from(__fs_metadata_field(self._owner, 18)))

    pub def unix_uid(self) -> u32:
        u32.wrapping_from(__fs_metadata_field(self._owner, 4))

    pub def unix_gid(self) -> u32:
        u32.wrapping_from(__fs_metadata_field(self._owner, 5))

    pub def unix_device(self) -> u64:
        __fs_metadata_field(self._owner, 6)

    pub def unix_inode(self) -> u64:
        __fs_metadata_field(self._owner, 7)

pub class DirEntry:
    _owner: FsDirEntry

    pub def file_name(self) -> Result[Path, IoError]:
        Ok(from_bytes(__fs_name(self._owner)?))

    pub def path(self) -> Result[Path, IoError]:
        Ok(from_bytes(__fs_path(self._owner)?))

    pub def file_type(self) -> Result[FileType, IoError]:
        Ok(file_type(__fs_type(self._owner)?))

    pub def metadata(self) -> Result[Metadata, IoError]:
        Ok(Metadata(__fs_entry_metadata(self._owner)?))

pub class ReadDir:
    _owner: FsReadDir

    pub def next(self: &mut ReadDir) -> Result[Option[DirEntry], IoError]:
        match __fs_next(self._owner)?:
            case Some(owner):
                Ok(Some(DirEntry(owner)))
            case Nothing:
                Ok(Nothing)

    pub def close(self: &mut ReadDir) -> Result[(), IoError]:
        __fs_close(self._owner)

    pub def closed(self) -> bool:
        __fs_closed(self._owner)

pub def read_dir(path: &Path) -> Result[ReadDir, IoError]:
    Ok(ReadDir(__fs_open(path.as_bytes())?))

pub def metadata(path: &Path) -> Result[Metadata, IoError]:
    Ok(Metadata(__fs_metadata(path.as_bytes(), True)?))

pub def symlink_metadata(path: &Path) -> Result[Metadata, IoError]:
    Ok(Metadata(__fs_metadata(path.as_bytes(), False)?))

# The open file itself, not whatever its path names now: a file opened
# through a Root keeps its confinement for this observation too.
pub def file_metadata(stream: &FileStream) -> Result[Metadata, IoError]:
    Ok(Metadata(__fs_file_metadata(stream.file)?))

pub def read_link(path: &Path) -> Result[Path, IoError]:
    Ok(from_bytes(__fs_readlink(path.as_bytes())?))

# Consuming generator uses the existing iteration system. Each item is fallible;
# construction opens immediately, while advancing obtains just one entry.
pub def entries(owner: ReadDir) -> Generator[Result[DirEntry, IoError]]:
    mut directory = owner
    while True:
        match directory.next():
            case Ok(value):
                match value:
                    case Some(entry):
                        yield Ok(entry)
                    case Nothing:
                        return
            case Err(error):
                yield Err(error)
                return

pub enum WalkError:
    Io(Path, str, IoError)
    Allocation(AllocError)

pub class WalkDir:
    pub path: Path
    pub directories: list[Path]
    pub files: list[DirEntry]

enum Frame:
    Pending(Path)
    Scanned(WalkDir)

def allocated[T](result: Result[T, AllocError]) -> Result[T, WalkError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(WalkError.Allocation(error))

def stored(result: Result[(), AllocError]) -> Result[(), WalkError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(error):
            Err(WalkError.Allocation(error))

def scan(path: Path) -> Result[WalkDir, WalkError]:
    match read_dir(&path):
        case Ok(owner):
            scan_open(path, owner)
        case Err(error):
            Err(WalkError.Io(path, "read_dir", error))

def scan_open(path: Path, owner: ReadDir) -> Result[WalkDir, WalkError]:
    mut directories = allocated(list[Path].new())?
    mut files = allocated(list[DirEntry].new())?
    mut directory = owner
    while True:
        advanced = directory.next()
        match advanced:
            case Ok(value):
                match value:
                    case Some(entry):
                        match entry.file_type():
                            case Ok(kind):
                                if kind == FileType.Directory:
                                    match entry.path():
                                        case Ok(child):
                                            stored(directories.append(child))?
                                        case Err(error):
                                            return Err(WalkError.Io(path, "entry.path", error))
                                else:
                                    stored(files.append(entry))?
                            case Err(error):
                                match entry.path():
                                    case Ok(child):
                                        return Err(WalkError.Io(child, "file_type", error))
                                    case Err(path_error):
                                        return Err(WalkError.Io(path, "entry.path", path_error))
                    case Nothing:
                        return Ok(WalkDir(path, directories, files))
            case Err(error):
                return Err(WalkError.Io(path, "next", error))
    Ok(WalkDir(path, directories, files))

# Only scan owns a native directory stream. Pending frames are detached values;
# bottom-up retains a row at each active level until its children finish.
pub class Walk:
    pub current: WalkDir
    _pending: list[Frame]
    _top_down: bool
    _started: bool
    _closed: bool

    pub def close(self: &mut Walk) -> ():
        self._pending.clear()
        self.current.directories.clear()
        self.current.files.clear()
        self._closed = True

    pub def next(self: &mut Walk) -> Result[bool, WalkError]:
        if self._closed:
            return Ok(False)
        if self._top_down and self._started:
            # Reserve before consuming caller-edited directories. The caller
            # can remove/reorder these paths before any child is opened.
            stored(self._pending.reserve(len(self.current.directories)))?
            while len(self.current.directories) > 0:
                match self.current.directories.pop():
                    case Some(child):
                        stored(self._pending.append(Frame.Pending(child)))?
                    case Nothing:
                        pass
        self._started = True
        while True:
            match self._pending.pop():
                case Nothing:
                    self._closed = True
                    return Ok(False)
                case Some(frame):
                    match frame:
                        case Frame.Scanned(row):
                            self.current = row
                            return Ok(True)
                        case Frame.Pending(path):
                            # A failed frame is already popped. Handling Err
                            # and calling next again continues pending siblings.
                            row = scan(path)?
                            if self._top_down:
                                self.current = row
                                return Ok(True)
                            extent = checked:
                                len(row.directories) + 1
                            additional = match extent:
                                case Ok(value):
                                    value
                                case Err(_):
                                    return Err(WalkError.Allocation(AllocError.CapacityOverflow))
                            stored(self._pending.reserve(additional))?
                            mut children = allocated(list[Frame].with_capacity(len(row.directories)))?
                            for child in &row.directories:
                                stored(children.append(Frame.Pending(allocated(child.copy())?)))?
                            stored(self._pending.append(Frame.Scanned(row)))?
                            while len(children) > 0:
                                match children.pop():
                                    case Some(child):
                                        stored(self._pending.append(child))?
                                    case Nothing:
                                        pass
        Ok(False)

pub def walk(root: &Path, top_down: bool) -> Result[Walk, AllocError]:
    mut pending = list[Frame].with_capacity(1)?
    pending.append(Frame.Pending(root.copy()?))?
    current = WalkDir(root.copy()?, list[Path].new()?, list[DirEntry].new()?)
    Ok(Walk(current, pending, top_down, False, False))
