# RFC 8259 JSON: a resumable event decoder, an event encoder, and a value tree
# built on both. Everything is checked Plenty over `std.bytes`; nothing is
# skipped or repaired. Every size the input controls is bounded by `Limits`.
# See book/src/design/stdlib/json.md.
import std.bytes
import std.error
import std.io
import std.serial
from std.bytes import Bytes, BytesError
from std.io import Reader, Writer, StreamError

pub enum JsonFault:
    UnexpectedByte
    UnexpectedEnd
    TrailingData
    InvalidLiteral
    InvalidNumber
    NumberOutOfRange
    InvalidEscape
    InvalidSurrogate
    ControlCharacter
    InvalidUtf8
    DuplicateKey
    DepthExceeded
    InputTooLarge
    OutputTooLarge
    NonFiniteNumber
    InvalidState
    Stream(StreamError)
    Allocation(AllocError)
    Serialization(std.serial.Fault)

# Decoder errors locate the offending input byte: `offset` counts bytes from
# zero, `line` and `column` count from one, and a column is one Unicode scalar.
# Encoder errors carry the output bytes produced so far and zero for both.
pub class JsonError:
    pub fault: JsonFault
    pub offset: i64
    pub line: i64
    pub column: i64

pub enum DuplicateKeys:
    Reject
    Keep

pub class Limits:
    pub max_depth: NonNegative[i64] __max(1024)
    pub max_input: NonNegative[i64]
    pub max_output: NonNegative[i64]
    pub duplicate_keys: DuplicateKeys

pub enum Json:
    Null
    Bool(bool)
    Int(i64)
    Float(f64)
    Text(str)
    Array(list[Json])
    Object(list[Member])

# Members keep their source order.
pub class Member:
    pub key: str
    pub value: Json

# `Number` carries the validated source text so a typed codec chooses its own
# width. `Pending` asks for more input; `End` follows a complete document.
pub enum Event:
    Pending
    End
    Null
    Bool(bool)
    Number(str)
    Text(str)
    Key(str)
    StartArray
    EndArray
    StartObject
    EndObject

# Encoder recursion over a tree is bounded by the depth limit, so the limit
# itself is capped to keep that recursion within the native stack; a larger
# `max_depth` traps.
const depth_ceiling: i64 = 1024
const read_chunk: i64 = 4096

const expect_value: i64 = 0
const expect_first_item: i64 = 1
const expect_first_key: i64 = 2
const expect_key: i64 = 3
const expect_colon: i64 = 4
const expect_after: i64 = 5
const expect_done: i64 = 6

const mode_none: i64 = 0
const mode_string: i64 = 1
const mode_escape: i64 = 2
const mode_unicode: i64 = 3
const mode_low_slash: i64 = 4
const mode_low_u: i64 = 5
const mode_utf8: i64 = 6
const mode_number: i64 = 7
const mode_literal: i64 = 8

const in_array: i64 = 0
const in_object: i64 = 1

const emit_top: i64 = 0
const emit_first_item: i64 = 1
const emit_first_key: i64 = 2
const emit_next_item: i64 = 3
const emit_next_key: i64 = 4
const emit_member_value: i64 = 5
const emit_done: i64 = 6

# 64 MiB of input and of output.
pub def limits() -> Limits:
    Limits(64, 67108864, 67108864, DuplicateKeys.Reject)

def faulted[T](result: Result[T, BytesError]) -> Result[T, JsonFault]:
    std.error.map_error(result, def once (cause: BytesError) -> JsonFault: bytes_fault(cause))

def bytes_fault(error: BytesError) -> JsonFault:
    match error:
        case BytesError.Allocation(cause):
            JsonFault.Allocation(cause)
        case BytesError.InvalidUtf8:
            JsonFault.InvalidUtf8

def reserved[T](result: Result[T, AllocError]) -> Result[T, JsonFault]:
    std.error.map_error(result, def once (cause: AllocError) -> JsonFault: JsonFault.Allocation(cause))

def unplaced[T](result: Result[T, JsonFault]) -> Result[T, JsonError]:
    std.error.map_error(result, def once (fault: JsonFault) -> JsonError: JsonError(fault, 0, 0, 0))

# The number grammar as one transition: the next state, 0 when `byte` cannot
# belong to a number, or -1 when it can but not here. States: 0 start,
# 1 after `-`, 2 after a leading `0`, 3 integer digits, 4 after `.`,
# 5 fraction digits, 6 after `e`, 7 after the exponent sign, 8 exponent digits.
def number_step(state: i64, byte: i64) -> i64:
    if byte >= 48 and byte <= 57:
        if state == 0 or state == 1:
            if byte == 48:
                return 2
            return 3
        if state == 2:
            return -1
        if state == 3:
            return 3
        if state == 4 or state == 5:
            return 5
        return 8
    if byte == 46:
        if state == 2 or state == 3:
            return 4
        return -1
    if byte == 101 or byte == 69:
        if state == 2 or state == 3 or state == 5:
            return 6
        return -1
    if byte == 45:
        if state == 0:
            return 1
        if state == 6:
            return 7
        return -1
    if byte == 43:
        if state == 6:
            return 7
        return -1
    0

def number_complete(state: i64) -> bool:
    state == 2 or state == 3 or state == 5 or state == 8

def hex_value(code: i64) -> i64:
    # Each subtraction follows its ASCII digit range check.
    unchecked:
        if code >= 48 and code <= 57:
            return code - 48
        if code >= 97 and code <= 102:
            return code - 87
        if code >= 65 and code <= 70:
            return code - 55
        -1

def hex_digit(value: i64) -> i64:
    # Only called with a nibble (0..15) from an escaped byte below 32.
    unchecked:
        if value < 10:
            return 48 + value
        87 + value

# The byte at `index` of `true`, `false`, or `null`, or -1 past its end.
def literal_byte(which: i64, index: i64) -> i64:
    if which == 0:
        if index == 0:
            return 116
        if index == 1:
            return 114
        if index == 2:
            return 117
        if index == 3:
            return 101
        return -1
    if which == 1:
        if index == 0:
            return 102
        if index == 1:
            return 97
        if index == 2:
            return 108
        if index == 3:
            return 115
        if index == 4:
            return 101
        return -1
    if index == 0:
        return 110
    if index == 1:
        return 117
    if index == 2 or index == 3:
        return 108
    -1

def push_byte(target: &mut Bytes, value: i64) -> Result[(), JsonFault]:
    reserved(target.push(u8(value)))

# `code` is a Unicode scalar value; the caller has excluded surrogates.
def push_scalar(target: &mut Bytes, code: i64) -> Result[(), JsonFault]:
    if code < 128:
        return push_byte(target, code)
    if code < 2048:
        push_byte(target, 192 | (code >> 6))?
        return push_byte(target, 128 | (code & 63))
    if code < 65536:
        push_byte(target, 224 | (code >> 12))?
        push_byte(target, 128 | ((code >> 6) & 63))?
        return push_byte(target, 128 | (code & 63))
    push_byte(target, 240 | (code >> 18))?
    push_byte(target, 128 | ((code >> 12) & 63))?
    push_byte(target, 128 | ((code >> 6) & 63))?
    push_byte(target, 128 | (code & 63))

# The bytes in [low, high) other than a quotation mark and a reverse solidus.
def byte_set(low: i64, high: i64, target: &mut Bytes) -> Result[(), JsonFault]:
    for value in range(low, high):
        if value != 34 and value != 92:
            push_byte(target, value)?
    Ok(())

# String content that is copied unchanged: ASCII from space upward, less the
# two bytes that end the run.
def plain_bytes() -> Result[Bytes, JsonFault]:
    mut set = reserved(std.bytes.with_capacity(96))?
    byte_set(32, 128, &mut set)?
    Ok(set)

# The bytes an encoded string must escape.
def escaped_bytes() -> Result[Bytes, JsonFault]:
    mut set = reserved(std.bytes.with_capacity(34))?
    byte_set(0, 32, &mut set)?
    push_byte(&mut set, 34)?
    push_byte(&mut set, 92)?
    Ok(set)

# The first index in [start, stop) that `found` located, or `stop`.
def run_end(found: Option[i64], stop: i64) -> i64:
    match found:
        case Some(index):
            index
        case Nothing:
            stop

# Locations are one-based: even an input byte budget of i64.MAX cannot
# prove that its following line/column fits. Preflight before consuming input.
def advanced_position(offset: i64, line: i64, column: i64, count: i64, scalar_start: bool, newline: bool) -> Result[(i64, i64, i64), JsonFault]:
    next_position = checked:
        next_offset = offset + count
        next_line = line + 1 if newline else line
        next_column = 1 if newline else column + count if scalar_start else column
        (next_offset, next_line, next_column)
    match next_position:
        case Ok(position):
            Ok(position)
        case Err(_):
            Err(JsonFault.InputTooLarge)

# A recognizer whose whole state lives in these fields, so input may stop and
# resume between any two bytes. It examines one byte at a time, except that a
# run of plain string content is taken in one step. `_window` holds input not
# yet examined; `_scratch` holds the decoded content of the current token;
# `_stack` holds one byte per open container.
pub class Decoder:
    _window: Bytes
    _at: i64
    _fed: i64
    _finished: bool
    _broken: bool
    _offset: i64
    _line: i64
    _column: i64
    _token_offset: i64
    _token_line: i64
    _token_column: i64
    _stack: Bytes
    _scratch: Bytes
    _plain: Bytes
    _expect: i64
    _mode: i64
    _is_key: bool
    _number: i64
    _literal: i64
    _literal_at: i64
    _hex_count: i64
    _hex_value: i64
    _high: i64
    _utf8_need: i64
    _utf8_low: i64
    _utf8_high: i64
    _max_depth: i64
    _max_input: i64

    # Bytes examined so far.
    pub def offset(self) -> i64:
        self._offset

    pub def depth(self) -> i64:
        self._stack.len()

    # A fault placed at the first byte of the most recent event's token, for
    # codecs that reject a value after reading it.
    pub def reject(self, fault: JsonFault) -> JsonError:
        JsonError(fault, self._token_offset, self._token_line, self._token_column)

    def here(self, fault: JsonFault) -> JsonError:
        JsonError(fault, self._offset, self._line, self._column)

    # Appends source[start:stop] to the unexamined input.
    pub def feed(self: &mut Decoder, source: &[u8]) -> Result[(), JsonError]:
        if self._broken or self._finished:
            return Err(self.here(JsonFault.InvalidState))
        # 0 <= _fed <= _max_input; additions below fit the remaining budget.
        room = unchecked:
            self._max_input - self._fed
        if len(source) > room:
            self._broken = True
            return Err(JsonError(JsonFault.InputTooLarge, self._max_input, 0, 0))
        if self._at == self._window.len():
            self._window.clear()
            self._at = 0
        match reserved(self._window.extend(source)):
            case Ok(_):
                unchecked:
                    self._fed += len(source)
                Ok(())
            case Err(fault):
                Err(self.here(fault))

    # Declares that no more input will arrive.
    pub def finish(self: &mut Decoder) -> ():
        self._finished = True

    # The next event. `Pending` means every fed byte has been examined and the
    # document is incomplete: feed more or finish. After an error the decoder
    # only reports `InvalidState`.
    pub def next(self: &mut Decoder) -> Result[Event, JsonError]:
        if self._broken:
            return Err(self.here(JsonFault.InvalidState))
        outcome = self.advance()
        match outcome:
            case Ok(event):
                Ok(event)
            case Err(fault):
                self._broken = True
                Err(self.here(fault))

    def bump(self: &mut Decoder, byte: i64) -> Result[(), JsonFault]:
        offset, line, column = advanced_position(self._offset, self._line, self._column, 1, byte & 192 != 128, byte == 10)?
        # advance only calls bump with _at < _window.len().
        unchecked:
            self._at += 1
        self._offset = offset
        self._line = line
        self._column = column
        Ok(())

    def mark(self: &mut Decoder) -> ():
        self._token_offset = self._offset
        self._token_line = self._line
        self._token_column = self._column

    # A fault leaves the offending byte unconsumed, so the position reported
    # by `next` is that byte's.
    def advance(self: &mut Decoder) -> Result[Event, JsonFault]:
        while True:
            if self._expect == expect_done:
                return Ok(Event.End)
            if self._at >= self._window.len():
                if not self._finished:
                    return Ok(Event.Pending)
                return self.at_end()
            byte = i64(self._window.get(self._at))
            mode = self._mode
            mut step: Option[Event] = Nothing
            if mode == mode_none:
                if byte == 32 or byte == 10 or byte == 13 or byte == 9:
                    self.bump(byte)?
                else:
                    step = self.token(byte)?
            elif mode == mode_string:
                step = self.string(byte)?
            elif mode == mode_utf8:
                self.continuation(byte)?
            elif mode == mode_number:
                step = self.number(byte)?
            elif mode == mode_literal:
                step = self.literal(byte)?
            else:
                self.escape(byte)?
            match step:
                case Some(event):
                    return Ok(event)
                case Nothing:
                    pass
        Ok(Event.End)

    def at_end(self: &mut Decoder) -> Result[Event, JsonFault]:
        if self._mode == mode_number and number_complete(self._number):
            return self.end_number()
        if self._mode == mode_none and self._expect == expect_after and self._stack.len() == 0:
            self._expect = expect_done
            return Ok(Event.End)
        Err(JsonFault.UnexpectedEnd)

    # One byte between tokens that is not whitespace.
    def token(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        expect = self._expect
        if expect == expect_after:
            return self.separator(byte)
        if expect == expect_colon:
            if byte != 58:
                return Err(JsonFault.UnexpectedByte)
            self.bump(byte)?
            self._expect = expect_value
            return Ok(Nothing)
        if expect == expect_key or expect == expect_first_key:
            if byte == 34:
                return self.open_string(byte, True)
            if byte == 125 and expect == expect_first_key:
                return self.close(byte)
            return Err(JsonFault.UnexpectedByte)
        if byte == 93 and expect == expect_first_item:
            return self.close(byte)
        if byte == 34:
            return self.open_string(byte, False)
        if byte == 123:
            return self.open(byte, in_object)
        if byte == 91:
            return self.open(byte, in_array)
        if byte == 45 or (byte >= 48 and byte <= 57):
            self.mark()
            self._number = number_step(0, byte)
            push_byte(&mut self._scratch, byte)?
            self.bump(byte)?
            self._mode = mode_number
            return Ok(Nothing)
        mut which = -1
        if byte == 116:
            which = 0
        elif byte == 102:
            which = 1
        elif byte == 110:
            which = 2
        if which < 0:
            return Err(JsonFault.UnexpectedByte)
        self.mark()
        self.bump(byte)?
        self._literal = which
        self._literal_at = 1
        self._mode = mode_literal
        Ok(Nothing)

    # After a complete value: a comma or the closing bracket of its container.
    def separator(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        count = self._stack.len()
        if count == 0:
            return Err(JsonFault.TrailingData)
        # count > 0, bounded by the allocated stack.
        top = unchecked:
            i64(self._stack.get(count - 1))
        if byte == 44:
            self.bump(byte)?
            if top == in_object:
                self._expect = expect_key
            else:
                self._expect = expect_value
            return Ok(Nothing)
        if (byte == 93 and top == in_array) or (byte == 125 and top == in_object):
            return self.close(byte)
        Err(JsonFault.UnexpectedByte)

    def open(self: &mut Decoder, byte: i64, kind: i64) -> Result[Option[Event], JsonFault]:
        if self._stack.len() >= self._max_depth:
            return Err(JsonFault.DepthExceeded)
        push_byte(&mut self._stack, kind)?
        self.mark()
        self.bump(byte)?
        if kind == in_object:
            self._expect = expect_first_key
            return Ok(Some(Event.StartObject))
        self._expect = expect_first_item
        Ok(Some(Event.StartArray))

    def close(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        drop(self._stack.pop())
        self.mark()
        self.bump(byte)?
        self._expect = expect_after
        if byte == 93:
            return Ok(Some(Event.EndArray))
        Ok(Some(Event.EndObject))

    def open_string(self: &mut Decoder, byte: i64, is_key: bool) -> Result[Option[Event], JsonFault]:
        self.mark()
        self.bump(byte)?
        self._is_key = is_key
        self._mode = mode_string
        Ok(Nothing)

    # One byte of string content. UTF-8 is validated here, byte by byte, so a
    # malformed sequence is reported at its own offset.
    def string(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        if byte == 34:
            text = faulted(self._scratch.to_text())?
            self._scratch.clear()
            self.bump(byte)?
            self._mode = mode_none
            if self._is_key:
                self._expect = expect_colon
                return Ok(Some(Event.Key(text)))
            self._expect = expect_after
            return Ok(Some(Event.Text(text)))
        if byte == 92:
            self.bump(byte)?
            self._mode = mode_escape
            return Ok(Nothing)
        if byte < 32:
            return Err(JsonFault.ControlCharacter)
        if byte >= 128:
            # The first continuation byte has a narrower range for the lead
            # bytes that could otherwise encode an overlong form, a surrogate,
            # or a value above U+10FFFF.
            mut need = 1
            mut low = 128
            mut high = 191
            if byte >= 194 and byte <= 223:
                pass
            elif byte >= 224 and byte <= 239:
                need = 2
                if byte == 224:
                    low = 160
                elif byte == 237:
                    high = 159
            elif byte >= 240 and byte <= 244:
                need = 3
                if byte == 240:
                    low = 144
                elif byte == 244:
                    high = 143
            else:
                return Err(JsonFault.InvalidUtf8)
            self._utf8_need = need
            self._utf8_low = low
            self._utf8_high = high
            self._mode = mode_utf8
            push_byte(&mut self._scratch, byte)?
            self.bump(byte)?
            return Ok(Nothing)
        # Plain content: one scan and one copy for the whole run. Each byte is
        # one column, and none is a line feed.
        available = self._window.len()
        stop = run_end(self._window.find_not_in(&self._plain, self._at, available), available)
        # find_not_in returns a position in [_at, available].
        count = unchecked:
            stop - self._at
        offset, line, column = advanced_position(self._offset, self._line, self._column, count, True, False)?
        reserved(self._scratch.extend(&self._window[self._at:stop]))?
        self._at = stop
        self._offset = offset
        self._line = line
        self._column = column
        Ok(Nothing)

    def continuation(self: &mut Decoder, byte: i64) -> Result[(), JsonFault]:
        if byte < self._utf8_low or byte > self._utf8_high:
            return Err(JsonFault.InvalidUtf8)
        push_byte(&mut self._scratch, byte)?
        self.bump(byte)?
        # A validated lead byte sets need to 1..3, then this mode counts down.
        unchecked:
            self._utf8_need -= 1
        self._utf8_low = 128
        self._utf8_high = 191
        if self._utf8_need == 0:
            self._mode = mode_string
        Ok(())

    # Everything between a backslash and the end of its escape. A high
    # surrogate must be followed at once by an escaped low surrogate.
    def escape(self: &mut Decoder, byte: i64) -> Result[(), JsonFault]:
        mode = self._mode
        if mode == mode_low_slash:
            if byte != 92:
                return Err(JsonFault.InvalidSurrogate)
            self.bump(byte)?
            self._mode = mode_low_u
            return Ok(())
        if mode == mode_low_u:
            if byte != 117:
                return Err(JsonFault.InvalidSurrogate)
            self.bump(byte)?
            self._hex_count = 0
            self._hex_value = 0
            self._mode = mode_unicode
            return Ok(())
        if mode == mode_unicode:
            return self.unicode(byte)
        mut plain = -1
        if byte == 34 or byte == 92 or byte == 47:
            plain = byte
        elif byte == 98:
            plain = 8
        elif byte == 102:
            plain = 12
        elif byte == 110:
            plain = 10
        elif byte == 114:
            plain = 13
        elif byte == 116:
            plain = 9
        elif byte == 117:
            self.bump(byte)?
            self._hex_count = 0
            self._hex_value = 0
            self._mode = mode_unicode
            return Ok(())
        if plain < 0:
            return Err(JsonFault.InvalidEscape)
        push_byte(&mut self._scratch, plain)?
        self.bump(byte)?
        self._mode = mode_string
        Ok(())

    def unicode(self: &mut Decoder, byte: i64) -> Result[(), JsonFault]:
        digit = hex_value(byte)
        if digit < 0:
            return Err(JsonFault.InvalidEscape)
        # At most four hex digits: partial <= 4095 and digit is 0..15.
        code = unchecked:
            self._hex_value * 16 + digit
        if self._hex_count < 3:
            self.bump(byte)?
            self._hex_value = code
            # This branch only increments counts 0..2.
            unchecked:
                self._hex_count += 1
            return Ok(())
        if self._high != 0:
            if code < 56320 or code > 57343:
                return Err(JsonFault.InvalidSurrogate)
            # Validated high/low surrogates produce a scalar <= U+10FFFF.
            scalar = unchecked:
                65536 + ((self._high - 55296) << 10) + (code - 56320)
            push_scalar(&mut self._scratch, scalar)?
            self._high = 0
            self._mode = mode_string
        elif code >= 55296 and code <= 56319:
            self._high = code
            self._mode = mode_low_slash
        elif code >= 56320 and code <= 57343:
            return Err(JsonFault.InvalidSurrogate)
        else:
            push_scalar(&mut self._scratch, code)?
            self._mode = mode_string
        self.bump(byte)?
        Ok(())

    def number(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        state = number_step(self._number, byte)
        if state < 0:
            return Err(JsonFault.InvalidNumber)
        if state == 0:
            return Ok(Some(self.end_number()?))
        push_byte(&mut self._scratch, byte)?
        self.bump(byte)?
        self._number = state
        Ok(Nothing)

    # The byte that ends a number is left for the next step.
    def end_number(self: &mut Decoder) -> Result[Event, JsonFault]:
        if not number_complete(self._number):
            return Err(JsonFault.InvalidNumber)
        text = faulted(self._scratch.to_text())?
        self._scratch.clear()
        self._mode = mode_none
        self._expect = expect_after
        Ok(Event.Number(text))

    def literal(self: &mut Decoder, byte: i64) -> Result[Option[Event], JsonFault]:
        if byte != literal_byte(self._literal, self._literal_at):
            return Err(JsonFault.InvalidLiteral)
        self.bump(byte)?
        # The longest literal is false (5 bytes); a mismatch exits above.
        unchecked:
            self._literal_at += 1
        if literal_byte(self._literal, self._literal_at) >= 0:
            return Ok(Nothing)
        self._mode = mode_none
        self._expect = expect_after
        if self._literal == 0:
            return Ok(Some(Event.Bool(True)))
        if self._literal == 1:
            return Ok(Some(Event.Bool(False)))
        Ok(Some(Event.Null))

pub def decoder(bounds: &Limits) -> Result[Decoder, JsonError]:
    if bounds.max_depth.get() > depth_ceiling:
        __trap("std.json.decoder: max_depth is above 1024")
    window = unplaced(reserved(std.bytes.empty()))?
    stack = unplaced(reserved(std.bytes.empty()))?
    scratch = unplaced(reserved(std.bytes.empty()))?
    plain = unplaced(plain_bytes())?
    Ok(Decoder(window, 0, 0, False, False, 0, 1, 1, 0, 1, 1, stack, scratch, plain, expect_value, mode_none, False, 0, 0, 0, 0, 0, 0, 0, 0, 0, bounds.max_depth.get(), bounds.max_input.get()))

def is_pending(event: &Event) -> bool:
    match event:
        case Event.Pending:
            True
        case _:
            False

def is_end(event: &Event) -> bool:
    match event:
        case Event.End:
            True
        case _:
            False

# One read into the emptied window. End of input finishes the decoder.
def refill[R: Reader](source: &mut Decoder, reader: &mut R) -> Result[(), JsonFault]:
    # 0 <= _fed <= _max_input. The extra byte is added only below 4096.
    mut room = unchecked:
        source._max_input - source._fed
    # One byte past the limit is enough to tell a full document from an
    # oversized one.
    if room < read_chunk:
        unchecked:
            room += 1
    else:
        room = read_chunk
    reserved(source._window.resize(room, 0u8))?
    source._at = 0
    while True:
        outcome = reader.read(&mut source._window, 0, room)
        match outcome:
            case Ok(count):
                if count < 0 or count > room:
                    source._window.clear()
                    return Err(JsonFault.Stream(StreamError.InvalidProgress))
                source._window.truncate(count)
                if count == 0:
                    source._finished = True
                # Remaining input budget is nonnegative and representable.
                remaining = unchecked:
                    source._max_input - source._fed
                if count > remaining:
                    source._window.clear()
                    return Err(JsonFault.InputTooLarge)
                # Validated count is nonnegative and no larger than remaining.
                unchecked:
                    source._fed += count
                return Ok(())
            case Err(cause):
                match cause:
                    case StreamError.Interrupted:
                        pass
                    case _:
                        source._window.clear()
                        return Err(JsonFault.Stream(cause))
    Ok(())

# The next event, reading from `reader` whenever the decoder runs dry. Never
# returns `Pending`. Memory stays bounded by the read window, the current
# token, and the depth limit, whatever the document size.
pub def read_event[R: Reader](source: &mut Decoder, reader: &mut R) -> Result[Event, JsonError]:
    while True:
        event = source.next()?
        if not is_pending(&event):
            return Ok(event)
        outcome = refill(source, reader)
        match outcome:
            case Ok(_):
                pass
            case Err(fault):
                source._broken = True
                match fault:
                    case JsonFault.InputTooLarge:
                        return Err(JsonError(fault, source._max_input, 0, 0))
                    case _:
                        return Err(source.here(fault))
    Ok(Event.End)

enum Frame:
    Items(list[Json])
    Members(list[Member], set[str])

# Assembles events into a tree without recursion: open containers wait in
# `frames`, and each object's pending key waits in `keys`.
class Builder:
    frames: list[Frame]
    keys: list[str]
    root: list[Json]
    reject: bool

    def accept(self: &mut Builder, event: Event) -> Result[(), JsonFault]:
        match event:
            case Event.Null:
                self.attach(Json.Null)
            case Event.Bool(value):
                self.attach(Json.Bool(value))
            case Event.Number(text):
                self.attach(number_value(&text)?)
            case Event.Text(text):
                self.attach(Json.Text(text))
            case Event.Key(name):
                self.key(name)
            case Event.StartArray:
                items = reserved(list[Json]())?
                reserved(self.frames.append(Frame.Items(items)))
            case Event.StartObject:
                members = reserved(list[Member]())?
                seen = reserved(set[str]())?
                reserved(self.frames.append(Frame.Members(members, seen)))
            case Event.EndArray:
                self.finish()
            case Event.EndObject:
                self.finish()
            case Event.Pending:
                Ok(())
            case Event.End:
                Ok(())

    def key(self: &mut Builder, name: str) -> Result[(), JsonFault]:
        if self.reject:
            match self.frames.pop():
                case Some(frame):
                    match frame:
                        case Frame.Members(members, had):
                            mut seen = had
                            if name in seen:
                                return Err(JsonFault.DuplicateKey)
                            reserved(seen.add(name))?
                            reserved(self.frames.append(Frame.Members(members, seen)))?
                        case Frame.Items(items):
                            reserved(self.frames.append(Frame.Items(items)))?
                case Nothing:
                    pass
        reserved(self.keys.append(name))

    def finish(self: &mut Builder) -> Result[(), JsonFault]:
        match self.frames.pop():
            case Some(frame):
                match frame:
                    case Frame.Items(items):
                        self.attach(Json.Array(items))
                    case Frame.Members(members, _):
                        self.attach(Json.Object(members))
            case Nothing:
                Err(JsonFault.InvalidState)

    def attach(self: &mut Builder, value: Json) -> Result[(), JsonFault]:
        match self.frames.pop():
            case Some(frame):
                match frame:
                    case Frame.Items(had):
                        mut items = had
                        reserved(items.append(value))?
                        reserved(self.frames.append(Frame.Items(items)))
                    case Frame.Members(had, seen):
                        mut members = had
                        match self.keys.pop():
                            case Some(name):
                                reserved(members.append(Member(name, value)))?
                            case Nothing:
                                return Err(JsonFault.InvalidState)
                        reserved(self.frames.append(Frame.Members(members, seen)))
            case Nothing:
                reserved(self.root.append(value))

# Integer syntax must fit `i64` exactly; a fraction or exponent selects `f64`,
# which must be finite. Nothing is rounded to fit an integer.
def number_value(text: &str) -> Result[Json, JsonFault]:
    if "." in text or "e" in text or "E" in text:
        match f64.parse(text):
            case Ok(value):
                Ok(Json.Float(value))
            case Err(_):
                Err(JsonFault.NumberOutOfRange)
    else:
        match i64.parse(text):
            case Ok(value):
                Ok(Json.Int(value))
            case Err(_):
                Err(JsonFault.NumberOutOfRange)

def builder(bounds: &Limits) -> Result[Builder, JsonFault]:
    frames = reserved(list[Frame]())?
    keys = reserved(list[str]())?
    root = reserved(list[Json]())?
    mut reject = False
    match bounds.duplicate_keys:
        case DuplicateKeys.Reject:
            reject = True
        case DuplicateKeys.Keep:
            pass
    Ok(Builder(frames, keys, root, reject))

def rooted(tree: Builder) -> Result[Json, JsonFault]:
    mut done = tree
    match done.root.pop():
        case Some(value):
            Ok(value)
        case Nothing:
            Err(JsonFault.InvalidState)

# Decodes one document that occupies the whole of `source`.
pub def parse(source: &[u8], bounds: &Limits) -> Result[Json, JsonError]:
    mut events = decoder(bounds)?
    events.feed(source)?
    events.finish()
    mut tree = unplaced(builder(bounds))?
    while True:
        event = events.next()?
        if is_end(&event):
            break
        outcome = tree.accept(event)
        match outcome:
            case Ok(_):
                pass
            case Err(fault):
                return Err(events.reject(fault))
    outcome = rooted(tree)
    match outcome:
        case Ok(value):
            Ok(value)
        case Err(fault):
            Err(events.reject(fault))

pub def parse_text(text: &str, bounds: &Limits) -> Result[Json, JsonError]:
    source = unplaced(reserved(std.bytes.from_text(text)))?
    parse(&source, bounds)

# Decodes one document from `reader`, reading to end of input.
pub def read_value[R: Reader](reader: &mut R, bounds: &Limits) -> Result[Json, JsonError]:
    mut events = decoder(bounds)?
    mut tree = unplaced(builder(bounds))?
    while True:
        event = read_event(&mut events, reader)?
        if is_end(&event):
            break
        outcome = tree.accept(event)
        match outcome:
            case Ok(_):
                pass
            case Err(fault):
                return Err(events.reject(fault))
    outcome = rooted(tree)
    match outcome:
        case Ok(value):
            Ok(value)
        case Err(fault):
            Err(events.reject(fault))

# The index of the first member named `key`.
pub def find(members: &list[Member], key: &str) -> Option[i64]:
    for index in range(len(members)):
        if members[index].key == key:
            return Some(index)
    Nothing

# Writes compact JSON into an owned buffer and checks that calls arrive in an
# order that forms one document. `_written` counts every byte produced, so
# the output limit also covers bytes already taken or written out.
pub class Encoder:
    _out: Bytes
    _stack: Bytes
    _escaped: Bytes
    _state: i64
    _written: i64
    _broken: bool
    _max_depth: i64
    _max_output: i64

    pub def reject(self, fault: std.serial.Fault) -> JsonError:
        JsonError(JsonFault.Serialization(fault), self._written, 0, 0)

    pub def allocation(self, cause: AllocError) -> JsonError:
        JsonError(JsonFault.Allocation(cause), self._written, 0, 0)

    # Bytes produced and not yet taken.
    pub def pending(self) -> i64:
        self._out.len()

    # Bytes produced since the encoder was created.
    pub def written(self) -> i64:
        self._written

    pub def is_complete(self) -> bool:
        self._state == emit_done and not self._broken

    def settle(self: &mut Encoder, result: Result[(), JsonFault]) -> Result[(), JsonError]:
        match result:
            case Ok(_):
                Ok(())
            case Err(fault):
                self._broken = True
                Err(JsonError(fault, self._written, 0, 0))

    def put(self: &mut Encoder, byte: i64) -> Result[(), JsonFault]:
        if self._written >= self._max_output:
            return Err(JsonFault.OutputTooLarge)
        push_byte(&mut self._out, byte)?
        # _written < _max_output <= i64.MAX.
        unchecked:
            self._written += 1
        Ok(())

    def extend(self: &mut Encoder, source: &[u8]) -> Result[(), JsonFault]:
        # 0 <= _written <= _max_output, including output already taken.
        remaining = unchecked:
            self._max_output - self._written
        if len(source) > remaining:
            return Err(JsonFault.OutputTooLarge)
        reserved(self._out.extend(source))?
        # The successful preflight bounds the sum by _max_output.
        unchecked:
            self._written += len(source)
        Ok(())

    def raw(self: &mut Encoder, text: &str) -> Result[(), JsonFault]:
        source = reserved(std.bytes.from_text(text))?
        self.extend(&source)

    def top(self) -> Result[i64, JsonFault]:
        count = self._stack.len()
        if count == 0:
            return Err(JsonFault.InvalidState)
        # count > 0, bounded by the allocated stack.
        unchecked:
            Ok(i64(self._stack.get(count - 1)))

    def before_value(self: &mut Encoder) -> Result[(), JsonFault]:
        if self._broken:
            return Err(JsonFault.InvalidState)
        state = self._state
        if state == emit_next_item:
            return self.put(44)
        if state == emit_top or state == emit_first_item or state == emit_member_value:
            return Ok(())
        Err(JsonFault.InvalidState)

    def after_value(self: &mut Encoder) -> Result[(), JsonFault]:
        if self._stack.len() == 0:
            self._state = emit_done
        elif self.top()? == in_object:
            self._state = emit_next_key
        else:
            self._state = emit_next_item
        Ok(())

    def quote(self: &mut Encoder, text: &str) -> Result[(), JsonFault]:
        source = reserved(std.bytes.from_text(text))?
        count = source.len()
        self.put(34)?
        mut run = 0
        mut index = run_end(source.find_in(&self._escaped, 0, count), count)
        while index < count:
            byte = i64(source.get(index))
            self.extend(&source[run:index])?
            self.put(92)?
            if byte == 34 or byte == 92:
                self.put(byte)?
            elif byte == 8:
                self.put(98)?
            elif byte == 12:
                self.put(102)?
            elif byte == 10:
                self.put(110)?
            elif byte == 13:
                self.put(114)?
            elif byte == 9:
                self.put(116)?
            else:
                self.put(117)?
                self.put(48)?
                self.put(48)?
                self.put(hex_digit(byte >> 4))?
                self.put(hex_digit(byte & 15))?
            # index < count <= i64.MAX.
            unchecked:
                run = index + 1
            index = run_end(source.find_in(&self._escaped, run, count), count)
        self.extend(&source[run:count])?
        self.put(34)

    def scalar(self: &mut Encoder, text: &str) -> Result[(), JsonFault]:
        self.before_value()?
        self.raw(text)?
        self.after_value()

    def emit_integer(self: &mut Encoder, value: i64) -> Result[(), JsonFault]:
        text = reserved(str.from(value))?
        self.scalar(&text)

    def emit_unsigned(self: &mut Encoder, value: u64) -> Result[(), JsonFault]:
        text = reserved(str.from(value))?
        self.scalar(&text)

    def emit_decimal(self: &mut Encoder, value: f64) -> Result[(), JsonFault]:
        if value != value or value == f64.INF or value == -f64.INF:
            return Err(JsonFault.NonFiniteNumber)
        text = reserved(str.from(value))?
        self.scalar(&text)

    def emit_number(self: &mut Encoder, text: &str) -> Result[(), JsonFault]:
        source = reserved(std.bytes.from_text(text))?
        mut state = 0
        for index in range(source.len()):
            state = number_step(state, i64(source.get(index)))
            if state <= 0:
                return Err(JsonFault.InvalidNumber)
        if not number_complete(state):
            return Err(JsonFault.InvalidNumber)
        self.before_value()?
        self.extend(&source)?
        self.after_value()

    def emit_text(self: &mut Encoder, text: &str) -> Result[(), JsonFault]:
        self.before_value()?
        self.quote(text)?
        self.after_value()

    def emit_key(self: &mut Encoder, name: &str) -> Result[(), JsonFault]:
        if self._broken:
            return Err(JsonFault.InvalidState)
        if self._state == emit_next_key:
            self.put(44)?
        elif self._state != emit_first_key:
            return Err(JsonFault.InvalidState)
        self.quote(name)?
        self.put(58)?
        self._state = emit_member_value
        Ok(())

    def emit_open(self: &mut Encoder, kind: i64) -> Result[(), JsonFault]:
        self.before_value()?
        if self._stack.len() >= self._max_depth:
            return Err(JsonFault.DepthExceeded)
        push_byte(&mut self._stack, kind)?
        if kind == in_object:
            self._state = emit_first_key
            return self.put(123)
        self._state = emit_first_item
        self.put(91)

    def emit_close(self: &mut Encoder, kind: i64) -> Result[(), JsonFault]:
        if self._broken:
            return Err(JsonFault.InvalidState)
        state = self._state
        if kind == in_object:
            if state != emit_first_key and state != emit_next_key:
                return Err(JsonFault.InvalidState)
            self.put(125)?
        else:
            if state != emit_first_item and state != emit_next_item:
                return Err(JsonFault.InvalidState)
            self.put(93)?
        drop(self._stack.pop())
        self.after_value()

    def emit_event(self: &mut Encoder, event: &Event) -> Result[(), JsonFault]:
        match event:
            case Event.Null:
                self.scalar("null")
            case Event.Bool(value):
                if *value:
                    self.scalar("true")
                else:
                    self.scalar("false")
            case Event.Number(text):
                self.emit_number(text)
            case Event.Text(text):
                self.emit_text(text)
            case Event.Key(name):
                self.emit_key(name)
            case Event.StartArray:
                self.emit_open(in_array)
            case Event.EndArray:
                self.emit_close(in_array)
            case Event.StartObject:
                self.emit_open(in_object)
            case Event.EndObject:
                self.emit_close(in_object)
            case Event.Pending:
                Ok(())
            case Event.End:
                Ok(())

    # Recursion depth equals container depth, which `emit_open` bounds.
    def emit_value(self: &mut Encoder, value: &Json) -> Result[(), JsonFault]:
        match value:
            case Json.Null:
                self.scalar("null")
            case Json.Bool(flag):
                if *flag:
                    self.scalar("true")
                else:
                    self.scalar("false")
            case Json.Int(number):
                self.emit_integer(*number)
            case Json.Float(number):
                self.emit_decimal(*number)
            case Json.Text(text):
                self.emit_text(text)
            case Json.Array(items):
                self.emit_open(in_array)?
                for item in items:
                    self.emit_value(item)?
                self.emit_close(in_array)
            case Json.Object(members):
                self.emit_open(in_object)?
                for member in members:
                    self.emit_key(&member.key)?
                    self.emit_value(&member.value)?
                self.emit_close(in_object)

    pub def null(self: &mut Encoder) -> Result[(), JsonError]:
        result = self.scalar("null")
        self.settle(result)

    pub def boolean(self: &mut Encoder, value: bool) -> Result[(), JsonError]:
        mut text = "false"
        if value:
            text = "true"
        result = self.scalar(&text)
        self.settle(result)

    pub def integer(self: &mut Encoder, value: i64) -> Result[(), JsonError]:
        result = self.emit_integer(value)
        self.settle(result)

    pub def unsigned(self: &mut Encoder, value: u64) -> Result[(), JsonError]:
        result = self.emit_unsigned(value)
        self.settle(result)

    # Shortest text that reads back as the same `f64`. NaN and the infinities
    # have no JSON form and are `NonFiniteNumber`.
    pub def decimal(self: &mut Encoder, value: f64) -> Result[(), JsonError]:
        result = self.emit_decimal(value)
        self.settle(result)

    # A number already in JSON syntax, copied unchanged.
    pub def number(self: &mut Encoder, text: &str) -> Result[(), JsonError]:
        result = self.emit_number(text)
        self.settle(result)

    pub def text(self: &mut Encoder, value: &str) -> Result[(), JsonError]:
        result = self.emit_text(value)
        self.settle(result)

    pub def field(self: &mut Encoder, name: &str) -> Result[(), JsonError]:
        self.key(name)

    pub def key(self: &mut Encoder, name: &str) -> Result[(), JsonError]:
        result = self.emit_key(name)
        self.settle(result)

    pub def start_array(self: &mut Encoder) -> Result[(), JsonError]:
        result = self.emit_open(in_array)
        self.settle(result)

    pub def end_array(self: &mut Encoder) -> Result[(), JsonError]:
        result = self.emit_close(in_array)
        self.settle(result)

    pub def start_object(self: &mut Encoder) -> Result[(), JsonError]:
        result = self.emit_open(in_object)
        self.settle(result)

    pub def end_object(self: &mut Encoder) -> Result[(), JsonError]:
        result = self.emit_close(in_object)
        self.settle(result)

    # Writes what a decoder reported. `Pending` and `End` write nothing.
    pub def event(self: &mut Encoder, event: &Event) -> Result[(), JsonError]:
        result = self.emit_event(event)
        self.settle(result)

    pub def value(self: &mut Encoder, value: &Json) -> Result[(), JsonError]:
        result = self.emit_value(value)
        self.settle(result)

    # Removes and returns the bytes produced so far.
    pub def take(self: &mut Encoder) -> Result[Bytes, JsonError]:
        match reserved(std.bytes.empty()):
            case Ok(fresh):
                Ok(replace(self._out, fresh))
            case Err(fault):
                Err(JsonError(fault, self._written, 0, 0))

pub def encoder(bounds: &Limits) -> Result[Encoder, JsonError]:
    if bounds.max_depth.get() > depth_ceiling:
        __trap("std.json.encoder: max_depth is above 1024")
    out = unplaced(reserved(std.bytes.empty()))?
    stack = unplaced(reserved(std.bytes.empty()))?
    escaped = unplaced(escaped_bytes())?
    Ok(Encoder(out, stack, escaped, emit_top, 0, False, bounds.max_depth.get(), bounds.max_output.get()))

# Delivers every pending byte to `writer` and keeps the buffer's capacity.
# Does not flush. On failure only the bytes the writer did not accept stay
# pending, so a retry cannot repeat output.
pub def write_pending[W: Writer](source: &mut Encoder, writer: &mut W) -> Result[(), JsonError]:
    outcome = std.io.write_all(writer, &source._out)
    match outcome:
        case Ok(_):
            source._out.clear()
            Ok(())
        case Err(partial):
            # write_all validates 0 <= completed <= output length; for every
            # index < kept, completed + index < output length. Shift in place:
            # a failure path must not need memory.
            kept = unchecked:
                source._out.len() - partial.completed
            for index in range(kept):
                unchecked:
                    source._out.set(index, source._out.get(partial.completed + index))
            source._out.truncate(kept)
            Err(JsonError(JsonFault.Stream(partial.cause), source._written, 0, 0))

def complete(source: &Encoder) -> Result[(), JsonError]:
    if source.is_complete():
        return Ok(())
    Err(JsonError(JsonFault.InvalidState, source._written, 0, 0))

pub def encode(value: &Json, bounds: &Limits) -> Result[Bytes, JsonError]:
    mut target = encoder(bounds)?
    target.value(value)?
    complete(&target)?
    target.take()

pub def encode_text(value: &Json, bounds: &Limits) -> Result[str, JsonError]:
    encoded = encode(value, bounds)?
    match faulted(encoded.to_text()):
        case Ok(text):
            Ok(text)
        case Err(fault):
            Err(JsonError(fault, encoded.len(), 0, 0))

# Encodes the whole value, then writes it. Does not flush.
pub def write_value[W: Writer](writer: &mut W, value: &Json, bounds: &Limits) -> Result[(), JsonError]:
    mut target = encoder(bounds)?
    target.value(value)?
    complete(&target)?
    write_pending(&mut target, writer)

# Typed codecs keep the parser's number text until a requested width is known.
# One lookahead event is enough for nullable values and container iteration.
pub class CodecOptions:
    pub limits: Limits
    pub unknown_fields: std.serial.UnknownFields

pub def codec_options() -> CodecOptions:
    CodecOptions(limits(), std.serial.UnknownFields.Reject)

pub class CodecDecoder:
    _source: Decoder
    _ahead: Option[Event]
    _unknown: std.serial.UnknownFields

    pub def reject(self, fault: std.serial.Fault) -> JsonError:
        self._source.reject(JsonFault.Serialization(fault))

    pub def allocation(self, cause: AllocError) -> JsonError:
        self._source.reject(JsonFault.Allocation(cause))

    def take(self: &mut CodecDecoder) -> Result[Event, JsonError]:
        match replace(self._ahead, Nothing):
            case Some(event):
                Ok(event)
            case Nothing:
                self._source.next()

    pub def null(self: &mut CodecDecoder) -> Result[bool, JsonError]:
        event = self.take()?
        match event:
            case Event.Null:
                Ok(True)
            case _:
                self._ahead = Some(event)
                Ok(False)

    pub def boolean(self: &mut CodecDecoder) -> Result[bool, JsonError]:
        match self.take()?:
            case Event.Bool(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def integer(self: &mut CodecDecoder) -> Result[i64, JsonError]:
        match self.take()?:
            case Event.Number(text):
                match i64.parse(&text):
                    case Ok(value):
                        Ok(value)
                    case Err(_):
                        Err(self.reject(std.serial.Fault.OutOfRange))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def unsigned(self: &mut CodecDecoder) -> Result[u64, JsonError]:
        match self.take()?:
            case Event.Number(text):
                match u64.parse(&text):
                    case Ok(value):
                        Ok(value)
                    case Err(_):
                        Err(self.reject(std.serial.Fault.OutOfRange))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def decimal(self: &mut CodecDecoder) -> Result[f64, JsonError]:
        match self.take()?:
            case Event.Number(text):
                match f64.parse(&text):
                    case Ok(value):
                        if value != value or value == f64.INF or value == -f64.INF:
                            return Err(self.reject(std.serial.Fault.OutOfRange))
                        Ok(value)
                    case Err(_):
                        Err(self.reject(std.serial.Fault.OutOfRange))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def variant(self: &mut CodecDecoder) -> Result[(str, bool), JsonError]:
        match self.take()?:
            case Event.Text(tag):
                Ok((tag, False))
            case Event.StartObject:
                match self.next_key()?:
                    case Some(tag):
                        Ok((tag, True))
                    case Nothing:
                        Err(self.reject(std.serial.Fault.UnexpectedKind))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def text(self: &mut CodecDecoder) -> Result[str, JsonError]:
        match self.take()?:
            case Event.Text(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def start_array(self: &mut CodecDecoder) -> Result[(), JsonError]:
        match self.take()?:
            case Event.StartArray:
                Ok(())
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_element(self: &mut CodecDecoder) -> Result[bool, JsonError]:
        event = self.take()?
        match event:
            case Event.EndArray:
                Ok(False)
            case _:
                self._ahead = Some(event)
                Ok(True)

    pub def start_object(self: &mut CodecDecoder) -> Result[(), JsonError]:
        match self.take()?:
            case Event.StartObject:
                Ok(())
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_key(self: &mut CodecDecoder) -> Result[Option[str], JsonError]:
        match self.take()?:
            case Event.Key(name):
                Ok(Some(name))
            case Event.EndObject:
                Ok(Nothing)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def unknown_key(self: &mut CodecDecoder, name: &str) -> Result[(), JsonError]:
        if self._unknown == std.serial.UnknownFields.Reject:
            return Err(self.reject(std.serial.Fault.UnknownField(*name)))
        mut depth = 0
        while True:
            match self.take()?:
                case Event.StartArray | Event.StartObject:
                    unchecked:
                        depth += 1
                case Event.EndArray | Event.EndObject:
                    if depth == 0:
                        return Err(self.reject(std.serial.Fault.UnexpectedKind))
                    unchecked:
                        depth -= 1
                case Event.End | Event.Pending:
                    return Err(self.reject(std.serial.Fault.UnexpectedKind))
                case _:
                    pass
            if depth == 0:
                break
        Ok(())

    pub def finish(self: &mut CodecDecoder) -> Result[(), JsonError]:
        match self.take()?:
            case Event.End:
                Ok(())
            case _:
                Err(self._source.reject(JsonFault.TrailingData))

pub def codec_decoder(source: &[u8], options: &CodecOptions) -> Result[CodecDecoder, JsonError]:
    mut events = decoder(&options.limits)?
    events.feed(source)?
    events.finish()
    Ok(CodecDecoder(events, Nothing, options.unknown_fields))

# Owns its stream because borrowed references cannot be stored in adapters.
# Initialization allocates in load_from while the adapter is borrowed.
pub class CodecReader[R]:
    pub inner: R
    _codec: Option[CodecDecoder]

    pub def reject(self, fault: std.serial.Fault) -> JsonError:
        match &self._codec:
            case Some(codec):
                codec.reject(fault)
            case Nothing:
                JsonError(JsonFault.Serialization(fault), 0, 0, 0)

    pub def allocation(self, cause: AllocError) -> JsonError:
        match &self._codec:
            case Some(codec):
                codec.allocation(cause)
            case Nothing:
                JsonError(JsonFault.Allocation(cause), 0, 0, 0)

    # Install one event before delegating to the buffer codec. A delegated
    # operation consumes at most one event; null/next_element may put it back.
    def prepare(self: &mut CodecReader[R]) -> Result[(), JsonError]:
        match &mut self._codec:
            case Some(codec):
                if codec._ahead.is_none():
                    event = read_event(&mut codec._source, &mut self.inner)?
                    codec._ahead = Some(event)
                Ok(())
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    def take(self: &mut CodecReader[R]) -> Result[Event, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.take()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def null(self: &mut CodecReader[R]) -> Result[bool, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.null()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def boolean(self: &mut CodecReader[R]) -> Result[bool, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.boolean()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def integer(self: &mut CodecReader[R]) -> Result[i64, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.integer()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def unsigned(self: &mut CodecReader[R]) -> Result[u64, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.unsigned()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def decimal(self: &mut CodecReader[R]) -> Result[f64, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.decimal()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def variant(self: &mut CodecReader[R]) -> Result[(str, bool), JsonError]:
        match self.take()?:
            case Event.Text(tag):
                Ok((tag, False))
            case Event.StartObject:
                match self.next_key()?:
                    case Some(tag):
                        Ok((tag, True))
                    case Nothing:
                        Err(self.reject(std.serial.Fault.UnexpectedKind))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def text(self: &mut CodecReader[R]) -> Result[str, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.text()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def start_array(self: &mut CodecReader[R]) -> Result[(), JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.start_array()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def next_element(self: &mut CodecReader[R]) -> Result[bool, JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.next_element()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def start_object(self: &mut CodecReader[R]) -> Result[(), JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.start_object()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def next_key(self: &mut CodecReader[R]) -> Result[Option[str], JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.next_key()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def finish(self: &mut CodecReader[R]) -> Result[(), JsonError]:
        self.prepare()?
        match &mut self._codec:
            case Some(codec):
                codec.finish()
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def unknown_key(self: &mut CodecReader[R], name: &str) -> Result[(), JsonError]:
        mut reject_unknown = True
        match &self._codec:
            case Some(codec):
                reject_unknown = codec._unknown == std.serial.UnknownFields.Reject
            case Nothing:
                return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        if reject_unknown:
            return Err(self.reject(std.serial.Fault.UnknownField(*name)))
        mut depth = 0
        while True:
            match self.take()?:
                case Event.StartArray | Event.StartObject:
                    unchecked:
                        depth += 1
                case Event.EndArray | Event.EndObject:
                    if depth == 0:
                        return Err(self.reject(std.serial.Fault.UnexpectedKind))
                    unchecked:
                        depth -= 1
                case Event.End | Event.Pending:
                    return Err(self.reject(std.serial.Fault.UnexpectedKind))
                case _:
                    pass
            if depth == 0:
                break
        Ok(())

pub def codec_reader[R: Reader](inner: R) -> CodecReader[R]:
    CodecReader(inner, Nothing)

# Decodes exactly one complete document, including the EOF check. The adapter
# retains its reader on failure. Use once, and discard buffered input on error.
pub def load_from[T, R: Reader](source: &mut CodecReader[R], options: &CodecOptions) -> Result[T, std.serial.SerialError[JsonError]]:
    if source._codec.is_some():
        return Err(std.serial.error(JsonError(JsonFault.InvalidState, 0, 0, 0)))
    events = std.serial.wrap(decoder(&options.limits))?
    source._codec = Some(CodecDecoder(events, Nothing, options.unknown_fields))
    value = std.serial.decode[T, JsonError, CodecReader[R]](source)?
    std.serial.wrap(source.finish())?
    Ok(value)

pub def dump[T](value: &T, bounds: &Limits) -> Result[Bytes, std.serial.SerialError[JsonError]]:
    mut output = std.serial.wrap(encoder(bounds))?
    std.serial.encode[T, JsonError, Encoder](value, &mut output)?
    std.serial.wrap(complete(&output))?
    std.serial.wrap(output.take())

pub def load[T](source: &[u8], options: &CodecOptions) -> Result[T, std.serial.SerialError[JsonError]]:
    mut input = std.serial.wrap(codec_decoder(source, options))?
    value = std.serial.decode[T, JsonError, CodecDecoder](&mut input)?
    std.serial.wrap(input.finish())?
    Ok(value)

# Tree conversion bounds storage independently of JSON text spelling. Every
# scalar/container and every key counts as a node; text budgets count UTF-8.
pub class TreeLimits:
    pub max_depth: NonNegative[i64] __max(1024)
    pub max_nodes: NonNegative[i64]
    pub max_text_bytes: NonNegative[i64]

pub def tree_limits() -> TreeLimits:
    TreeLimits(64, 1048576, 67108864)

class TreeBudget:
    depth: i64
    nodes: i64
    text: i64
    max_depth: i64
    max_nodes: i64
    max_text: i64

    def node(self: &mut TreeBudget, text: i64 = 0) -> Result[(), JsonError]:
        unchecked:
            if self.nodes >= self.max_nodes or text > self.max_text - self.text:
                return Err(JsonError(JsonFault.OutputTooLarge, 0, 0, 0))
            self.nodes += 1
            self.text += text
        Ok(())

    def enter(self: &mut TreeBudget) -> Result[(), JsonError]:
        if self.depth >= self.max_depth:
            return Err(JsonError(JsonFault.DepthExceeded, 0, 0, 0))
        unchecked:
            self.depth += 1
        Ok(())

    def leave(self: &mut TreeBudget) -> ():
        unchecked:
            self.depth -= 1

def tree_budget(limits: &TreeLimits) -> TreeBudget:
    if limits.max_depth.get() > depth_ceiling:
        __trap("std.json.tree_limits: max_depth is above 1024")
    TreeBudget(0, 0, 0, limits.max_depth.get(), limits.max_nodes.get(), limits.max_text_bytes.get())

pub class TreeEncoder:
    _tree: Builder
    # 0 array; 1 object expecting a key; 2 object expecting its value.
    _states: list[i64]
    _root: bool
    _budget: TreeBudget
    _failed: bool

    pub def reject(self, fault: std.serial.Fault) -> JsonError:
        JsonError(JsonFault.Serialization(fault), 0, 0, 0)

    pub def allocation(self, cause: AllocError) -> JsonError:
        JsonError(JsonFault.Allocation(cause), 0, 0, 0)

    def slot(self: &mut TreeEncoder) -> Result[(), JsonError]:
        if self._failed:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        if len(self._states) == 0:
            if self._root:
                return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
            self._root = True
        elif self._states[-1] == 2:
            self._states[-1] = 1
        elif self._states[-1] != 0:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        Ok(())

    def scalar(self: &mut TreeEncoder, value: Json, text: i64 = 0) -> Result[(), JsonError]:
        self.slot()?
        self._budget.node(text)?
        unplaced(self._tree.attach(value))

    pub def null(self: &mut TreeEncoder) -> Result[(), JsonError]:
        self.scalar(Json.Null)

    pub def boolean(self: &mut TreeEncoder, value: bool) -> Result[(), JsonError]:
        self.scalar(Json.Bool(value))

    pub def integer(self: &mut TreeEncoder, value: i64) -> Result[(), JsonError]:
        self.scalar(Json.Int(value))

    pub def unsigned(self: &mut TreeEncoder, value: u64) -> Result[(), JsonError]:
        if value > 9223372036854775807u64:
            return Err(JsonError(JsonFault.Serialization(std.serial.Fault.Unrepresentable), 0, 0, 0))
        self.scalar(Json.Int(i64(value)))

    pub def decimal(self: &mut TreeEncoder, value: f64) -> Result[(), JsonError]:
        if value != value or value == f64.INF or value == -f64.INF:
            return Err(JsonError(JsonFault.NonFiniteNumber, 0, 0, 0))
        self.scalar(Json.Float(value))

    pub def text(self: &mut TreeEncoder, value: &str) -> Result[(), JsonError]:
        self.scalar(Json.Text(*value), value.byte_len())

    def begin(self: &mut TreeEncoder, state: i64, event: Event) -> Result[(), JsonError]:
        self.slot()?
        self._budget.node()?
        self._budget.enter()?
        unplaced(reserved(self._states.append(state)))?
        unplaced(self._tree.accept(event))

    pub def start_array(self: &mut TreeEncoder) -> Result[(), JsonError]:
        self.begin(0, Event.StartArray)

    pub def start_object(self: &mut TreeEncoder) -> Result[(), JsonError]:
        self.begin(1, Event.StartObject)

    pub def field(self: &mut TreeEncoder, name: &str) -> Result[(), JsonError]:
        self.key(name)

    pub def key(self: &mut TreeEncoder, name: &str) -> Result[(), JsonError]:
        if len(self._states) == 0 or self._states[-1] != 1:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        self._budget.node(name.byte_len())?
        self._states[-1] = 2
        unplaced(self._tree.key(*name))

    def end(self: &mut TreeEncoder, state: i64) -> Result[(), JsonError]:
        if len(self._states) == 0 or self._states[-1] != state:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        drop(self._states.pop())
        self._budget.leave()
        unplaced(self._tree.finish())

    pub def end_array(self: &mut TreeEncoder) -> Result[(), JsonError]:
        self.end(0)

    pub def end_object(self: &mut TreeEncoder) -> Result[(), JsonError]:
        self.end(1)

    pub def finish(self: &mut TreeEncoder) -> Result[Json, JsonError]:
        if self._failed or not self._root or len(self._states) != 0:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        self._failed = True
        match self._tree.root.pop():
            case Some(value):
                Ok(value)
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

pub def tree_encoder(limits: &TreeLimits) -> Result[TreeEncoder, JsonError]:
    budget = tree_budget(limits)
    tree = unplaced(builder(&Limits(0, 0, 0, DuplicateKeys.Reject)))?
    states = unplaced(reserved(list[i64]()))?
    Ok(TreeEncoder(tree, states, False, budget, False))

enum TreeFrame:
    Items(list[Json])
    Members(list[Member])

# Owns the source because classes cannot retain references. Moving a tree
# through this cursor avoids copying it and never encodes numeric values.
pub class TreeDecoder:
    _value: Option[Json]
    _frames: list[TreeFrame]
    _unknown: std.serial.UnknownFields
    _budget: TreeBudget

    pub def reject(self, fault: std.serial.Fault) -> JsonError:
        JsonError(JsonFault.Serialization(fault), 0, 0, 0)

    pub def allocation(self, cause: AllocError) -> JsonError:
        JsonError(JsonFault.Allocation(cause), 0, 0, 0)

    def take(self: &mut TreeDecoder) -> Result[Json, JsonError]:
        match replace(self._value, Nothing):
            case Some(value):
                self._budget.node()?
                Ok(value)
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def null(self: &mut TreeDecoder) -> Result[bool, JsonError]:
        match &self._value:
            case Some(value):
                match value:
                    case Json.Null:
                        drop(self.take()?)
                        return Ok(True)
                    case _:
                        return Ok(False)
            case Nothing:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def boolean(self: &mut TreeDecoder) -> Result[bool, JsonError]:
        match self.take()?:
            case Json.Bool(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def integer(self: &mut TreeDecoder) -> Result[i64, JsonError]:
        match self.take()?:
            case Json.Int(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def unsigned(self: &mut TreeDecoder) -> Result[u64, JsonError]:
        number = self.integer()?
        if number < 0:
            return Err(self.reject(std.serial.Fault.OutOfRange))
        Ok(u64(number))

    pub def decimal(self: &mut TreeDecoder) -> Result[f64, JsonError]:
        match self.take()?:
            case Json.Int(value):
                Ok(f64(value))
            case Json.Float(value):
                if value != value or value == f64.INF or value == -f64.INF:
                    return Err(self.reject(std.serial.Fault.OutOfRange))
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def variant(self: &mut TreeDecoder) -> Result[(str, bool), JsonError]:
        match &self._value:
            case Some(Json.Text(_)):
                return Ok((self.text()?, False))
            case _:
                pass
        self.start_object()?
        match self.next_key()?:
            case Some(tag):
                Ok((tag, True))
            case Nothing:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def text(self: &mut TreeDecoder) -> Result[str, JsonError]:
        match self.take()?:
            case Json.Text(value):
                # The node was counted by take; count text without a second node.
                unchecked:
                    self._budget.nodes -= 1
                self._budget.node(value.byte_len())?
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def start_array(self: &mut TreeDecoder) -> Result[(), JsonError]:
        match self.take()?:
            case Json.Array(values):
                self._budget.enter()?
                mut items = values
                items.reverse()
                unplaced(reserved(self._frames.append(TreeFrame.Items(items))))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_element(self: &mut TreeDecoder) -> Result[bool, JsonError]:
        if self._value.is_some():
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        match self._frames.pop():
            case Some(TreeFrame.Items(values)):
                mut items = values
                match items.pop():
                    case Some(value):
                        self._value = Some(value)
                        unplaced(reserved(self._frames.append(TreeFrame.Items(items))))?
                        Ok(True)
                    case Nothing:
                        self._budget.leave()
                        Ok(False)
            case _:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def start_object(self: &mut TreeDecoder) -> Result[(), JsonError]:
        match self.take()?:
            case Json.Object(values):
                self._budget.enter()?
                mut members = values
                members.reverse()
                unplaced(reserved(self._frames.append(TreeFrame.Members(members))))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_key(self: &mut TreeDecoder) -> Result[Option[str], JsonError]:
        if self._value.is_some():
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        match self._frames.pop():
            case Some(TreeFrame.Members(values)):
                mut members = values
                match members.pop():
                    case Some(member):
                        self._budget.node(member.key.byte_len())?
                        self._value = Some(member.value)
                        unplaced(reserved(self._frames.append(TreeFrame.Members(members))))?
                        Ok(Some(member.key))
                    case Nothing:
                        self._budget.leave()
                        Ok(Nothing)
            case _:
                Err(JsonError(JsonFault.InvalidState, 0, 0, 0))

    pub def unknown_key(self: &mut TreeDecoder, name: &str) -> Result[(), JsonError]:
        if self._unknown == std.serial.UnknownFields.Reject:
            return Err(self.reject(std.serial.Fault.UnknownField(*name)))
        # Skipping uses the same typed traversal and budgets as decoding.
        self.skip()

    def skip(self: &mut TreeDecoder) -> Result[(), JsonError]:
        match &self._value:
            case Some(value):
                match value:
                    case Json.Null:
                        drop(self.null()?)
                    case Json.Bool(_):
                        drop(self.boolean()?)
                    case Json.Int(_):
                        drop(self.integer()?)
                    case Json.Float(_):
                        drop(self.decimal()?)
                    case Json.Text(_):
                        drop(self.text()?)
                    case Json.Array(_):
                        self.start_array()?
                        while self.next_element()?:
                            self.skip()?
                    case Json.Object(_):
                        self.start_object()?
                        while True:
                            match self.next_key()?:
                                case Some(_):
                                    self.skip()?
                                case Nothing:
                                    break
            case Nothing:
                return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        Ok(())

    pub def finish(self: &mut TreeDecoder) -> Result[(), JsonError]:
        if self._value.is_some() or len(self._frames) != 0:
            return Err(JsonError(JsonFault.InvalidState, 0, 0, 0))
        Ok(())

pub def tree_decoder(value: Json, limits: &TreeLimits, unknown_fields: std.serial.UnknownFields = std.serial.UnknownFields.Reject) -> Result[TreeDecoder, JsonError]:
    budget = tree_budget(limits)
    frames = unplaced(reserved(list[TreeFrame]()))?
    Ok(TreeDecoder(Some(value), frames, unknown_fields, budget))

pub def to_value[T](value: &T, limits: &TreeLimits) -> Result[Json, std.serial.SerialError[JsonError]]:
    mut output = std.serial.wrap(tree_encoder(limits))?
    std.serial.encode[T, JsonError, TreeEncoder](value, &mut output)?
    std.serial.wrap(output.finish())

pub def from_value[T](value: Json, limits: &TreeLimits, unknown_fields: std.serial.UnknownFields = std.serial.UnknownFields.Reject) -> Result[T, std.serial.SerialError[JsonError]]:
    mut source = std.serial.wrap(tree_decoder(value, limits, unknown_fields))?
    result = std.serial.decode[T, JsonError, TreeDecoder](&mut source)?
    std.serial.wrap(source.finish())?
    Ok(result)
