from std.sync import CancellationToken
# Child processes started from an argument vector. Nothing is parsed by a
# shell unless the program is one: `shell` names that choice. Encoding the
# request, draining pipes without deadlock, decoding the status and deciding
# when to reap are checked Plenty; the runtime spawns, waits, signals and
# polls. See book/src/design/stdlib/process.md.
from std.bytes import Bytes, with_capacity, write_file
from std.env import valid_name
from std.io import StreamError, classify
from std.path import Path
from std.time import Deadline, Duration, Instant, deadline_after, milliseconds, monotonic_now, sleep

const chunk: i64 = 8192
# A pipe that polls writable has a free page, so a write this size cannot block.
const pipe_page: i64 = 4096
const unreaped: i64 = -1
const running: i64 = 65536
const piped: i64 = 2
const broken_pipe: i32 = 32
const terminate_signal: i32 = 15
const kill_signal: i32 = 9

pub enum Stdio:
    Inherit
    Null
    Piped

def stdio_code(mode: Stdio) -> i64:
    match mode:
        case Stdio.Inherit:
            0
        case Stdio.Null:
            1
        case Stdio.Piped:
            piped

def allocated[T](result: Result[T, AllocError]) -> Result[T, IoError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(IoError.Data(DataError.Allocation(cause)))

def extent(first: i64, second: i64) -> Result[i64, IoError]:
    size = checked:
        first + second
    match size:
        case Ok(value):
            Ok(value)
        case Err(_):
            Err(IoError.Data(DataError.Allocation(AllocError.CapacityOverflow)))

def has_nul(piece: &list[u8]) -> bool:
    for byte in piece:
        if byte == 0u8:
            return True
    False

# Appends `piece` and its NUL terminator, or changes nothing. No argument,
# variable or path can hold a NUL.
def terminated(target: &mut list[u8], piece: &list[u8]) -> Result[(), IoError]:
    if has_nul(piece):
        return Err(IoError.InvalidInput)
    # reserve takes additional elements; held bytes must not be counted twice.
    allocated(target.reserve(extent(len(piece), 1)?))?
    for index in range(len(piece)):
        allocated(target.append(piece[index]))?
    allocated(target.append(0u8))

# How a child ended: an exit code in 0..=255, or the signal that stopped it.
pub class ExitStatus:
    _raw: i64

    pub def success(self) -> bool:
        self._raw == 0

    pub def code(self) -> Option[i32]:
        if self._raw < 256:
            Some(i32(self._raw))
        else:
            Nothing

    pub def signal(self) -> Option[i32]:
        if self._raw < 256:
            Nothing
        else:
            # The branch proves raw >= 256, so subtraction stays nonnegative.
            signal = unchecked:
                self._raw - 256
            Some(i32(signal))

pub class Output:
    pub status: ExitStatus
    pub stdout: Bytes
    pub stderr: Bytes

# A description of a child. Each setter either applies completely or reports
# an error and leaves the command unchanged.
pub class Command:
    _spec: list[u8]
    _dir: list[u8]
    _env: list[u8]
    _argc: i64
    _stdin: i64
    _stdout: i64
    _stderr: i64
    _change_dir: bool
    _clear_env: bool

    pub def arg_bytes(self: &mut Command, value: &list[u8]) -> Result[(), IoError]:
        terminated(&mut self._spec, value)?
        # Each counted argument has a NUL byte in the successfully grown spec.
        self._argc = unchecked:
            self._argc + 1
        Ok(())

    pub def arg(self: &mut Command, value: &str) -> Result[(), IoError]:
        encoded = encode_utf8(value)?
        self.arg_bytes(&encoded)

    pub def arg_path(self: &mut Command, value: &Path) -> Result[(), IoError]:
        self.arg_bytes(value.as_bytes())

    pub def env_bytes(self: &mut Command, name: &list[u8], value: &list[u8]) -> Result[(), IoError]:
        if not valid_name(name):
            return Err(IoError.InvalidInput)
        mut edit = allocated(list[u8].with_capacity(extent(extent(len(name), len(value))?, 1)?))?
        for index in range(len(name)):
            allocated(edit.append(name[index]))?
        allocated(edit.append(61u8))?
        for index in range(len(value)):
            allocated(edit.append(value[index]))?
        terminated(&mut self._env, &edit)

    pub def env(self: &mut Command, name: &str, value: &str) -> Result[(), IoError]:
        encoded_name = encode_utf8(name)?
        encoded_value = encode_utf8(value)?
        self.env_bytes(&encoded_name, &encoded_value)

    pub def env_remove_bytes(self: &mut Command, name: &list[u8]) -> Result[(), IoError]:
        if not valid_name(name):
            return Err(IoError.InvalidInput)
        terminated(&mut self._env, name)

    pub def env_remove(self: &mut Command, name: &str) -> Result[(), IoError]:
        encoded = encode_utf8(name)?
        self.env_remove_bytes(&encoded)

    # The child starts with no inherited variables; earlier edits are dropped.
    pub def env_clear(self: &mut Command) -> ():
        self._env.clear()
        self._clear_env = True

    pub def current_dir(self: &mut Command, path: &Path) -> Result[(), IoError]:
        if len(path.as_bytes()) == 0:
            return Err(IoError.InvalidInput)
        mut dir = allocated(list[u8].new())?
        terminated(&mut dir, path.as_bytes())?
        self._dir = dir
        self._change_dir = True
        Ok(())

    pub def stdin(self: &mut Command, mode: Stdio) -> ():
        self._stdin = stdio_code(mode)

    pub def stdout(self: &mut Command, mode: Stdio) -> ():
        self._stdout = stdio_code(mode)

    pub def stderr(self: &mut Command, mode: Stdio) -> ():
        self._stderr = stdio_code(mode)

    # The command is reusable: each call starts another child.
    pub def spawn(self) -> Result[Child, IoError]:
        mut spec = allocated(list[u8].with_capacity(extent(extent(len(self._spec), len(self._dir))?, len(self._env))?))?
        for index in range(len(self._spec)):
            allocated(spec.append(self._spec[index]))?
        mut flags = self._stdin | (self._stdout << 2) | (self._stderr << 4)
        if self._change_dir:
            flags = flags | 64
            for index in range(len(self._dir)):
                allocated(spec.append(self._dir[index]))?
        if self._clear_env:
            flags = flags | 128
        for index in range(len(self._env)):
            allocated(spec.append(self._env[index]))?
        handle = __process_spawn(spec, self._argc, flags)?
        mut child = Child(handle, unreaped, Nothing, Nothing, Nothing)
        if self._stdin == piped:
            child._stdin = Some(pipe_end(handle, 0u8)?)
        if self._stdout == piped:
            child._stdout = Some(pipe_end(handle, 1u8)?)
        if self._stderr == piped:
            child._stderr = Some(pipe_end(handle, 2u8)?)
        Ok(child)

# A child whose pipe cannot be handed over has no owner to wait for it, so it
# is killed and reaped before the failure is reported.
def pipe_end(handle: i64, which: u8) -> Result[File, IoError]:
    match __process_pipe(handle, which):
        case Ok(file):
            Ok(file)
        case Err(error):
            match __process_signal(handle, i64(kill_signal)):
                case _:
                    pass
            match __process_wait(handle, True):
                case _:
                    pass
            Err(error)

# The program is looked up in PATH unless it contains a slash. It becomes the
# child's argv[0]; arguments are passed exactly as given.
pub def command_bytes(program: &list[u8]) -> Result[Command, IoError]:
    if len(program) == 0:
        return Err(IoError.InvalidInput)
    mut spec = allocated(list[u8].new())?
    terminated(&mut spec, program)?
    Ok(Command(spec, allocated(list[u8].new())?, allocated(list[u8].new())?, 0, 0, 0, 0, False, False))

pub def command(program: &str) -> Result[Command, IoError]:
    encoded = encode_utf8(program)?
    command_bytes(&encoded)

# The explicit shell: `/bin/sh -c script`. The script is shell syntax, so
# never build it from untrusted text.
pub def shell(script: &str) -> Result[Command, IoError]:
    mut built = command("/bin/sh")?
    built.arg("-c")?
    built.arg(script)?
    Ok(built)

def closed_end(end: Option[File]) -> Result[(), IoError]:
    match end:
        case Some(file):
            mut owned = file
            owned.close()
        case Nothing:
            Ok(())

def failed[T](result: Result[T, IoError]) -> Result[T, StreamError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(classify(error))

def empty() -> Result[Bytes, StreamError]:
    with_capacity(0).map_error(StreamError.Allocation)

# A budget too long for the monotonic clock is InvalidInput.
def ending(start: &Instant, budget: &Duration) -> Result[Deadline, IoError]:
    match deadline_after(start, budget):
        case Ok(deadline):
            Ok(deadline)
        case Err(_):
            Err(IoError.InvalidInput)

def interrupted(cause: &StreamError) -> bool:
    match cause:
        case StreamError.Interrupted:
            True
        case _:
            False

def broken(error: &IoError) -> bool:
    match error:
        case IoError.System(code):
            code == broken_pipe
        case _:
            False

# Checked extent for a chunk or a one-byte probe past the output budget.
def drain_extent(before: i64, limit: i64) -> Result[i64, StreamError]:
    if before < 0 or limit < before:
        return Err(StreamError.OutOfRange)
    # Validated endpoints bound the difference; only a remainder < chunk is incremented.
    wanted = unchecked:
        remaining = limit - before
        if remaining < chunk:
            remaining + 1
        else:
            chunk
    size = checked:
        before + wanted
    match size:
        case Ok(end):
            Ok(end)
        case Err(_):
            Err(StreamError.Allocation(AllocError.CapacityOverflow))

# One read of at most a chunk, appended to out. True means end of input.
# Reading one byte past limit distinguishes excess output from an exact fit.
# Representation failure precedes growth or consuming input.
def drained(file: &mut File, out: &mut Bytes, limit: i64) -> Result[bool, StreamError]:
    before = out.len()
    end = drain_extent(before, limit)?
    out.resize(end, 0u8).map_error(StreamError.Allocation)?
    match out.read_file(file, before, end):
        case Ok(count):
            # Concrete native file progress is in 0..=end-before.
            after = unchecked:
                before + count
            out.truncate(after)
            if after > limit:
                return Err(StreamError.OutOfRange)
            Ok(count == 0)
        case Err(error):
            out.truncate(before)
            cause = classify(error)
            if interrupted(&cause):
                return Ok(False)
            Err(cause)

# An owned child. Dropping it neither stops nor reaps the process: call wait.
pub class Child:
    _handle: i64
    _raw: i64
    _stdin: Option[File]
    _stdout: Option[File]
    _stderr: Option[File]

    pub def id(self) -> i64:
        self._handle & 4294967295

    # The pipe ends, present once each when the command asked for Piped.
    pub def take_stdin(self: &mut Child) -> Option[File]:
        replace(self._stdin, Nothing)

    pub def take_stdout(self: &mut Child) -> Option[File]:
        replace(self._stdout, Nothing)

    pub def take_stderr(self: &mut Child) -> Option[File]:
        replace(self._stderr, Nothing)

    # End of input for the child. A no-op once the pipe is closed or taken.
    pub def close_stdin(self: &mut Child) -> Result[(), IoError]:
        closed_end(replace(self._stdin, Nothing))

    # Blocks until the child ends and reaps it. Stdin still held here is
    # closed first, so a child reading to end of input can finish. Later calls
    # return the same status.
    pub def wait(self: &mut Child) -> Result[ExitStatus, IoError]:
        if self._raw == unreaped:
            self.close_stdin()?
            self._raw = __process_wait(self._handle, True)?
        Ok(ExitStatus(self._raw))

    # Reaps the child if it has ended; Nothing while it is running.
    pub def try_wait(self: &mut Child) -> Result[Option[ExitStatus], IoError]:
        if self._raw == unreaped:
            raw = __process_wait(self._handle, False)?
            if raw == running:
                return Ok(Nothing)
            self._raw = raw
        Ok(Some(ExitStatus(self._raw)))

    # Polls try_wait with cancellable pauses of at most 10 ms. Nothing means
    # the budget ran out and the child is still running. Stdin is left open.
    pub def wait_timeout(self: &mut Child, budget: &Duration, cancel: &CancellationToken) -> Result[Option[ExitStatus], WaitError]:
        deadline = ending(&monotonic_now(), budget).map_error(WaitError.Io)?
        self.wait_before(&deadline, cancel)

    # Cancellation observes this wait only; it never kills or reaps the child.
    pub def wait_before(self: &mut Child, deadline: &Deadline, cancel: &CancellationToken) -> Result[Option[ExitStatus], WaitError]:
        while True:
            if cancel.is_cancelled():
                return Err(WaitError.Cancelled)
            match self.try_wait().map_error(WaitError.Io)?:
                case Some(status):
                    return Ok(Some(status))
                case Nothing:
                    pass
            now = monotonic_now()
            if deadline.expired(&now):
                return Ok(Nothing)
            left = deadline.remaining(&now).as_timeout_ms()
            if left > 10u64:
                drop(cancel.wait_timeout_ms(10u64))
            else:
                drop(cancel.wait_timeout_ms(left))
        Ok(Nothing)

    # Sends a signal to a child that has not been reaped; afterwards a no-op,
    # so the number can never reach an unrelated process that reused the pid.
    pub def signal(self, number: i32) -> Result[(), IoError]:
        if self._raw != unreaped:
            return Ok(())
        __process_signal(self._handle, i64(number))

    # SIGTERM: a request the child may handle or ignore.
    pub def terminate(self) -> Result[(), IoError]:
        self.signal(terminate_signal)

    # SIGKILL: cannot be caught. The child still has to be waited for.
    pub def kill(self) -> Result[(), IoError]:
        self.signal(kill_signal)

    # One page of `input` from `sent`; returns the new position. A child that
    # stopped reading ends the feed without an error: its status tells why.
    def feed(self: &mut Child, input: &[u8], sent: i64) -> Result[i64, StreamError]:
        # Private sent is within input; the page clamp and native write count bound its advance.
        unchecked:
            mut stop = len(input)
            if stop - sent > pipe_page:
                stop = sent + pipe_page
            match &mut self._stdin:
                case Some(file):
                    match write_file(file, &input[sent:stop]):
                        case Ok(count):
                            return Ok(sent + count)
                        case Err(error):
                            if not broken(&error):
                                cause = classify(error)
                                if interrupted(&cause):
                                    return Ok(sent)
                                return Err(cause)
                case Nothing:
                    return Ok(len(input))
            self._stdin = Nothing
            Ok(len(input))

    # Writes `input` to a piped stdin while collecting piped stdout and stderr,
    # whichever is ready, so no pipe fills while another is being served. Then
    # closes stdin and waits. More than `limit` bytes on either stream is
    # OutOfRange; the child is then still running and still owned.
    pub def communicate(self: &mut Child, input: &[u8], limit: NonNegative[i64]) -> Result[Output, StreamError]:
        most = limit.get()
        mut out = empty()?
        mut err = empty()?
        mut sent = 0
        while True:
            if sent >= len(input):
                failed(self.close_stdin())?
            mut interest = 0
            if self._stdin.is_some():
                interest = interest | 1
            if self._stdout.is_some():
                interest = interest | 2
            if self._stderr.is_some():
                interest = interest | 4
            if interest == 0:
                break
            mut ready = 0
            match __process_poll(self._handle, interest, -1):
                case Ok(mask):
                    ready = mask
                case Err(error):
                    cause = classify(error)
                    if not interrupted(&cause):
                        return Err(cause)
            if ready & 1 != 0:
                sent = self.feed(input, sent)?
            if ready & 2 != 0:
                mut ended = False
                match &mut self._stdout:
                    case Some(file):
                        ended = drained(file, &mut out, most)?
                    case Nothing:
                        pass
                if ended:
                    failed(closed_end(replace(self._stdout, Nothing)))?
            if ready & 4 != 0:
                mut ended = False
                match &mut self._stderr:
                    case Some(file):
                        ended = drained(file, &mut err, most)?
                    case Nothing:
                        pass
                if ended:
                    failed(closed_end(replace(self._stderr, Nothing)))?
        status = failed(self.wait())?
        Ok(Output(status, out, err))

    # communicate with no input: stdin is closed at once.
    pub def output(self: &mut Child, limit: NonNegative[i64]) -> Result[Output, StreamError]:
        nothing = empty()?
        self.communicate(&nothing, limit)

pub enum WaitError:
    Io(IoError)
    Cancelled
