# Python-style paragraph tools adapted from CPython Lib/textwrap.py,
# b3714a5fb7a (3.15 development), Copyright (C) 1999-2001 Gregory P. Ward,
# Copyright (C) 2002 Python Software Foundation. PSF-2.0; see
# scripts/release/licenses/cpython-textwrap-LICENSE.txt. The adaptation uses
# checked, bounded Plenty storage and a scanner instead of regular expressions.


import std.bytes
from std.bytes import ByteSource, Bytes, BytesError

def located(index: i64) -> Option[i64]:
    if index < 0:
        return Nothing
    Some(index)

# Byte-set scans over text, the `str` forms of `Bytes.find_in` and
# `find_not_in`: one native call over the whole text, no allocation. A scalar
# is a member when it is ASCII and its byte is in `set`; set bytes from 0x80
# match nothing. Results are scalar positions, as for `str.find`.
pub def find_in[S: ByteSource](text: &str, set: &S) -> Option[i64]:
    located(__text_find_in(text, set, 1u8))

# The first scalar that is not a member: the end of a run. Text made only of
# members gives `Nothing`.
pub def find_not_in[S: ByteSource](text: &str, set: &S) -> Option[i64]:
    located(__text_find_in(text, set, 0u8))

pub enum TextError:
    InvalidLimit
    LimitExceeded
    Allocation(AllocError)
    Bytes(BytesError)

def byte_result[T](value: Result[T, BytesError]) -> Result[T, TextError]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(error):
            Err(TextError.Bytes(error))

# Count UTF-8 bytes without allocating a temporary encoding of an unbounded input.
def byte_count(text: &str, limit: i64) -> Result[i64, TextError]:
    mut count = 0
    for scalar in text:
        code = ord(scalar).unwrap()
        mut size = 1
        if code >= 65536u32:
            size = 4
        elif code >= 2048u32:
            size = 3
        elif code >= 128u32:
            size = 2
        if size > limit - count:
            return Err(TextError.LimitExceeded)
        count += size
    Ok(count)

pub class Builder:
    _bytes: Bytes
    _limit: i64

    pub def byte_len(self) -> i64:
        self._bytes.len()

    pub def limit(self) -> i64:
        self._limit

    pub def append(self: &mut Builder, text: &str) -> Result[(), TextError]:
        drop(byte_count(text, self._limit - self._bytes.len())?)
        encoded = byte_result(std.bytes.from_text(text))?
        byte_result(self._bytes.extend(&encoded))

    pub def clear(self: &mut Builder) -> ():
        self._bytes.clear()

    pub def to_text(self) -> Result[str, TextError]:
        byte_result(self._bytes.to_text())

    # Finalization consumes the buffer even when allocating the string fails.
    # Use to_text when retaining the builder for reuse or retry is important.
    pub def finish(self: Builder) -> Result[str, TextError]:
        self.to_text()

pub def builder(max_bytes: i64) -> Result[Builder, TextError]:
    if max_bytes < 0:
        return Err(TextError.InvalidLimit)
    Ok(Builder(byte_result(std.bytes.empty())?, max_bytes))

pub def join(pieces: &list[str], separator: &str, max_bytes: i64) -> Result[str, TextError]:
    mut output = builder(max_bytes)?
    mut first = True
    for piece in pieces:
        if not first:
            output.append(separator)?
        output.append(piece)?
        first = False
    output.finish()

# Hard wrap by Unicode scalar count, preserving explicit LF and every input
# scalar. This is deliberately not display-width or grapheme/word wrapping.
pub def hard_wrap(text: &str, width: i64, max_bytes: i64) -> Result[str, TextError]:
    if width <= 0:
        return Err(TextError.InvalidLimit)
    mut output = builder(max_bytes)?
    mut column = 0
    for scalar in text:
        if scalar == "\n":
            output.append(scalar)?
            column = 0
        else:
            if column == width:
                output.append("\n")?
                column = 0
            output.append(scalar)?
            column += 1
    output.finish()


def text_result[T](value: Result[T, AllocError]) -> Result[T, TextError]:
    value.map_error(TextError.Allocation)

def check_input(text: &str, max_input_bytes: i64) -> Result[(), TextError]:
    if max_input_bytes < 0:
        return Err(TextError.InvalidLimit)
    if text.byte_len() > max_input_bytes:
        return Err(TextError.LimitExceeded)
    Ok(())

def wrap_space(scalar: &str) -> bool:
    scalar == " " or scalar == "\t" or scalar == "\n" or scalar == "\r" or ord(scalar).unwrap() == 11u32 or ord(scalar).unwrap() == 12u32

def word_scalar(scalar: &str) -> bool:
    code = ord(scalar).unwrap()
    scalar == "_" or __regex_property(code, 10) or __regex_property(code, 14)

def letter_scalar(scalar: &str) -> bool:
    scalar == "_" or __regex_property(ord(scalar).unwrap(), 10)

def scalar_piece(scalars: &list[str], start: i64, stop: i64) -> Result[str, TextError]:
    pieces = text_result(scalars[start:stop])?
    text_result("".join(&pieces))

# The Python splitter uses lookbehind/lookahead for compound hyphens and
# double-dash punctuation. Keep that distinction from minus signs and flags.
def split_chunks(text: &str, hyphens: bool) -> Result[list[str], TextError]:
    scalars = text_result([*scalar for scalar in text])?
    mut chunks = text_result(list[str].new())?
    mut start = 0
    mut at = 0
    while at < len(scalars):
        if wrap_space(&scalars[at]):
            at += 1
            while at < len(scalars) and wrap_space(&scalars[at]):
                at += 1
            chunks.append(scalar_piece(&scalars, start, at)?).map_error(TextError.Allocation)?
            start = at
            continue
        if hyphens and scalars[at] == "-":
            mut stop = at
            while stop < len(scalars) and scalars[stop] == "-":
                stop += 1
            if stop - at >= 2 and at > start and stop < len(scalars) and word_scalar(&scalars[stop]) and (word_scalar(&scalars[at - 1]) or scalars[at - 1] in "!\"'&.,?"):
                chunks.append(scalar_piece(&scalars, start, at)?).map_error(TextError.Allocation)?
                chunks.append(scalar_piece(&scalars, at, stop)?).map_error(TextError.Allocation)?
                at = stop
                start = at
                continue
            if stop - at >= 2:
                # A nonbreaking dash run is one scan, including at the start
                # of a word; revisiting its suffix would be quadratic.
                at = stop
                if at == len(scalars) or wrap_space(&scalars[at]):
                    chunks.append(scalar_piece(&scalars, start, at)?).map_error(TextError.Allocation)?
                    start = at
                continue
            before = (at >= 2 and letter_scalar(&scalars[at - 1]) and letter_scalar(&scalars[at - 2])) or (at >= 3 and letter_scalar(&scalars[at - 1]) and scalars[at - 2] == "-" and letter_scalar(&scalars[at - 3]))
            mut after = at + 2
            if after < len(scalars) and scalars[after] == "-":
                after += 1
            if before and at + 1 < len(scalars) and letter_scalar(&scalars[at + 1]) and after < len(scalars) and letter_scalar(&scalars[after]):
                at += 1
                chunks.append(scalar_piece(&scalars, start, at)?).map_error(TextError.Allocation)?
                start = at
                continue
        at += 1
        if at == len(scalars) or wrap_space(&scalars[at]):
            chunks.append(scalar_piece(&scalars, start, at)?).map_error(TextError.Allocation)?
            start = at
    Ok(chunks)

def sentence_ending(text: &str) -> bool:
    mut stop = len(text)
    if stop > 0 and (text[stop - 1] == "\"" or text[stop - 1] == "'"):
        stop -= 1
    stop >= 2 and text[stop - 1] in ".!?" and text[stop - 2] >= "a" and text[stop - 2] <= "z"

pub class TextWrapper:
    pub width: i64
    pub initial_indent: str
    pub subsequent_indent: str
    pub expand_tabs: bool
    pub replace_whitespace: bool
    pub fix_sentence_endings: bool
    pub break_long_words: bool
    pub drop_whitespace: bool
    pub break_on_hyphens: bool
    pub tabsize: i64
    pub max_lines: Option[i64]
    pub placeholder: str
    pub max_bytes: i64
    pub max_input_bytes: i64

    def validate(self) -> Result[(), TextError]:
        if self.width <= 0 or self.tabsize < 0 or self.max_bytes < 0 or self.max_input_bytes < 0:
            return Err(TextError.InvalidLimit)
        check_input(&self.initial_indent, self.max_input_bytes)?
        check_input(&self.subsequent_indent, self.max_input_bytes)?
        match self.max_lines:
            case Some(count):
                check_input(&self.placeholder, self.max_input_bytes)?
                if count <= 0:
                    return Err(TextError.InvalidLimit)
                indent = self.subsequent_indent if count > 1 else self.initial_indent
                # Subtract after the bounds check to avoid overflow for i64.MAX.
                if len(indent) > self.width:
                    return Err(TextError.InvalidLimit)
                mark = text_result(self.placeholder.lstrip())?
                if len(mark) > self.width - len(indent):
                    return Err(TextError.InvalidLimit)
            case Nothing:
                pass
        Ok(())

    def prepare(self, text: &str) -> Result[str, TextError]:
        mut output = builder(self.max_input_bytes)?
        mut column = 0
        for scalar in text:
            if scalar == "\t" and self.expand_tabs:
                if self.tabsize > 0:
                    count = self.tabsize - column % self.tabsize
                    # Bound before looping even when tabsize is i64.MAX.
                    if count > output.limit() - output.byte_len():
                        return Err(TextError.LimitExceeded)
                    for unused in range(count):
                        output.append(" ")?
                    # Only the remainder is needed to place the next tab.
                    column = 0
            else:
                if self.replace_whitespace and wrap_space(scalar):
                    output.append(" ")?
                else:
                    output.append(scalar)?
                if scalar == "\n" or scalar == "\r":
                    column = 0
                elif self.tabsize > 0:
                    column = (column + 1) % self.tabsize
        output.finish()

    pub def wrap(self, text: &str) -> Result[list[str], TextError]:
        self.validate()?
        check_input(text, self.max_input_bytes)?
        normalized = self.prepare(text)?
        mut chunks = split_chunks(&normalized, self.break_on_hyphens)?
        if self.fix_sentence_endings:
            for at in range(1, len(chunks)):
                if chunks[at] == " " and sentence_ending(&chunks[at - 1]):
                    chunks[at] = "  "
        chunks.reverse()
        mut lines = text_result(list[str].new())?
        mut used_bytes = 0
        # Retain an offset into a split long word: repeatedly copying the
        # whole remaining suffix would make narrow wrapping quadratic.
        mut offset = 0
        mut long_scalars = text_result(list[str].new())?
        mut nonwhite_stop = 0
        while len(chunks) > 0:
            indent = self.initial_indent if len(lines) == 0 else self.subsequent_indent
            available = self.width - len(indent)
            mut current = text_result(list[str].new())?
            mut size = 0
            head_is_space = chunks[-1].isspace() if offset == 0 else offset >= nonwhite_stop
            if self.drop_whitespace and len(lines) > 0 and head_is_space:
                drop(chunks.pop())
                offset = 0
            while len(chunks) > 0:
                if len(chunks[-1]) - offset > available - size:
                    break
                size += len(chunks[-1]) - offset
                piece = chunks.pop().unwrap()
                current.append(text_result(piece[offset:])?).map_error(TextError.Allocation)?
                offset = 0
            if len(chunks) > 0 and len(chunks[-1]) - offset > available:
                mut space_left = 1 if available < 1 else available - size
                if self.break_long_words and space_left > 0:
                    chunk = chunks[-1]
                    if offset == 0:
                        long_scalars = text_result([*scalar for scalar in &chunk])?
                        nonwhite_stop = 0
                        for at, scalar in enumerate(&long_scalars):
                            if not scalar.isspace():
                                nonwhite_stop = at + 1
                    if space_left > len(chunk) - offset:
                        space_left = len(chunk) - offset
                    mut end = space_left
                    if self.break_on_hyphens and len(chunk) - offset > space_left:
                        mut hyphen = -1
                        mut non_hyphen = False
                        for at in range(space_left):
                            if long_scalars[offset + at] == "-" and non_hyphen:
                                hyphen = at
                            elif long_scalars[offset + at] != "-":
                                non_hyphen = True
                        if hyphen > 0:
                            end = hyphen + 1
                    current.append(scalar_piece(&long_scalars, offset, offset + end)?).map_error(TextError.Allocation)?
                    offset += end
                    if offset == len(chunk):
                        drop(chunks.pop())
                        offset = 0
                    size += end
                elif len(current) == 0:
                    size = len(chunks[-1])
                    current.append(chunks.pop().unwrap()).map_error(TextError.Allocation)?
                    offset = 0
            if self.drop_whitespace and len(current) > 0 and current[-1].isspace():
                size -= len(current[-1])
                drop(current.pop())
            if len(current) == 0:
                continue
            mut truncate = False
            match self.max_lines:
                case Some(count):
                    mut exhausted = len(chunks) == 0
                    if self.drop_whitespace and len(chunks) == 1:
                        exhausted = chunks[0].isspace() if offset == 0 else offset >= nonwhite_stop
                    truncate = len(lines) + 1 >= count and not (exhausted and size <= available)
                case Nothing:
                    pass
            mut mark = ""
            if truncate:
                mark = self.placeholder
                while len(current) > 0:
                    if not current[-1].isspace() and len(mark) <= available - size:
                        break
                    size -= len(current[-1])
                    drop(current.pop())
                if len(current) == 0:
                    if len(lines) > 0:
                        previous = text_result(lines[-1].rstrip())?
                        if len(mark) <= self.width - len(previous):
                            mut output = builder(self.max_bytes - used_bytes + lines[-1].byte_len())?
                            output.append(&previous)?
                            output.append(&mark)?
                            lines[-1] = output.finish()?
                            break
                    mark = text_result(self.placeholder.lstrip())?
            mut output = builder(self.max_bytes - used_bytes)?
            output.append(&indent)?
            for piece in &current:
                output.append(piece)?
            output.append(&mark)?
            line = output.finish()?
            used_bytes += line.byte_len()
            lines.append(line).map_error(TextError.Allocation)?
            if truncate:
                break
        Ok(lines)

    pub def fill(self, text: &str) -> Result[str, TextError]:
        lines = self.wrap(text)?
        join(&lines, "\n", self.max_bytes)

# Mutable configuration is reusable; each operation observes it without
# retaining the input or accumulating state between calls.
pub def text_wrapper(width: i64 = 70, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> TextWrapper:
    TextWrapper(width, "", "", True, True, False, True, True, True, 8, Nothing, " [...]", max_bytes, max_input_bytes)

pub def wrap(text: &str, width: i64 = 70, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> Result[list[str], TextError]:
    text_wrapper(width, max_bytes, max_input_bytes).wrap(text)

pub def fill(text: &str, width: i64 = 70, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> Result[str, TextError]:
    text_wrapper(width, max_bytes, max_input_bytes).fill(text)

pub def shorten(text: &str, width: i64, placeholder: &str = " [...]", max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576, fix_sentence_endings: bool = False, break_long_words: bool = True, break_on_hyphens: bool = True) -> Result[str, TextError]:
    check_input(text, max_input_bytes)?
    check_input(placeholder, max_input_bytes)?
    mut wrapper = text_wrapper(width, max_bytes, max_input_bytes)
    wrapper.max_lines = Some(1)
    wrapper.placeholder = *placeholder
    wrapper.fix_sentence_endings = fix_sentence_endings
    wrapper.break_long_words = break_long_words
    wrapper.break_on_hyphens = break_on_hyphens
    wrapper.validate()?
    mut collapsed = builder(max_input_bytes)?
    mut space = False
    for scalar in text:
        if scalar.isspace():
            space = collapsed.byte_len() > 0
        else:
            if space:
                collapsed.append(" ")?
                space = False
            collapsed.append(scalar)?
    normalized = collapsed.finish()?
    wrapper.fill(&normalized)

# LF defines dedent lines; other whitespace-only line bodies are normalized,
# while only literal spaces and tabs contribute to the common margin.
pub def dedent(text: &str, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> Result[str, TextError]:
    check_input(text, max_input_bytes)?
    mut output = builder(max_bytes)?
    lines = text_result(text.split("\n"))?
    mut margin = text_result(list[str].new())?
    mut seen = False
    for line in &lines:
        if len(line) == 0 or line.isspace():
            continue
        mut prefix = text_result(list[str].new())?
        for scalar in line:
            if scalar != " " and scalar != "\t":
                break
            prefix.append(*scalar).map_error(TextError.Allocation)?
        if not seen:
            margin = prefix
            seen = True
        else:
            mut common = 0
            while common < len(prefix) and common < len(margin) and prefix[common] == margin[common]:
                common += 1
            while len(margin) > common:
                drop(margin.pop())
    count = len(margin)
    mut first = True
    for line in &lines:
        if not first:
            output.append("\n")?
        first = False
        if len(line) > 0 and not line.isspace():
            output.append(&text_result(line[count:])?)?
    output.finish()

def nonblank_line(line: &str) -> bool:
    len(line) > 0 and not line.isspace()

pub def indent(text: &str, prefix: &str, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> Result[str, TextError]:
    indent_with(text, prefix, nonblank_line, max_bytes, max_input_bytes)

pub def indent_with[F: Callable[[&str], bool]](text: &str, prefix: &str, predicate: F, max_bytes: i64 = 1048576, max_input_bytes: i64 = 1048576) -> Result[str, TextError]:
    check_input(text, max_input_bytes)?
    check_input(prefix, max_input_bytes)?
    mut output = builder(max_bytes)?
    lines = text_result(text.splitlines(True))?
    for line in &lines:
        if predicate(line):
            output.append(prefix)?
        output.append(line)?
    output.finish()
