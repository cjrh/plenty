# Byte streams with explicit partial progress. A stream is any class whose
# methods match Reader, Writer, Seeker or Closer; calls are statically
# dispatched per concrete class. One read or write call makes at most one
# attempt and reports the bytes it moved. The helpers below add retry, end of
# input and failure-after-progress policy. See book/src/design/stdlib/io.md.
from std.bytes import Bytes, with_capacity
from std.path import Path
from std.encoding import Endian
import std.encoding
import std.bytes

pub enum StreamError:
    Interrupted
    UnexpectedEof
    WriteZero
    OutOfRange
    InvalidProgress
    Io(IoError)
    Allocation(AllocError)

# Checked in-memory fields retain position and size context on truncation.
pub enum BinaryError:
    Truncated(i64, i64, i64)
    TrailingData(i64, i64)
    OutOfRange
    LimitExceeded
    Allocation(AllocError)

# A multi-step helper stopped after moving `completed` bytes.
pub class Partial:
    pub completed: i64
    pub cause: StreamError

# The count is the bytes delivered to the writer before the named side failed.
pub enum CopyError:
    Read(i64, StreamError)
    Write(i64, StreamError)

pub enum CloseError:
    Flush(StreamError)
    Close(StreamError)
    FlushAndClose(StreamError, StreamError)

pub enum SeekFrom:
    Start(i64)
    Current(i64)
    End(i64)

pub protocol Reader:
    def read(self: &mut Reader, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        pass

# `write` reads a `&[u8]` view, so `&buffer`, a `b"..."` literal and
# `&buffer[a:b]` are all written without a copy.
pub protocol Writer:
    def write(self: &mut Writer, source: &[u8]) -> Result[i64, StreamError]:
        pass

    def flush(self: &mut Writer) -> Result[(), StreamError]:
        pass

pub protocol Seeker:
    def seek(self: &mut Seeker, target: SeekFrom) -> Result[i64, StreamError]:
        pass

pub protocol Closer:
    def close(self: &mut Closer) -> Result[(), StreamError]:
        pass

const chunk: i64 = 8192
const interrupted_call: i32 = 4

def within(start: i64, stop: i64, count: i64) -> bool:
    start >= 0 and start <= stop and stop <= count

# A stream that reports moving more than it was offered, or a negative count,
# is broken; trusting it would corrupt every offset computed afterwards.
def progressed(count: i64, offered: i64) -> Result[i64, StreamError]:
    if count < 0 or count > offered:
        return Err(StreamError.InvalidProgress)
    Ok(count)

def interrupted(cause: &StreamError) -> bool:
    match cause:
        case StreamError.Interrupted:
            True
        case _:
            False

# EINTR becomes Interrupted and buffer exhaustion Allocation; every other
# native failure keeps its IoError.
pub def classify(error: IoError) -> StreamError:
    match error:
        case IoError.System(code):
            if code == interrupted_call:
                StreamError.Interrupted
            else:
                StreamError.Io(IoError.System(code))
        case IoError.Data(data):
            match data:
                case DataError.Allocation(cause):
                    StreamError.Allocation(cause)
                case _:
                    StreamError.Io(IoError.Data(data))
        case _ as other:
            StreamError.Io(other)

def moved(result: Result[i64, IoError]) -> Result[i64, StreamError]:
    match result:
        case Ok(count):
            Ok(count)
        case Err(error):
            Err(classify(error))

def finished(result: Result[(), IoError]) -> Result[(), StreamError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(error):
            Err(classify(error))

# `base` is a nonnegative position, so only the upper bound can overflow.
def displaced(base: i64, offset: i64) -> Result[i64, StreamError]:
    result = checked:
        base + offset
    match result:
        case Ok(position):
            if position < 0:
                Err(StreamError.OutOfRange)
            else:
                Ok(position)
        case Err(_):
            Err(StreamError.OutOfRange)

# Fills buffer[start:stop] completely, retrying interrupted and short reads.
pub def read_exact[R: Reader](reader: &mut R, buffer: &mut Bytes, start: i64, stop: i64) -> Result[(), Partial]:
    # Validated ranges and progress keep start <= at <= stop <= len(buffer).
    unchecked:
        if not within(start, stop, buffer.len()):
            __trap("read_exact: start/stop outside buffer")
        mut at = start
        while at < stop:
            match reader.read(buffer, at, stop):
                case Ok(count):
                    if count == 0:
                        return Err(Partial(at - start, StreamError.UnexpectedEof))
                    if count < 0 or count > stop - at:
                        return Err(Partial(at - start, StreamError.InvalidProgress))
                    at += count
                case Err(cause):
                    if not interrupted(&cause):
                        return Err(Partial(at - start, cause))
        Ok(())

# Delivers all of `source`, retrying interrupted and short writes.
pub def write_all[W: Writer](writer: &mut W, source: &[u8]) -> Result[(), Partial]:
    # Progress is checked before advancing, so 0 <= at <= len(source).
    unchecked:
        stop = len(source)
        mut at = 0
        while at < stop:
            match writer.write(&source[at:]):
                case Ok(count):
                    if count == 0:
                        return Err(Partial(at, StreamError.WriteZero))
                    if count < 0 or count > stop - at:
                        return Err(Partial(at, StreamError.InvalidProgress))
                    at += count
                case Err(cause):
                    if not interrupted(&cause):
                        return Err(Partial(at, cause))
        Ok(())

# Appends at most `limit` bytes to `out`, stopping early only at end of input.
# `out` grows one bounded step at a time and never holds unread filler.
pub def read_up_to[R: Reader](reader: &mut R, out: &mut Bytes, limit: NonNegative[i64]) -> Result[i64, Partial]:
    up_to(reader, out, limit.get())

def up_to[R: Reader](reader: &mut R, out: &mut Bytes, limit: i64) -> Result[i64, Partial]:
    # total <= limit; checked extent bounds filled + count, and step <= limit - total.
    unchecked:
        mut total = 0
        while total < limit:
            mut step = limit - total
            if step > chunk:
                step = chunk
            filled = out.len()
            extent = checked:
                filled + step
            end = match extent:
                case Ok(value):
                    value
                case Err(_):
                    return Err(Partial(total, StreamError.Allocation(AllocError.CapacityOverflow)))
            match out.resize(end, 0u8).map_error(StreamError.Allocation):
                case Ok(_):
                    pass
                case Err(cause):
                    return Err(Partial(total, cause))
            outcome = reader.read(out, filled, end)
            match outcome:
                case Ok(count):
                    if count < 0 or count > step:
                        out.truncate(filled)
                        return Err(Partial(total, StreamError.InvalidProgress))
                    out.truncate(filled + count)
                    if count == 0:
                        return Ok(total)
                    total += count
                case Err(cause):
                    out.truncate(filled)
                    if not interrupted(&cause):
                        return Err(Partial(total, cause))
        Ok(total)

# Moves bytes until the reader reports end of input, using the whole of the
# caller's `scratch` as the transfer buffer. Nothing is allocated or flushed.
pub def copy_all[R: Reader, W: Writer](reader: &mut R, writer: &mut W, scratch: &mut Bytes) -> Result[i64, CopyError]:
    size = scratch.len()
    if size == 0:
        return Err(CopyError.Read(0, StreamError.OutOfRange))
    mut total = 0
    while True:
        outcome = reader.read(scratch, 0, size)
        match outcome:
            case Ok(count):
                if count == 0:
                    return Ok(total)
                if count < 0 or count > size:
                    return Err(CopyError.Read(total, StreamError.InvalidProgress))
                next_total = match displaced(total, count):
                    case Ok(value):
                        value
                    case Err(cause):
                        return Err(CopyError.Read(total, cause))
                match write_all(writer, &scratch[0:count]):
                    case Ok(_):
                        total = next_total
                    case Err(partial):
                        # write_all validates partial.completed <= count; next_total fits.
                        completed = unchecked:
                            total + partial.completed
                        return Err(CopyError.Write(completed, partial.cause))
            case Err(cause):
                if not interrupted(&cause):
                    return Err(CopyError.Read(total, cause))
    Ok(total)

# A fixed-capacity read buffer in front of `inner`. The buffer is allocated
# once and never grows. `inner` is public so its owner can be closed or
# replaced; reading it directly skips bytes still held here.
pub class BufReader[R]:
    pub inner: R
    _buffer: Bytes
    _start: i64
    _stop: i64

    pub def capacity(self) -> i64:
        self._buffer.len()

    pub def buffered(self) -> i64:
        # Private cursors satisfy 0 <= start <= stop <= buffer capacity.
        unchecked:
            self._stop - self._start

    # One inner read into the empty buffer. An error leaves it empty.
    def fill(self: &mut BufReader[R]) -> Result[i64, StreamError]:
        self._start = 0
        self._stop = 0
        size = self._buffer.len()
        count = progressed(self.inner.read(&mut self._buffer, 0, size)?, size)?
        self._stop = count
        Ok(count)

    pub def read(self: &mut BufReader[R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        # Validated destination bounds and progress bound every cursor by its buffer.
        unchecked:
            if not (0 <= start and start <= stop and stop <= buffer.len()):
                __trap("read: start/stop outside buffer")
            if start == stop:
                return Ok(0)
            if self._start == self._stop:
                # A request at least as large as the buffer gains nothing from it.
                if stop - start >= self._buffer.len():
                    return progressed(self.inner.read(buffer, start, stop)?, stop - start)
                if self.fill()? == 0:
                    return Ok(0)
            mut count = stop - start
            if count > self._stop - self._start:
                count = self._stop - self._start
            buffer.overwrite(start, &self._buffer[self._start:self._start + count])
            self._start += count
            Ok(count)

    # Appends to `out` through the first `delimiter`, at most `limit` bytes.
    # Returns the count appended; zero is end of input. A nonzero count whose
    # last byte is not the delimiter means the limit or end of input came first.
    # After an error, `out` keeps the bytes already appended.
    pub def read_until(self: &mut BufReader[R], delimiter: u8, out: &mut Bytes, limit: Positive[i64]) -> Result[i64, StreamError]:
        # The scan clamps each step to most - total and the buffer's validated cursors.
        unchecked:
            most = limit.get()
            mut total = 0
            while total < most:
                if self._start == self._stop:
                    match self.fill():
                        case Ok(count):
                            if count == 0:
                                return Ok(total)
                        case Err(cause):
                            if not interrupted(&cause):
                                return Err(cause)
                else:
                    mut stop = self._stop
                    if stop - self._start > most - total:
                        stop = self._start + (most - total)
                    mut found = False
                    match self._buffer.find(delimiter, self._start, stop):
                        case Some(index):
                            stop = index + 1
                            found = True
                        case Nothing:
                            pass
                    out.extend(&self._buffer[self._start:stop]).map_error(StreamError.Allocation)?
                    total += stop - self._start
                    self._start = stop
                    if found:
                        return Ok(total)
            Ok(total)

pub def buffered_reader[R](inner: R, capacity: Positive[i64]) -> Result[BufReader[R], StreamError]:
    size = capacity.get()
    mut buffer = with_capacity(size).map_error(StreamError.Allocation)?
    buffer.resize(size, 0u8).map_error(StreamError.Allocation)?
    Ok(BufReader(inner, buffer, 0, 0))

# Repositions the inner stream and discards buffered input. A relative target
# is measured from the position the program has consumed up to.
pub def seek_reader[R: Seeker](reader: &mut BufReader[R], target: SeekFrom) -> Result[i64, StreamError]:
    # Private cursors satisfy 0 <= start <= stop <= buffer length.
    held = unchecked:
        reader._stop - reader._start
    mut adjusted = target
    match target:
        case SeekFrom.Current(offset):
            result = checked:
                offset - held
            match result:
                case Ok(position):
                    adjusted = SeekFrom.Current(position)
                case Err(_):
                    return Err(StreamError.OutOfRange)
        case _:
            pass
    position = reader.inner.seek(adjusted)?
    reader._start = 0
    reader._stop = 0
    Ok(position)

# A fixed-capacity write buffer in front of `inner`. Pending bytes never
# exceed the capacity, and nothing reaches `inner` in a different order.
# `inner` is public so its owner can be closed or replaced; flush first.
pub class BufWriter[W]:
    pub inner: W
    _buffer: Bytes
    _start: i64
    _capacity: i64

    pub def capacity(self) -> i64:
        self._capacity

    pub def pending(self) -> i64:
        # The private drain cursor stays in 0..=len(buffer).
        unchecked:
            self._buffer.len() - self._start

    # Delivers every pending byte. A failure keeps the undelivered tail, so a
    # later drain resumes exactly where this one stopped.
    def drain(self: &mut BufWriter[W]) -> Result[(), StreamError]:
        # Positive progress is bounded by the undelivered suffix before advancing.
        unchecked:
            total = self._buffer.len()
            while self._start < total:
                match self.inner.write(&self._buffer[self._start:total]):
                    case Ok(count):
                        if count == 0:
                            return Err(StreamError.WriteZero)
                        if count < 0 or count > total - self._start:
                            return Err(StreamError.InvalidProgress)
                        self._start += count
                    case Err(cause):
                        if not interrupted(&cause):
                            return Err(cause)
            self._buffer.clear()
            self._start = 0
            Ok(())

    pub def write(self: &mut BufWriter[W], source: &[u8]) -> Result[i64, StreamError]:
        # Pending bytes never exceed the fixed capacity; subtraction is nonnegative.
        unchecked:
            count = len(source)
            if count == 0:
                return Ok(0)
            if count > self._capacity - self._buffer.len():
                self.drain()?
            # A write at least as large as the buffer goes straight through.
            if count >= self._capacity:
                return progressed(self.inner.write(source)?, count)
            self._buffer.extend(source).map_error(StreamError.Allocation)?
            Ok(count)

    pub def flush(self: &mut BufWriter[W]) -> Result[(), StreamError]:
        self.drain()?
        self.inner.flush()

pub def buffered_writer[W](inner: W, capacity: Positive[i64]) -> Result[BufWriter[W], StreamError]:
    size = capacity.get()
    Ok(BufWriter(inner, with_capacity(size).map_error(StreamError.Allocation)?, 0, size))

# Delivers pending bytes, then repositions the inner stream.
pub def seek_writer[W: Seeker](writer: &mut BufWriter[W], target: SeekFrom) -> Result[i64, StreamError]:
    writer.drain()?
    writer.inner.seek(target)

# Flushes, then closes the inner stream whether or not the flush succeeded, and
# reports which step failed.
pub def close_buffered[W: Closer](writer: &mut BufWriter[W]) -> Result[(), CloseError]:
    flushed = writer.flush()
    closed = writer.inner.close()
    match flushed:
        case Ok(_):
            match closed:
                case Ok(_):
                    Ok(())
                case Err(cause):
                    Err(CloseError.Close(cause))
        case Err(first):
            match closed:
                case Ok(_):
                    Err(CloseError.Flush(first))
                case Err(second):
                    Err(CloseError.FlushAndClose(first, second))

# An in-memory stream over an owned buffer. Reads stop at the buffer's end;
# writes overwrite in place and extend it at the end.
pub class Cursor:
    pub data: Bytes
    _position: i64

    pub def position(self) -> i64:
        self._position

    pub def remaining(self) -> i64:
        # Position is nonnegative; the branch excludes positions past the data end.
        unchecked:
            if self._position >= self.data.len():
                return 0
            self.data.len() - self._position

    pub def require_end(self) -> Result[(), BinaryError]:
        if self.remaining() > 0:
            return Err(BinaryError.TrailingData(self._position, self.remaining()))
        Ok(())

    def field_end(self, count: i64) -> Result[i64, BinaryError]:
        # count is nonnegative and <= remaining; zero preserves an arbitrary valid seek.
        unchecked:
            if count < 0:
                return Err(BinaryError.OutOfRange)
            if count > self.remaining():
                return Err(BinaryError.Truncated(self._position, count, self.remaining()))
            Ok(self._position + count)

    def prepare_field(self: &mut Cursor, count: i64, max_bytes: i64) -> Result[i64, BinaryError]:
        if max_bytes < 0 or count < 0:
            return Err(BinaryError.OutOfRange)
        result = checked:
            self._position + count
        end = match result:
            case Ok(value):
                value
            case Err(_):
                return Err(BinaryError.OutOfRange)
        if end > max_bytes or self.data.len() > max_bytes:
            return Err(BinaryError.LimitExceeded)
        if end > self.data.len():
            self.data.resize(end, 0u8).map_error(BinaryError.Allocation)?
        Ok(end)

    # This explicit owned copy is capped before allocation; views cannot escape.
    pub def read_bytes(self: &mut Cursor, count: i64, max_bytes: i64 = 1048576) -> Result[Bytes, BinaryError]:
        if count < 0 or max_bytes < 0:
            return Err(BinaryError.OutOfRange)
        if count > max_bytes:
            return Err(BinaryError.LimitExceeded)
        end = self.field_end(count)?
        if count == 0:
            return std.bytes.empty().map_error(BinaryError.Allocation)
        result = std.bytes.from_bytes(&self.data[self._position:end]).map_error(BinaryError.Allocation)?
        self._position = end
        Ok(result)

    pub def write_bytes(self: &mut Cursor, source: &[u8], max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        # An empty write follows Writer: it neither fills a gap nor moves position.
        if len(source) == 0:
            if max_bytes < 0:
                return Err(BinaryError.OutOfRange)
            if self.data.len() > max_bytes:
                return Err(BinaryError.LimitExceeded)
            return Ok(())
        end = self.prepare_field(len(source), max_bytes)?
        self.data.overwrite(self._position, source)
        self._position = end
        Ok(())

    pub def read_u8(self: &mut Cursor) -> Result[u8, BinaryError]:
        end = self.field_end(1)?
        value = u8.wrapping_from(self.data[self._position])
        self._position = end
        Ok(value)

    pub def write_u8(self: &mut Cursor, value: u8, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(1, max_bytes)?
        self.data[self._position] = u8.wrapping_from(value)
        self._position = end
        Ok(())

    pub def read_i8(self: &mut Cursor) -> Result[i8, BinaryError]:
        end = self.field_end(1)?
        value = i8.wrapping_from(self.data[self._position])
        self._position = end
        Ok(value)

    pub def write_i8(self: &mut Cursor, value: i8, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(1, max_bytes)?
        self.data[self._position] = u8.wrapping_from(value)
        self._position = end
        Ok(())

    pub def read_u16(self: &mut Cursor, order: Endian) -> Result[u16, BinaryError]:
        end = self.field_end(2)?
        value = std.encoding.unpack_u16(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_u16(self: &mut Cursor, value: u16, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(2, max_bytes)?
        std.encoding.pack_u16(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_i16(self: &mut Cursor, order: Endian) -> Result[i16, BinaryError]:
        end = self.field_end(2)?
        value = std.encoding.unpack_i16(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_i16(self: &mut Cursor, value: i16, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(2, max_bytes)?
        std.encoding.pack_i16(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_u32(self: &mut Cursor, order: Endian) -> Result[u32, BinaryError]:
        end = self.field_end(4)?
        value = std.encoding.unpack_u32(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_u32(self: &mut Cursor, value: u32, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(4, max_bytes)?
        std.encoding.pack_u32(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_i32(self: &mut Cursor, order: Endian) -> Result[i32, BinaryError]:
        end = self.field_end(4)?
        value = std.encoding.unpack_i32(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_i32(self: &mut Cursor, value: i32, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(4, max_bytes)?
        std.encoding.pack_i32(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_u64(self: &mut Cursor, order: Endian) -> Result[u64, BinaryError]:
        end = self.field_end(8)?
        value = std.encoding.unpack_u64(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_u64(self: &mut Cursor, value: u64, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(8, max_bytes)?
        std.encoding.pack_u64(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_i64(self: &mut Cursor, order: Endian) -> Result[i64, BinaryError]:
        end = self.field_end(8)?
        value = std.encoding.unpack_i64(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_i64(self: &mut Cursor, value: i64, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(8, max_bytes)?
        std.encoding.pack_i64(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_f32(self: &mut Cursor, order: Endian) -> Result[f32, BinaryError]:
        end = self.field_end(4)?
        value = std.encoding.unpack_f32(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_f32(self: &mut Cursor, value: f32, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(4, max_bytes)?
        std.encoding.pack_f32(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read_f64(self: &mut Cursor, order: Endian) -> Result[f64, BinaryError]:
        end = self.field_end(8)?
        value = std.encoding.unpack_f64(&self.data, self._position, order)
        self._position = end
        Ok(value)

    pub def write_f64(self: &mut Cursor, value: f64, order: Endian, max_bytes: i64 = 1048576) -> Result[(), BinaryError]:
        end = self.prepare_field(8, max_bytes)?
        std.encoding.pack_f64(&mut self.data, self._position, value, order)
        self._position = end
        Ok(())

    pub def read(self: &mut Cursor, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        # Validated ranges and min(remaining, offered) bound every cursor update.
        unchecked:
            if not (0 <= start and start <= stop and stop <= buffer.len()):
                __trap("read: start/stop outside buffer")
            size = self.data.len()
            if self._position >= size:
                return Ok(0)
            mut count = stop - start
            if count > size - self._position:
                count = size - self._position
            buffer.overwrite(start, &self.data[self._position:self._position + count])
            self._position += count
            Ok(count)

    pub def write(self: &mut Cursor, source: &[u8]) -> Result[i64, StreamError]:
        count = len(source)
        if count == 0:
            return Ok(0)
        end = displaced(self._position, count)?
        # Reserve the entire extent before changing a seek gap or existing data.
        if end > self.data.len():
            # This branch proves 0 <= len(data) < end <= i64.MAX.
            additional = unchecked:
                end - self.data.len()
            self.data.reserve(additional).map_error(StreamError.Allocation)?
            self.data.resize(end, 0u8).map_error(StreamError.Allocation)?
        self.data.overwrite(self._position, source)
        self._position = end
        Ok(count)

    pub def flush(self: &mut Cursor) -> Result[(), StreamError]:
        Ok(())

    pub def seek(self: &mut Cursor, target: SeekFrom) -> Result[i64, StreamError]:
        match target:
            case SeekFrom.Start(offset):
                self._position = displaced(0, offset)?
            case SeekFrom.Current(offset):
                self._position = displaced(self._position, offset)?
            case SeekFrom.End(offset):
                self._position = displaced(self.data.len(), offset)?
        Ok(self._position)

pub def cursor(data: Bytes) -> Cursor:
    Cursor(data, 0)

# Byte access to an owned file. Positions are byte offsets, not the text
# cookies of File.tell. `file` is public for the remaining File operations.
pub class FileStream:
    pub file: File

    pub def read(self: &mut FileStream, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        if not (0 <= start and start <= stop and stop <= buffer.len()):
            __trap("read: start/stop outside buffer")
        moved(buffer.read_file(&mut self.file, start, stop))

    pub def write(self: &mut FileStream, source: &[u8]) -> Result[i64, StreamError]:
        moved(__io_file_write(source, self.file))

    pub def flush(self: &mut FileStream) -> Result[(), StreamError]:
        finished(self.file.flush())

    pub def sync(self: &mut FileStream) -> Result[(), StreamError]:
        finished(self.file.sync())

    pub def seek(self: &mut FileStream, target: SeekFrom) -> Result[i64, StreamError]:
        match target:
            case SeekFrom.Start(offset):
                if offset < 0:
                    return Err(StreamError.OutOfRange)
                moved(__io_file_seek(self.file, 0u8, offset))
            case SeekFrom.Current(offset):
                moved(__io_file_seek(self.file, 1u8, offset))
            case SeekFrom.End(offset):
                moved(__io_file_seek(self.file, 2u8, offset))

    pub def close(self: &mut FileStream) -> Result[(), StreamError]:
        finished(self.file.close())

pub def open_file(path: &str, mode: &str __open_mode) -> Result[FileStream, StreamError]:
    match open(path, mode):
        case Ok(file):
            Ok(FileStream(file))
        case Err(error):
            Err(classify(error))

# Ordinary file opening without decoding or changing native path bytes.
pub def open_path(path: &Path, mode: &str __open_mode) -> Result[FileStream, StreamError]:
    match __fs_open_file_path(path.as_bytes(), mode):
        case Ok(file):
            Ok(FileStream(file))
        case Err(error):
            Err(classify(error))

pub def from_file(file: File) -> FileStream:
    FileStream(file)

# The process streams. Each adapter is a zero-cost handle: the descriptor
# stays owned by the process and is never closed.
pub class Stdin:
    pub def is_terminal(self) -> bool:
        __io_is_terminal(0u8)

    pub def read(self: &mut Stdin, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        if not (0 <= start and start <= stop and stop <= buffer.len()):
            __trap("read: start/stop outside buffer")
        moved(buffer.read_stdin(start, stop))

pub class Stdout:
    pub def is_terminal(self) -> bool:
        __io_is_terminal(1u8)

    pub def write(self: &mut Stdout, source: &[u8]) -> Result[i64, StreamError]:
        moved(__io_std_write(source, 1u8))

    pub def flush(self: &mut Stdout) -> Result[(), StreamError]:
        finished(flush_stdout())

pub class Stderr:
    pub def is_terminal(self) -> bool:
        __io_is_terminal(2u8)

    pub def write(self: &mut Stderr, source: &[u8]) -> Result[i64, StreamError]:
        moved(__io_std_write(source, 2u8))

    pub def flush(self: &mut Stderr) -> Result[(), StreamError]:
        finished(flush_stderr())

pub def stdin() -> Stdin:
    Stdin()

pub def stdout() -> Stdout:
    Stdout()

pub def stderr() -> Stderr:
    Stderr()
