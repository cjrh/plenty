import std.text
from std.text import TextError

pub def version() -> str:
    return "17.0.0"

# All public classification accepts exactly one scalar, not an arbitrary string.
pub def combining_class(scalar: &strview) -> Option[u32]:
    match ord(scalar):
        case Ok(code):
            Some(__unicode_ccc(code))
        case Err(_):
            Nothing

pub def is_mark(scalar: &strview) -> Option[bool]:
    match ord(scalar):
        case Ok(code):
            Some(__unicode_is_mark(code))
        case Err(_):
            Nothing

def allocated[T](value: Result[T, AllocError]) -> Result[T, TextError]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(error):
            Err(TextError.Allocation(error))

# A caller-selected scalar bound covers input, full decomposition and output.
# Stable insertion ordering follows UAX #15 D109; zero classes are boundaries.
def normalized(text: &strview, limit: i64, compatible: bool, compose: bool) -> Result[str, TextError]:
    # NonNegative public arguments supply limit; the positive constant divisor
    # cannot fail, and the ceiling makes the final UTF-8 multiplication fit.
    ceiling = unchecked:
        i64.MAX // 4
    if limit > ceiling:
        __trap("std.unicode: max_scalars is above i64.MAX // 4")
    if len(text) > limit:
        return Err(TextError.LimitExceeded)
    mut ordered = allocated(list[u32].new())?
    for scalar in text:
        code = ord(scalar).unwrap()
        mut part = 0
        mut value = __unicode_decompose_at(code, compatible, part)
        while value != 1114112u32:
            if len(ordered) == limit:
                return Err(TextError.LimitExceeded)
            allocated(ordered.append(value))?
            class_value = __unicode_ccc(value)
            # append succeeded, so 1 <= len(ordered) <= limit.
            mut index = unchecked:
                len(ordered) - 1
            if class_value != 0u32:
                while index > 0:
                    # index > 0 and within the allocated ordered list.
                    before = unchecked:
                        index - 1
                    previous = __unicode_ccc(ordered[before])
                    if previous == 0u32 or previous <= class_value:
                        break
                    ordered.swap(index, before)
                    index = before
            # Each increment follows an append; part <= len(ordered) <= limit.
            unchecked:
                part += 1
            value = __unicode_decompose_at(code, compatible, part)
    mut result = allocated(list[u32].new())?
    mut starter = -1
    mut previous_class = 0u32
    for code in ordered:
        class_value = __unicode_ccc(code)
        mut combined = 1114112u32
        if compose and starter >= 0 and (previous_class == 0u32 or previous_class < class_value):
            combined = __unicode_compose(result[starter], code)
        if combined != 1114112u32:
            replace(result[starter], combined)
        else:
            if class_value == 0u32:
                starter = len(result)
            allocated(result.append(code))?
            previous_class = class_value
    # The ceiling above keeps the UTF-8 byte bound nonnegative.
    byte_limit = unchecked:
        limit * 4
    mut output = std.text.builder(NonNegative.try_from(byte_limit).unwrap())?
    for code in result:
        scalar = chr(code).unwrap()
        output.append(&scalar)?
    output.finish()

pub def nfd(text: &strview, max_scalars: NonNegative[i64] __max(2305843009213693951)) -> Result[str, TextError]:
    normalized(text, max_scalars.get(), False, False)

pub def nfc(text: &strview, max_scalars: NonNegative[i64] __max(2305843009213693951)) -> Result[str, TextError]:
    normalized(text, max_scalars.get(), False, True)

pub def nfkd(text: &strview, max_scalars: NonNegative[i64] __max(2305843009213693951)) -> Result[str, TextError]:
    normalized(text, max_scalars.get(), True, False)

pub def nfkc(text: &strview, max_scalars: NonNegative[i64] __max(2305843009213693951)) -> Result[str, TextError]:
    normalized(text, max_scalars.get(), True, True)
