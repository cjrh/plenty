import std.bytes
from std.bytes import Bytes, BytesError, ByteSource

# Binary-to-text codecs and fixed-width integer packing over `std.bytes`.
# Everything here is checked Plenty: ranges are validated before reads and
# writes, and an index outside the buffer would trap rather than reach past
# it. Ordinary codecs accept one canonical form; only the explicitly named
# MIME decoder skips ASCII whitespace.
pub enum EncodingError:
    OutOfRange
    InvalidLength
    InvalidByte(i64)
    InvalidPadding(i64)
    NonCanonical(i64)
    InvalidAlphabet
    Allocation(AllocError)

pub enum Endian:
    Little
    Big

# Validated reusable tables. Public construction goes through `custom` so
# symbols are distinct printable ASCII and padding cannot be a symbol.
pub class Encoding:
    _symbols: Bytes
    _values: Bytes
    _bits: i64
    _padding: i64

    pub def encode(self, source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
        encode_radix(source, start, stop, &self._symbols, self._bits, self._padding)

    pub def decode(self, source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
        decode_radix(source, start, stop, &self._values, 0, self._bits, self._padding)

    pub def text(self, source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
        lifted(self.encode(source, start, stop)?.to_text())

    pub def from_text(self, text: &str) -> Result[Bytes, EncodingError]:
        source = lifted(std.bytes.from_text(text))?
        self.decode(&source, 0, source.len())

pub def custom(symbols: &str, padding: Option[u8] = Some(61u8)) -> Result[Encoding, EncodingError]:
    count = len(symbols)
    if count < 2 or count > 64 or count & (count - 1) != 0:
        return Err(EncodingError.InvalidAlphabet)
    alphabet = lifted(std.bytes.from_text(symbols))?
    if alphabet.len() != count:
        return Err(EncodingError.InvalidAlphabet)
    mut pad = -1
    match padding:
        case Some(value):
            pad = i64(value)
            if pad < 33 or pad > 126:
                return Err(EncodingError.InvalidAlphabet)
        case Nothing:
            pass
    mut values = lifted(std.bytes.with_capacity(128))?
    lifted(values.resize(128, 255u8))?
    for index in range(count):
        code = i64(alphabet[index])
        if code < 33 or code > 126 or code == pad:
            return Err(EncodingError.InvalidAlphabet)
        if values[code] != 255u8:
            return Err(EncodingError.InvalidAlphabet)
        values[code] = u8(index)
    mut bits = 1
    while 1 << bits < count:
        bits += 1
    Ok(Encoding(alphabet, values, bits, pad))

pub def base32_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    encode_radix(source, start, stop, b"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", 5, 61)

pub def base32_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    decode_radix(source, start, stop, b"", 1, 5, 61)

pub def base32_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(base32_encode(source, start, stop)?.to_text())

pub def base32_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    base32_decode(&source, 0, source.len())

pub def base32hex_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    encode_radix(source, start, stop, b"0123456789ABCDEFGHIJKLMNOPQRSTUV", 5, 61)

pub def base32hex_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    decode_radix(source, start, stop, b"", 2, 5, 61)

pub def base32hex_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(base32hex_encode(source, start, stop)?.to_text())

pub def base32hex_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    base32hex_decode(&source, 0, source.len())

# MIME's 76-column layout, CRLF between lines, no final line terminator.
pub def base64mime_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    encoded = base64_encode(source, start, stop)?
    mut breaks = 0
    if encoded.len() > 0:
        breaks = (encoded.len() - 1) // 76
    mut wrapped = lifted(std.bytes.with_capacity(encoded.len() + breaks * 2))?
    for index in range(encoded.len()):
        if index > 0 and index % 76 == 0:
            emit(&mut wrapped, 13)?
            emit(&mut wrapped, 10)?
        emit(&mut wrapped, i64(encoded[index]))?
    Ok(wrapped)

# Deliberately narrower than MIME's liberal recovery: skip SP/HT/CR/LF only,
# and retain the strict base64 alphabet, padding and trailing-bit checks.
pub def base64mime_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    mut size = 0
    for index in range(start, stop):
        if not mime_space(source[index]):
            size += 1
    mut compact = lifted(std.bytes.with_capacity(size))?
    for index in range(start, stop):
        if not mime_space(source[index]):
            emit(&mut compact, i64(source[index]))?
    match base64_decode(&compact, 0, compact.len()):
        case Ok(decoded):
            Ok(decoded)
        case Err(error):
            match error:
                case EncodingError.InvalidByte(index):
                    Err(EncodingError.InvalidByte(mime_index(source, start, stop, index)))
                case EncodingError.InvalidPadding(index):
                    Err(EncodingError.InvalidPadding(mime_index(source, start, stop, index)))
                case EncodingError.NonCanonical(index):
                    Err(EncodingError.NonCanonical(mime_index(source, start, stop, index)))
                case _:
                    Err(error)

pub def base64mime_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(base64mime_encode(source, start, stop)?.to_text())

pub def base64mime_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    base64mime_decode(&source, 0, source.len())

def mime_space(code: u8) -> bool:
    code == 32u8 or code == 9u8 or code == 13u8 or code == 10u8

def mime_index(source: &Bytes, start: i64, stop: i64, compact_index: i64) -> i64:
    mut seen = 0
    for index in range(start, stop):
        if not mime_space(source[index]):
            if seen == compact_index:
                return index
            seen += 1
    stop

# The smallest number of symbols encoding a whole number of bytes.
def quantum(bits: i64) -> i64:
    mut count = 1
    while count * bits % 8 != 0:
        count += 1
    count

def encode_radix[S: ByteSource](source: &Bytes, start: i64, stop: i64, symbols: &S, bits: i64, padding: i64) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    count = stop - start
    if count > (i64.MAX - 7) // 8:
        return Err(EncodingError.InvalidLength)
    mut size = (count * 8 + bits - 1) // bits
    if padding >= 0:
        group = quantum(bits)
        size += (group - size % group) % group
    mut encoded = lifted(std.bytes.with_capacity(size))?
    mask = (1 << bits) - 1
    mut pending = 0
    mut available = 0
    for index in range(start, stop):
        pending = pending << 8 | i64(source[index])
        available += 8
        while available >= bits:
            available -= bits
            emit(&mut encoded, i64(symbols[(pending >> available) & mask]))?
        pending = pending & ((1 << available) - 1)
    if available > 0:
        emit(&mut encoded, i64(symbols[(pending << (bits - available)) & mask]))?
    while encoded.len() < size:
        emit(&mut encoded, padding)?
    Ok(encoded)

# Fixed alphabets avoid allocating a lookup table on every call; a custom
# Encoding pays for its 128-byte table once and reuses it.
def radix_value[V: ByteSource](code: i64, values: &V, kind: i64) -> i64:
    if kind == 1:
        if code >= 65 and code <= 90:
            return code - 65
        if code >= 50 and code <= 55:
            return code - 24
    elif kind == 2:
        if code >= 48 and code <= 57:
            return code - 48
        if code >= 65 and code <= 86:
            return code - 55
    elif code < 128:
        value = i64(values[code])
        if value != 255:
            return value
    -1

def decode_radix[V: ByteSource](source: &Bytes, start: i64, stop: i64, values: &V, kind: i64, bits: i64, padding: i64) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    group = quantum(bits)
    if padding >= 0 and (stop - start) % group != 0:
        return Err(EncodingError.InvalidLength)
    mut end = stop
    if padding >= 0:
        while end > start and i64(source[end - 1]) == padding:
            end -= 1
    count = end - start
    # An incomplete byte needs fewer unused bits than one whole symbol.
    trailing = (count % 8) * bits % 8
    if trailing >= bits:
        return Err(EncodingError.InvalidLength)
    if padding >= 0 and stop - end != (group - count % group) % group:
        return Err(EncodingError.InvalidPadding(end))
    size = (count // 8) * bits + (count % 8) * bits // 8
    mut decoded = lifted(std.bytes.with_capacity(size))?
    mut pending = 0
    mut available = 0
    for index in range(start, end):
        code = i64(source[index])
        value = radix_value(code, values, kind)
        if value < 0:
            if code == padding:
                return Err(EncodingError.InvalidPadding(index))
            return Err(EncodingError.InvalidByte(index))
        pending = pending << bits | value
        available += bits
        if available >= 8:
            available -= 8
            emit(&mut decoded, pending >> available)?
            pending = pending & ((1 << available) - 1)
    if pending != 0:
        return Err(EncodingError.NonCanonical(end - 1))
    Ok(decoded)

# Lowercase digits. Sizes below cannot overflow: a buffer large enough to make
# them wrap cannot have been allocated.
pub def hex_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    mut encoded = lifted(std.bytes.with_capacity((stop - start) * 2))?
    for index in range(start, stop):
        value = i64(source[index])
        emit(&mut encoded, hex_digit(value >> 4))?
        emit(&mut encoded, hex_digit(value & 15))?
    Ok(encoded)

# Accepts either digit case; the length must be even.
pub def hex_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    if (stop - start) % 2 != 0:
        return Err(EncodingError.InvalidLength)
    mut decoded = lifted(std.bytes.with_capacity((stop - start) // 2))?
    for pair in range((stop - start) // 2):
        index = start + pair * 2
        high = hex_value(i64(source[index]))
        if high < 0:
            return Err(EncodingError.InvalidByte(index))
        low = hex_value(i64(source[index + 1]))
        if low < 0:
            return Err(EncodingError.InvalidByte(index + 1))
        emit(&mut decoded, high * 16 + low)?
    Ok(decoded)

pub def hex_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(hex_encode(source, start, stop)?.to_text())

pub def hex_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    hex_decode(&source, 0, source.len())

# RFC 4648 section 4: `+` and `/`, always padded with `=` to a multiple of four.
pub def base64_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    encode64(source, start, stop, False)

pub def base64_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    decode64(source, start, stop, False)

pub def base64_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(encode64(source, start, stop, False)?.to_text())

pub def base64_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    decode64(&source, 0, source.len(), False)

# RFC 4648 section 5: `-` and `_`, never padded.
pub def base64url_encode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    encode64(source, start, stop, True)

pub def base64url_decode(source: &Bytes, start: i64, stop: i64) -> Result[Bytes, EncodingError]:
    decode64(source, start, stop, True)

pub def base64url_text(source: &Bytes, start: i64, stop: i64) -> Result[str, EncodingError]:
    lifted(encode64(source, start, stop, True)?.to_text())

pub def base64url_from_text(text: &str) -> Result[Bytes, EncodingError]:
    source = lifted(std.bytes.from_text(text))?
    decode64(&source, 0, source.len(), True)

# `pack_` overwrites existing bytes and never grows the buffer; `append_`
# grows it by exactly the width, or not at all.
pub def pack_u16(target: &mut Bytes, offset: i64, value: u16, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, u64(value), 2, order)

pub def pack_u32(target: &mut Bytes, offset: i64, value: u32, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, u64(value), 4, order)

pub def pack_u64(target: &mut Bytes, offset: i64, value: u64, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, value, 8, order)

# Signed values are stored in two's complement.
pub def pack_i16(target: &mut Bytes, offset: i64, value: i16, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, u64.wrapping_from(value), 2, order)

pub def pack_i32(target: &mut Bytes, offset: i64, value: i32, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, u64.wrapping_from(value), 4, order)

pub def pack_i64(target: &mut Bytes, offset: i64, value: i64, order: Endian) -> Result[(), EncodingError]:
    store(target, offset, u64.wrapping_from(value), 8, order)

pub def append_u16(target: &mut Bytes, value: u16, order: Endian) -> Result[(), EncodingError]:
    grow(target, u64(value), 2, order)

pub def append_u32(target: &mut Bytes, value: u32, order: Endian) -> Result[(), EncodingError]:
    grow(target, u64(value), 4, order)

pub def append_u64(target: &mut Bytes, value: u64, order: Endian) -> Result[(), EncodingError]:
    grow(target, value, 8, order)

pub def append_i16(target: &mut Bytes, value: i16, order: Endian) -> Result[(), EncodingError]:
    grow(target, u64.wrapping_from(value), 2, order)

pub def append_i32(target: &mut Bytes, value: i32, order: Endian) -> Result[(), EncodingError]:
    grow(target, u64.wrapping_from(value), 4, order)

pub def append_i64(target: &mut Bytes, value: i64, order: Endian) -> Result[(), EncodingError]:
    grow(target, u64.wrapping_from(value), 8, order)

pub def unpack_u16(source: &Bytes, offset: i64, order: Endian) -> Result[u16, EncodingError]:
    Ok(u16.wrapping_from(load(source, offset, 2, order)?))

pub def unpack_u32(source: &Bytes, offset: i64, order: Endian) -> Result[u32, EncodingError]:
    Ok(u32.wrapping_from(load(source, offset, 4, order)?))

pub def unpack_u64(source: &Bytes, offset: i64, order: Endian) -> Result[u64, EncodingError]:
    load(source, offset, 8, order)

pub def unpack_i16(source: &Bytes, offset: i64, order: Endian) -> Result[i16, EncodingError]:
    Ok(i16.wrapping_from(load(source, offset, 2, order)?))

pub def unpack_i32(source: &Bytes, offset: i64, order: Endian) -> Result[i32, EncodingError]:
    Ok(i32.wrapping_from(load(source, offset, 4, order)?))

pub def unpack_i64(source: &Bytes, offset: i64, order: Endian) -> Result[i64, EncodingError]:
    Ok(i64.wrapping_from(load(source, offset, 8, order)?))

# The `std.bytes` range rule: 0 <= start <= stop <= count.
def checked(start: i64, stop: i64, count: i64) -> Result[(), EncodingError]:
    if start < 0 or start > stop or stop > count:
        return Err(EncodingError.OutOfRange)
    Ok(())

# Ranges are validated before any `Bytes` call and encoder output is ASCII, so
# only `Allocation` reaches here in practice.
def lifted[T](result: Result[T, BytesError]) -> Result[T, EncodingError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(EncodingError.Allocation(cause))
                case _:
                    Err(EncodingError.OutOfRange)

# Output buffers are created with their exact final capacity, so this never
# allocates.
def emit(target: &mut Bytes, value: i64) -> Result[(), EncodingError]:
    lifted(target.push(u8(value)))

def hex_digit(value: i64) -> i64:
    if value < 10:
        return 48 + value
    87 + value

def hex_value(code: i64) -> i64:
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 97 and code <= 102:
        return code - 87
    if code >= 65 and code <= 70:
        return code - 55
    -1

def symbol(value: i64, url: bool) -> i64:
    if value < 26:
        return 65 + value
    if value < 52:
        return 71 + value
    if value < 62:
        return value - 4
    if value == 62:
        if url:
            return 45
        return 43
    if url:
        return 95
    47

def sextet(code: i64, url: bool) -> i64:
    if code >= 65 and code <= 90:
        return code - 65
    if code >= 97 and code <= 122:
        return code - 71
    if code >= 48 and code <= 57:
        return code + 4
    if url:
        if code == 45:
            return 62
        if code == 95:
            return 63
        return -1
    if code == 43:
        return 62
    if code == 47:
        return 63
    -1

def encode64(source: &Bytes, start: i64, stop: i64, url: bool) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    groups = (stop - start) // 3
    tail = (stop - start) % 3
    mut size = groups * 4
    if tail > 0:
        if url:
            size += tail + 1
        else:
            size += 4
    mut encoded = lifted(std.bytes.with_capacity(size))?
    for group in range(groups):
        index = start + group * 3
        first = i64(source[index])
        second = i64(source[index + 1])
        third = i64(source[index + 2])
        emit(&mut encoded, symbol(first >> 2, url))?
        emit(&mut encoded, symbol((first & 3) << 4 | second >> 4, url))?
        emit(&mut encoded, symbol((second & 15) << 2 | third >> 6, url))?
        emit(&mut encoded, symbol(third & 63, url))?
    if tail > 0:
        index = stop - tail
        first = i64(source[index])
        emit(&mut encoded, symbol(first >> 2, url))?
        if tail == 1:
            emit(&mut encoded, symbol((first & 3) << 4, url))?
        else:
            second = i64(source[index + 1])
            emit(&mut encoded, symbol((first & 3) << 4 | second >> 4, url))?
            emit(&mut encoded, symbol((second & 15) << 2, url))?
        if not url:
            for _ in range(3 - tail):
                emit(&mut encoded, 61)?
    Ok(encoded)

# One symbol, or the error naming its index. `=` is a padding error wherever
# the caller did not already strip it.
def symbol_at(source: &Bytes, index: i64, url: bool) -> Result[i64, EncodingError]:
    code = i64(source[index])
    value = sextet(code, url)
    if value >= 0:
        return Ok(value)
    if code == 61:
        return Err(EncodingError.InvalidPadding(index))
    Err(EncodingError.InvalidByte(index))

def decode64(source: &Bytes, start: i64, stop: i64, url: bool) -> Result[Bytes, EncodingError]:
    checked(start, stop, source.len())?
    mut end = stop
    if url:
        if (stop - start) % 4 == 1:
            return Err(EncodingError.InvalidLength)
    else:
        if (stop - start) % 4 != 0:
            return Err(EncodingError.InvalidLength)
        # At most two trailing `=` are padding. Any other `=` is reported by
        # `symbol_at`.
        if end > start:
            if i64(source[end - 1]) == 61:
                end -= 1
                if i64(source[end - 1]) == 61:
                    end -= 1
    groups = (end - start) // 4
    tail = (end - start) % 4
    mut size = groups * 3
    if tail > 0:
        size += tail - 1
    mut decoded = lifted(std.bytes.with_capacity(size))?
    for group in range(groups):
        index = start + group * 4
        first = symbol_at(source, index, url)?
        second = symbol_at(source, index + 1, url)?
        third = symbol_at(source, index + 2, url)?
        fourth = symbol_at(source, index + 3, url)?
        emit(&mut decoded, first << 2 | second >> 4)?
        emit(&mut decoded, (second & 15) << 4 | third >> 2)?
        emit(&mut decoded, (third & 3) << 6 | fourth)?
    if tail > 0:
        index = end - tail
        first = symbol_at(source, index, url)?
        second = symbol_at(source, index + 1, url)?
        emit(&mut decoded, first << 2 | second >> 4)?
        if tail == 2:
            # Bits that encode no byte must be zero, so each value has one text.
            if second & 15 != 0:
                return Err(EncodingError.NonCanonical(index + 1))
        else:
            third = symbol_at(source, index + 2, url)?
            if third & 3 != 0:
                return Err(EncodingError.NonCanonical(index + 2))
            emit(&mut decoded, (second & 15) << 4 | third >> 2)?
    Ok(decoded)

def big(order: Endian) -> bool:
    match order:
        case Endian.Big:
            True
        case Endian.Little:
            False

def place(target: &mut Bytes, offset: i64, bits: u64, width: i64, order: Endian) -> Result[(), EncodingError]:
    forward = big(order)
    for index in range(width):
        mut shift = index
        if forward:
            shift = width - 1 - index
        target[offset + index] = u8.wrapping_from(bits >> u64(shift * 8))
    Ok(())

def store(target: &mut Bytes, offset: i64, bits: u64, width: i64, order: Endian) -> Result[(), EncodingError]:
    if offset < 0 or offset > target.len() - width:
        return Err(EncodingError.OutOfRange)
    place(target, offset, bits, width, order)

def grow(target: &mut Bytes, bits: u64, width: i64, order: Endian) -> Result[(), EncodingError]:
    offset = target.len()
    lifted(target.resize(offset + width, 0u8))?
    place(target, offset, bits, width, order)

def load(source: &Bytes, offset: i64, width: i64, order: Endian) -> Result[u64, EncodingError]:
    if offset < 0 or offset > source.len() - width:
        return Err(EncodingError.OutOfRange)
    forward = big(order)
    mut bits = 0u64
    for index in range(width):
        mut position = width - 1 - index
        if forward:
            position = index
        bits = bits << 8 | u64(source[offset + position])
    Ok(bits)
