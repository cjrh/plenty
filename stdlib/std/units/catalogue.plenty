# Prefixed units accepted for use with the SI.
pub const microlitre: Quantity[f64, u.Volume] = 1e-9 * (u.m * u.m * u.m)
pub const centilitre: Quantity[f64, u.Volume] = 1e-5 * (u.m * u.m * u.m)
pub const decilitre: Quantity[f64, u.Volume] = 1e-4 * (u.m * u.m * u.m)
pub const hectolitre: Quantity[f64, u.Volume] = 1e-1 * (u.m * u.m * u.m)
pub const kilolitre: Quantity[f64, u.Volume] = u.m * u.m * u.m
pub const megalitre: Quantity[f64, u.Volume] = 1e3 * (u.m * u.m * u.m)
pub const meV: Quantity[f64, u.Energy] = 1e-3 * u.eV
pub const TeV: Quantity[f64, u.Energy] = 1e12 * u.eV
pub const TWh: Quantity[f64, u.Energy] = 1e12 * u.Wh

# Conventional water density for the inch and foot of water (SP 811 B.8 note).
const water_density: Quantity[f64, u.Density] = 1e3 * u.kg / (u.m * u.m * u.m)

# Length.
pub const fermi: Quantity[f64, u.Length] = 1e-15 * u.m
pub const micron: Quantity[f64, u.Length] = 1e-6 * u.m
pub const mil: Quantity[f64, u.Length] = 1e-3 * u.inch
pub const microinch: Quantity[f64, u.Length] = 1e-6 * u.inch
pub const point: Quantity[f64, u.Length] = u.inch / 72.0
pub const pica: Quantity[f64, u.Length] = u.inch / 6.0
pub const printers_point: Quantity[f64, u.Length] = 0.013837 * u.inch
pub const printers_pica: Quantity[f64, u.Length] = 12.0 * printers_point
pub const survey_foot: Quantity[f64, u.Length] = (1200.0 / 3937.0) * u.m
pub const survey_mile: Quantity[f64, u.Length] = 5280.0 * survey_foot
pub const chain: Quantity[f64, u.Length] = 66.0 * survey_foot
pub const rod: Quantity[f64, u.Length] = 16.5 * survey_foot
pub const fathom: Quantity[f64, u.Length] = 6.0 * survey_foot

# Area.
pub const are: Quantity[f64, u.Area] = 1e2 * (u.m * u.m)
pub const barn: Quantity[f64, u.Area] = 1e-28 * (u.m * u.m)
pub const circular_mil: Quantity[f64, u.Area] = (f64.PI / 4.0) * (mil * mil)
pub const survey_acre: Quantity[f64, u.Area] = 43560.0 * (survey_foot * survey_foot)
pub const darcy: Quantity[f64, u.Area] = u.cm * (1e-3 * u.Pa * u.s) * (u.cm * u.cm * u.cm / u.s) / (u.cm * u.cm * u.atm)

# Volume.
pub const stere: Quantity[f64, u.Volume] = u.m * u.m * u.m
pub const acre_foot: Quantity[f64, u.Volume] = survey_acre * survey_foot
pub const barrel: Quantity[f64, u.Volume] = 42.0 * u.gallon
pub const quart: Quantity[f64, u.Volume] = u.gallon / 4.0
pub const pint: Quantity[f64, u.Volume] = u.gallon / 8.0
pub const cup: Quantity[f64, u.Volume] = u.gallon / 16.0
pub const gill: Quantity[f64, u.Volume] = u.gallon / 32.0
pub const fluid_ounce: Quantity[f64, u.Volume] = u.gallon / 128.0
pub const tablespoon: Quantity[f64, u.Volume] = fluid_ounce / 2.0
pub const teaspoon: Quantity[f64, u.Volume] = fluid_ounce / 6.0
pub const bushel: Quantity[f64, u.Volume] = 2150.42 * (u.inch * u.inch * u.inch)
pub const peck: Quantity[f64, u.Volume] = bushel / 4.0
pub const dry_quart: Quantity[f64, u.Volume] = bushel / 32.0
pub const dry_pint: Quantity[f64, u.Volume] = bushel / 64.0
pub const imperial_gallon: Quantity[f64, u.Volume] = 4.54609e-3 * (u.m * u.m * u.m)
pub const imperial_gill: Quantity[f64, u.Volume] = imperial_gallon / 32.0
pub const imperial_fluid_ounce: Quantity[f64, u.Volume] = imperial_gallon / 160.0
pub const cord: Quantity[f64, u.Volume] = 128.0 * (u.foot * u.foot * u.foot)
pub const register_ton: Quantity[f64, u.Volume] = 100.0 * (u.foot * u.foot * u.foot)

# Mass.
pub const carat: Quantity[f64, u.Mass] = 200.0 * u.mg
pub const grain: Quantity[f64, u.Mass] = 64.79891 * u.mg
pub const pennyweight: Quantity[f64, u.Mass] = 24.0 * grain
pub const troy_ounce: Quantity[f64, u.Mass] = 480.0 * grain
pub const troy_pound: Quantity[f64, u.Mass] = 5760.0 * grain
pub const short_hundredweight: Quantity[f64, u.Mass] = 100.0 * u.pound
pub const long_hundredweight: Quantity[f64, u.Mass] = 112.0 * u.pound
pub const short_ton: Quantity[f64, u.Mass] = 2000.0 * u.pound
pub const long_ton: Quantity[f64, u.Mass] = 2240.0 * u.pound
pub const assay_ton: Quantity[f64, u.Mass] = (short_ton / troy_ounce) * u.mg
pub const slug: Quantity[f64, u.Mass] = u.pound_force * u.s * u.s / u.foot

# Time.
pub const shake: Quantity[f64, u.Time] = 1e-8 * u.s
pub const sidereal_day: Quantity[f64, u.Time] = 86164.0905 * u.s
pub const sidereal_hour: Quantity[f64, u.Time] = sidereal_day / 24.0
pub const sidereal_minute: Quantity[f64, u.Time] = sidereal_hour / 60.0
pub const sidereal_second: Quantity[f64, u.Time] = sidereal_minute / 60.0
pub const sidereal_year: Quantity[f64, u.Time] = 365.256363004 * u.day
pub const tropical_year: Quantity[f64, u.Time] = 365.24219 * u.day

# Force.
pub const dyne: Quantity[f64, u.Force] = 1e-5 * u.N
pub const kilogram_force: Quantity[f64, u.Force] = u.kg * u.g_n
pub const ounce_force: Quantity[f64, u.Force] = u.pound_force / 16.0
pub const poundal: Quantity[f64, u.Force] = u.pound * u.foot / (u.s * u.s)
pub const kip: Quantity[f64, u.Force] = 1e3 * u.pound_force
pub const ton_force: Quantity[f64, u.Force] = 2000.0 * u.pound_force

# Pressure.
pub const technical_atmosphere: Quantity[f64, u.Pressure] = kilogram_force / (u.cm * u.cm)
pub const ksi: Quantity[f64, u.Pressure] = 1e3 * u.psi
pub const cmHg: Quantity[f64, u.Pressure] = 10.0 * u.mmHg
pub const inHg: Quantity[f64, u.Pressure] = 25.4 * u.mmHg
pub const ftHg: Quantity[f64, u.Pressure] = 304.8 * u.mmHg
pub const mmH2O: Quantity[f64, u.Pressure] = water_density * u.g_n * u.mm
pub const cmH2O: Quantity[f64, u.Pressure] = water_density * u.g_n * u.cm
pub const inH2O: Quantity[f64, u.Pressure] = water_density * u.g_n * u.inch
pub const ftH2O: Quantity[f64, u.Pressure] = water_density * u.g_n * u.foot

# Energy.
pub const erg: Quantity[f64, u.Energy] = 1e-7 * u.J
pub const calorie_IT: Quantity[f64, u.Energy] = 4.1868 * u.J
pub const kilocalorie_IT: Quantity[f64, u.Energy] = 4186.8 * u.J
pub const btu_th: Quantity[f64, u.Energy] = u.calorie / (u.g * u.K) * u.pound * u.rankine
pub const therm_EC: Quantity[f64, u.Energy] = 1.05506e8 * u.J
pub const therm_US: Quantity[f64, u.Energy] = 1.054804e8 * u.J
pub const quad: Quantity[f64, u.Energy] = 1e15 * u.btu
pub const ton_of_tnt: Quantity[f64, u.Energy] = 4.184e9 * u.J

# Power.
pub const horsepower_electric: Quantity[f64, u.Power] = 746.0 * u.W
pub const horsepower_metric: Quantity[f64, u.Power] = 75.0 * kilogram_force * u.m / u.s
pub const ton_of_refrigeration: Quantity[f64, u.Power] = 12000.0 * u.btu / u.hour

# Viscosity.
pub const poise: Quantity[f64, u.DynamicViscosity] = 0.1 * u.Pa * u.s
pub const centipoise: Quantity[f64, u.DynamicViscosity] = 1e-3 * u.Pa * u.s
pub const rhe: Quantity[f64, One / u.DynamicViscosity] = 1.0 / poise
pub const stokes: Quantity[f64, u.KinematicViscosity] = 1e-4 * (u.m * u.m) / u.s
pub const centistokes: Quantity[f64, u.KinematicViscosity] = 1e-6 * (u.m * u.m) / u.s

# Electricity and magnetism.
pub const ampere_hour: Quantity[f64, u.Charge] = u.A * u.hour
pub const milliampere_hour: Quantity[f64, u.Charge] = u.mA * u.hour
pub const faraday: Quantity[f64, u.Charge] = u.e * u.N_A * u.mol
pub const mho: Quantity[f64, u.Conductance] = u.S
pub const debye: Quantity[f64, ElectricDipoleMoment] = 1e-21 * u.C * u.m * u.m / (u.c * u.s)
pub const gauss: Quantity[f64, u.MagneticFluxDensity] = 1e-4 * u.T
pub const gamma: Quantity[f64, u.MagneticFluxDensity] = 1e-9 * u.T
pub const maxwell: Quantity[f64, u.MagneticFlux] = 1e-8 * u.Wb
pub const oersted: Quantity[f64, MagneticFieldStrength] = (1e3 / (4.0 * f64.PI)) * u.A / u.m

# Radiation.
pub const curie: Quantity[f64, u.Frequency] = 3.7e10 * u.Bq
pub const rad_dose: Quantity[f64, u.SpecificEnergy] = 1e-2 * u.Gy
pub const rem: Quantity[f64, u.SpecificEnergy] = 1e-2 * u.Sv
pub const roentgen: Quantity[f64, Exposure] = 2.58e-4 * u.C / u.kg

# Light.
pub const footcandle: Quantity[f64, u.Illuminance] = u.lm / (u.foot * u.foot)
pub const phot: Quantity[f64, u.Illuminance] = u.lm / (u.cm * u.cm)
pub const stilb: Quantity[f64, Luminance] = u.cd / (u.cm * u.cm)
pub const lambert: Quantity[f64, Luminance] = u.cd / (f64.PI * u.cm * u.cm)
pub const footlambert: Quantity[f64, Luminance] = u.cd / (f64.PI * u.foot * u.foot)

# Angle.
pub const revolution: Quantity[f64, One] = 2.0 * f64.PI * u.rad
pub const gon: Quantity[f64, One] = (f64.PI / 200.0) * u.rad
pub const angular_mil: Quantity[f64, One] = (2.0 * f64.PI / 6400.0) * u.rad

# Other.
pub const gal: Quantity[f64, u.Acceleration] = 1e-2 * u.m / (u.s * u.s)
pub const kayser: Quantity[f64, u.Wavenumber] = 1e2 / u.m
pub const tex: Quantity[f64, LinearDensity] = u.g / u.km
pub const denier: Quantity[f64, LinearDensity] = u.g / (9000.0 * u.m)
