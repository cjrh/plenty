# Every SI prefix on every SI unit, and the other named units of NIST SP 811
# (2008) appendix B. Import it alongside std.units, which declares the
# dimensions; see book/src/design/stdlib/units-catalogue.md.
#
# Each unit is built from its definition, not from SP 811's rounded factor.
# tests/test_std_units.rs checks every one against that factor.
import std.units as u

# Dimensions std.units lacks. Each names a distinct normal form, as the
# aliases in std.units do.
pub dimension LinearDensity = u.Mass / u.Length
pub dimension ElectricDipoleMoment = u.Charge * u.Length
pub dimension MagneticFieldStrength = u.Current / u.Length
pub dimension Exposure = u.Charge / u.Mass
pub dimension Luminance = u.Luminosity / u.Area

# Prefixed SI units: quecto (1e-30) to quetta (1e30). Mass prefixes apply to
# the gram. `attosecond` and `milliohm` replace symbols that cannot be names.
pub const qg: Quantity[f64, u.Mass] = 1e-33 * u.kg
pub const rg: Quantity[f64, u.Mass] = 1e-30 * u.kg
