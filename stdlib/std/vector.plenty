# Three related f64 components with ordered scalar IEEE arithmetic.
# Scalar bodies are the reference; private native lowering is an optimization.

@copy
pub class Vec3:
    pub x: f64
    pub y: f64
    pub z: f64

    pub def __add__(self, other: &Vec3) -> Vec3:
        Vec3(self.x + other.x, self.y + other.y, self.z + other.z)

    pub def __sub__(self, other: &Vec3) -> Vec3:
        Vec3(self.x - other.x, self.y - other.y, self.z - other.z)

    pub def __neg__(self) -> Vec3:
        Vec3(-self.x, -self.y, -self.z)

    pub def __mul__(self, scale: f64) -> Vec3:
        Vec3(self.x * scale, self.y * scale, self.z * scale)

    pub def __rmul__(self, scale: f64) -> Vec3:
        Vec3(scale * self.x, scale * self.y, scale * self.z)

    pub def mul(self, other: &Vec3) -> Vec3:
        Vec3(self.x * other.x, self.y * other.y, self.z * other.z)

    pub def dot(self, other: &Vec3) -> f64:
        (self.x * other.x + self.y * other.y) + self.z * other.z

    pub def length(self) -> f64:
        self.dot(self).sqrt()

    pub def lane(self, index: i64) -> Option[f64]:
        if index == 0:
            return Some(self.x)
        if index == 1:
            return Some(self.y)
        if index == 2:
            return Some(self.z)
        Nothing

    pub def to_tuple(self) -> (f64, f64, f64):
        (self.x, self.y, self.z)
