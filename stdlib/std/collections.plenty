# No child exists in the upper half of a heap. Test this before doubling:
# even for bound == i64.MAX, the returned index is at most bound - 1.
def first_child(parent: i64, bound: i64) -> Option[i64]:
    two: Positive[i64] = 2
    if parent < 0 or parent >= bound // two:
        return Nothing
    unchecked:
        Some(2 * parent + 1)

# Binary heaps over a private list. Sifting exchanges rows with `swap`, so
# elements are never copied or dropped while the heap is reordered.
pub class Heap[T]:
    _items: list[T]

    pub def __init__(self) -> Result[(), AllocError]:
        self._items = list[T].new()?
        Ok(())

    pub def len(self) -> i64:
        len(self._items)

    pub def is_empty(self) -> bool:
        len(self._items) == 0

    pub def reserve(self: &mut Heap[T], additional: i64) -> Result[(), AllocError]:
        self._items.reserve(additional)

    # A copy of the first element, like `dict.get`. Only a copyable `T`
    # type-checks; generic methods are checked when used, so other element
    # types are rejected at the call. There is no `peek_mut`: changing the
    # first element in place could break the heap order.
    pub def peek(self) -> Option[T]:
        if len(self._items) == 0:
            return Nothing
        Some(self._items[0])

    # Borrows the first element; the result borrows the heap until its last use.
    pub def peek_ref(self) -> Option[&T]:
        if len(self._items) == 0:
            return Nothing
        Some(&self._items[0])

    pub def push(self: &mut Heap[T], value: T) -> Result[(), AllocError]:
        self._items.append(value)?
        # append succeeded, so the held list is nonempty.
        mut child = unchecked:
            len(self._items) - 1
        while child > 0:
            # child > 0 bounds the subtraction; the divisor is positive.
            parent = unchecked:
                (child - 1) // 2
            if not (self._items[child] < self._items[parent]):
                break
            self._items.swap(child, parent)
            child = parent
        Ok(())

    pub def pop(self: &mut Heap[T]) -> Option[T]:
        # List lengths are in 0..=i64.MAX; the empty sentinel is -1.
        last = unchecked:
            len(self._items) - 1
        if last < 0:
            return Nothing
        self._items.swap(0, last)
        result = self._items.pop()
        mut parent = 0
        while True:
            mut first = parent
            left = match first_child(parent, last):
                case Some(index):
                    index
                case Nothing:
                    break
            # left < last <= i64.MAX - 1, so the right sentinel fits too.
            right = unchecked:
                left + 1
            if left < last and self._items[left] < self._items[first]:
                first = left
            if right < last and self._items[right] < self._items[first]:
                first = right
            if first == parent:
                break
            self._items.swap(parent, first)
            parent = first
        result

    pub def clear(self: &mut Heap[T]) -> ():
        self._items.clear()

pub class HeapBy[T, F: Callable[[&T, &T], bool]]:
    _items: list[T]
    _before: F

    pub def __init__(self, before: F) -> Result[(), AllocError]:
        self._items = list[T].new()?
        self._before = before
        Ok(())

    pub def len(self) -> i64:
        len(self._items)

    pub def is_empty(self) -> bool:
        len(self._items) == 0

    pub def reserve(self: &mut HeapBy[T, F], additional: i64) -> Result[(), AllocError]:
        self._items.reserve(additional)

    # A copy of the first element, like `dict.get`. Only a copyable `T`
    # type-checks; generic methods are checked when used, so other element
    # types are rejected at the call. There is no `peek_mut`: changing the
    # first element in place could break the heap order.
    pub def peek(self) -> Option[T]:
        if len(self._items) == 0:
            return Nothing
        Some(self._items[0])

    # Borrows the first element; the result borrows the heap until its last use.
    pub def peek_ref(self) -> Option[&T]:
        if len(self._items) == 0:
            return Nothing
        Some(&self._items[0])

    pub def push(self: &mut HeapBy[T, F], value: T) -> Result[(), AllocError]:
        self._items.append(value)?
        # append succeeded, so the held list is nonempty.
        mut child = unchecked:
            len(self._items) - 1
        while child > 0:
            # child > 0 bounds the subtraction; the divisor is positive.
            parent = unchecked:
                (child - 1) // 2
            if not (self._before(&self._items[child], &self._items[parent])):
                break
            self._items.swap(child, parent)
            child = parent
        Ok(())

    pub def pop(self: &mut HeapBy[T, F]) -> Option[T]:
        # List lengths are in 0..=i64.MAX; the empty sentinel is -1.
        last = unchecked:
            len(self._items) - 1
        if last < 0:
            return Nothing
        self._items.swap(0, last)
        result = self._items.pop()
        mut parent = 0
        while True:
            mut first = parent
            left = match first_child(parent, last):
                case Some(index):
                    index
                case Nothing:
                    break
            # left < last <= i64.MAX - 1, so the right sentinel fits too.
            right = unchecked:
                left + 1
            if left < last and self._before(&self._items[left], &self._items[first]):
                first = left
            if right < last and self._before(&self._items[right], &self._items[first]):
                first = right
            if first == parent:
                break
            self._items.swap(parent, first)
            parent = first
        result

    pub def clear(self: &mut HeapBy[T, F]) -> ():
        self._items.clear()

pub def drain[T](heap: Heap[T]) -> Generator[T]:
    mut rest = heap
    while True:
        match rest.pop():
            case Some(value):
                yield value
            case Nothing:
                return

pub def drain_by[T, F: Callable[[&T, &T], bool]](heap: HeapBy[T, F]) -> Generator[T]:
    mut rest = heap
    while True:
        match rest.pop():
            case Some(value):
                yield value
            case Nothing:
                return
