from std.bytes import Bytes, BytesError, with_capacity
from std.io import Writer, StreamError, Cursor, cursor, Stderr, stderr, classify

pub enum FormatError:
    InvalidSpec
    LimitExceeded
    RecursionLimit
    Allocation(AllocError)
    Output(StreamError)
    OutputClosed

# Scratch offsets are computed here, so only allocation can fail; any other
# byte error is a bug in this module and traps.
def stored[T](result: Result[T, BytesError]) -> Result[T, FormatError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(BytesError.Allocation(cause)):
            Err(FormatError.Allocation(cause))
        case Err(error):
            unexpected: Result[FormatError, BytesError] = Err(error)
            Err(unexpected.unwrap())

# Options of one Python format-spec field. Strings hold the spec characters
# themselves; `precision` is -1 when absent. f-strings check them at compile
# time; direct callers get `InvalidSpec` for a combination the type rejects.
pub class Spec:
    pub fill: str
    pub align: str
    pub sign: str
    pub coerce_zero: bool
    pub alternate: bool
    pub zero: bool
    pub width: i64
    pub grouping: str
    pub precision: i64
    pub kind: str

pub def spec(fill: str = " ", align: str = "", sign: str = "", coerce_zero: bool = False, alternate: bool = False, zero: bool = False, width: i64 = 0, grouping: str = "", precision: i64 = -1, kind: str = "") -> Spec:
    Spec(fill, align, sign, coerce_zero, alternate, zero, width, grouping, precision, kind)

# Checks the parts of a spec that an f-string's nested fields supply at run
# time; the rest of the spec was checked when compiling. A fill needs an
# alignment, so a nested value cannot silently change a spec's meaning.
pub def spec_fill(fill: &str, align: &str) -> Result[str, FormatError]:
    if fill == "":
        return Ok(" ")
    if align == "":
        return Err(FormatError.InvalidSpec)
    match ord(fill):
        case Ok(code):
            match chr(code):
                case Ok(scalar):
                    Ok(scalar)
                case Err(_):
                    Err(FormatError.InvalidSpec)
        case Err(_):
            Err(FormatError.InvalidSpec)

pub def spec_align(align: &str) -> Result[str, FormatError]:
    if align == "":
        Ok("")
    elif align == "<":
        Ok("<")
    elif align == ">":
        Ok(">")
    elif align == "^":
        Ok("^")
    elif align == "=":
        Ok("=")
    else:
        Err(FormatError.InvalidSpec)

pub def spec_count(value: i64) -> Result[i64, FormatError]:
    if value < 0 or value > 4096:
        return Err(FormatError.InvalidSpec)
    Ok(value)

def valid_layout(spec: &Spec) -> bool:
    if len(spec.fill) != 1 or spec.width < 0 or spec.width > 4096 or spec.precision < -1 or spec.precision > 4096:
        return False
    if spec.zero and spec.align != "":
        return False
    (spec.align == "" or spec.align == "<" or spec.align == ">" or spec.align == "^" or spec.align == "=") and (spec.sign == "" or spec.sign == "+" or spec.sign == "-" or spec.sign == " ") and (spec.grouping == "" or spec.grouping == "," or spec.grouping == "_")

# Spec-driven numbers are spelled into scratch at this offset, above the bytes
# that single-scalar emission reuses.
const SPELLING: i64 = 8

# Streaming uses caller scratch. Collected text reserves a complete emission
# before touching its cursor; Stderr keeps basic reports allocation-free.
enum Destination:
    Streaming
    Collected
    Stderr

# Scratch is reused; only spec-driven numbers grow it, fallibly, when it is
# shorter than their spelling. Each emission checks the remaining byte
# budget before calling the writer; the successful prefix remains observable.
pub class Formatter[W]:
    pub writer: W
    _scratch: Option[Bytes]
    _destination: Destination
    _failed: bool
    _limit: i64
    _written: i64
    _depth: i64
    _max_depth: i64

    pub def completed(self) -> i64:
        self._written

    pub def has_failed(self) -> bool:
        self._failed

    def emit(self: &mut Formatter[W], count: i64) -> Result[(), FormatError]:
        self.emit_span(0, count)

    def emit_span(self: &mut Formatter[W], begin: i64, end: i64) -> Result[(), FormatError]:
        # Scratch bounds and validated progress bound at; the byte-budget guard bounds written.
        unchecked:
            if self._failed:
                return Err(FormatError.OutputClosed)
            count = end - begin
            if count > self._limit - self._written:
                return Err(FormatError.LimitExceeded)
            mut at = begin
            while at < end:
                mut result: Result[i64, StreamError] = Err(StreamError.InvalidProgress)
                match &self._scratch:
                    case Some(scratch):
                        result = self.writer.write(&scratch[at:end])
                    case Nothing:
                        return Err(FormatError.InvalidSpec)
                match result:
                    case Ok(moved):
                        if moved == 0:
                            self._failed = self._destination == Destination.Stderr
                            return Err(FormatError.Output(StreamError.WriteZero))
                        if moved < 0 or moved > end - at:
                            self._failed = self._destination == Destination.Stderr
                            return Err(FormatError.Output(StreamError.InvalidProgress))
                        at += moved
                        self._written += moved
                    case Err(error):
                        match error:
                            case StreamError.Interrupted:
                                pass
                            case StreamError.Allocation(cause):
                                return Err(FormatError.Allocation(cause))
                            case _:
                                self._failed = self._destination == Destination.Stderr
                                return Err(FormatError.Output(error))
            Ok(())

    def byte(self: &mut Formatter[W], value: u8) -> Result[(), FormatError]:
        self.scratch_set(0, value)
        self.emit(1)

    pub def text(self: &mut Formatter[W], value: &str) -> Result[(), FormatError]:
        # UTF-8 cursors stay within byte_len(); emission stays within limit - written.
        unchecked:
            if self._failed:
                return Err(FormatError.OutputClosed)
            count = value.byte_len()
            if count > self._limit - self._written:
                return Err(FormatError.LimitExceeded)
            # Reports must remain usable while handling allocation failure. Direct
            # stderr text does not construct a byte buffer or encode a second copy.
            if self._destination == Destination.Stderr:
                mut at = 0
                while at < count:
                    match __report_write(value, at):
                        case Ok(moved):
                            if moved == 0:
                                self._failed = True
                                return Err(FormatError.Output(StreamError.WriteZero))
                            at += moved
                            self._written += moved
                        case Err(error):
                            match classify(error):
                                case StreamError.Interrupted:
                                    pass
                                case _ as failure:
                                    self._failed = True
                                    return Err(FormatError.Output(failure))
                return Ok(())
            self.ensure_scratch(count if self._destination == Destination.Collected else 4)?
            mut offset = 0
            for scalar in value:
                code = ord(scalar).unwrap()
                if code < 128u32:
                    self.scratch_set(offset, u8(code))
                    offset += 1
                elif code < 2048u32:
                    self.scratch_set(offset, u8(192u32 + code // 64u32))
                    self.scratch_set(offset + 1, u8(128u32 + code % 64u32))
                    offset += 2
                elif code < 65536u32:
                    self.scratch_set(offset, u8(224u32 + code // 4096u32))
                    self.scratch_set(offset + 1, u8(128u32 + code // 64u32 % 64u32))
                    self.scratch_set(offset + 2, u8(128u32 + code % 64u32))
                    offset += 3
                else:
                    self.scratch_set(offset, u8(240u32 + code // 262144u32))
                    self.scratch_set(offset + 1, u8(128u32 + code // 4096u32 % 64u32))
                    self.scratch_set(offset + 2, u8(128u32 + code // 64u32 % 64u32))
                    self.scratch_set(offset + 3, u8(128u32 + code % 64u32))
                    offset += 4
                if self._destination != Destination.Collected:
                    self.emit(offset)?
                    offset = 0
            if self._destination == Destination.Collected:
                self.emit(offset)?
            Ok(())

    # The text of a borrowed substring, `&s[a:b]`, written without a copy.
    pub def substr(self: &mut Formatter[W], value: &strview) -> Result[(), FormatError]:
        for scalar in value:
            self.text(&scalar)?
        Ok(())

    pub def boolean(self: &mut Formatter[W], value: bool) -> Result[(), FormatError]:
        if value:
            self.text("True")
        else:
            self.text("False")

    pub def floating(self: &mut Formatter[W], value: f64, width: NonNegative[i64]) -> Result[(), FormatError]:
        # The native spelling is <= 32 bytes; nonnegative width minus size fits i64.
        unchecked:
            columns = width.get()
            self.ensure_scratch(32)?
            size = self.scratch_float(value)
            if size < 0:
                return Err(FormatError.InvalidSpec)
            mut padding = columns - size
            while padding > 0:
                self.text(" ")?
                padding -= 1
            # Padding reuses byte zero, so restore the spelling before emission.
            if columns > size:
                drop(self.scratch_float(value))
            self.emit(size)

    # Numeric width includes a minus sign and counts ASCII bytes. Bases are
    # explicit; there is no format-string parser or implicit prefix.
    pub def unsigned(self: &mut Formatter[W], value: u64, base: i64, width: NonNegative[i64] = 0) -> Result[(), FormatError]:
        # radix is 2/8/10/16; the quotient guard proves divisor * radix <= value.
        unchecked:
            if base != 2 and base != 8 and base != 10 and base != 16:
                return Err(FormatError.InvalidSpec)
            mut divisor = 1u64
            mut digits = 1
            radix = u64(base)
            while value // divisor >= radix:
                divisor *= radix
                digits += 1
            mut padding = width.get() - digits
            while padding > 0:
                self.text(" ")?
                padding -= 1
            mut remaining = value
            while divisor > 0u64:
                self.text(&digit(remaining // divisor))?
                remaining %= divisor
                divisor //= radix
            Ok(())

    pub def integer(self: &mut Formatter[W], value: i64, width: NonNegative[i64] = 0) -> Result[(), FormatError]:
        # The minimum's magnitude uses -(value + 1) then unsigned +1; digits <= 21.
        unchecked:
            mut magnitude = 0u64
            if value < 0:
                magnitude = u64(-(value + 1)) + 1u64
            else:
                magnitude = u64(value)
            mut digits = 1
            mut rest = magnitude
            while rest >= 10u64:
                digits += 1
                rest //= 10u64
            if value < 0:
                digits += 1
            mut padding = width.get() - digits
            while padding > 0:
                self.text(" ")?
                padding -= 1
            if value < 0:
                self.text("-")?
            self.unsigned(magnitude, 10, 0)

    pub def debug_text(self: &mut Formatter[W], value: &str) -> Result[(), FormatError]:
        self.text("\"")?
        for scalar in value:
            self.debug_scalar(&scalar)?
        self.text("\"")

    # `debug_text` for a borrowed substring.
    pub def debug_substr(self: &mut Formatter[W], value: &strview) -> Result[(), FormatError]:
        self.text("\"")?
        for scalar in value:
            self.debug_scalar(&scalar)?
        self.text("\"")

    def debug_scalar(self: &mut Formatter[W], scalar: &str) -> Result[(), FormatError]:
        if scalar == "\"":
            self.text("\\\"")
        elif scalar == "\\":
            self.text("\\\\")
        elif scalar == "\n":
            self.text("\\n")
        elif scalar == "\r":
            self.text("\\r")
        elif scalar == "\t":
            self.text("\\t")
        else:
            code = ord(scalar).unwrap()
            if code < 32u32 or (code >= 127u32 and code <= 159u32):
                self.text("\\u{")?
                self.unsigned(u64(code), 16, 0)?
                self.text("}")
            else:
                self.text(scalar)

    # `!a`: the text with every non-ASCII scalar spelled `\u{hex}`, as
    # `debug_text` spells controls.
    pub def ascii_text(self: &mut Formatter[W], value: &str) -> Result[(), FormatError]:
        for scalar in value:
            code = ord(scalar).unwrap()
            if code < 128u32:
                self.text(scalar)?
            else:
                self.text("\\u{")?
                self.unsigned(u64(code), 16, 0)?
                self.text("}")?
        Ok(())

    # Type `c`: the scalar with code point `code`, laid out like a number
    # (default right; `0` pads with zeros) without sign, `#`, grouping, or
    # precision. A value that is not a Unicode scalar is `InvalidSpec`.
    pub def char_spec(self: &mut Formatter[W], code: i64, spec: &Spec) -> Result[(), FormatError]:
        # Validated width is 0..4096, so every padding calculation is within -1..4096.
        unchecked:
            if not valid_layout(spec) or spec.sign != "" or spec.coerce_zero or spec.alternate or spec.grouping != "" or spec.precision != -1 or spec.kind != "c":
                return Err(FormatError.InvalidSpec)
            if code < 0 or code > 1114111:
                return Err(FormatError.InvalidSpec)
            match chr(u32(code)):
                case Ok(value):
                    padding = spec.width - 1
                    if spec.zero:
                        self.repeat_fill("0", padding)?
                        return self.text(&value)
                    mut before = padding
                    if spec.align == "<":
                        before = 0
                    elif spec.align == "^":
                        before = padding // 2
                    self.repeat_fill(&spec.fill, before)?
                    self.text(&value)?
                    self.repeat_fill(&spec.fill, padding - before)
                case Err(_):
                    Err(FormatError.InvalidSpec)

    def ensure_scratch(self: &mut Formatter[W], size: i64) -> Result[(), FormatError]:
        match &mut self._scratch:
            case Some(scratch):
                if scratch.len() < size:
                    scratch.resize(size, 0u8).map_error(FormatError.Allocation)?
                return Ok(())
            case Nothing:
                pass
        mut scratch = with_capacity(size).map_error(FormatError.Allocation)?
        scratch.resize(size, 0u8).map_error(FormatError.Allocation)?
        self._scratch = Some(scratch)
        Ok(())

    # The scratch buffer is reserved before any spelling uses it, so Nothing
    # here is a std defect.
    def scratch_set(self: &mut Formatter[W], at: i64, value: u8) -> ():
        match &mut self._scratch:
            case Some(scratch):
                scratch.set(at, value)
            case Nothing:
                __trap("Formatter: scratch buffer used before it was reserved")

    def scratch_get(self, at: i64) -> u8:
        match &self._scratch:
            case Some(scratch):
                scratch.get(at)
            case Nothing:
                __trap("Formatter: scratch buffer used before it was reserved")

    def scratch_float(self: &mut Formatter[W], value: f64) -> i64:
        match &mut self._scratch:
            case Some(scratch):
                scratch.write_float(value)
            case Nothing:
                __trap("Formatter: scratch buffer used before it was reserved")

    def scratch_float_spec(self: &mut Formatter[W], value: f64, style: i64, precision: i64, offset: i64) -> i64:
        match &mut self._scratch:
            case Some(scratch):
                scratch.write_float_spec(value, style, precision, offset)
            case Nothing:
                __trap("Formatter: scratch buffer used before it was reserved")

    def repeat_fill(self: &mut Formatter[W], fill: &str, count: i64) -> Result[(), FormatError]:
        # Only positive left values are decremented; a negative padding emits nothing.
        unchecked:
            mut left = count
            while left > 0:
                self.text(fill)?
                left -= 1
            Ok(())

    # Text options: fill, alignment (default left), width and precision, which
    # truncates. Both count Unicode scalars.
    pub def text_spec(self: &mut Formatter[W], value: &str, spec: &Spec) -> Result[(), FormatError]:
        # width <= 4096 and shown <= len(value); counters and signed padding fit i64.
        unchecked:
            if not valid_layout(spec) or spec.align == "=" or spec.sign != "" or spec.coerce_zero or spec.alternate or spec.zero or spec.grouping != "" or (spec.kind != "" and spec.kind != "s"):
                return Err(FormatError.InvalidSpec)
            mut shown = len(value)
            if spec.precision >= 0 and spec.precision < shown:
                shown = spec.precision
            padding = spec.width - shown
            mut before = 0
            if spec.align == ">":
                before = padding
            elif spec.align == "^":
                before = padding // 2
            self.repeat_fill(&spec.fill, before)?
            if shown == len(value):
                self.text(value)?
            else:
                mut taken = 0
                for scalar in value:
                    if taken == shown:
                        break
                    self.text(scalar)?
                    taken += 1
            self.repeat_fill(&spec.fill, padding - before)

    # `text_spec` for a borrowed substring.
    pub def substr_spec(self: &mut Formatter[W], value: &strview, spec: &Spec) -> Result[(), FormatError]:
        # width <= 4096 and shown <= len(value); counters and signed padding fit i64.
        unchecked:
            if not valid_layout(spec) or spec.align == "=" or spec.sign != "" or spec.coerce_zero or spec.alternate or spec.zero or spec.grouping != "" or (spec.kind != "" and spec.kind != "s"):
                return Err(FormatError.InvalidSpec)
            mut shown = len(value)
            if spec.precision >= 0 and spec.precision < shown:
                shown = spec.precision
            padding = spec.width - shown
            mut before = 0
            if spec.align == ">":
                before = padding
            elif spec.align == "^":
                before = padding // 2
            self.repeat_fill(&spec.fill, before)?
            if shown == len(value):
                self.substr(value)?
            else:
                mut taken = 0
                for scalar in value:
                    if taken == shown:
                        break
                    self.text(&scalar)?
                    taken += 1
            self.repeat_fill(&spec.fill, padding - before)

    # Integer options: types d, x, X, o, b; `#` prefixes; `,` (decimal only)
    # or `_` grouping; sign; `0` sign-aware zero padding. Default right-aligned.
    pub def signed_spec(self: &mut Formatter[W], value: i64, spec: &Spec) -> Result[(), FormatError]:
        # For negative values, -(value + 1) fits i64 and unsigned magnitude <= 2**63.
        unchecked:
            if value < 0:
                return self.whole(u64(-(value + 1)) + 1u64, True, spec)
            self.whole(u64(value), False, spec)

    pub def unsigned_spec(self: &mut Formatter[W], value: u64, spec: &Spec) -> Result[(), FormatError]:
        self.whole(value, False, spec)

    def whole(self: &mut Formatter[W], magnitude: u64, negative: bool, spec: &Spec) -> Result[(), FormatError]:
        # Radix is 2/8/10/16; at most 64 digits fit scratch and ASCII sums fit u8.
        unchecked:
            if not valid_layout(spec) or spec.precision != -1 or spec.coerce_zero:
                return Err(FormatError.InvalidSpec)
            if spec.kind == "n" and spec.grouping != "":
                return Err(FormatError.InvalidSpec)
            mut base = 10
            mut prefix = ""
            mut letters = 87u8
            if spec.kind == "x" or spec.kind == "X":
                base = 16
                prefix = "0x"
                if spec.kind == "X":
                    prefix = "0X"
                    letters = 55u8
            elif spec.kind == "o":
                base = 8
                prefix = "0o"
            elif spec.kind == "b":
                base = 2
                prefix = "0b"
            elif spec.kind != "" and spec.kind != "d" and spec.kind != "n":
                return Err(FormatError.InvalidSpec)
            if base != 10 and spec.grouping == ",":
                return Err(FormatError.InvalidSpec)
            if not spec.alternate:
                prefix = ""
            radix = u64(base)
            mut digits = 1
            mut rest = magnitude
            while rest >= radix:
                rest //= radix
                digits += 1
            self.ensure_scratch(SPELLING + digits)?
            mut at = SPELLING + digits
            rest = magnitude
            while at > SPELLING:
                at -= 1
                digit = u8(rest % radix)
                if digit >= 10u8:
                    self.scratch_set(at, letters + digit)
                else:
                    self.scratch_set(at, 48u8 + digit)
                rest //= radix
            mut group = 3
            if base != 10:
                group = 4
            self.number(negative, prefix, SPELLING + digits, SPELLING + digits, "", group, spec)

    # Float options: types e, E, f, F, g, G, % and none; precision (default 6
    # for typed fields); `#`; `,` or `_` grouping of the integer digits; sign;
    # `0` zero padding. Without type or precision the spelling is `print`'s.
    pub def float_spec(self: &mut Formatter[W], value: f64, spec: &Spec) -> Result[(), FormatError]:
        self.real(value, 5, spec)

    pub def float32_spec(self: &mut Formatter[W], value: f32, spec: &Spec) -> Result[(), FormatError]:
        self.real(f64(value), 6, spec)

    def real(self: &mut Formatter[W], value: f64, display: i64, spec: &Spec) -> Result[(), FormatError]:
        # Native spelling size is bounded by precision <= 4096 and binary64's exponent range.
        unchecked:
            if not valid_layout(spec):
                return Err(FormatError.InvalidSpec)
            mut precision = spec.precision
            if precision < 0:
                precision = 6
            mut style = 1
            mut scaled = value
            mut suffix = ""
            kind = spec.kind
            if kind == "":
                if spec.precision < 0:
                    style = display
                    precision = 0
                else:
                    style = 4
            elif kind == "e" or kind == "E":
                style = 2
            elif kind == "g" or kind == "G" or kind == "n":
                if kind == "n" and spec.grouping != "":
                    return Err(FormatError.InvalidSpec)
                style = 3
            elif kind == "%":
                scaled = value * 100.0
                suffix = "%"
            elif kind != "f" and kind != "F":
                return Err(FormatError.InvalidSpec)
            if spec.alternate:
                style += 16
            self.ensure_scratch(32)?
            mut size = self.scratch_float_spec(scaled, style, precision, SPELLING)
            if size < 0:
                self.ensure_scratch(-size)?
                size = self.scratch_float_spec(scaled, style, precision, SPELLING)
            end = SPELLING + size
            if kind == "E" or kind == "F" or kind == "G":
                mut at = SPELLING
                while at < end:
                    code = self.scratch_get(at)
                    if code >= 97u8 and code <= 122u8:
                        self.scratch_set(at, code - 32u8)
                    at += 1
            negative = self.scratch_get(SPELLING) == 45u8
            mut start = SPELLING
            if negative:
                start += 1
            # `z`: a spelling whose digits before any exponent are all zero, such
            # as `-0.00`, loses its sign. `-inf` has no digits and keeps it.
            mut signed = negative
            if negative and spec.coerce_zero:
                mut digits = 0
                mut nonzero = False
                mut at = start
                while at < end:
                    code = self.scratch_get(at)
                    if code == 101u8 or code == 69u8:
                        break
                    if code >= 48u8 and code <= 57u8:
                        digits += 1
                        if code != 48u8:
                            nonzero = True
                    at += 1
                signed = digits == 0 or nonzero
            mut digits_end = start
            while digits_end < end:
                code = self.scratch_get(digits_end)
                if code < 48u8 or code > 57u8:
                    break
                digits_end += 1
            # The sign is emitted separately, so shift the spelling past it.
            if negative:
                mut at = SPELLING
                while at + 1 < end:
                    self.scratch_set(at, self.scratch_get(at + 1))
                    at += 1
                return self.number(signed, "", digits_end - 1, end - 1, suffix, 3, spec)
            self.number(False, "", digits_end, end, suffix, 3, spec)

    # Lays out an unsigned spelling held in scratch: integer digits from
    # SPELLING to `digits_end`, then the rest of the spelling to `end`.
    def number(self: &mut Formatter[W], negative: bool, prefix: &str, digits_end: i64, end: i64, suffix: &str, group: i64, spec: &Spec) -> Result[(), FormatError]:
        # Private spellings are bounded; width <= 4096 and grouping divisors are 3 or 4.
        unchecked:
            mut sign = ""
            if negative:
                sign = "-"
            elif spec.sign == "+" or spec.sign == " ":
                sign = spec.sign
            digits = digits_end - SPELLING
            mut zeros = 0
            mut separator_every = 0
            if spec.grouping != "":
                separator_every = group
            fixed = len(sign) + len(prefix) + end - digits_end + len(suffix)
            mut padding = spec.width - fixed - grouped(digits, separator_every)
            if spec.zero:
                while padding > 0:
                    zeros += 1
                    padding = spec.width - fixed - grouped(digits + zeros, separator_every)
                padding = 0
            mut before = padding
            if spec.align == "<" or spec.align == "=":
                before = 0
            elif spec.align == "^":
                before = padding // 2
            self.repeat_fill(&spec.fill, before)?
            self.text(sign)?
            self.text(prefix)?
            if spec.align == "=":
                self.repeat_fill(&spec.fill, padding)?
            total = digits + zeros
            mut index = 0
            while index < total:
                # One run of positions up to the next separator.
                mut stop = total
                if separator_every != 0:
                    stop = index + 1
                    while (total - stop) % separator_every != 0:
                        stop += 1
                while index < stop and index < zeros:
                    self.byte(48u8)?
                    index += 1
                if index < stop:
                    self.emit_span(SPELLING + index - zeros, SPELLING + stop - zeros)?
                    index = stop
                if index < total:
                    self.text(&spec.grouping)?
            self.emit_span(digits_end, end)?
            self.text(suffix)?
            if spec.align != "=":
                self.repeat_fill(&spec.fill, padding - before)?
            Ok(())

    pub def enter(self: &mut Formatter[W]) -> Result[(), FormatError]:
        # The private depth starts at zero and is capped at the validated maximum <= 64.
        unchecked:
            if self._depth >= self._max_depth:
                return Err(FormatError.RecursionLimit)
            self._depth += 1
            Ok(())

    pub def leave(self: &mut Formatter[W]) -> ():
        # Only strictly positive depths are decremented.
        unchecked:
            if self._depth > 0:
                self._depth -= 1

def grouped(digits: i64, every: i64) -> i64:
    # Private digit counts are spelling/width bounded; every is 0, 3 or 4.
    unchecked:
        if every == 0 or digits == 0:
            return digits
        digits + (digits - 1) // every

# Nested display and debug calls recurse, so depth stays within the native stack.
const depth_ceiling: i64 = 64

# Construction only borrows writer requirements; no stream is flushed or closed.
pub def formatter[W: Writer](writer: W, scratch: Bytes, max_bytes: NonNegative[i64], max_depth: NonNegative[i64] __max(64)) -> Result[Formatter[W], FormatError]:
    if scratch.len() < 32:
        __trap("std.fmt.formatter: scratch is shorter than 32 bytes")
    if max_depth.get() > depth_ceiling:
        __trap("std.fmt.formatter: max_depth is above 64")
    Ok(Formatter(writer, Some(scratch), Destination.Streaming, False, max_bytes.get(), 0, 0, max_depth.get()))

# Text, booleans and integers use a direct, allocation-free stderr path.
# Advanced numeric formatting acquires scratch lazily and remains fallible.
pub def stderr_formatter(max_bytes: NonNegative[i64], max_depth: NonNegative[i64] __max(64)) -> Result[Formatter[Stderr], FormatError]:
    if max_depth.get() > depth_ceiling:
        __trap("std.fmt.stderr_formatter: max_depth is above 64")
    Ok(Formatter(stderr(), Nothing, Destination.Stderr, False, max_bytes.get(), 0, 0, max_depth.get()))

pub def string_formatter(max_bytes: NonNegative[i64], max_depth: NonNegative[i64] __max(64)) -> Result[Formatter[Cursor], FormatError]:
    if max_depth.get() > depth_ceiling:
        __trap("std.fmt.string_formatter: max_depth is above 64")
    mut scratch = with_capacity(32).map_error(FormatError.Allocation)?
    scratch.resize(32, 0u8).map_error(FormatError.Allocation)?
    Ok(Formatter(cursor(with_capacity(0).map_error(FormatError.Allocation)?), Some(scratch), Destination.Collected, False, max_bytes.get(), 0, 0, max_depth.get()))

pub def finish(output: &Formatter[Cursor]) -> Result[str, FormatError]:
    stored(output.writer.data.to_text())

# Contracts are checked at each concrete call. A user method may itself be
# generic in W. Reports use the same writer-generic shape through Formattable.
pub def display[T, W](value: &T, output: &mut Formatter[W]) -> Result[(), FormatError]:
    output.enter()?
    result = value.display(output)
    output.leave()
    result

pub def debug[T, W](value: &T, output: &mut Formatter[W]) -> Result[(), FormatError]:
    output.enter()?
    result = value.debug(output)
    output.leave()
    result

pub def to_string[T](value: &T, max_bytes: NonNegative[i64], max_depth: NonNegative[i64] __max(64)) -> Result[str, FormatError]:
    mut output = string_formatter(max_bytes, max_depth)?
    display(value, &mut output)?
    finish(&output)

pub def to_debug[T](value: &T, max_bytes: NonNegative[i64], max_depth: NonNegative[i64] __max(64)) -> Result[str, FormatError]:
    mut output = string_formatter(max_bytes, max_depth)?
    debug(value, &mut output)?
    finish(&output)

# Writes the `str.repr` spelling, which `print` also uses for aggregates.
# A value whose spelling runs a `debug` method uses `repr_text`.
pub def represent[T, W](value: &T, output: &mut Formatter[W]) -> Result[(), FormatError]:
    match str.repr(value):
        case Ok(text):
            output.text(&text)
        case Err(error):
            Err(FormatError.Allocation(error))

pub def repr_string[T](value: &T) -> Result[str, FormatError]:
    match str.repr(value):
        case Ok(text):
            Ok(text)
        case Err(error):
            Err(FormatError.Allocation(error))

# The same spellings for a slice view, which a `&T` parameter cannot take:
# a `&[u8]` as a `bytes` literal, any other view as a list.
pub def represent_view[T, W](value: &[T], output: &mut Formatter[W]) -> Result[(), FormatError]:
    match str.repr(value):
        case Ok(text):
            output.text(&text)
        case Err(error):
            Err(FormatError.Allocation(error))

pub def repr_view_string[T](value: &[T]) -> Result[str, FormatError]:
    match str.repr(value):
        case Ok(text):
            Ok(text)
        case Err(error):
            Err(FormatError.Allocation(error))

# The `str.repr` result of a value whose spelling runs a `debug` method,
# which can fail with that method's error. The compiler calls `str.repr` at
# the f-string's site, so a private type's method is reachable.
pub def repr_text[W](spelled: Result[str, AllocError | FormatError], output: &mut Formatter[W]) -> Result[(), FormatError]:
    text = repr_result(spelled)?
    output.text(&text)

pub def repr_result(spelled: Result[str, AllocError | FormatError]) -> Result[str, FormatError]:
    match spelled:
        case Ok(text):
            Ok(text)
        case Err(error):
            match error:
                case cause: AllocError:
                    Err(FormatError.Allocation(cause))
                case cause: FormatError:
                    Err(cause)

# An f-string's result. With only built-in spellings and static specs,
# allocation is the only failure, so another error is a compiler bug and
# traps.
pub def allocation_only(built: Result[str, FormatError]) -> Result[str, AllocError]:
    match built:
        case Ok(text):
            Ok(text)
        case Err(FormatError.Allocation(cause)):
            Err(cause)
        case Err(error):
            unexpected: Result[AllocError, FormatError] = Err(error)
            Err(unexpected.unwrap())

pub def allocation_or_format(built: Result[str, FormatError]) -> Result[str, AllocError | FormatError]:
    match built:
        case Ok(text):
            Ok(text)
        case Err(FormatError.Allocation(cause)):
            Err(cause)
        case Err(error):
            Err(error)

pub def debug_string(value: &str) -> Result[str, FormatError]:
    mut output = string_formatter(9223372036854775807, 0)?
    output.debug_text(value)?
    finish(&output)

pub def repr_substr_string(value: &strview) -> Result[str, FormatError]:
    mut output = string_formatter(9223372036854775807, 0)?
    output.debug_substr(value)?
    finish(&output)

pub def ascii_string(value: &str) -> Result[str, FormatError]:
    mut output = string_formatter(9223372036854775807, 0)?
    output.ascii_text(value)?
    finish(&output)

def list_body[T, W, F: Callable[[&T, &mut Formatter[W]], Result[(), FormatError]]](values: &list[T], output: &mut Formatter[W], render: F) -> Result[(), FormatError]:
    output.text("[")?
    mut first = True
    for value in values:
        if not first:
            output.text(", ")?
        render(value, output)?
        first = False
    output.text("]")

pub def list_with[T, W, F: Callable[[&T, &mut Formatter[W]], Result[(), FormatError]]](values: &list[T], output: &mut Formatter[W], render: F) -> Result[(), FormatError]:
    output.enter()?
    result = list_body(values, output, render)
    output.leave()
    result

def pair_body[A, B, W, F: Callable[[&A, &mut Formatter[W]], Result[(), FormatError]], G: Callable[[&B, &mut Formatter[W]], Result[(), FormatError]]](value: &(A, B), output: &mut Formatter[W], first: F, second: G) -> Result[(), FormatError]:
    output.text("(")?
    first(&value[0], output)?
    output.text(", ")?
    second(&value[1], output)?
    output.text(")")

pub def pair_with[A, B, W, F: Callable[[&A, &mut Formatter[W]], Result[(), FormatError]], G: Callable[[&B, &mut Formatter[W]], Result[(), FormatError]]](value: &(A, B), output: &mut Formatter[W], first: F, second: G) -> Result[(), FormatError]:
    output.enter()?
    result = pair_body(value, output, first, second)
    output.leave()
    result

def digit(value: u64) -> str:
    match value:
        case 0u64:
            "0"
        case 1u64:
            "1"
        case 2u64:
            "2"
        case 3u64:
            "3"
        case 4u64:
            "4"
        case 5u64:
            "5"
        case 6u64:
            "6"
        case 7u64:
            "7"
        case 8u64:
            "8"
        case 9u64:
            "9"
        case 10u64:
            "a"
        case 11u64:
            "b"
        case 12u64:
            "c"
        case 13u64:
            "d"
        case 14u64:
            "e"
        case _:
            "f"

pub protocol Formattable:
    def format[W](self, output: &mut Formatter[W]) -> Result[(), FormatError]:
        pass

# Ownership stays here so formatting failure never replaces the original error
# or skips its ordinary destruction. The scalar stderr path never allocates.
def entry_report[T: Formattable](value: T) -> i32:
    drop(flush_stdout())
    mut output = stderr_formatter(16384, 64).unwrap()
    result = entry_record(&value, &mut output)
    match result:
        case Ok(_):
            pass
        case Err(_):
            if not output.has_failed():
                mut fallback = stderr_formatter(22, 0).unwrap()
                drop(fallback.text(" [report unavailable]\n"))
    1i32

def entry_record[T: Formattable](value: &T, output: &mut Formatter[Stderr]) -> Result[(), FormatError]:
    output.text("error: main returned ")?
    output.enter()?
    result = value.format(output)
    output.leave()
    result?
    output.text("\n")
