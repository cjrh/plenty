# Reads of the process environment and working directory. Names, values and
# directories are the exact native bytes; text conversion is explicit. The one
# mutation is set_current_dir, which changes the working directory of the whole
# process. Variables are never changed: a child's variables are set on its
# std.process Command. See book/src/design/stdlib/env.md.
from std.path import Path, from_bytes

pub class Variable:
    pub name: list[u8]
    pub value: list[u8]

def allocated[T](result: Result[T, AllocError]) -> Result[T, IoError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(IoError.Data(DataError.Allocation(cause)))

# A name is nonempty and holds neither `=` nor NUL.
pub def valid_name(name: &list[u8]) -> bool:
    if len(name) == 0:
        return False
    for byte in name:
        if byte == 0u8 or byte == 61u8:
            return False
    True

pub def get_bytes(name: &list[u8]) -> Result[Option[list[u8]], IoError]:
    if not valid_name(name):
        return Err(IoError.InvalidInput)
    __env_get(name)

# A value that is not UTF-8 is IoError.Data(DataError.InvalidUtf8); read it
# with get_bytes.
pub def get(name: &str) -> Result[Option[str], IoError]:
    encoded = encode_utf8(name)?
    match get_bytes(&encoded)?:
        case Some(value):
            Ok(Some(decode_utf8(value)?))
        case Nothing:
            Ok(Nothing)

# A snapshot in the order the process stores its variables.
pub def vars() -> Result[list[Variable], IoError]:
    # The runtime returns name, value, name, value...; popping reverses it.
    mut flat = __env_vars()?
    mut reversed = allocated(list[Variable].with_capacity(len(flat) // 2))?
    while len(flat) > 1:
        match flat.pop():
            case Some(value):
                match flat.pop():
                    case Some(name):
                        allocated(reversed.append(Variable(name, value)))?
                    case Nothing:
                        pass
            case Nothing:
                pass
    mut ordered = allocated(list[Variable].with_capacity(len(reversed)))?
    while len(reversed) > 0:
        match reversed.pop():
            case Some(variable):
                allocated(ordered.append(variable))?
            case Nothing:
                pass
    Ok(ordered)

pub def current_dir() -> Result[Path, IoError]:
    Ok(from_bytes(__env_current_dir()?))

# Changes the directory of the whole process, for every thread.
pub def set_current_dir(path: &Path) -> Result[(), IoError]:
    __env_change_dir(path.as_bytes())
