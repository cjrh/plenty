            c1 = transform_garner_step(b[i], c0, 312876447629491759u64, 1152702701792919553u64, 1152702701792919551u64, 549807853720474145u64)
            c2 = transform_garner_step(transform_garner_step(c[i], c0, 171887048208605330u64, 1152654323281297409u64, 1152654323281297407u64, 1065844120376875002u64), c1, 864490742460949231u64, 1152654323281297409u64, 1152654323281297407u64, 1065844120376875002u64)
            c3 = transform_garner_step(transform_garner_step(transform_garner_step(d[i], c0, 1143042328493092594u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64), c1, 207476590718054569u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64), c2, 960539771842767573u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64)
            c4 = transform_garner_step(transform_garner_step(transform_garner_step(transform_garner_step(e[i], c0, 43848051642774040u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c1, 272978847821206010u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c2, 938527276794829683u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c3, 126063148472975365u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64)
            mut x0 = c4
            mut x1 = 0u64
            mut x2 = 0u64
            mut x3 = 0u64
            mut x4 = 0u64
            for j in range(4):
                prime = 1152647726211530753u64 if j == 0 else (1152654323281297409u64 if j == 1 else (1152702701792919553u64 if j == 2 else 1152779667606863873u64))
                digit = c3 if j == 0 else (c2 if j == 1 else (c1 if j == 2 else c0))
                (lo0, hi0) = x0.widening_mul(prime)
                (lo1, hi1) = x1.widening_mul(prime)
                (lo2, hi2) = x2.widening_mul(prime)
                (lo3, hi3) = x3.widening_mul(prime)
                (lo4, _) = x4.widening_mul(prime)
                (next0, t0) = lo0.carrying_add(digit, False)
                (next1, t1) = lo1.carrying_add(hi0, t0)
                (next2, t2) = lo2.carrying_add(hi1, t1)
                (next3, t3) = lo3.carrying_add(hi2, t2)
                (next4, _) = lo4.carrying_add(hi3, t3)
                x0 = next0
                x1 = next1
                x2 = next2
                x3 = next3
                x4 = next4
            (word0, t0) = x0.carrying_add(carry0, False)
            (word1, t1) = x1.carrying_add(carry1, t0)
            (next0, t2) = x2.carrying_add(carry2, t1)
            (next1, t3) = x3.carrying_add(0u64, t2)
            carry0 = next0
            carry1 = next1
            carry2 = x4 + (1u64 if t3 else 0u64)
            out[2 * i] = word0
            if 2 * i + 1 < len(out):
