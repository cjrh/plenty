# Arbitrary precision signed integers. Canonical signed magnitude with inline i64.
# Arithmetic algorithms follow the base-power limb approach described in
# The Art of Computer Programming, vol. 2, sections 4.3.1 and 4.3.3
# (Donald Knuth): schoolbook arithmetic, Knuth division, Karatsuba and Toom-3.
# Large multiplication independently implements small-prime NTT/CRT, with
# 128-bit digit packing and exact Montgomery reduction:
# https://flintlib.org/doc/algorithms/fft/multimodular.html
# No third-party code or data is included.
from std.fmt import Formatter, FormatError

pub enum BigIntError:
    InvalidDigit
    InvalidRadix
    LimitExceeded
    OutOfRange
    ZeroDivision
    Allocation(AllocError)

enum Value:
    Small(i64)
    Large(bool, list[u64])

pub class BigInt:
    _value: Value

    pub def is_zero(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n == 0
            case Value.Large(_, _):
                False

    pub def is_negative(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n < 0
            case Value.Large(negative, _):
                *negative

    def word_len(self) -> i64:
        match &self._value:
            case Value.Small(n):
                0 if *n == 0 else 1
            case Value.Large(_, words):
                len(words)

    def word(self, index: i64) -> u64:
        if index < 0 or index >= self.word_len():
            return 0u64
        match &self._value:
            case Value.Small(n):
                unchecked:
                    u64(-(*n + 1)) + 1u64 if *n < 0 else u64(*n)
            case Value.Large(_, words):
                words[index]

    pub def cmp(self, other: &BigInt) -> i64:
        if self.is_negative() != other.is_negative():
            return -1 if self.is_negative() else 1
        result = magnitude_cmp(self, other)
        unchecked:
            -result if self.is_negative() else result

    pub def to_i64(self) -> Result[i64, BigIntError]:
        match &self._value:
            case Value.Small(n):
                Ok(*n)
            case Value.Large(_, _):
                Err(BigIntError.OutOfRange)

    pub def to_u64(self) -> Result[u64, BigIntError]:
        if self.is_negative() or self.word_len() > 1:
            return Err(BigIntError.OutOfRange)
        Ok(self.word(0))

    pub def bit_length(self) -> i64:
        if self.is_zero():
            return 0
        unchecked:
            mut high = self.word(self.word_len() - 1)
            mut bits = (self.word_len() - 1) * 64
            while high != 0u64:
                bits += 1
                high >>= 1u64
            bits

    pub def to_f64(self) -> f64:
        unchecked:
            bits = self.bit_length()
            if bits <= 53:
                value = f64(self.word(0))
                return -value if self.is_negative() else value
            if bits > 1024:
                return -f64.INF if self.is_negative() else f64.INF
            shift = bits - 53
            mut top = 0u64
            for i in range(53):
                position = bits - i - 1
                top = (top << 1u64) | ((self.word(position // 64) >> u64(position % 64)) & 1u64)
            guard_position = shift - 1
            guard = ((self.word(guard_position // 64) >> u64(guard_position % 64)) & 1u64) != 0u64
            mut sticky = False
            for i in range(guard_position // 64):
                sticky = sticky or self.word(i) != 0u64
            remaining = u64(guard_position % 64)
            if remaining != 0u64:
                sticky = sticky or (self.word(guard_position // 64) << (64u64 - remaining)) != 0u64
            if guard and (sticky or (top & 1u64) != 0u64):
                top += 1u64
            value = f64(top) * 2.0.pow(f64(shift))
            -value if self.is_negative() else value

    pub def __add__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a + *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() == other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(other.is_negative(), magnitude_sub(other, self)?))

    pub def __radd__(self, other: i64) -> Result[BigInt, AllocError]:
        self + from_i64(other)

    pub def __neg__(self) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(n):
                if *n != i64.MIN:
                    unchecked:
                        return Ok(from_i64(-*n))
            case _:
                pass
        Ok(canonical(not self.is_negative(), words(self)?))

    pub def __sub__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a - *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() != other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(not self.is_negative(), magnitude_sub(other, self)?))

    pub def __mul__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if self.is_zero() or other.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a * *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        a = words(self)?
        b = words(other)?
        Ok(canonical(self.is_negative() != other.is_negative(), multiply(&a, &b)?))

    pub def add_assign(self: &mut BigInt, other: &BigInt) -> Result[(), AllocError]:
        result = (self + other)?
        self._value = result._value
        Ok(())

    pub def __floordiv__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__floordiv__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (q, _) = pair
        Ok(q)

    pub def __mod__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__mod__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (_, r) = pair
        Ok(r)

    pub def checked_divmod(self, other: &BigInt) -> Result[(BigInt, BigInt), BigIntError]:
        if other.is_zero():
            return Err(BigIntError.ZeroDivision)
        quotient_remainder(self, other).map_error(BigIntError.Allocation)

    pub def __lshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__lshift__: count is negative")
        if self.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(n):
                if count < 63:
                    factor = unchecked:
                        1i64 << count
                    result = checked:
                        *n * factor
                    match result:
                        case Ok(value):
                            return Ok(from_i64(value))
                        case Err(_):
                            pass
                elif count == 63 and *n == -1:
                    return Ok(from_i64(i64.MIN))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra > i64.MAX - self.word_len() - 1:
                return Err(AllocError.CapacityOverflow)
            mut result = zeros(self.word_len() + extra + 1)?
            shift = u64(count % 64)
            for i in range(self.word_len()):
                value = self.word(i)
                result[i + extra] = result[i + extra] | (value << shift)
                if shift != 0u64:
                    result[i + extra + 1] = value >> (64u64 - shift)
            Ok(canonical(self.is_negative(), result))

    pub def __rshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__rshift__: count is negative")
        match &self._value:
            case Value.Small(n):
                if count >= 63:
                    return Ok(from_i64(-1 if *n < 0 else 0))
                unchecked:
                    return Ok(from_i64(*n >> count))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra >= self.word_len():
                return Ok(from_i64(-1 if self.is_negative() else 0))
            shift = u64(count % 64)
            mut result = zeros(self.word_len() - extra)?
            mut discarded = False
            for i in range(extra):
                discarded = discarded or self.word(i) != 0u64
            if shift != 0u64:
                discarded = discarded or (self.word(extra) << (64u64 - shift)) != 0u64
            for i in range(len(result)):
                result[i] = self.word(i + extra) >> shift
                if shift != 0u64:
                    result[i] = result[i] | (self.word(i + extra + 1) << (64u64 - shift))
            value = canonical(self.is_negative(), result)
            if self.is_negative() and discarded:
                return value - from_i64(1)
            Ok(value)

    pub def __and__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 0)

    pub def __or__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 1)

    pub def __xor__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 2)

    pub def to_string(self, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[str, BigIntError]:
        if radix < 2 or radix > 36:
            return Err(BigIntError.InvalidRadix)
        if self.word_len() <= 1:
            return render_one_word(self, radix, max_digits.get())
        mut powers = RadixPowers([from_i64(radix)].map_error(BigIntError.Allocation)?, dict[i64, BigInt]().map_error(BigIntError.Allocation)?)
        width = digit_count(self, radix, max_digits.get(), &mut powers).map_error(BigIntError.Allocation)?
        if width > max_digits.get():
            return Err(BigIntError.LimitExceeded)
        mut digits = list[str]().map_error(BigIntError.Allocation)?
        if self.is_negative():
            digits.append("-").map_error(BigIntError.Allocation)?
        render_digits(self, radix, width, &mut digits, &mut powers).map_error(BigIntError.Allocation)?
        "".join(&digits).map_error(BigIntError.Allocation)

    pub def display[W](self, out: &mut Formatter[W]) -> Result[(), FormatError]:
        match self.to_string():
            case Ok(text):
                out.text(text)
            case Err(BigIntError.Allocation(cause)):
                Err(FormatError.Allocation(cause))
            case Err(_):
                Err(FormatError.LimitExceeded)

pub def from_i64(value: i64) -> BigInt:
    BigInt(Value.Small(value))

pub def from_u64(value: u64) -> Result[BigInt, AllocError]:
    if value <= 9223372036854775807u64:
        unchecked:
            return Ok(from_i64(i64(value)))
    Ok(canonical(False, [value]?))

pub def parse(text: &strview, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[BigInt, BigIntError]:
    if radix < 2 or radix > 36:
        return Err(BigIntError.InvalidRadix)
    data = text.as_bytes()
    if len(data) == 0:
        return Err(BigIntError.InvalidDigit)
    negative = data[0] == 45u8
    start = 1 if negative or data[0] == 43u8 else 0
    unchecked:
        if len(data) - start > max_digits.get():
            return Err(BigIntError.LimitExceeded)
        if start == len(data):
            return Err(BigIntError.InvalidDigit)
        for i in range(start, len(data)):
            digit = digit_value(data[i])
            if digit < 0 or digit >= radix:
                return Err(BigIntError.InvalidDigit)
        value = if len(data) - start <= 12:
            parse_small(data, start, len(data), radix)
        else:
            mut powers = RadixPowers([from_i64(radix)].map_error(BigIntError.Allocation)?, dict[i64, BigInt]().map_error(BigIntError.Allocation)?)
            parse_digits(data, start, len(data), radix, &mut powers).map_error(BigIntError.Allocation)?
        if negative:
            (-value).map_error(BigIntError.Allocation)
        else:
            Ok(value)

def digit_value(ch: u8) -> i64:
    unchecked:
        if ch >= 48u8 and ch <= 57u8:
            i64(ch - 48u8)
        elif ch >= 65u8 and ch <= 90u8:
            i64(ch - 65u8) + 10
        elif ch >= 97u8 and ch <= 122u8:
            i64(ch - 97u8) + 10
        else:
            -1

# Each conversion shares the binary powers instead of squaring them again
# at every recursive split and digit-count probe.
class RadixPowers:
    values: list[BigInt]
    exact: dict[i64, BigInt]

    def power(self: &mut RadixPowers, exponent: i64) -> Result[&BigInt, AllocError]:
        if exponent not in self.exact:
            self.compute(exponent)?
        Ok(self.exact.get_ref(exponent).unwrap())

    def compute(self: &mut RadixPowers, exponent: i64) -> Result[(), AllocError]:
        unchecked:
            mut result = from_i64(1)
            mut count = exponent
            mut index = 0
            while count > 0:
                if index == len(self.values):
                    previous = &self.values[index - 1]
                    square = (previous * previous)?
                    self.values.append(square)?
                if count % 2 != 0:
                    result = (result * self.values[index])?
                count //= 2
                index += 1
            self.exact.insert(exponent, result)?
            Ok(())

def parse_small(data: &[u8], start: i64, stop: i64, radix: i64) -> BigInt:
    unchecked:
        mut value = 0
        for i in range(start, stop):
            value = value * radix + digit_value(data[i])
        from_i64(value)

def parse_digits(data: &[u8], start: i64, stop: i64, radix: i64, powers: &mut RadixPowers) -> Result[BigInt, AllocError]:
    unchecked:
        if stop - start <= 12:
            return Ok(parse_small(data, start, stop, radix))
        middle = start + (stop - start) // 2
        left = parse_digits(data, start, middle, radix, &mut powers)?
        right = parse_digits(data, middle, stop, radix, &mut powers)?
        power = powers.power(stop - middle)?
        shifted = (left * power)?
        shifted + right

def digit_count(value: &BigInt, radix: i64, limit: i64, powers: &mut RadixPowers) -> Result[i64, AllocError]:
    if value.is_zero():
        return Ok(1)
    unchecked:
        possible = value.word_len() * 64 + 1
        mut high = possible if limit >= possible else limit + 1
        mut low = 1
        while low < high:
            middle = low + (high - low) // 2
            power = powers.power(middle)?
            if magnitude_cmp(value, power) < 0:
                high = middle
            else:
                low = middle + 1
        Ok(low)

def render_one_word(value: &BigInt, radix: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        mut count = value.word(0)
        mut width = 1
        while count >= u64(radix):
            count //= u64(radix)
            width += 1
        if width > limit:
            return Err(BigIntError.LimitExceeded)
        mut digits = list[str]().map_error(BigIntError.Allocation)?
        if value.is_negative():
            digits.append("-").map_error(BigIntError.Allocation)?
        render_word(value.word(0), radix, width, &mut digits).map_error(BigIntError.Allocation)?
        "".join(&digits).map_error(BigIntError.Allocation)

def render_word(value: u64, radix: i64, width: i64, output: &mut list[str]) -> Result[(), AllocError]:
    unchecked:
        mut n = value
        mut digits: list[str] = []?
        alphabet = "0123456789abcdefghijklmnopqrstuvwxyz"
        for _ in range(width):
            digits.append(alphabet[i64(n % u64(radix))])?
            n //= u64(radix)
        mut i = len(digits)
        while i > 0:
            i -= 1
            output.append(digits[i])?
        Ok(())

def render_digits(value: &BigInt, radix: i64, width: i64, output: &mut list[str], powers: &mut RadixPowers) -> Result[(), AllocError]:
    unchecked:
        if width <= 12:
            return render_word(value.word(0), radix, width, output)
        right_width = width // 2
        power = powers.power(right_width)?
        (q, r) = divide_magnitude(value, power)?
        left = canonical(False, q)
        right = canonical(False, r)
        render_digits(&left, radix, width - right_width, output, &mut powers)?
        render_digits(&right, radix, right_width, output, &mut powers)?
        Ok(())

# Only this constructor can create a large representation. Zero has no sign;
# every value in the signed word range returns to the inline representation.
def canonical(negative: bool, source: list[u64]) -> BigInt:
    mut value = source
    trim(&mut value)
    if len(value) == 0:
        return from_i64(0)
    if len(value) == 1:
        limit = 9223372036854775808u64 if negative else 9223372036854775807u64
        if value[0] <= limit:
            unchecked:
                if negative and value[0] == 9223372036854775808u64:
                    return from_i64(i64.MIN)
                n = -i64(value[0]) if negative else i64(value[0])
                return from_i64(n)
    BigInt(Value.Large(negative, value))

def trim(value: &mut list[u64]) -> ():
    while len(value) > 0:
        if value[-1] != 0u64:
            return
        drop(value.pop())

def zeros(length: i64) -> Result[list[u64], AllocError]:
    [0u64 for _ in range(length)]

def words(value: &BigInt) -> Result[list[u64], AllocError]:
    mut result = list[u64].with_capacity(value.word_len())?
    for i in range(value.word_len()):
        result.append(value.word(i))?
    Ok(result)

def magnitude_cmp(a: &BigInt, b: &BigInt) -> i64:
    if a.word_len() != b.word_len():
        return -1 if a.word_len() < b.word_len() else 1
    unchecked:
        mut i = a.word_len()
        while i > 0:
            i -= 1
            if a.word(i) != b.word(i):
                return -1 if a.word(i) < b.word(i) else 1
    0

def magnitude_add(a: &BigInt, b: &BigInt) -> Result[list[u64], AllocError]:
    unchecked:
        n = a.word_len() if a.word_len() > b.word_len() else b.word_len()
        mut result = list[u64].with_capacity(n + 1)?
        mut carry = False
        for i in range(n):
            (word, overflow) = a.word(i).carrying_add(b.word(i), carry)
            result.append(word)?
            carry = overflow
        if carry:
            result.append(1u64)?
        Ok(result)

def magnitude_sub(a: &BigInt, b: &BigInt) -> Result[list[u64], AllocError]:
    mut result = list[u64].with_capacity(a.word_len())?
    mut borrow = False
    for i in range(a.word_len()):
        x = a.word(i)
        y = b.word(i)
        difference = x.wrapping_sub(y)
        result.append(difference.wrapping_sub(1u64 if borrow else 0u64))?
        borrow = x < y or (borrow and difference == 0u64)
    Ok(result)

# Borrow limbs directly through recursion. The result has enough room for
# every partial product; the final public constructor trims leading zeroes.
def add_words(a: &[u64], b: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        n = len(a) if len(a) > len(b) else len(b)
        mut out = zeros(n + 1)?
        add_words_into(a, b, &mut out)
        trim(&mut out)
        Ok(out)

def add_words_into(a: &[u64], b: &[u64], out: &mut [u64]) -> ():
    unchecked:
        mut carry = False
        n = len(out) - 1
        for i in range(n):
            x = a[i] if i < len(a) else 0u64
            y = b[i] if i < len(b) else 0u64
            (word, overflow) = x.carrying_add(y, carry)
            out[i] = word
            carry = overflow
        out[n] = 1u64 if carry else 0u64

def subtract_words(out: &mut [u64], b: &[u64]) -> ():
    mut borrow = False
    for i in range(len(out)):
        x = out[i]
        y = b[i] if i < len(b) else 0u64
        difference = x.wrapping_sub(y)
        out[i] = difference.wrapping_sub(1u64 if borrow else 0u64)
        borrow = x < y or (borrow and difference == 0u64)

def add_shifted(out: &mut [u64], value: &[u64], offset: i64) -> ():
    unchecked:
        mut carry = False
        for i in range(len(value)):
            (word, overflow) = out[offset + i].carrying_add(value[i], carry)
            out[offset + i] = word
            carry = overflow
        mut position = offset + len(value)
        while carry:
            (word, overflow) = out[position].carrying_add(0u64, carry)
            out[position] = word
            carry = overflow
            position += 1

def multiply(a: &[u64], b: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = zeros(len(a) + len(b))?
        if len(a) < 32 or len(b) < 32 or len(a) > 2 * len(b) or len(b) > 2 * len(a):
            multiply_schoolbook(a, b, &mut out)
        else:
            multiply_into(a, b, &mut out)?
        Ok(out)

# Output regions start zeroed and cannot resize. The low and high recursive
# products occupy disjoint final regions; interpolation reads them before
# adding the middle coefficients, eliminating two owning arrays per node.
def multiply_into(a: &[u64], b: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        if use_transform(len(a), len(b)):
            return multiply_transform_wide_into(a, b, out)
        n = len(a) if len(a) > len(b) else len(b)
        third = (n + 2) // 3
        shorter = len(a) if len(a) < len(b) else len(b)
        if n >= 128 and len(a) > 2 * third and len(b) > 2 * third and 4 * n <= 5 * shorter:
            return multiply_toom3_into(a, b, third, out)
        if len(a) >= 32 and len(b) >= 32 and len(a) <= 2 * len(b) and len(b) <= 2 * len(a):
            half = n // 2
            middle_start = half * 2
            multiply_into(&a[:half], &b[:half], &mut out[:middle_start])?
            multiply_into(&a[half:], &b[half:], &mut out[middle_start:])?
            sum_a = add_words(&a[:half], &a[half:])?
            sum_b = add_words(&b[:half], &b[half:])?
            mut middle = multiply(&sum_a, &sum_b)?
            subtract_words(&mut middle, &out[:middle_start])
            subtract_words(&mut middle, &out[middle_start:])
            trim(&mut middle)
            add_shifted(out, &middle, half)
        else:
            multiply_schoolbook(a, b, out)
        Ok(())

# Toom-3 evaluates the limb polynomials at 0, 1, -1, 2 and infinity.
# Signed evaluation is represented only by a magnitude and one sign bit;
# interpolation coefficients are nonnegative. No public BigInt temporaries
# or copying operand slices are needed in this recursion.
def multiply_toom3_into(a: &[u64], b: &[u64], k: i64, out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        a0 = &a[:k]
        a1 = &a[k:2 * k]
        a2 = &a[2 * k:]
        b0 = &b[:k]
        b1 = &b[k:2 * k]
        b2 = &b[2 * k:]
        low_end = 2 * k
        high_start = 4 * k
        multiply_into(a0, b0, &mut out[:low_end])?
        multiply_into(a2, b2, &mut out[high_start:])?
        a_sum = add_words(a0, a2)?
        b_sum = add_words(b0, b2)?
        a_one = add_words(&a_sum, a1)?
        b_one = add_words(&b_sum, b1)?
        mut v1 = multiply(&a_one, &b_one)?
        (a_negative, a_minus) = absolute_difference(&a_sum, a1)?
        (b_negative, b_minus) = absolute_difference(&b_sum, b1)?
        vm = multiply(&a_minus, &b_minus)?
        mut odd = zeros(len(v1) + 1)?
        if a_negative != b_negative:
            add_words_into(&v1, &vm, &mut odd)
        else:
            copy_words(&v1, &mut odd[:len(v1)])
            subtract_words(&mut odd, &vm)
        divide_words_two(&mut odd)
        trim(&mut odd)
        subtract_words(&mut v1, &out[:low_end])
        subtract_words(&mut v1, &out[high_start:])
        subtract_words(&mut v1, &odd)
        trim(&mut v1)
        a_two = evaluate_two(a0, a1, a2)?
        b_two = evaluate_two(b0, b1, b2)?
        mut cubic = multiply(&a_two, &b_two)?
        subtract_words(&mut cubic, &out[:low_end])
        subtract_scaled(&mut cubic, &out[high_start:], 16u64)
        divide_words_two(&mut cubic)
        subtract_words(&mut cubic, &odd)
        subtract_scaled(&mut cubic, &v1, 2u64)
        divide_words_three(&mut cubic)
        trim(&mut cubic)
        subtract_words(&mut odd, &cubic)
        trim(&mut odd)
        add_shifted(out, &odd, k)
        add_shifted(out, &v1, 2 * k)
        add_shifted(out, &cubic, 3 * k)
        Ok(())

def absolute_difference(a: &[u64], b: &[u64]) -> Result[(bool, list[u64]), AllocError]:
    unchecked:
        mut an = len(a)
        mut bn = len(b)
        while an > 0 and a[an - 1] == 0u64:
            an -= 1
        while bn > 0 and b[bn - 1] == 0u64:
            bn -= 1
        mut negative = an < bn
        if an == bn:
            mut i = an
            while i > 0:
                i -= 1
                if a[i] != b[i]:
                    negative = a[i] < b[i]
                    break
        mut out = zeros(an if an > bn else bn)?
        if negative:
            copy_words(&b[:bn], &mut out[:bn])
            subtract_words(&mut out, &a[:an])
        else:
            copy_words(&a[:an], &mut out[:an])
            subtract_words(&mut out, &b[:bn])
        trim(&mut out)
        Ok((negative, out))

def evaluate_two(a: &[u64], b: &[u64], c: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = zeros(len(a) + 1)?
        mut carry = 0u64
        for i in range(len(a)):
            x = b[i]
            y = c[i] if i < len(c) else 0u64
            (first, c1) = a[i].carrying_add(x << 1u64, False)
            (second, c2) = first.carrying_add(y << 2u64, False)
            (word, c3) = second.carrying_add(carry, False)
            out[i] = word
            carry = (x >> 63u64) + (y >> 62u64) + (1u64 if c1 else 0u64) + (1u64 if c2 else 0u64) + (1u64 if c3 else 0u64)
        out[len(a)] = carry
        trim(&mut out)
        Ok(out)

# Subtract a small multiple without constructing another limb array.
def subtract_scaled(out: &mut [u64], value: &[u64], factor: u64) -> ():
    unchecked:
        mut carry = 0u64
        mut borrow = False
        for i in range(len(out)):
            x = value[i] if i < len(value) else 0u64
            (low, high) = x.widening_mul(factor)
            (scaled, overflow) = low.carrying_add(carry, False)
            carry = high + (1u64 if overflow else 0u64)
            old = out[i]
            difference = old.wrapping_sub(scaled)
            out[i] = difference.wrapping_sub(1u64 if borrow else 0u64)
            borrow = old < scaled or (borrow and difference == 0u64)

def divide_words_two(value: &mut [u64]) -> ():
    unchecked:
        mut carry = 0u64
        mut i = len(value)
        while i > 0:
            i -= 1
            word = value[i]
            value[i] = (word >> 1u64) | carry
            carry = word << 63u64

# Each interpolation numerator is exactly divisible. Base-2^32 long
# division keeps the two-digit dividend inside a u64 on every step.
def divide_words_three(value: &mut [u64]) -> ():
    unchecked:
        mut remainder = 0u64
        mut i = len(value)
        while i > 0:
            i -= 1
            word = value[i]
            high = (remainder << 32u64) | (word >> 32u64)
            low = ((high % 3u64) << 32u64) | (word & 4294967295u64)
            value[i] = ((high // 3u64) << 32u64) | (low // 3u64)
            remainder = low % 3u64

# Full transforms have a power-of-two padding cost. Retain recursion in the
# sparsely occupied band after each size jump, as well as for small/unbalanced
# inputs. The retained capacity bound is within all five prime root orders.
def use_transform(a: i64, b: i64) -> bool:
    if a < 1024 or b < 1024:
        return False
    if a > 524288 or b > 524288:
        return False
    if a > 2 * b or b > 2 * a or a + b > 524288:
        return False
    unchecked:
        digits = (a + 1) // 2 + (b + 1) // 2
        mut n = 1
        while n < digits:
            n *= 2
        digits >= 7 * (n // 8)

def copy_words(source: &[u64], out: &mut [u64]) -> ():
    for i in range(len(out)):
        out[i] = source[i]

# Wide exact transforms pack two u64 limbs per digit. Five independently
# generated Proth primes provide >299 coefficient bits; the common root
# order exceeds the retained transform limit. Constants and certificates are
# regenerated by experiments/bigint-comparison/algorithms-next/constants.py.
def multiply_transform_wide_into(a: &[u64], b: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        digits = (len(a) + 1) // 2 + (len(b) + 1) // 2
        mut n = 1
        while n < digits:
            n *= 2
        mut x = zeros(n)?
        mut y = zeros(n)?
        mut roots = zeros(n // 2)?
        mut residues0 = zeros(digits)?
        mut residues1 = zeros(digits)?
        mut residues2 = zeros(digits)?
        mut residues3 = zeros(digits)?
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, 1152779667606863873u64, 3u64, 1152779667606863871u64, 2269391999729648u64, 438850205479958496u64, 577409928151867344u64)
        copy_words(&x, &mut residues0)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, 1152702701792919553u64, 5u64, 1152702701792919551u64, 3500845022838768u64, 549807853720474145u64, 836242407834260066u64)
        copy_words(&x, &mut residues1)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, 1152654323281297409u64, 3u64, 1152654323281297407u64, 4274901208793072u64, 1065844120376875002u64, 870989715713157113u64)
        copy_words(&x, &mut residues2)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, 1152647726211530753u64, 3u64, 1152647726211530751u64, 4380454325059568u64, 726084339089016087u64, 915534325496093643u64)
        copy_words(&x, &mut residues3)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, 1152577357467353089u64, 7u64, 1152577357467353087u64, 5506354231902192u64, 1052221714738828282u64, 443901272462896093u64)
        transform_wide_recover(&residues0, &residues1, &residues2, &residues3, &x, out)
        Ok(())

# REDC with R=2^64. The caller supplies high<p, so T<p*R and the
# unreduced result is below 2p < 2^61. The low word cancellation is exact.
def transform_wide_reduce(low: u64, high: u64, p: u64, inverse: u64) -> u64:
    unchecked:
        m = low.wrapping_mul(inverse)
        (m_low, m_high) = m.widening_mul(p)
        (_, carry) = low.carrying_add(m_low, False)
        result = high + m_high + (1u64 if carry else 0u64)
        result - p if result >= p else result

def transform_wide_multiply(a: u64, b: u64, p: u64, inverse: u64) -> u64:
    (low, high) = a.widening_mul(b)
    transform_wide_reduce(low, high, p, inverse)

def transform_wide_power(base: u64, exponent: u64, p: u64, inverse: u64, r: u64, r2: u64) -> u64:
    mut x = transform_wide_multiply(base, r2, p, inverse)
    mut power = exponent
    mut result = r
    while power > 0u64:
        if power & 1u64 != 0u64:
            result = transform_wide_multiply(result, x, p, inverse)
        x = transform_wide_multiply(x, x, p, inverse)
        power >>= 1u64
    result

def transform_wide_load(words: &[u64], out: &mut [u64], p: u64, inverse: u64, r3: u64) -> ():
    unchecked:
        count = (len(words) + 1) // 2
        for i in range(count):
            low = words[2 * i]
            high = words[2 * i + 1] if 2 * i + 1 < len(words) else 0u64
            reduced = transform_wide_reduce(low, high % p, p, inverse)
            out[i] = transform_wide_multiply(reduced, r3, p, inverse)
        for i in range(count, len(out)):
            out[i] = 0u64

def transform_wide_product(a: &[u64], b: &[u64], x: &mut [u64], y: &mut [u64], roots: &mut [u64], p: u64, generator: u64, inverse: u64, r: u64, r2: u64, r3: u64) -> ():
    unchecked:
        n = len(x)
        root = transform_wide_power(generator, (p - 1u64) // u64(n), p, inverse, r, r2)
        roots[0] = r
        for i in range(1, len(roots)):
            roots[i] = transform_wide_multiply(roots[i - 1], root, p, inverse)
        transform_wide_load(a, x, p, inverse, r3)
        transform_wide_load(b, y, p, inverse, r3)
        transform_wide_forward(x, roots, p, inverse)
        transform_wide_forward(y, roots, p, inverse)
        for i in range(n):
            x[i] = transform_wide_multiply(x[i], y[i], p, inverse)
        transform_wide_inverse(x, roots, p, inverse)
        scale = transform_wide_multiply(transform_wide_power(u64(n), p - 2u64, p, inverse, r, r2), 1u64, p, inverse)
        for i in range(n):
            x[i] = transform_wide_multiply(x[i], scale, p, inverse)

def transform_wide_forward(data: &mut [u64], roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        mut width = n
        mut step = 1
        while width >= 2:
            half = width // 2
            mut start = 0
            while start < n:
                block = &mut data[start:start + width]
                transform_wide_forward_block(&mut block[:half], &mut block[half:], roots, step, p, inverse)
                start += width
            width = half
            step *= 2

def transform_wide_inverse(data: &mut [u64], roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        mut width = 2
        mut step = n // 2
        while width <= n:
            half = width // 2
            mut start = 0
            while start < n:
                block = &mut data[start:start + width]
                transform_wide_inverse_block(&mut block[:half], &mut block[half:], roots, step, p, inverse)
                start += width
            width *= 2
            step //= 2

def transform_wide_forward_block(low: &mut [u64], high: &mut [u64], roots: &[u64], step: i64, p: u64, inverse: u64) -> ():
    unchecked:
        mut k = 0
        for j in range(len(low)):
            u = low[j]
            v = high[j]
            sum = u + v
            difference = u + p - v
            low[j] = sum - p if sum >= p else sum
            high[j] = transform_wide_multiply(difference - p if difference >= p else difference, roots[k], p, inverse)
            k += step

def transform_wide_inverse_block(low: &mut [u64], high: &mut [u64], roots: &[u64], step: i64, p: u64, inverse: u64) -> ():
    unchecked:
        mut k = 0
        for j in range(len(low)):
            root = roots[0] if k == 0 else p - roots[len(roots) - k]
            u = low[j]
            v = transform_wide_multiply(high[j], root, p, inverse)
            sum = u + v
            difference = u + p - v
            low[j] = sum - p if sum >= p else sum
            high[j] = difference - p if difference >= p else difference
            k += step

# Garner's mixed-radix conversion uses exact modular products. The fixed
# inverse constants and Proth witnesses are independently regenerated in
# the experiment proof, including every cross-prime residue.
def transform_garner_step(value: u64, digit: u64, reciprocal: u64, p: u64, inverse: u64, r2: u64) -> u64:
    unchecked:
        d = value + p - digit % p
        difference = d - p if d >= p else d
        product = transform_wide_multiply(difference, reciprocal, p, inverse)
        transform_wide_multiply(product, r2, p, inverse)

def transform_wide_recover(a: &[u64], b: &[u64], c: &[u64], d: &[u64], e: &[u64], out: &mut [u64]) -> ():
    unchecked:
        mut carry0 = 0u64
        mut carry1 = 0u64
        mut carry2 = 0u64
