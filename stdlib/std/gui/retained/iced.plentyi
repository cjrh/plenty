# iced 0.14.0 binding (iced contributors, MIT; https://iced.rs/).
# Linked by name. None of these calls is certified for worker entry.
extern def admit() -> u32 = "plic_v2_admit"
extern def drive(driver: &mut Box[Driver] as scoped_box) -> u32 = "plic_v2_drive"
extern def native_row(token: u64) -> u32 = "plic_v1_row"
extern def native_column(token: u64) -> u32 = "plic_v1_column"
extern def native_end(token: u64) -> u32 = "plic_v1_end"
extern def native_text(token: u64, text: &str as utf8) -> u32 = "plic_v1_text"
extern def native_button(token: u64, text: &str as utf8, action: u64) -> u32 = "plic_v1_button"

extern def native_checkbox(token: u64, caption: &str as utf8, selected: bool, action: u64) -> u32 = "plic_v1_checkbox"
extern def native_toggler(token: u64, caption: &str as utf8, selected: bool, action: u64) -> u32 = "plic_v1_toggler"
extern def native_radio(token: u64, caption: &str as utf8, selected: bool, action: u64) -> u32 = "plic_v1_radio"
extern def native_progress_bar(token: u64, fraction: f32) -> u32 = "plic_v1_progress_bar"
extern def native_rule(token: u64) -> u32 = "plic_v1_rule"
extern def native_space(token: u64, width: u16, height: u16) -> u32 = "plic_v1_space"
extern def native_responsive(token: u64, row_min_width: u16) -> u32 = "plic_v1_responsive"
extern def native_image_rgba(token: u64, pixels: &[u8] as strided, width: u16, height: u16, scale: u16) -> u32 = "plic_v1_image_rgba"
extern def native_pick_list(token: u64, selected: u64) -> u32 = "plic_v1_pick_list"
extern def native_choice(token: u64, label: &str as utf8, action: u64) -> u32 = "plic_v1_choice"
extern def native_canvas(token: u64, width: u16, height: u16) -> u32 = "plic_v1_canvas"
extern def native_fill_rect(token: u64, x: u16, y: u16, width: u16, height: u16, rgb: u32) -> u32 = "plic_v1_fill_rect"
extern def native_slider(token: u64, vertical: bool, value: u16, minimum: u16, maximum: u16, id: u64) -> u32 = "plic_v1_slider"
extern def slider_value(out: &mut u16) -> bool = "plic_v1_slider_value"
extern def native_pane_grid(token: u64, side_by_side: bool, first_percent: u16) -> u32 = "plic_v1_pane_grid"
extern def native_grid(token: u64, columns: u16) -> u32 = "plic_v1_grid"
extern def native_float_scaled(token: u64, percent: u16) -> u32 = "plic_v1_float_scaled"
extern def native_mouse_area(token: u64, action: u64) -> u32 = "plic_v1_mouse_area"
extern def native_sensor(token: u64, action: u64) -> u32 = "plic_v1_sensor"
extern def native_themer(token: u64, dark: bool) -> u32 = "plic_v1_themer"
extern def native_container(token: u64, padding: u16) -> u32 = "plic_v1_container"
extern def native_pin(token: u64, x: u16, y: u16) -> u32 = "plic_v1_pin"
extern def native_scrollable(token: u64, height: u16) -> u32 = "plic_v1_scrollable"
extern def native_tooltip(token: u64) -> u32 = "plic_v1_tooltip"
extern def native_stack(token: u64) -> u32 = "plic_v1_stack"

pub enum IcedError:
    OutOfMemory
    CapacityOverflow
    InvalidContext
    LimitExceeded
    InvalidLayout
    InvalidArgument
    NativeFailure


def checked(status: u32) -> Result[(), IcedError]:
    match status:
        case 0u32:
            Ok(())
        case 1u32:
            Err(IcedError.OutOfMemory)
        case 2u32:
            Err(IcedError.CapacityOverflow)
        case 3u32:
            Err(IcedError.InvalidContext)
        case 4u32:
            Err(IcedError.LimitExceeded)
        case 5u32:
            Err(IcedError.InvalidLayout)
        case 6u32:
            Err(IcedError.InvalidArgument)
        case _:
            Err(IcedError.NativeFailure)

pub def allocation(error: AllocError) -> IcedError:
    match error:
        case AllocError.OutOfMemory:
            IcedError.OutOfMemory
        case AllocError.CapacityOverflow:
            IcedError.CapacityOverflow

# A frame is only usable during the render that supplied its token.
pub class Frame:
    token: u64
    pub def __init__(self, token: u64) -> ():
        self.token = token
    pub def checkbox(self, caption: &str, selected: bool, action: u64) -> Result[(), IcedError]:
        checked(native_checkbox(self.token, caption, selected, action))
    pub def toggler(self, caption: &str, selected: bool, action: u64) -> Result[(), IcedError]:
        checked(native_toggler(self.token, caption, selected, action))
    pub def radio(self, caption: &str, selected: bool, action: u64) -> Result[(), IcedError]:
        checked(native_radio(self.token, caption, selected, action))
    pub def progress_bar(self, fraction: f32) -> Result[(), IcedError]:
        checked(native_progress_bar(self.token, fraction))
    pub def rule(self) -> Result[(), IcedError]:
        checked(native_rule(self.token))
    pub def space(self, width: u16, height: u16) -> Result[(), IcedError]:
        checked(native_space(self.token, width, height))
    pub def responsive(self, row_min_width: u16) -> Result[(), IcedError]:
        checked(native_responsive(self.token, row_min_width))
    pub def image_rgba(self, pixels: &[u8], width: u16, height: u16, scale: u16 = 1u16) -> Result[(), IcedError]:
        checked(native_image_rgba(self.token, pixels, width, height, scale))
    pub def pick_list(self, selected: u64) -> Result[(), IcedError]:
        checked(native_pick_list(self.token, selected))
    pub def choice(self, label: &str, action: u64) -> Result[(), IcedError]:
        checked(native_choice(self.token, label, action))
    pub def canvas(self, width: u16, height: u16) -> Result[(), IcedError]:
        checked(native_canvas(self.token, width, height))
    pub def fill_rect(self, x: u16, y: u16, width: u16, height: u16, rgb: u32) -> Result[(), IcedError]:
        checked(native_fill_rect(self.token, x, y, width, height, rgb))
    pub def slider(self, value: u16, minimum: u16, maximum: u16, id: u64) -> Result[(), IcedError]:
        checked(native_slider(self.token, False, value, minimum, maximum, id))
    pub def vertical_slider(self, value: u16, minimum: u16, maximum: u16, id: u64) -> Result[(), IcedError]:
        checked(native_slider(self.token, True, value, minimum, maximum, id))
    pub def pane_grid(self, side_by_side: bool, first_percent: u16) -> Result[(), IcedError]:
        checked(native_pane_grid(self.token, side_by_side, first_percent))
    pub def grid(self, columns: u16) -> Result[(), IcedError]:
        checked(native_grid(self.token, columns))
    pub def float_scaled(self, percent: u16) -> Result[(), IcedError]:
        checked(native_float_scaled(self.token, percent))
    pub def mouse_area(self, on_press: u64) -> Result[(), IcedError]:
        checked(native_mouse_area(self.token, on_press))
    pub def sensor(self, on_show: u64) -> Result[(), IcedError]:
        checked(native_sensor(self.token, on_show))
    pub def themer(self, dark: bool) -> Result[(), IcedError]:
        checked(native_themer(self.token, dark))
    pub def container(self, padding: u16) -> Result[(), IcedError]:
        checked(native_container(self.token, padding))
    pub def pin(self, x: u16, y: u16) -> Result[(), IcedError]:
        checked(native_pin(self.token, x, y))
    pub def scrollable(self, height: u16) -> Result[(), IcedError]:
        checked(native_scrollable(self.token, height))
    pub def tooltip(self) -> Result[(), IcedError]:
        checked(native_tooltip(self.token))
    pub def stack(self) -> Result[(), IcedError]:
        checked(native_stack(self.token))
    pub def row(self) -> Result[(), IcedError]:
        checked(native_row(self.token))
    pub def column(self) -> Result[(), IcedError]:
        checked(native_column(self.token))
    pub def end(self) -> Result[(), IcedError]:
        checked(native_end(self.token))
    pub def text(self, text: &str) -> Result[(), IcedError]:
        checked(native_text(self.token, text))
    pub def button(self, text: &str, action: u64) -> Result[(), IcedError]:
        checked(native_button(self.token, text, action))

class Driver:
    callback: BoxedMutCallable[[bool, u64], Result[(), IcedError]]
    def __init__(self, callback: BoxedMutCallable[[bool, u64], Result[(), IcedError]]) -> ():
        self.callback = callback

export def render_frame(driver: &mut Driver, token: u64) -> Result[(), IcedError] = "iced_app_render_frame":
    driver.callback(False, token)

export def handle_action(driver: &mut Driver, action: u64) -> Result[(), IcedError] = "iced_app_handle_action":
    driver.callback(True, action)

def reject_action[S](state: &mut S, action: u64) -> Result[(), IcedError]:
    Err(IcedError.InvalidArgument)

pub def run[S](create: Callable[[], Result[S, AllocError]], view: Callable[[&S, &Frame], Result[(), IcedError]], update: Callable[[&mut S, u64], Result[(), IcedError]] = reject_action[S]) -> Result[(), IcedError]:
    checked(admit())?
    state = create().map_error(allocation)?
    callback = def [mut state, view, update](is_action: bool, value: u64) -> Result[(), IcedError]:
        if is_action:
            mut number = 0u16
            if slider_value(&mut number):
                return Err(IcedError.InvalidArgument)
            return update(&mut state, value)
        frame = Frame(value)
        view(&state, &frame)
    erased = BoxedMutCallable(callback).map_error(allocation)?
    mut driver = Box(Driver(erased)).map_error(allocation)?
    checked(drive(&mut driver))

pub enum Event:
    Action(u64)
    SliderChanged(u64, u16)

pub def run_events[S](create: Callable[[], Result[S, AllocError]], view: Callable[[&S, &Frame], Result[(), IcedError]], update: Callable[[&mut S, Event], Result[(), IcedError]]) -> Result[(), IcedError]:
    checked(admit())?
    state = create().map_error(allocation)?
    callback = def [mut state, view, update](is_action: bool, value: u64) -> Result[(), IcedError]:
        if is_action:
            mut number = 0u16
            if slider_value(&mut number):
                return update(&mut state, Event.SliderChanged(value, number))
            return update(&mut state, Event.Action(value))
        frame = Frame(value)
        view(&state, &frame)
    erased = BoxedMutCallable(callback).map_error(allocation)?
    mut driver = Box(Driver(erased)).map_error(allocation)?
    checked(drive(&mut driver))
