# egui/eframe 0.37.0 (Emil Ernerfeldt and contributors, MIT OR Apache-2.0):
# synchronous widgets, default fonts and the X11/glow renderer. https://www.egui.rs/
# Checked only on the synchronous GUI thread; no worker certification.
import std.bytes as buffers

extern def admit() -> u32 = "pleg_v2_admit"
extern def drive(driver: &mut Box[Driver] as scoped_box) -> u32 = "pleg_v2_drive"
extern def native_label(token: u64, text: &str as utf8) -> u32 = "pleg_v1_label"
extern def native_button(token: u64, text: &str as utf8) -> u32 = "pleg_v1_button"

extern def native_edit(token: u64, id: u64, text: &str as utf8, count: &mut i64) -> u32 = "pleg_v1_text_edit"
extern def copy_edit(token: u64, out: &mut list[u8] as strided) -> u32 = "pleg_v1_copy_edit"

extern def reject_edit(token: u64, status: u32) -> u32 = "pleg_v1_reject_edit"

extern def native_checkbox(token: u64, text: &str as utf8, value: &mut bool) -> u32 = "pleg_v1_checkbox"
extern def native_radio(token: u64, text: &str as utf8, selected: bool) -> u32 = "pleg_v1_radio"
extern def native_link(token: u64, text: &str as utf8) -> u32 = "pleg_v1_link"
extern def native_separator(token: u64) -> u32 = "pleg_v1_separator"
extern def native_spinner(token: u64) -> u32 = "pleg_v1_spinner"
extern def native_progress_bar(token: u64, fraction: f32) -> u32 = "pleg_v1_progress_bar"
extern def native_range_slider(token: u64, low: &mut f32, high: &mut f32, minimum: f32, maximum: f32) -> u32 = "pleg_v1_range_slider"
extern def native_slider(token: u64, value: &mut f32, minimum: f32, maximum: f32) -> u32 = "pleg_v1_slider"
extern def native_drag_value(token: u64, value: &mut f32, minimum: f32, maximum: f32) -> u32 = "pleg_v1_drag_value"

pub enum EguiError:
    OutOfMemory
    CapacityOverflow
    InvalidContext
    LimitExceeded
    InvalidArgument
    NativeFailure

pub def allocation(error: AllocError) -> EguiError:
    match error:
        case AllocError.OutOfMemory:
            EguiError.OutOfMemory
        case AllocError.CapacityOverflow:
            EguiError.CapacityOverflow

# Copyback happens after admission. Latch a local failure just as the native
# widget would, even when draw handles the returned Err and continues.
def reject_allocation(token: u64, error: AllocError) -> EguiError:
    status = match error:
        case AllocError.OutOfMemory:
            2u32
        case AllocError.CapacityOverflow:
            3u32
    failure(reject_edit(token, status))

# Status 1 is a successful widget action.
def failure(status: u32) -> EguiError:
    match status:
        case 2u32:
            EguiError.OutOfMemory
        case 3u32:
            EguiError.CapacityOverflow
        case 4u32:
            EguiError.InvalidContext
        case 5u32:
            EguiError.LimitExceeded
        case 6u32:
            EguiError.InvalidArgument
        case _:
            EguiError.NativeFailure

def checked(status: u32) -> Result[(), EguiError]:
    if status == 0u32:
        return Ok(())
    Err(failure(status))

def response(status: u32) -> Result[bool, EguiError]:
    if status <= 1u32:
        return Ok(status == 1u32)
    Err(failure(status))

pub class Ui:
    token: u64
    pub def __init__(self, token: u64) -> ():
        self.token = token
    pub def checkbox(self, text: &str, value: &mut bool) -> Result[bool, EguiError]:
        response(native_checkbox(self.token, text, value))
    pub def radio(self, text: &str, selected: bool) -> Result[bool, EguiError]:
        response(native_radio(self.token, text, selected))
    pub def link(self, text: &str) -> Result[bool, EguiError]:
        response(native_link(self.token, text))
    pub def separator(self) -> Result[(), EguiError]:
        checked(native_separator(self.token))
    pub def spinner(self) -> Result[(), EguiError]:
        checked(native_spinner(self.token))
    pub def progress_bar(self, fraction: f32) -> Result[(), EguiError]:
        checked(native_progress_bar(self.token, fraction))
    pub def range_slider(self, low: &mut f32, high: &mut f32, minimum: f32, maximum: f32) -> Result[bool, EguiError]:
        response(native_range_slider(self.token, low, high, minimum, maximum))
    pub def slider(self, value: &mut f32, minimum: f32, maximum: f32) -> Result[bool, EguiError]:
        response(native_slider(self.token, value, minimum, maximum))
    pub def drag_value(self, value: &mut f32, minimum: f32, maximum: f32) -> Result[bool, EguiError]:
        response(native_drag_value(self.token, value, minimum, maximum))
    pub def label(self, text: &str) -> Result[(), EguiError]:
        checked(native_label(self.token, text))
    pub def button(self, text: &str) -> Result[bool, EguiError]:
        match native_button(self.token, text):
            case 0u32:
                Ok(False)
            case 1u32:
                Ok(True)
            case _ as status:
                Err(failure(status))

    pub def text_edit(self, id: u64, text: &mut str) -> Result[bool, EguiError]:
        mut count = -1
        status = native_edit(self.token, id, text, &mut count)
        if status > 1u32:
            return Err(failure(status))
        if count < -1 or count > 4096:
            return Err(failure(reject_edit(self.token, 7u32)))
        if count >= 0:
            mut data = match [0u8 for _ in range(count)]:
                case Ok(value):
                    value
                case Err(error):
                    return Err(reject_allocation(self.token, error))
            checked(copy_edit(self.token, &mut data))?
            match buffers.to_text(&data):
                case Ok(value):
                    *text = value
                case Err(buffers.BytesError.Allocation(error)):
                    return Err(reject_allocation(self.token, error))
                case Err(buffers.BytesError.InvalidUtf8):
                    return Err(failure(reject_edit(self.token, 7u32)))
        Ok(status == 1u32)

class Driver:
    callback: BoxedMutCallable[[u64], Result[(), EguiError]]
    def __init__(self, callback: BoxedMutCallable[[u64], Result[(), EguiError]]) -> ():
        self.callback = callback

export def draw_frame(driver: &mut Driver, token: u64) -> Result[(), EguiError] = "egui_app_draw_frame":
    driver.callback(token)

pub def run[S](create: Callable[[], Result[S, AllocError]], draw: Callable[[&mut S, &Ui], Result[(), EguiError]]) -> Result[(), EguiError]:
    checked(admit())?
    state = create().map_error(allocation)?
    callback = def [mut state, draw](token: u64) -> Result[(), EguiError]:
        ui = Ui(token)
        draw(&mut state, &ui)
    erased = BoxedMutCallable(callback).map_error(allocation)?
    mut driver = Box(Driver(erased)).map_error(allocation)?
    checked(drive(&mut driver))
