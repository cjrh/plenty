# Curated digests, HMAC and constant-time comparison over std.bytes buffers.
# Primitives use RustCrypto (sha2, sha1, hmac, subtle) and the BLAKE3 team's
# blake3 crate (CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception); this
# module validates arguments and reports errors. See
# book/src/design/stdlib/crypto.md.
import std.bytes
from std.bytes import Bytes, BytesError

pub enum CryptoError:
    OutOfRange
    Finished
    InvalidKeyLength
    UnsupportedAlgorithm
    Allocation(AllocError)

# Sha1 is broken for collision resistance and exists only for protocols
# that require it, such as the WebSocket handshake and Git object IDs.
pub enum Algorithm:
    Sha256
    Sha512
    Sha1
    Blake3

# Output bytes: 32 for BLAKE3, SHA-256 and HMAC-SHA-256, 64 for the SHA-512 pair,
# 20 for the SHA-1 pair.
pub def output_size(algorithm: Algorithm) -> i64:
    match algorithm:
        case Algorithm.Sha256:
            32
        case Algorithm.Sha512:
            64
        case Algorithm.Sha1:
            20
        case Algorithm.Blake3:
            32

# Runtime tags: 1, 2 and 5 are SHA digests; 3, 4 and 6 the HMACs over them;
# 7 is BLAKE3 and 8 its keyed mode (constructed separately).
def kind(algorithm: Algorithm, keyed: bool) -> u8:
    match algorithm:
        case Algorithm.Sha256:
            if keyed:
                return 3u8
            1u8
        case Algorithm.Sha512:
            if keyed:
                return 4u8
            2u8
        case Algorithm.Sha1:
            if keyed:
                return 6u8
            5u8
        case Algorithm.Blake3:
            7u8

def reported[T](result: Result[T, BytesError]) -> Result[T, CryptoError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(CryptoError.Allocation(cause))
                case _:
                    Err(CryptoError.OutOfRange)

def absorbed(result: Result[bool, BytesError]) -> Result[(), CryptoError]:
    if not reported(result)?:
        return Err(CryptoError.Finished)
    Ok(())

def output(state: &mut Bytes, size: i64) -> Result[Bytes, CryptoError]:
    mut target = reported(std.bytes.with_capacity(size))?
    reported(target.resize(size, 0u8))?
    absorbed(state.crypto_finish(&mut target, 0, size))?
    Ok(target)

# An incremental hash. Feed input in any number of pieces; the result equals
# hashing the concatenation. `finish` ends it: later calls report Finished.
pub class Digest:
    _state: Bytes
    _size: i64

    pub def size(self) -> i64:
        self._size

    pub def update(self: &mut Digest, data: &Bytes, start: i64, stop: i64) -> Result[(), CryptoError]:
        absorbed(self._state.crypto_update(data, start, stop))

    pub def update_text(self: &mut Digest, text: &str) -> Result[(), CryptoError]:
        if not self._state.crypto_update_text(text):
            return Err(CryptoError.Finished)
        Ok(())

    # The digest in a new buffer. An allocation failure leaves the state
    # unfinished, so the call can be retried.
    pub def finish(self: &mut Digest) -> Result[Bytes, CryptoError]:
        output(&mut self._state, self._size)

    # Writes size() bytes at target[offset:] without allocating.
    pub def finish_into(self: &mut Digest, target: &mut Bytes, offset: i64) -> Result[(), CryptoError]:
        absorbed(self._state.crypto_finish(target, offset, self._size))

# An incremental HMAC or keyed BLAKE3. Its state holds key material; finishing or dropping it
# overwrites that state.
pub class Mac:
    _state: Bytes
    _size: i64

    pub def size(self) -> i64:
        self._size

    pub def update(self: &mut Mac, data: &Bytes, start: i64, stop: i64) -> Result[(), CryptoError]:
        absorbed(self._state.crypto_update(data, start, stop))

    pub def update_text(self: &mut Mac, text: &str) -> Result[(), CryptoError]:
        if not self._state.crypto_update_text(text):
            return Err(CryptoError.Finished)
        Ok(())

    pub def finish(self: &mut Mac) -> Result[Bytes, CryptoError]:
        output(&mut self._state, self._size)

    pub def finish_into(self: &mut Mac, target: &mut Bytes, offset: i64) -> Result[(), CryptoError]:
        absorbed(self._state.crypto_finish(target, offset, self._size))

    # Finishes and compares the tag with expected[start:stop] in constant
    # time. A tag of the wrong length is a mismatch, not an error.
    pub def verify(self: &mut Mac, expected: &Bytes, start: i64, stop: i64) -> Result[bool, CryptoError]:
        match reported(self._state.crypto_verify(expected, start, stop))?:
            case 1:
                Ok(True)
            case 0:
                Ok(False)
            case _:
                Err(CryptoError.Finished)

pub def digest(algorithm: Algorithm) -> Result[Digest, CryptoError]:
    state = reported(std.bytes.crypto_state(kind(algorithm, False)))?
    Ok(Digest(state, output_size(algorithm)))

# SHA algorithms accept any key length; RFC 2104 hashes keys longer than a block.
pub def hmac(algorithm: Algorithm, key: &Bytes) -> Result[Mac, CryptoError]:
    if algorithm == Algorithm.Blake3:
        return Err(CryptoError.UnsupportedAlgorithm)
    state = reported(std.bytes.crypto_keyed_state(kind(algorithm, True), key, 0, key.len()))?
    Ok(Mac(state, output_size(algorithm)))

def hashed(algorithm: Algorithm, data: &Bytes) -> Result[Bytes, CryptoError]:
    mut hasher = digest(algorithm)?
    hasher.update(data, 0, data.len())?
    hasher.finish()

def keyed(algorithm: Algorithm, key: &Bytes, data: &Bytes) -> Result[Bytes, CryptoError]:
    mut mac = hmac(algorithm, key)?
    mac.update(data, 0, data.len())?
    mac.finish()

pub def sha256(data: &Bytes) -> Result[Bytes, CryptoError]:
    hashed(Algorithm.Sha256, data)

pub def sha512(data: &Bytes) -> Result[Bytes, CryptoError]:
    hashed(Algorithm.Sha512, data)

pub def blake3(data: &Bytes) -> Result[Bytes, CryptoError]:
    hashed(Algorithm.Blake3, data)

# Native keyed BLAKE3, with exactly 32 key bytes (not HMAC).
pub def blake3_keyed_hasher(key: &Bytes) -> Result[Mac, CryptoError]:
    if key.len() != 32:
        return Err(CryptoError.InvalidKeyLength)
    state = reported(std.bytes.crypto_keyed_state(8u8, key, 0, key.len()))?
    Ok(Mac(state, 32))

pub def blake3_keyed(key: &Bytes, data: &Bytes) -> Result[Bytes, CryptoError]:
    mut mac = blake3_keyed_hasher(key)?
    mac.update(data, 0, data.len())?
    mac.finish()

# Context is a fixed, globally unique application/purpose string. This is a
# KDF for high-entropy key material, not password hashing.
pub def blake3_derive_hasher(context: &str) -> Result[Digest, CryptoError]:
    state = reported(std.bytes.crypto_derive_state(context))?
    Ok(Digest(state, 32))

pub def blake3_derive_key(context: &str, key_material: &Bytes) -> Result[Bytes, CryptoError]:
    mut hasher = blake3_derive_hasher(context)?
    hasher.update(key_material, 0, key_material.len())?
    hasher.finish()

# Legacy: only for protocols that require SHA-1. Never use it for security.
pub def sha1(data: &Bytes) -> Result[Bytes, CryptoError]:
    hashed(Algorithm.Sha1, data)

pub def hmac_sha256(key: &Bytes, data: &Bytes) -> Result[Bytes, CryptoError]:
    keyed(Algorithm.Sha256, key, data)

pub def hmac_sha512(key: &Bytes, data: &Bytes) -> Result[Bytes, CryptoError]:
    keyed(Algorithm.Sha512, key, data)

# Whether two buffers hold the same bytes, in time that depends only on their
# lengths. Use it for secrets such as tags and tokens; `==` may stop early.
pub def equal(a: &Bytes, b: &Bytes) -> bool:
    a.crypto_equal(b)
