# Dense, column-major f64 storage belongs to Plenty. Native calls only borrow it.
import std.math as math

extern def multiply_raw(m: i64, n: i64, k: i64, a: &list[f64] as strided, b: &list[f64] as strided, out: &mut list[f64] as strided) -> i64 = "plla_v1_multiply"
extern def lu_raw(m: i64, n: i64, a: &mut list[f64] as strided, perm: &mut list[i64] as strided) -> i64 = "plla_v1_lu"
extern def solve_raw(n: i64, k: i64, a: &list[f64] as strided, perm: &list[i64] as strided, rhs: &mut list[f64] as strided) -> i64 = "plla_v1_solve"
extern def qr_raw(m: i64, n: i64, a: &mut list[f64] as strided, q: &mut list[f64] as strided) -> i64 = "plla_v1_qr"
extern def cholesky_raw(n: i64, a: &mut list[f64] as strided) -> i64 = "plla_v1_cholesky"
extern def svd_raw(m: i64, n: i64, a: &list[f64] as strided, s: &mut list[f64] as strided, u: &mut list[f64] as strided, v: &mut list[f64] as strided) -> i64 = "plla_v1_svd"
extern def eigh_raw(n: i64, a: &list[f64] as strided, values: &mut list[f64] as strided, vectors: &mut list[f64] as strided) -> i64 = "plla_v1_eigh"
extern def eig_raw(n: i64, a: &list[f64] as strided, real: &mut list[f64] as strided, imag: &mut list[f64] as strided, vectors_real: &mut list[f64] as strided, vectors_imag: &mut list[f64] as strided) -> i64 = "plla_v1_eig"

pub enum LinalgError:
    Shape
    Bounds
    NonFinite
    Singular
    NotSymmetric
    NotPositiveDefinite
    NoConvergence
    Overflow
    NativePanic

def checked(code: i64) -> Result[(), AllocError | LinalgError]:
    match code:
        case 0:
            Ok(())
        case 1:
            Err(AllocError.OutOfMemory)
        case 2:
            Err(LinalgError.Shape)
        case 3:
            Err(LinalgError.Singular)
        case 4:
            Err(LinalgError.NotPositiveDefinite)
        case 5:
            Err(LinalgError.NoConvergence)
        case 6:
            Err(LinalgError.Overflow)
        case _:
            Err(LinalgError.NativePanic)

def size(rows: i64, cols: i64) -> Result[i64, LinalgError]:
    if rows <= 0 or cols <= 0:
        return Err(LinalgError.Shape)
    if rows > (i64.MAX // 16) // cols:
        return Err(LinalgError.Shape)
    Ok(rows * cols)

def finite(values: &list[f64]) -> Result[(), LinalgError]:
    for value in values:
        if not math.isfinite(*value):
            return Err(LinalgError.NonFinite)
    Ok(())

pub class Matrix:
    _rows: i64
    _cols: i64
    _values: list[f64]

    pub def rows(self) -> i64:
        self._rows

    pub def cols(self) -> i64:
        self._cols

    pub def get(self, row: i64, col: i64) -> Result[f64, LinalgError]:
        if row < 0 or row >= self._rows or col < 0 or col >= self._cols:
            return Err(LinalgError.Bounds)
        Ok(self._values[col * self._rows + row])

    pub def set(self: &mut Matrix, row: i64, col: i64, value: f64) -> Result[(), LinalgError]:
        if row < 0 or row >= self._rows or col < 0 or col >= self._cols:
            return Err(LinalgError.Bounds)
        if not math.isfinite(value):
            return Err(LinalgError.NonFinite)
        self._values[col * self._rows + row] = value
        Ok(())

    pub def to_list(self) -> Result[list[f64], AllocError]:
        [self._values[col * self._rows + row] for row in range(self._rows) for col in range(self._cols)]

    pub def transpose(self) -> Result[Matrix, AllocError]:
        Ok(Matrix(self._cols, self._rows, self.to_list()?))

    pub def add(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        if self._rows != rhs._rows or self._cols != rhs._cols:
            return Err(LinalgError.Shape)
        mut out = zeros(self._rows, self._cols)?
        for index in range(len(self._values)):
            value = self._values[index] + rhs._values[index]
            if not math.isfinite(value):
                return Err(LinalgError.Overflow)
            out._values[index] = value
        Ok(out)

    pub def subtract(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        if self._rows != rhs._rows or self._cols != rhs._cols:
            return Err(LinalgError.Shape)
        mut out = zeros(self._rows, self._cols)?
        for index in range(len(self._values)):
            value = self._values[index] - rhs._values[index]
            if not math.isfinite(value):
                return Err(LinalgError.Overflow)
            out._values[index] = value
        Ok(out)

    pub def scale(self, factor: f64) -> Result[Matrix, AllocError | LinalgError]:
        if not math.isfinite(factor):
            return Err(LinalgError.NonFinite)
        mut out = zeros(self._rows, self._cols)?
        for index in range(len(self._values)):
            value = self._values[index] * factor
            if not math.isfinite(value):
                return Err(LinalgError.Overflow)
            out._values[index] = value
        Ok(out)

    pub def negate(self) -> Result[Matrix, AllocError | LinalgError]:
        self.scale(-1.0)

    pub def __add__(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        self.add(rhs)

    pub def __sub__(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        self.subtract(rhs)

    pub def __neg__(self) -> Result[Matrix, AllocError | LinalgError]:
        self.negate()

    pub def __mul__(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        self.matmul(rhs)

    pub def __rmul__(self, factor: f64) -> Result[Matrix, AllocError | LinalgError]:
        self.scale(factor)

    pub def matmul(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        if self._cols != rhs._rows:
            return Err(LinalgError.Shape)
        mut out = zeros(self._rows, rhs._cols)?
        checked(multiply_raw(self._rows, rhs._cols, self._cols, &self._values, &rhs._values, &mut out._values))?
        Ok(out)

    pub def lu(self) -> Result[Lu, AllocError | LinalgError]:
        mut packed = copy(self)?
        mut permutation = [0 for _ in range(self._rows)]?
        checked(lu_raw(self._rows, self._cols, &mut packed._values, &mut permutation))?
        Ok(Lu(packed, permutation))

    pub def solve(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        if self._rows != self._cols or rhs._rows != self._rows:
            return Err(LinalgError.Shape)
        factor = self.lu()?
        factor.solve(rhs)

    pub def qr(self) -> Result[(Matrix, Matrix), AllocError | LinalgError]:
        mut packed = copy(self)?
        mut q = identity(self._rows)?
        checked(qr_raw(self._rows, self._cols, &mut packed._values, &mut q._values))?
        for col in range(packed._cols):
            for row in range(col + 1, packed._rows):
                packed._values[col * packed._rows + row] = 0.0
        Ok((q, packed))

    pub def cholesky(self) -> Result[Matrix, AllocError | LinalgError]:
        symmetric(self)?
        mut lower = copy(self)?
        checked(cholesky_raw(self._rows, &mut lower._values))?
        for col in range(lower._cols):
            for row in range(col):
                lower._values[col * lower._rows + row] = 0.0
        Ok(lower)

    pub def svd(self) -> Result[(Matrix, list[f64], Matrix), AllocError | LinalgError]:
        rank = math.min(self._rows, self._cols)
        mut values = [0.0 for _ in range(rank)]?
        mut u = zeros(self._rows, rank)?
        mut v = zeros(self._cols, rank)?
        checked(svd_raw(self._rows, self._cols, &self._values, &mut values, &mut u._values, &mut v._values))?
        Ok((u, values, v))

    pub def eigh(self) -> Result[(list[f64], Matrix), AllocError | LinalgError]:
        symmetric(self)?
        mut values = [0.0 for _ in range(self._rows)]?
        mut vectors = zeros(self._rows, self._rows)?
        checked(eigh_raw(self._rows, &self._values, &mut values, &mut vectors._values))?
        Ok((values, vectors))

    pub def eig(self) -> Result[(list[f64], list[f64], Matrix, Matrix), AllocError | LinalgError]:
        if self._rows != self._cols:
            return Err(LinalgError.Shape)
        mut real = [0.0 for _ in range(self._rows)]?
        mut imag = [0.0 for _ in range(self._rows)]?
        mut vectors_real = zeros(self._rows, self._rows)?
        mut vectors_imag = zeros(self._rows, self._rows)?
        checked(eig_raw(self._rows, &self._values, &mut real, &mut imag, &mut vectors_real._values, &mut vectors_imag._values))?
        Ok((real, imag, vectors_real, vectors_imag))

def symmetric(matrix: &Matrix) -> Result[(), LinalgError]:
    if matrix._rows != matrix._cols:
        return Err(LinalgError.Shape)
    for col in range(matrix._cols):
        for row in range(col):
            if matrix._values[col * matrix._rows + row] != matrix._values[row * matrix._rows + col]:
                return Err(LinalgError.NotSymmetric)
    Ok(())

pub class Lu:
    _packed: Matrix
    _permutation: list[i64]

    pub def lower(self) -> Result[Matrix, AllocError | LinalgError]:
        rank = math.min(self._packed._rows, self._packed._cols)
        mut result = zeros(self._packed._rows, rank)?
        for col in range(rank):
            result._values[col * result._rows + col] = 1.0
            for row in range(col + 1, result._rows):
                result._values[col * result._rows + row] = self._packed._values[col * self._packed._rows + row]
        Ok(result)

    pub def upper(self) -> Result[Matrix, AllocError | LinalgError]:
        rank = math.min(self._packed._rows, self._packed._cols)
        mut result = zeros(rank, self._packed._cols)?
        for col in range(result._cols):
            for row in range(math.min(col + 1, rank)):
                result._values[col * rank + row] = self._packed._values[col * self._packed._rows + row]
        Ok(result)

    pub def permutation(self) -> Result[list[i64], AllocError]:
        copy(self._permutation)

    pub def solve(self, rhs: &Matrix) -> Result[Matrix, AllocError | LinalgError]:
        n = self._packed._rows
        if n != self._packed._cols or rhs._rows != n:
            return Err(LinalgError.Shape)
        mut result = copy(rhs)?
        checked(solve_raw(n, rhs._cols, &self._packed._values, &self._permutation, &mut result._values))?
        Ok(result)

pub def matrix(rows: i64, cols: i64, values: &list[f64]) -> Result[Matrix, AllocError | LinalgError]:
    count = size(rows, cols)?
    if len(values) != count:
        return Err(LinalgError.Shape)
    finite(values)?
    Ok(Matrix(rows, cols, [values[row * cols + col] for col in range(cols) for row in range(rows)]?))

pub def vector(values: &list[f64]) -> Result[Matrix, AllocError | LinalgError]:
    matrix(len(values), 1, values)

pub def zeros(rows: i64, cols: i64) -> Result[Matrix, AllocError | LinalgError]:
    count = size(rows, cols)?
    Ok(Matrix(rows, cols, [0.0 for _ in range(count)]?))

pub def identity(n: i64) -> Result[Matrix, AllocError | LinalgError]:
    mut result = zeros(n, n)?
    for index in range(n):
        result._values[index * n + index] = 1.0
    Ok(result)

pub def diagonal(values: &list[f64]) -> Result[Matrix, AllocError | LinalgError]:
    finite(values)?
    mut result = zeros(len(values), len(values))?
    for index in range(len(values)):
        result._values[index * len(values) + index] = values[index]
    Ok(result)
