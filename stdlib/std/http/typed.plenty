# Typed HTTP heads, writes, body framing and connection recovery.
# Low-level adapters require already validated framing and method/status semantics.
from std.bytes import Bytes
import std.bytes
import std.http
import std.io
from std.http import Header, HttpError, Limits, Framing, RequestHead, ResponseHead
import std.io.typed
from std.io.typed import Reader, Writer, StepError, Partial, WriteFailure, within

pub enum FramingError[E]:
    Transport(E)
    Truncated
    InvalidProgress
    OutOfRange
    Broken
    NotReusable
    Protocol(HttpError)

# completed is bytes consumed from this head, including CRLF and leading
# request blank lines. Interrupted retries the current byte without losing
# parser state. Other failures are terminal for this head.
def head_step[E, T](result: Result[T, HttpError], completed: i64) -> Result[T, Partial[FramingError[E]]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(Partial(completed, FramingError[E].Protocol(cause)))

def head_storage[E, T](result: Result[T, std.bytes.BytesError], completed: i64) -> Result[T, Partial[FramingError[E]]]:
    match chunk_bytes[E, T](result):
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(Partial(completed, cause))

def head_line[E, R: Reader[E]](reader: &mut R, line: &mut Bytes, limits: &Limits, completed: i64) -> Result[i64, Partial[FramingError[E]]]:
    mut limit = limits.max_line
    mut overflow = HttpError.LineTooLong
    if limits.max_head - completed < limit:
        limit = limits.max_head - completed
        overflow = HttpError.HeadTooLarge
    line.clear()
    mut at = 0
    while at < limit:
        head_storage[E, ()](line.resize(at + 1, 0u8), completed + at)?
        match reader.read(line, at, at + 1):
            case Ok(count):
                if count == 0:
                    if at == 0:
                        return Ok(-1)
                    return Err(Partial(completed + at, FramingError[E].Truncated))
                if count != 1:
                    return Err(Partial(completed + at, FramingError[E].InvalidProgress))
                at += 1
                if line[at - 1] == 10u8:
                    if at < 2 or line[at - 2] != 13u8:
                        return Err(Partial(completed + at, FramingError[E].Protocol(HttpError.BareLineFeed)))
                    return Ok(at - 2)
            case Err(StepError.Interrupted):
                pass
            case Err(StepError.Source(cause)):
                return Err(Partial(completed + at, FramingError[E].Transport(cause)))
    Err(Partial(completed + at, FramingError[E].Protocol(overflow)))

def head_fields[E, R: Reader[E]](reader: &mut R, line: &mut Bytes, limits: &Limits, completed: i64, headers: &mut list[Header]) -> Result[(), Partial[FramingError[E]]]:
    mut total = completed
    while True:
        size = head_line[E, R](reader, line, limits, total)?
        if size < 0:
            return Err(Partial(total, FramingError[E].Truncated))
        total += size + 2
        if size == 0:
            return Ok(())
        if len(headers) >= limits.max_headers:
            return Err(Partial(total, FramingError[E].Protocol(HttpError.TooManyHeaders)))
        field = head_step[E, Header](std.http.parse_field(line, size), total)?
        match headers.append(field):
            case Ok(_):
                pass
            case Err(cause):
                return Err(Partial(total, FramingError[E].Protocol(HttpError.Allocation(cause))))
    Ok(())

def head_buffer[E](limits: &Limits) -> Result[Bytes, Partial[FramingError[E]]]:
    if limits.max_line < 2 or limits.max_head < 2 or limits.max_headers < 0 or limits.max_body < 0:
        return Err(Partial(0, FramingError[E].Protocol(HttpError.InvalidLimit)))
    head_storage[E, Bytes](std.bytes.empty(), 0)

# These readers do not read ahead. Supply a typed BufReader for efficient
# transport reads and retain that same reader for the body and next message.
pub def read_request[E, R: Reader[E]](reader: &mut R, limits: &Limits) -> Result[Option[RequestHead], Partial[FramingError[E]]]:
    mut line = head_buffer[E](limits)?
    mut total = 0
    mut size = 0
    while size == 0:
        size = head_line[E, R](reader, &mut line, limits, total)?
        if size < 0:
            return Ok(Nothing)
        total += size + 2
    mut head = head_step[E, RequestHead](std.http.parse_request_line(&line, size), total)?
    head_fields[E, R](reader, &mut line, limits, total, &mut head.headers)?
    Ok(Some(head))

pub def read_response[E, R: Reader[E]](reader: &mut R, limits: &Limits) -> Result[Option[ResponseHead], Partial[FramingError[E]]]:
    mut line = head_buffer[E](limits)?
    size = head_line[E, R](reader, &mut line, limits, 0)?
    if size < 0:
        return Ok(Nothing)
    total = size + 2
    mut head = head_step[E, ResponseHead](std.http.parse_status_line(&line, size), total)?
    head_fields[E, R](reader, &mut line, limits, total, &mut head.headers)?
    Ok(Some(head))

def write_failure[E](cause: WriteFailure[E]) -> FramingError[E]:
    match cause:
        case WriteFailure.Source(error):
            FramingError[E].Transport(error)
        case WriteFailure.WriteZero:
            FramingError[E].Protocol(HttpError.Stream(std.io.StreamError.WriteZero))
        case WriteFailure.InvalidProgress:
            FramingError[E].InvalidProgress
        case WriteFailure.OutOfRange:
            FramingError[E].OutOfRange

def deliver[E, W: Writer[E]](writer: &mut W, data: &Bytes, start: i64, stop: i64, completed: i64) -> Result[(), Partial[FramingError[E]]]:
    match std.io.typed.write_all[E, W](writer, data, start, stop):
        case Ok(_):
            Ok(())
        case Err(partial):
            Err(Partial(completed + partial.completed, write_failure[E](partial.cause)))

pub def write_request[E, W: Writer[E]](writer: &mut W, head: &RequestHead) -> Result[(), Partial[FramingError[E]]]:
    data = head_step[E, Bytes](std.http.encode_request(head), 0)?
    deliver[E, W](writer, &data, 0, data.len(), 0)

pub def write_response[E, W: Writer[E]](writer: &mut W, head: &ResponseHead) -> Result[(), Partial[FramingError[E]]]:
    data = head_step[E, Bytes](std.http.encode_response(head), 0)?
    deliver[E, W](writer, &data, 0, data.len(), 0)

pub def write_last_chunk[E, W: Writer[E]](writer: &mut W, trailers: &list[Header]) -> Result[(), Partial[FramingError[E]]]:
    data = head_step[E, Bytes](std.http.encode_last_chunk(trailers), 0)?
    deliver[E, W](writer, &data, 0, data.len(), 0)

pub def write_chunk[E, W: Writer[E]](writer: &mut W, source: &Bytes, start: i64, stop: i64) -> Result[(), Partial[FramingError[E]]]:
    if not within(start, stop, source.len()):
        return Err(Partial(0, FramingError[E].OutOfRange))
    if start == stop:
        return Ok(())
    line = head_step[E, Bytes](std.http.encode_chunk_size(stop - start), 0)?
    deliver[E, W](writer, &line, 0, line.len(), 0)?
    deliver[E, W](writer, source, start, stop, line.len())?
    deliver[E, W](writer, &line, line.len() - 2, line.len(), line.len() + stop - start)

pub def fixed_body[E, R: Reader[E]](inner: R, length: i64) -> Result[FixedBody[E, R], FramingError[E]]:
    if length < 0:
        return Err(FramingError[E].OutOfRange)
    Ok(FixedBody[E, R](Some(inner), length, False))

pub class FixedBody[E, R]:
    inner: Option[R]
    remaining: i64
    broken: bool

    pub def read(self: &mut FixedBody[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        if self.broken:
            return Err(StepError[FramingError[E]].Source(FramingError[E].Broken))
        if not within(start, stop, buffer.len()) or self.remaining < 0:
            return Err(StepError[FramingError[E]].Source(FramingError[E].OutOfRange))
        if start == stop or self.remaining == 0:
            return Ok(0)
        mut offered = stop - start
        if offered > self.remaining:
            offered = self.remaining
        match read_inner[E, R](&mut self.inner, buffer, start, start + offered):
            case Ok(count):
                if count <= 0 or count > offered:
                    self.broken = True
                    if count == 0:
                        return Err(StepError[FramingError[E]].Source(FramingError[E].Truncated))
                    return Err(StepError[FramingError[E]].Source(FramingError[E].InvalidProgress))
                self.remaining -= count
                Ok(count)
            case Err(StepError.Interrupted):
                Err(StepError[FramingError[E]].Interrupted)
            case Err(StepError.Source(cause)):
                self.broken = True
                Err(StepError[FramingError[E]].Source(cause))

# Parsing state survives Interrupted, including a partially consumed CRLF.
# Metadata is read one byte at a time so the next message is never prefetched.
pub def chunked_body[E, R: Reader[E]](inner: R, limits: &Limits) -> Result[ChunkedBody[E, R], FramingError[E]]:
    if limits.max_line < 2 or limits.max_head < 2 or limits.max_headers < 0 or limits.max_body < 0:
        return Err(FramingError[E].Protocol(HttpError.InvalidLimit))
    line = chunk_bytes[E, Bytes](std.bytes.with_capacity(limits.max_line))?
    trailers = chunk_alloc[E, list[Header]](list[Header].new())?
    Ok(ChunkedBody[E, R](Some(inner), trailers, line, 0, 0, 0, 0, 0, limits.max_line, limits.max_head, limits.max_headers, limits.max_body))

def chunk_alloc[E, T](result: Result[T, AllocError]) -> Result[T, FramingError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(FramingError[E].Protocol(HttpError.Allocation(cause)))

def chunk_bytes[E, T](result: Result[T, std.bytes.BytesError]) -> Result[T, FramingError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(std.bytes.BytesError.Allocation(cause)):
            Err(FramingError[E].Protocol(HttpError.Allocation(cause)))
        case Err(_):
            Err(FramingError[E].Protocol(HttpError.InvalidHeader))

def chunk_hex(code: u8) -> i64:
    if code >= 48u8 and code <= 57u8:
        return i64(code) - 48
    if code >= 65u8 and code <= 70u8:
        return i64(code) - 55
    if code >= 97u8 and code <= 102u8:
        return i64(code) - 87
    -1

def chunk_token(code: u8) -> bool:
    if code >= 48u8 and code <= 57u8 or code >= 65u8 and code <= 90u8 or code >= 97u8 and code <= 122u8:
        return True
    code == 33u8 or code == 35u8 or code == 36u8 or code == 37u8 or code == 38u8 or code == 39u8 or code == 42u8 or code == 43u8 or code == 45u8 or code == 46u8 or code == 94u8 or code == 95u8 or code == 96u8 or code == 124u8 or code == 126u8

const size_line: i64 = 0
const chunk_data: i64 = 1
const data_crlf: i64 = 2
const trailer_lines: i64 = 3
const done: i64 = 4
const broken: i64 = 5

pub class ChunkedBody[E, R]:
    inner: Option[R]
    pub trailers: list[Header]
    line: Bytes
    state: i64
    remaining: i64
    delivered: i64
    trailer_bytes: i64
    trailer_count: i64
    max_line: i64
    max_head: i64
    max_headers: i64
    max_body: i64

    pub def total(self) -> i64:
        self.delivered

    pub def is_done(self) -> bool:
        self.state == done

    def pull(self: &mut ChunkedBody[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        match read_inner[E, R](&mut self.inner, buffer, start, stop):
            case Ok(count):
                if count == 0:
                    return Err(StepError[FramingError[E]].Source(FramingError[E].Truncated))
                if count < 0 or count > stop - start:
                    return Err(StepError[FramingError[E]].Source(FramingError[E].InvalidProgress))
                Ok(count)
            case Err(StepError.Interrupted):
                Err(StepError[FramingError[E]].Interrupted)
            case Err(StepError.Source(cause)):
                Err(StepError[FramingError[E]].Source(cause))

    def parse_line(self: &mut ChunkedBody[E, R]) -> Result[(), FramingError[E]]:
        size = self.line.len() - 2
        if self.state == data_crlf:
            if size != 0:
                return Err(FramingError[E].Protocol(HttpError.InvalidChunk))
            self.state = size_line
        elif self.state == size_line:
            mut index = 0
            mut value = 0
            while index < size:
                code = chunk_hex(self.line[index])
                if code < 0:
                    break
                if value > (i64.MAX - code) // 16:
                    return Err(FramingError[E].Protocol(HttpError.InvalidChunk))
                value = value * 16 + code
                index += 1
            if index == 0:
                return Err(FramingError[E].Protocol(HttpError.InvalidChunk))
            if index < size:
                while index < size and (self.line[index] == 32u8 or self.line[index] == 9u8):
                    index += 1
                if index == size or self.line[index] != 59u8:
                    return Err(FramingError[E].Protocol(HttpError.InvalidChunk))
                while index < size:
                    code = self.line[index]
                    if code != 9u8 and (code < 32u8 or code == 127u8):
                        return Err(FramingError[E].Protocol(HttpError.InvalidChunk))
                    index += 1
            if value > self.max_body - self.delivered:
                return Err(FramingError[E].Protocol(HttpError.BodyTooLarge))
            self.remaining = value
            self.state = trailer_lines if value == 0 else chunk_data
        else:
            if size == 0:
                self.state = done
                return Ok(())
            if self.trailer_count >= self.max_headers:
                return Err(FramingError[E].Protocol(HttpError.TooManyHeaders))
            mut colon = 0
            while colon < size and chunk_token(self.line[colon]):
                colon += 1
            if colon == 0 or colon == size or self.line[colon] != 58u8:
                return Err(FramingError[E].Protocol(HttpError.InvalidHeader))
            mut start = colon + 1
            while start < size and (self.line[start] == 32u8 or self.line[start] == 9u8):
                start += 1
            mut stop = size
            while stop > start and (self.line[stop - 1] == 32u8 or self.line[stop - 1] == 9u8):
                stop -= 1
            for index in range(start, stop):
                code = self.line[index]
                if code != 9u8 and (code < 32u8 or code == 127u8):
                    return Err(FramingError[E].Protocol(HttpError.InvalidHeader))
            name = chunk_bytes[E, str](self.line.to_text_range(0, colon))?
            value = chunk_bytes[E, str](self.line.to_text_range(start, stop))?
            chunk_alloc[E, ()](self.trailers.append(Header(name, value)))?
            self.trailer_count += 1
        Ok(())

    def step(self: &mut ChunkedBody[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        while self.state != done:
            if self.state == chunk_data:
                mut offered = stop - start
                if offered > self.remaining:
                    offered = self.remaining
                count = self.pull(buffer, start, start + offered)?
                self.remaining -= count
                self.delivered += count
                if self.remaining == 0:
                    self.state = data_crlf
                # Return payload progress before consuming any more framing.
                return Ok(count)
            mut limit = self.max_line
            mut overflow = HttpError.LineTooLong
            if self.state == data_crlf:
                limit = 2
                overflow = HttpError.InvalidChunk
            elif self.state == trailer_lines and self.max_head - self.trailer_bytes < limit:
                limit = self.max_head - self.trailer_bytes
                overflow = HttpError.HeadTooLarge
            if self.line.len() >= limit:
                return Err(StepError[FramingError[E]].Source(FramingError[E].Protocol(overflow)))
            drop(self.pull(buffer, start, start + 1)?)
            code = buffer[start]
            match chunk_bytes[E, ()](self.line.push(code)):
                case Err(cause):
                    return Err(StepError[FramingError[E]].Source(cause))
                case Ok(_):
                    pass
            if code == 10u8:
                size = self.line.len()
                if size < 2 or self.line[size - 2] != 13u8:
                    return Err(StepError[FramingError[E]].Source(FramingError[E].Protocol(HttpError.BareLineFeed)))
                if self.state == trailer_lines:
                    self.trailer_bytes += size
                match self.parse_line():
                    case Err(cause):
                        return Err(StepError[FramingError[E]].Source(cause))
                    case Ok(_):
                        self.line.clear()
        Ok(0)

    pub def read(self: &mut ChunkedBody[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        if self.state == broken:
            return Err(StepError[FramingError[E]].Source(FramingError[E].Broken))
        if not within(start, stop, buffer.len()):
            return Err(StepError[FramingError[E]].Source(FramingError[E].OutOfRange))
        if start == stop:
            return Ok(0)
        match self.step(buffer, start, stop):
            case Err(StepError.Source(cause)):
                self.state = broken
                Err(StepError[FramingError[E]].Source(cause))
            case _ as result:
                result
# EOF completes this framing mode; its connection must never be reused.
pub def close_body[E, R: Reader[E]](inner: R) -> CloseBody[E, R]:
    CloseBody[E, R](Some(inner), False, False)

pub class CloseBody[E, R]:
    inner: Option[R]
    finished: bool
    broken: bool

    pub def read(self: &mut CloseBody[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        if self.broken:
            return Err(StepError[FramingError[E]].Source(FramingError[E].Broken))
        if not within(start, stop, buffer.len()):
            return Err(StepError[FramingError[E]].Source(FramingError[E].OutOfRange))
        if start == stop or self.finished:
            return Ok(0)
        match read_inner[E, R](&mut self.inner, buffer, start, stop):
            case Ok(count):
                if count < 0 or count > stop - start:
                    self.broken = True
                    return Err(StepError[FramingError[E]].Source(FramingError[E].InvalidProgress))
                if count == 0:
                    self.finished = True
                Ok(count)
            case Err(StepError.Interrupted):
                Err(StepError[FramingError[E]].Interrupted)
            case Err(StepError.Source(cause)):
                self.broken = True
                Err(StepError[FramingError[E]].Source(cause))

# Only Body.finish extracts these transports, and it rejects later reads.
def read_inner[E, R](inner: &mut Option[R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
    match inner:
        case Some(reader):
            match reader.read(buffer, start, stop):
                case Ok(count):
                    Ok(count)
                case Err(StepError.Interrupted):
                    Err(StepError[FramingError[E]].Interrupted)
                case Err(StepError.Source(cause)):
                    Err(StepError[FramingError[E]].Source(FramingError[E].Transport(cause)))
        case Nothing:
            Err(StepError[FramingError[E]].Source(FramingError[E].Broken))

enum BodyKind[E, R]:
    Fixed(FixedBody[E, R])
    Chunked(ChunkedBody[E, R])
    Close(CloseBody[E, R])

# Parsed heads retain the existing framing validation policy. Head syntax,
# routing and request semantics are the caller's responsibility.
pub def request_body[E, R: Reader[E]](inner: R, head: &RequestHead, limits: &Limits) -> Result[Body[E, R], FramingError[E]]:
    framing = head_result[E, Framing](std.http.request_framing(head))?
    framed_body[E, R](inner, &framing, limits, std.http.request_keeps_alive(head))

# `request_keep_alive` must also account for the request's Connection policy.
# Recovery is for another HTTP message, never a protocol upgrade or tunnel.
pub def response_body[E, R: Reader[E]](inner: R, head: &ResponseHead, method: &str, request_keep_alive: bool, limits: &Limits) -> Result[Body[E, R], FramingError[E]]:
    framing = head_result[E, Framing](std.http.response_framing(head, method))?
    keep = request_keep_alive and std.http.response_keeps_alive(head, &framing) and head.status != 101 and not (method == "CONNECT" and head.status >= 200 and head.status < 300)
    framed_body[E, R](inner, &framing, limits, keep)

def head_result[E, T](result: Result[T, HttpError]) -> Result[T, FramingError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(FramingError[E].Protocol(cause))

def framed_body[E, R: Reader[E]](inner: R, framing: &Framing, limits: &Limits, keep: bool) -> Result[Body[E, R], FramingError[E]]:
    if limits.max_line < 2 or limits.max_head < 2 or limits.max_headers < 0 or limits.max_body < 0:
        return Err(FramingError[E].Protocol(HttpError.InvalidLimit))
    empty = chunk_alloc[E, list[Header]](list[Header].new())?
    kind: BodyKind[E, R] = match framing:
        case Framing.Empty:
            BodyKind[E, R].Fixed(fixed_body[E, R](inner, 0)?)
        case Framing.Length(length):
            if *length > limits.max_body:
                return Err(FramingError[E].Protocol(HttpError.BodyTooLarge))
            BodyKind[E, R].Fixed(fixed_body[E, R](inner, *length)?)
        case Framing.Chunked:
            BodyKind[E, R].Chunked(chunked_body[E, R](inner, limits)?)
        case Framing.UntilClose:
            BodyKind[E, R].Close(close_body[E, R](inner))
    Ok(Body[E, R](kind, empty, keep, False, 0, limits.max_body))

pub class Body[E, R]:
    kind: BodyKind[E, R]
    empty: list[Header]
    keep: bool
    broken: bool
    delivered: i64
    max_body: i64

    pub def total(self) -> i64:
        self.delivered

    pub def is_done(self) -> bool:
        if self.broken:
            return False
        match &self.kind:
            case BodyKind.Fixed(body):
                not body.broken and body.remaining == 0
            case BodyKind.Chunked(body):
                body.is_done()
            case BodyKind.Close(body):
                not body.broken and body.finished

    # Complete only once is_done() is true, as with ChunkedBody.trailers.
    pub def trailers(self) -> &list[Header]:
        match &self.kind:
            case BodyKind.Chunked(body):
                &body.trailers
            case _:
                &self.empty

    pub def read(self: &mut Body[E, R], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StepError[FramingError[E]]]:
        if self.broken:
            return Err(StepError[FramingError[E]].Source(FramingError[E].Broken))
        if not within(start, stop, buffer.len()):
            return Err(StepError[FramingError[E]].Source(FramingError[E].OutOfRange))
        if start == stop:
            return Ok(0)
        # At the close-delimited budget, probe one byte to distinguish EOF
        # from an oversized body. That connection is never recoverable.
        mut offered = stop - start
        left = self.max_body - self.delivered
        if offered > left:
            offered = left
        if offered == 0:
            offered = 1
        outcome = match &mut self.kind:
            case BodyKind.Fixed(body):
                body.read(buffer, start, start + offered)
            case BodyKind.Chunked(body):
                body.read(buffer, start, start + offered)
            case BodyKind.Close(body):
                body.read(buffer, start, start + offered)
        match outcome:
            case Ok(count):
                if count > left:
                    self.broken = True
                    return Err(StepError[FramingError[E]].Source(FramingError[E].Protocol(HttpError.BodyTooLarge)))
                self.delivered += count
                Ok(count)
            case Err(StepError.Interrupted):
                Err(StepError[FramingError[E]].Interrupted)
            case Err(StepError.Source(cause)):
                self.broken = True
                Err(StepError[FramingError[E]].Source(cause))

    # An incomplete body remains readable; failure does not extract its
    # transport. Success transfers ownership exactly once and breaks the body.
    pub def finish(self: &mut Body[E, R]) -> Result[R, FramingError[E]]:
        if self.broken:
            return Err(FramingError[E].Broken)
        if not self.is_done():
            return Err(FramingError[E].Protocol(HttpError.Unfinished))
        if not self.keep:
            return Err(FramingError[E].NotReusable)
        self.broken = True
        match &mut self.kind:
            case BodyKind.Fixed(body):
                Ok(replace(body.inner, Nothing).unwrap())
            case BodyKind.Chunked(body):
                Ok(replace(body.inner, Nothing).unwrap())
            case BodyKind.Close(_):
                Err(FramingError[E].NotReusable)
