# An HTTP/1.1 server over std.http framing: method and path routing, handlers
# checked as ordinary worker code, a fixed pool of workers fed by a bounded
# admission queue, per-phase deadlines, and graceful shutdown that drains and
# then cooperatively cancels active work before joining every worker.
# See book/src/design/stdlib/http-server.md.
import std.bytes
import std.http
import std.io
import std.log
import std.net
import std.ready
import std.time
import std.url
from std.bytes import ByteSource, Bytes, BytesError
from std.http import BodyReader, Framing, Header, HttpError, Limits, RequestHead, RequestTarget, ResponseHead
from std.io import BufReader, StreamError
from std.log import ChannelSink, Field, Level
from std.net import NetError, Shutdown, SocketAddress, TcpListener, TcpStream, UdpSocket
from std.ready import Interest, Selector, WaitError
from std.sync import CancellationToken
from std.time import Deadline, Duration, deadline_at, instant_at, monotonic_now, seconds

pub enum ServerError:
    InvalidConfig
    InvalidPattern
    DuplicateRoute
    Allocation(AllocError)
    Thread(ThreadError)
    Net(NetError)

# What a connection needs from its byte stream: reads and writes bounded by a
# deadline and a token, and ending its output. A std.net TcpStream has these
# methods; another stream with the same methods, such as a TLS session, can
# be served with `serve_connection`.
pub protocol Transport:
    def read_before(self: &mut Transport, buffer: &mut Bytes, start: i64, stop: i64, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, NetError]:
        pass

    def write_before[S: ByteSource](self: &mut Transport, source: &S, start: i64, stop: i64, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, NetError]:
        pass

    # The server only ends writes (`Shutdown.Write`), before a lingering
    # close.
    def shutdown(self: &mut Transport, direction: Shutdown) -> Result[(), NetError]:
        pass

# Every worker borrows the one handler shared, so `handle` cannot change it.
# `route` is the value the matched route was added with, borrowed from the
# router; the handler usually matches on it.
pub protocol Handler[T, R]:
    def handle(self, route: &R, exchange: &mut Exchange[T]) -> Result[(), Failure]:
        pass

pub class Config:
    pub workers: i64
    pub queue: i64
    pub limits: Limits
    pub idle_timeout: Duration
    pub head_timeout: Duration
    pub body_timeout: Duration
    pub write_timeout: Duration
    pub response_timeout: Duration
    pub drain_timeout: Duration
    pub max_requests: i64
    pub events: Option[ChannelSink]
    pub handshake_timeout: Duration
    pub idle_connections: i64

pub def config() -> Config:
    Config(4, 16, std.http.limits(), seconds(5u32), seconds(10u32), seconds(30u32), seconds(10u32), seconds(60u32), seconds(5u32), 1000, Nothing, seconds(10u32), 256)

# Counts for one connection, one worker, or a whole run of `serve`.
pub class Report:
    pub connections: u64
    pub rejected: u64
    pub requests: u64
    pub handler_errors: u64
    pub protocol_errors: u64
    pub timeouts: u64
    pub cancelled: u64
    pub accept_errors: u64
    pub dropped_events: u64

def empty_report() -> Report:
    Report(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64)

def merge(total: &mut Report, part: &Report) -> ():
    total.connections += part.connections
    total.rejected += part.rejected
    total.requests += part.requests
    total.handler_errors += part.handler_errors
    total.protocol_errors += part.protocol_errors
    total.timeouts += part.timeouts
    total.cancelled += part.cancelled
    total.accept_errors += part.accept_errors
    total.dropped_events += part.dropped_events

def allocated[T](result: Result[T, AllocError]) -> Result[T, ServerError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(ServerError.Allocation(cause))

def http_allocated[T](result: Result[T, AllocError]) -> Result[T, HttpError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(HttpError.Allocation(cause))

def http_bytes[T](result: Result[T, BytesError]) -> Result[T, HttpError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(HttpError.Allocation(cause))
                case _:
                    Err(HttpError.Stream(StreamError.OutOfRange))

# Deadlines are kept as monotonic nanoseconds so they can be stored and
# compared without copying Deadline values.
def now_ns() -> u64:
    monotonic_now().saturating_duration_since(&instant_at(0u64)).as_nanoseconds()

def after(start: u64, budget: u64) -> u64:
    if budget > u64.MAX - start:
        return u64.MAX
    start + budget

def deadline_of(at: u64) -> Deadline:
    deadline_at(&instant_at(at))

def least(left: u64, right: u64) -> u64:
    if left < right:
        return left
    right

# Routing

# `{name}` captures one nonempty segment; a final `{name...}` captures the
# rest of the path, possibly empty. Other segments match exactly.
const literal: i64 = 0
const capture: i64 = 1
const rest: i64 = 2

class Segment:
    text: str
    kind: i64

class Entry[R]:
    method: str
    segments: list[Segment]
    route: R

# `Found` holds the index of the matched route, in the order routes were
# added (see `Router.route`), and its captures.
pub enum Match:
    Found(i64, list[str])
    NotFound
    MethodNotAllowed(str)

# Routes map a method and path pattern to a value of the application's route
# type `R`, normally an enum, which the handler receives.
pub class Router[R]:
    _routes: list[Entry[R]]

    # Adds a route. `method` is a request method, or `*` for any; `pattern`
    # starts with `/`. Routes are tried in the order they were added. Several
    # patterns may carry equal route values.
    pub def add(self: &mut Router[R], method: &str, pattern: &str, route: R) -> Result[(), ServerError]:
        if not valid_method(method):
            return Err(ServerError.InvalidPattern)
        if not pattern.startswith("/"):
            return Err(ServerError.InvalidPattern)
        segments = parse_pattern(pattern)?
        for index in range(len(self._routes)):
            entry = &self._routes[index]
            if entry.method == method and same_segments(&entry.segments, &segments):
                return Err(ServerError.DuplicateRoute)
        allocated(self._routes.append(Entry(*method, segments, route)))

    # The first route whose pattern matches `path` and whose method is
    # `method` or `*`; a GET route also answers HEAD. Captures are returned
    # percent-encoded, as they appear in the path.
    pub def find(self, method: &str, path: &str) -> Result[Match, ServerError]:
        pieces = allocated(path.split("/"))?
        mut allowed: list[str] = allocated(list[str].new())?
        for index in range(len(self._routes)):
            entry = &self._routes[index]
            if matches(&entry.segments, &pieces):
                if entry.method == "*" or entry.method == method or (method == "HEAD" and entry.method == "GET"):
                    return Ok(Match.Found(index, captured(&entry.segments, &pieces)?))
                if not listed(&allowed, &entry.method):
                    allocated(allowed.append(entry.method))?
        if len(allowed) == 0:
            return Ok(Match.NotFound)
        if listed(&allowed, "GET") and not listed(&allowed, "HEAD"):
            allocated(allowed.append("HEAD"))?
        Ok(Match.MethodNotAllowed(allocated(", ".join(&allowed))?))

    # The value of the route at `index`, as `Match.Found` reports it.
    pub def route(self, index: i64) -> &R:
        &self._routes[index].route

# An empty router for route type `R`: `router[Route]()`.
pub def router[R]() -> Result[Router[R], ServerError]:
    Ok(Router(allocated(list[Entry[R]].new())?))

def valid_method(method: &str) -> bool:
    if method == "*":
        return True
    if method.byte_len() == 0:
        return False
    for scalar in method:
        if not (scalar.isalpha() or scalar.isdigit() or scalar == "-" or scalar == "_" or scalar == "."):
            return False
    True

def listed(values: &list[str], value: &str) -> bool:
    for index in range(len(values)):
        if values[index] == value:
            return True
    False

def valid_name(name: &str) -> bool:
    if name.byte_len() == 0:
        return False
    for scalar in name:
        if not (scalar.isalpha() or scalar.isdigit() or scalar == "_"):
            return False
    True

def parse_pattern(pattern: &str) -> Result[list[Segment], ServerError]:
    pieces = allocated(pattern.split("/"))?
    mut segments: list[Segment] = allocated(list[Segment].new())?
    # pieces[0] is the empty text before the leading `/`.
    for index in range(1, len(pieces)):
        piece = &pieces[index]
        if piece.startswith("{") and piece.endswith("}"):
            inner = allocated(piece.slice(1, -1))?
            if inner.endswith("..."):
                name = allocated(inner.slice(0, -3))?
                if index != len(pieces) - 1 or not valid_name(&name):
                    return Err(ServerError.InvalidPattern)
                allocated(segments.append(Segment(name, rest)))?
            else:
                if not valid_name(&inner):
                    return Err(ServerError.InvalidPattern)
                allocated(segments.append(Segment(inner, capture)))?
        else:
            if "{" in piece or "}" in piece or "?" in piece:
                return Err(ServerError.InvalidPattern)
            allocated(segments.append(Segment(*piece, literal)))?
    Ok(segments)

def same_segments(left: &list[Segment], right: &list[Segment]) -> bool:
    if len(left) != len(right):
        return False
    for index in range(len(left)):
        if left[index].kind != right[index].kind:
            return False
        if left[index].kind == literal and left[index].text != right[index].text:
            return False
    True

# `pieces` is the path split at `/`, so pieces[0] is empty.
def matches(segments: &list[Segment], pieces: &list[str]) -> bool:
    count = len(pieces) - 1
    for index in range(len(segments)):
        segment = &segments[index]
        if segment.kind == rest:
            return True
        if index >= count:
            return False
        piece = &pieces[index + 1]
        if segment.kind == capture:
            if piece.byte_len() == 0:
                return False
        elif piece != segment.text:
            return False
    len(segments) == count

def captured(segments: &list[Segment], pieces: &list[str]) -> Result[list[str], ServerError]:
    mut params: list[str] = allocated(list[str].new())?
    for index in range(len(segments)):
        segment = &segments[index]
        if segment.kind == capture:
            allocated(params.append(pieces[index + 1]))?
        elif segment.kind == rest:
            mut joined: list[str] = allocated(list[str].new())?
            for later in range(index + 1, len(pieces)):
                allocated(joined.append(pieces[later]))?
            allocated(params.append(allocated("/".join(&joined))?))?
    Ok(params)

# Request heads

const line_feed: u8 = 10u8
const carriage_return: u8 = 13u8
# Bytes read at a time while a head is gathered.
const read_chunk: i64 = 4096

# Input read ahead of the parser: the start of a request head at data[0],
# and how far `scanned` has searched it for the head's end.
class Gathered:
    data: Bytes
    # Start of the line being searched; data[line:searched] holds no LF.
    line: i64
    searched: i64
    # What `max_head` leaves for the line at `line`.
    left: i64
    # -1 before the request line, then the field lines seen.
    fields: i64

def gathered(data: Bytes, limits: &Limits) -> Gathered:
    Gathered(data, 0, 0, limits.max_head, -1)

# Whether std.http.read_request could finish on `input.data` without
# reading more, as it will once the head's final empty line has arrived or
# input it rejects has. This follows the parser's framing: lines end at LF;
# each is bounded by `max_line` and by what is left of `max_head`, which
# blank lines before the request line also use; a line without CR before
# its LF, a line over its bound, and a field line past `max_headers` are
# rejected. Searching resumes where the last call stopped.
def scanned(input: &mut Gathered, limits: &Limits) -> bool:
    size = input.data.len()
    while True:
        mut limit = input.left
        if limits.max_line < limit:
            limit = limits.max_line
        if limit <= 0:
            return True
        bound = input.line + limit
        mut end = size
        if bound < end:
            end = bound
        found = match input.data.find(line_feed, input.searched, end):
            case Ok(position):
                position
            case Err(_):
                return True
        match found:
            case Some(index):
                count = index + 1 - input.line
                if count < 2 or input.data[index - 1] != carriage_return:
                    return True
                input.left -= count
                input.line = index + 1
                input.searched = input.line
                if count == 2:
                    if input.fields >= 0:
                        return True
                elif input.fields < 0:
                    input.fields = 0
                elif input.fields >= limits.max_headers:
                    return True
                else:
                    input.fields += 1
            case Nothing:
                input.searched = end
                return end == bound
    True

def net_bytes[T](result: Result[T, BytesError]) -> Result[T, NetError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(BytesError.Allocation(cause)):
            Err(NetError.Stream(StreamError.Allocation(cause)))
        case Err(_):
            Err(NetError.Stream(StreamError.OutOfRange))

# Appends input that has already arrived to `input.data`, without waiting.
# Zero is the end of the peer's stream; TimedOut means nothing has arrived.
# An empty buffer starts at `read_chunk`; a full one doubles, so a head
# trickling in costs about twice its size, and never grows past `max_head`,
# the most `scanned` needs.
def read_ahead[T: Transport](stream: &mut T, input: &mut Gathered, limits: &Limits, token: &CancellationToken) -> Result[i64, NetError]:
    have = input.data.len()
    if have >= limits.max_head:
        return Err(NetError.Stream(StreamError.OutOfRange))
    if input.data.capacity() <= have:
        mut size = input.data.capacity() * 2
        if size == 0:
            size = read_chunk
        if size > limits.max_head:
            size = limits.max_head
        mut grown = net_bytes(std.bytes.with_capacity(size))?
        net_bytes(grown.extend(&input.data))?
        input.data = grown
    mut room = input.data.capacity() - have
    if room > read_chunk:
        room = read_chunk
    if room > limits.max_head - have:
        room = limits.max_head - have
    net_bytes(input.data.resize(have + room, 0u8))?
    match stream.read_before(&mut input.data, have, have + room, &deadline_of(0u64), token):
        case Ok(count):
            drop(input.data.truncate(have + count))
            Ok(count)
        case Err(error):
            drop(input.data.truncate(have))
            Err(error)

# Reads what has arrived of a request head until the parser could take it
# without waiting (true) or nothing more has arrived (false). The end of
# input also gives true: the parser then meets it.
def gather[T: Transport](stream: &mut T, input: &mut Gathered, limits: &Limits, token: &CancellationToken) -> Result[bool, NetError]:
    while not scanned(input, limits):
        match read_ahead(stream, input, limits, token):
            case Ok(0):
                return Ok(True)
            case Ok(_):
                pass
            case Err(NetError.TimedOut):
                return Ok(False)
            case Err(error):
                return Err(error)
    Ok(True)

# Connections

def send_all[T: Transport, S: ByteSource](stream: &mut T, source: &S, start: i64, stop: i64, span: u64, until: u64, cancel: &CancellationToken) -> Result[(), NetError]:
    mut at = start
    while at < stop:
        limit = least(after(now_ns(), span), until)
        count = stream.write_before(source, at, stop, &deadline_of(limit), cancel)?
        if count <= 0:
            return Err(NetError.Stream(StreamError.WriteZero))
        at += count
    Ok(())

def read_some[T: Transport](stream: &mut Option[T], buffer: &mut Bytes, start: i64, stop: i64, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, NetError]:
    match stream:
        case Some(open):
            open.read_before(buffer, start, stop, deadline, cancel)
        case Nothing:
            Err(NetError.Stream(StreamError.Io(IoError.Closed)))

def send_some[T: Transport, S: ByteSource](stream: &mut Option[T], source: &S, start: i64, stop: i64, span: u64, until: u64, cancel: &CancellationToken) -> Result[(), NetError]:
    match stream:
        case Some(open):
            send_all(open, source, start, stop, span, until, cancel)
        case Nothing:
            Err(NetError.Stream(StreamError.Io(IoError.Closed)))

# Lingering close: closing a socket with request input unread resets the
# connection, and the client can lose the answer it has not yet read. So
# after a response that may leave input unread, the server ends its output
# and discards input until the client ends its own, `linger_bytes` have
# gone, or `linger_ns` (at most `write_timeout`) has passed. A reverse proxy
# forwards a body up to its own limit even after the answer, and reports
# `502` instead of that answer when the connection resets under it, so the
# byte budget covers common proxy body limits; the time limit bounds it.
const linger_ns: u64 = 2000000000u64
const linger_bytes: i64 = 16777216
const discard_chunk: i64 = 4096

def linger_span(config: &Config) -> u64:
    least(config.write_timeout.as_nanoseconds(), linger_ns)

# Reads and discards input into `buffer` until it ends or fails (0), `left`
# bytes have gone (0), or nothing more arrives by `until`: the bytes still
# allowed.
def discard[T: Transport](stream: &mut T, buffer: &mut Bytes, left: i64, until: u64, cancel: &CancellationToken) -> i64:
    size = buffer.len()
    mut rest = left
    while rest > 0:
        match stream.read_before(buffer, 0, size, &deadline_of(until), cancel):
            case Ok(0):
                return 0
            case Ok(count):
                rest -= count
            case Err(NetError.TimedOut):
                return rest
            case Err(_):
                return 0
    0

# A std.io Reader and Writer over a Transport, bounded by the deadline of the
# current phase. Reads take gathered input first. Waiting for a request uses
# the idle deadline and wakes on `stop`; reading a request and writing a
# response use phase deadlines and wake on `cancel`. Writes are staged in
# `out` and sent by `flush`. The cause of a failed read or write is kept in
# `failure`.
pub class Conn[T]:
    # Nothing once the stream has been handed back for parking.
    _stream: Option[T]
    # Input read ahead of the parser; data[_at:] is not yet read.
    _input: Gathered
    _at: i64
    _stop: CancellationToken
    _cancel: CancellationToken
    _idle: bool
    _idle_until: u64
    _head_span: u64
    _until: u64
    _write_span: u64
    _write_until: u64
    _out: Bytes
    _out_limit: i64
    _failure: Option[NetError]

    def noted(self: &mut Conn[T], error: NetError) -> StreamError:
        self._failure = Some(error)
        StreamError.Io(IoError.Other)

    pub def read(self: &mut Conn[T], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        unread = self._input.data.len() - self._at
        if unread > 0 and stop > start:
            mut count = stop - start
            if count > unread:
                count = unread
            match buffer.overwrite(start, &self._input.data, self._at, self._at + count):
                case Ok(_):
                    self._at += count
                    return Ok(count)
                case Err(BytesError.Allocation(cause)):
                    return Err(StreamError.Allocation(cause))
                case Err(_):
                    return Err(StreamError.OutOfRange)
        if not self._idle:
            match read_some(&mut self._stream, buffer, start, stop, &deadline_of(self._until), &self._cancel):
                case Ok(count):
                    return Ok(count)
                case Err(error):
                    return Err(self.noted(error))
        mut outcome: Result[i64, NetError] = Err(NetError.Cancelled)
        if not self._stop.is_cancelled():
            outcome = read_some(&mut self._stream, buffer, start, stop, &deadline_of(self._idle_until), &self._stop)
        if self._stop.is_cancelled() and outcome.is_err():
            # Stopping: serve a request that has already arrived, but wait
            # for nothing.
            outcome = read_some(&mut self._stream, buffer, start, stop, &deadline_of(0u64), &self._cancel)
        match outcome:
            case Ok(count):
                if count > 0:
                    self._idle = False
                    self._until = after(now_ns(), self._head_span)
                Ok(count)
            case Err(error):
                Err(self.noted(error))

    pub def write[S: ByteSource](self: &mut Conn[T], source: &S, start: i64, stop: i64) -> Result[i64, StreamError]:
        if start < 0 or start > stop or stop > source.len():
            return Err(StreamError.OutOfRange)
        if self._out.len() + (stop - start) > self._out_limit:
            self.flush()?
            if stop - start >= self._out_limit:
                match send_some(&mut self._stream, source, start, stop, self._write_span, self._write_until, &self._cancel):
                    case Ok(_):
                        return Ok(stop - start)
                    case Err(error):
                        return Err(self.noted(error))
        match self._out.extend_range(source, start, stop):
            case Ok(_):
                Ok(stop - start)
            case Err(error):
                match error:
                    case BytesError.Allocation(cause):
                        Err(StreamError.Allocation(cause))
                    case _:
                        Err(StreamError.OutOfRange)

    pub def flush(self: &mut Conn[T]) -> Result[(), StreamError]:
        size = self._out.len()
        if size == 0:
            return Ok(())
        outcome = send_some(&mut self._stream, &self._out, 0, size, self._write_span, self._write_until, &self._cancel)
        self._out.clear()
        match outcome:
            case Ok(_):
                Ok(())
            case Err(error):
                Err(self.noted(error))

def flushed(result: Result[(), StreamError]) -> Result[(), HttpError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(cause):
            match cause:
                case StreamError.Allocation(inner):
                    Err(HttpError.Allocation(inner))
                case _ as other:
                    Err(HttpError.Stream(other))

# Response states.
const unanswered: i64 = 0
const sized: i64 = 1
const chunked: i64 = 2
const closing: i64 = 3
const ended: i64 = 4
const broken: i64 = 5

# One request and its response. Read the body with `read_body` or `read_all`,
# then answer once with `send`, `send_text` or `respond`, or stream with
# `start`, `write` and `end`. Answering before the body has been read to its
# end closes the connection after the response.
pub class Exchange[T]:
    pub request: RequestHead
    # `host[:port]` the request names: the absolute-form target's authority,
    # else its Host value (empty only for HTTP/1.0 without Host).
    pub authority: str
    pub path: str
    pub query: str
    pub params: list[str]
    # The connection's remote address: the client, or the proxy in front of
    # it (see std.http.proxy). `Nothing` when the transport has none.
    pub peer: Option[SocketAddress]
    _body: Option[BodyReader[Conn[T]]]
    _conn: Option[BufReader[Conn[T]]]
    _framing: Framing
    _limits: Limits
    _stop: CancellationToken
    _cancel: CancellationToken
    _state: i64
    _remaining: i64
    _head_only: bool
    _keep: bool
    _status: i64
    _sent: i64
    _expects: bool
    _unread: bool
    _refusal: i64

    # Server shutdown has begun; a long response should end soon.
    pub def stopping(self) -> bool:
        self._stop.is_cancelled()

    # The drain deadline has passed; every further read or write fails.
    pub def cancelled(self) -> bool:
        self._cancel.is_cancelled()

    # The status sent, or 0 before the response starts.
    pub def status(self) -> i64:
        self._status

    # Response body bytes written so far; always 0 for HEAD.
    pub def sent(self) -> i64:
        self._sent

    # Fills part of buffer[start:stop] with request body bytes; 0 is the end.
    pub def read_body(self: &mut Exchange[T], buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, HttpError]:
        self.interim()?
        outcome: Result[i64, HttpError] = match &mut self._body:
            case Some(body):
                body.read_body(buffer, start, stop)
            case Nothing:
                Err(HttpError.Broken)
        self.noted(outcome)

    # Appends the rest of the request body to `out`, within `max_body`.
    pub def read_all(self: &mut Exchange[T], out: &mut Bytes) -> Result[i64, HttpError]:
        self.interim()?
        outcome: Result[i64, HttpError] = match &mut self._body:
            case Some(body):
                std.http.read_to_end(body, out)
            case Nothing:
                Err(HttpError.Broken)
        self.noted(outcome)

    # Remembers how to answer a request whose body could not be read, should
    # the handler then fail without answering.
    def noted(self: &mut Exchange[T], outcome: Result[i64, HttpError]) -> Result[i64, HttpError]:
        match &outcome:
            case Err(HttpError.BodyTooLarge):
                self._refusal = 413
            case Err(HttpError.Stream(_)):
                self._refusal = 408
            case Err(HttpError.Allocation(_)):
                pass
            case Err(HttpError.Broken):
                pass
            case Err(_):
                self._refusal = 400
            case Ok(_):
                pass
        outcome

    # Sends `100 Continue` before the first body read when the client asked
    # for it. Nothing has been read yet, so the body reader is rebuilt fresh.
    def interim(self: &mut Exchange[T]) -> Result[(), HttpError]:
        if not self._expects:
            return Ok(())
        self._expects = False
        mut taken: Option[BufReader[Conn[T]]] = Nothing
        match &mut self._body:
            case Some(body):
                taken = std.http.release(body)
            case Nothing:
                return Err(HttpError.Broken)
        match taken:
            case Some(conn):
                mut owned = conn
                head = std.http.response(100, "Continue")?
                std.http.write_response(&mut owned.inner, &head)?
                flushed(owned.inner.flush())?
                self._body = Some(std.http.body_reader(owned, &self._framing, &self._limits)?)
                Ok(())
            case Nothing:
                Err(HttpError.Broken)

    # Takes the connection from the body reader to write the response. An
    # unread body leaves the connection unusable for another request.
    def connection(self: &mut Exchange[T]) -> Result[(), HttpError]:
        if self._conn.is_some():
            return Ok(())
        mut taken: Option[BufReader[Conn[T]]] = Nothing
        match &mut self._body:
            case Some(body):
                if body.is_done():
                    match std.http.finish(body):
                        case Ok(conn):
                            taken = Some(conn)
                        case Err(_):
                            pass
                if taken.is_none():
                    self._keep = False
                    self._unread = True
                    taken = std.http.release(body)
            case Nothing:
                pass
        self._body = Nothing
        match taken:
            case Some(conn):
                self._conn = Some(conn)
                Ok(())
            case Nothing:
                Err(HttpError.Broken)

    # Adds the Connection field and writes the head.
    def begin(self: &mut Exchange[T], head: &mut ResponseHead) -> Result[(), HttpError]:
        if self._state != unanswered:
            return Err(HttpError.Broken)
        if head.status < 200 or head.status > 999:
            return Err(HttpError.InvalidStatusLine)
        self.connection()?
        if self._stop.is_cancelled():
            self._keep = False
        if not self._keep:
            head.add("Connection", "close")?
        elif self.request.minor == 0:
            head.add("Connection", "keep-alive")?
        self._status = head.status
        self._state = broken
        match &mut self._conn:
            case Some(conn):
                std.http.write_response(&mut conn.inner, head)
            case Nothing:
                Err(HttpError.Broken)

    def put(self: &mut Exchange[T], source: &Bytes, start: i64, stop: i64, framed: bool) -> Result[(), HttpError]:
        if self._head_only:
            return Ok(())
        match &mut self._conn:
            case Some(conn):
                if framed:
                    std.http.write_chunk(&mut conn.inner, source, start, stop)
                else:
                    match std.io.write_all(&mut conn.inner, source, start, stop):
                        case Ok(_):
                            Ok(())
                        case Err(partial):
                            flushed(Err(partial.cause))
            case Nothing:
                Err(HttpError.Broken)

    def flush(self: &mut Exchange[T]) -> Result[(), HttpError]:
        match &mut self._conn:
            case Some(conn):
                flushed(conn.inner.flush())
            case Nothing:
                Err(HttpError.Broken)

    # Sends a whole response: `head` plus `body`, with Content-Length added.
    # `head` must not declare framing itself.
    pub def respond(self: &mut Exchange[T], head: ResponseHead, body: &Bytes) -> Result[(), HttpError]:
        mut owned = head
        if std.http.find(&owned.headers, "content-length").is_some() or std.http.find(&owned.headers, "transfer-encoding").is_some():
            return Err(HttpError.ConflictingFraming)
        bodiless = owned.status == 204 or owned.status == 304
        if bodiless and body.len() != 0:
            return Err(HttpError.LengthMismatch)
        if not bodiless:
            size = http_allocated(str.from(body.len()))?
            owned.add("Content-Length", size)?
        self.begin(&mut owned)?
        self.put(body, 0, body.len(), False)?
        self.flush()?
        if not self._head_only:
            self._sent = body.len()
        self._state = ended
        Ok(())

    # Sends `body` with the given status and Content-Type.
    pub def send(self: &mut Exchange[T], status: i64, content_type: &str, body: &Bytes) -> Result[(), HttpError]:
        mut head = std.http.response(status, reason(status))?
        head.add("Content-Type", *content_type)?
        self.respond(head, body)

    # Sends UTF-8 text as text/plain.
    pub def send_text(self: &mut Exchange[T], status: i64, text: &str) -> Result[(), HttpError]:
        body = http_bytes(std.bytes.from_text(text))?
        self.send(status, "text/plain; charset=utf-8", &body)

    # Starts a streamed response. A head with Content-Length streams exactly
    # that many bytes; otherwise the body is chunked, or for an HTTP/1.0
    # client runs until the connection closes.
    pub def start(self: &mut Exchange[T], head: ResponseHead) -> Result[(), HttpError]:
        mut owned = head
        if std.http.find(&owned.headers, "transfer-encoding").is_some():
            return Err(HttpError.ConflictingFraming)
        mut next = sized
        mut size = 0
        match std.http.response_framing(&owned, "GET")?:
            case Framing.Length(declared):
                size = declared
            case _:
                if owned.status == 204 or owned.status == 304:
                    size = 0
                elif self.request.minor == 1:
                    owned.add("Transfer-Encoding", "chunked")?
                    next = chunked
                else:
                    self._keep = False
                    next = closing
        self.begin(&mut owned)?
        self.flush()?
        self._remaining = size
        self._state = next
        Ok(())

    # Sends source[start:stop] of a streamed response and flushes it.
    pub def write(self: &mut Exchange[T], source: &Bytes, start: i64, stop: i64) -> Result[(), HttpError]:
        if self._state != sized and self._state != chunked and self._state != closing:
            return Err(HttpError.Broken)
        if start < 0 or start > stop or stop > source.len():
            return Err(HttpError.Stream(StreamError.OutOfRange))
        if self._state == sized and stop - start > self._remaining:
            return Err(HttpError.LengthMismatch)
        state = self._state
        self._state = broken
        self.put(source, start, stop, state == chunked)?
        self.flush()?
        self._remaining -= stop - start
        if not self._head_only:
            self._sent += stop - start
        self._state = state
        Ok(())

    # Ends a streamed response. A sized response must have sent every byte,
    # except for HEAD, whose Content-Length describes a body never sent.
    pub def end(self: &mut Exchange[T]) -> Result[(), HttpError]:
        if self._state == sized:
            if self._remaining != 0 and not self._head_only:
                self._state = broken
                return Err(HttpError.LengthMismatch)
        elif self._state == chunked:
            self._state = broken
            if not self._head_only:
                match &mut self._conn:
                    case Some(conn):
                        trailers = http_allocated(list[Header].new())?
                        std.http.write_last_chunk(&mut conn.inner, &trailers)?
                    case Nothing:
                        return Err(HttpError.Broken)
            self.flush()?
        elif self._state != closing:
            return Err(HttpError.Broken)
        self._state = ended
        Ok(())

pub def reason(status: i64) -> str:
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 204:
        return "No Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 304:
        return "Not Modified"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 408:
        return "Request Timeout"
    if status == 413:
        return "Content Too Large"
    if status == 414:
        return "URI Too Long"
    if status == 415:
        return "Unsupported Media Type"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 500:
        return "Internal Server Error"
    if status == 501:
        return "Not Implemented"
    if status == 503:
        return "Service Unavailable"
    if status == 505:
        return "HTTP Version Not Supported"
    ""

# Serving connections

def shared_sink(events: &Option[ChannelSink]) -> Option[ChannelSink]:
    match events:
        case Some(sink):
            Some(sink.share())
        case Nothing:
            Nothing

def emit(events: &mut Option[ChannelSink], level: Level, message: str, fields: list[Field], report: &mut Report) -> ():
    match events:
        case Some(sink):
            match sink.emit(std.log.event(level, message, fields)):
                case Ok(_):
                    pass
                case Err(_):
                    report.dropped_events += 1u64
        case Nothing:
            pass

# One access event per answered request: method, target, status, body bytes
# sent and microseconds from head to the end of the response.
def access[T](events: &mut Option[ChannelSink], exchange: &Exchange[T], started: u64, report: &mut Report) -> ():
    if events.is_none():
        return
    elapsed = (now_ns() - started) // 1000u64
    match access_fields(exchange, elapsed):
        case Ok(fields):
            emit(events, Level.Info, "request", fields, report)
        case Err(_):
            report.dropped_events += 1u64

def access_fields[T](exchange: &Exchange[T], elapsed: u64) -> Result[list[Field], AllocError]:
    mut fields = list[Field].new()?
    fields.append(std.log.text("method", exchange.request.method))?
    fields.append(std.log.text("target", exchange.request.target))?
    fields.append(std.log.integer("status", exchange._status))?
    fields.append(std.log.integer("bytes", exchange._sent))?
    fields.append(std.log.unsigned("micros", elapsed))?
    Ok(fields)

def problem(events: &mut Option[ChannelSink], message: str, status: i64, report: &mut Report) -> ():
    if events.is_none():
        return
    match list[Field].new():
        case Ok(fields):
            mut owned = fields
            match owned.append(std.log.integer("status", status)):
                case Ok(_):
                    emit(events, Level.Warn, message, owned, report)
                case Err(_):
                    report.dropped_events += 1u64
        case Err(_):
            report.dropped_events += 1u64

def count_failure(failure: &Option[NetError], events: &mut Option[ChannelSink], report: &mut Report) -> ():
    match failure:
        case Some(NetError.TimedOut):
            report.timeouts += 1u64
            problem(events, "timed out", 408, report)
        case Some(NetError.Cancelled):
            report.cancelled += 1u64
            problem(events, "cancelled", 0, report)
        case _:
            pass

def error_status(error: &HttpError) -> i64:
    match error:
        case HttpError.LineTooLong:
            431
        case HttpError.HeadTooLarge:
            431
        case HttpError.TooManyHeaders:
            431
        case HttpError.BodyTooLarge:
            413
        case HttpError.UnsupportedVersion:
            505
        case HttpError.UnsupportedTransferEncoding:
            501
        case _:
            400

# A whole response written by the server itself, always closing the
# connection.
def refuse[T: Transport](conn: &mut Conn[T], status: i64, allow: &str) -> Result[(), HttpError]:
    mut head = std.http.response(status, reason(status))?
    text = reason(status)
    head.add("Content-Type", "text/plain; charset=utf-8")?
    head.add("Content-Length", http_allocated(str.from(text.byte_len() + 1))?)?
    if allow.byte_len() > 0:
        head.add("Allow", *allow)?
    head.add("Connection", "close")?
    std.http.write_response(conn, &head)?
    body = http_bytes(std.bytes.from_text(&http_allocated(text.concat("\n"))?))?
    match std.io.write_all(conn, &body, 0, body.len()):
        case Ok(_):
            pass
        case Err(partial):
            return flushed(Err(partial.cause))
    flushed(conn.flush())

def decoded(params: &list[str]) -> Option[list[str]]:
    match list[str].new():
        case Ok(empty):
            mut out = empty
            for index in range(len(params)):
                match std.url.decode(&params[index]):
                    case Ok(text):
                        if out.append(text).is_err():
                            return Nothing
                    case Err(_):
                        return Nothing
            Some(out)
        case Err(_):
            Nothing

def wants_continue(head: &RequestHead) -> bool:
    if head.minor != 1:
        return False
    match std.http.find(&head.headers, "expect"):
        case Some(index):
            match head.headers[index].value.lower():
                case Ok(value):
                    value == "100-continue"
                case Err(_):
                    False
        case Nothing:
            False

def copy_limits(limits: &Limits) -> Limits:
    Limits(limits.max_line, limits.max_head, limits.max_headers, limits.max_body)

# Outcome of one request on a connection.
const next_request: i64 = 0
const close_connection: i64 = 1

# Restarts the search for the end of a head at input.data[0].
def restart(input: &mut Gathered, limits: &Limits) -> ():
    input.line = 0
    input.searched = 0
    input.left = limits.max_head
    input.fields = -1

# Puts input the reader holds but has not consumed in front of the
# connection's own unread input, so the next head starts at data[0]. False
# when that cannot allocate.
def unread[T](reader: &mut BufReader[Conn[T]], limits: &Limits) -> bool:
    held = reader.buffered()
    at = reader.inner._at
    size = reader.inner._input.data.len()
    if held == 0 and at == size:
        reader.inner._input.data.clear()
    elif held > 0 or at > 0:
        mut merged = match std.bytes.with_capacity(held + size - at):
            case Ok(bytes):
                bytes
            case Err(_):
                return False
        if merged.resize(held, 0u8).is_err():
            return False
        # Taken from the reader's buffer; the stream is not read.
        if held > 0 and reader.read(&mut merged, 0, held).is_err():
            return False
        if merged.extend_range(&reader.inner._input.data, at, size).is_err():
            return False
        reader.inner._input.data = merged
    reader.inner._at = 0
    restart(&mut reader.inner._input, limits)
    True

# A connection handed back to wait on the accepting thread: the stream,
# what has arrived of its next request, and when to stop waiting. The
# partial head is copied to fit, as it may wait long.
def waiting[T](conn: &mut Conn[T], idle_ns: u64) -> Option[tuple[T, Option[Gathered], u64, i64]]:
    stream = match replace(conn._stream, Nothing):
        case Some(open):
            open
        case Nothing:
            return Nothing
    if conn._input.data.len() == 0:
        return Some((stream, Nothing, after(now_ns(), idle_ns), 0))
    match conn._input.data.copy():
        case Ok(data):
            Some((stream, Some(Gathered(data, conn._input.line, conn._input.searched, conn._input.left, conn._input.fields)), conn._until, 0))
        case Err(_):
            Nothing

# Closes a connection after a response that may leave request input unread:
# ends its output, then discards input (see `linger_ns`). With `park` the
# stream is returned instead, to discard on the accepting thread with the
# deadline and byte budget it carries.
def linger[T: Transport](conn: &mut Conn[T], park: bool, config: &Config) -> Option[tuple[T, Option[Gathered], u64, i64]]:
    mut stream = match replace(conn._stream, Nothing):
        case Some(open):
            open
        case Nothing:
            return Nothing
    if stream.shutdown(Shutdown.Write).is_err():
        return Nothing
    until = after(now_ns(), linger_span(config))
    if park:
        return Some((stream, Nothing, until, linger_bytes))
    match std.bytes.with_capacity(discard_chunk):
        case Ok(scratch):
            mut buffer = scratch
            if buffer.resize(discard_chunk, 0u8).is_ok():
                drop(discard(&mut stream, &mut buffer, linger_bytes, until, &conn._cancel))
        case Err(_):
            pass
    Nothing

# Serves every request on one connection until it closes, fails, reaches
# `max_requests`, or shutdown finds it idle. Never fails: problems are
# answered on the wire where possible and counted in `report`. With `park`,
# no head is waited for: a connection whose next head has not wholly
# arrived is returned with the part that has, to wait on the accepting
# thread, as is one to close lingering, with its discard budget (otherwise
# 0). `input` is a head that arrived while it waited there, and `until`
# that head's deadline. `served` counts its requests.
def connection[T: Transport, R, H: Handler[T, R]](stream: T, input: Option[Gathered], until: u64, served: &mut i64, park: bool, peer: &Option[SocketAddress], router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, events: &mut Option[ChannelSink], report: &mut Report) -> Option[tuple[T, Option[Gathered], u64, i64]]:
    out = match std.bytes.with_capacity(4096):
        case Ok(bytes):
            bytes
        case Err(_):
            return Nothing
    head_span = config.head_timeout.as_nanoseconds()
    mut carried = False
    start = match input:
        case Some(found):
            carried = found.data.len() > 0
            found
        case Nothing:
            match std.bytes.empty():
                case Ok(bytes):
                    gathered(bytes, &config.limits)
                case Err(_):
                    return Nothing
    conn = Conn(Some(stream), start, 0, stop.share(), cancel.share(), True, 0u64, head_span, until, config.write_timeout.as_nanoseconds(), u64.MAX, out, 4096, Nothing)
    mut reader = match std.io.buffered_reader(conn, 4096):
        case Ok(buffered):
            buffered
        case Err(_):
            return Nothing
    while *served < config.max_requests:
        if not unread(&mut reader, &config.limits):
            return Nothing
        # Input left by the previous request has started the next one, so
        # its head deadline runs from now and an end or stall inside it is
        # answered. A carried head keeps the deadline it was parked with.
        if reader.inner._input.data.len() > 0 and not carried:
            reader.inner._until = after(now_ns(), head_span)
        carried = False
        if park and not stop.is_cancelled():
            had = reader.inner._input.data.len()
            gathering = match &mut reader.inner._stream:
                case Some(open):
                    gather(open, &mut reader.inner._input, &config.limits, &reader.inner._cancel)
                case Nothing:
                    return Nothing
            if had == 0 and reader.inner._input.data.len() > 0:
                reader.inner._until = after(now_ns(), head_span)
            match gathering:
                case Ok(True):
                    pass
                case Ok(False):
                    return waiting(&mut reader.inner, config.idle_timeout.as_nanoseconds())
                case Err(error):
                    if reader.inner._input.data.len() > 0:
                        count_failure(&Some(error), events, report)
                    return Nothing
            # Whatever the head needs is here, or the input has ended.
            reader.inner._idle_until = 0u64
        else:
            reader.inner._idle_until = after(now_ns(), config.idle_timeout.as_nanoseconds())
        reader.inner._idle = reader.inner._input.data.len() == 0
        reader.inner._write_until = u64.MAX
        reader.inner._failure = Nothing
        head = match std.http.read_request(&mut reader, &config.limits):
            case Ok(Some(found)):
                found
            case Ok(Nothing):
                return Nothing
            case Err(error):
                # Waiting for a request that never starts is not an error;
                # a failure after its first byte is.
                if reader.inner._idle:
                    return Nothing
                if reader.inner._failure.is_some():
                    count_failure(&reader.inner._failure, events, report)
                    timed_out = match &reader.inner._failure:
                        case Some(NetError.TimedOut):
                            True
                        case _:
                            False
                    if timed_out:
                        reader.inner._write_until = after(now_ns(), config.write_timeout.as_nanoseconds())
                        if refuse(&mut reader.inner, 408, "").is_ok():
                            return linger(&mut reader.inner, park and not stop.is_cancelled(), config)
                    return Nothing
                report.protocol_errors += 1u64
                status = error_status(&error)
                reader.inner._write_until = after(now_ns(), config.write_timeout.as_nanoseconds())
                answered = refuse(&mut reader.inner, status, "").is_ok()
                problem(events, "bad request", status, report)
                if answered:
                    return linger(&mut reader.inner, park and not stop.is_cancelled(), config)
                return Nothing
        *served += 1
        report.requests += 1u64
        mut lingering = False
        match request(reader, head, peer, router, handler, config, stop, cancel, *served < config.max_requests, &mut lingering, events, report):
            case Some(next):
                reader = next
                if lingering:
                    return linger(&mut reader.inner, park and not stop.is_cancelled(), config)
            case Nothing:
                return Nothing
    Nothing

# Runs one request through the router and handler. Returns the connection
# when it can carry another request, or with `lingering` set when it is
# answered but request input may be left unread, to close lingering.
def request[T: Transport, R, H: Handler[T, R]](reader: BufReader[Conn[T]], head: RequestHead, peer: &Option[SocketAddress], router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, more: bool, lingering: &mut bool, events: &mut Option[ChannelSink], report: &mut Report) -> Option[BufReader[Conn[T]]]:
    started = now_ns()
    mut conn = reader
    conn.inner._until = after(started, config.body_timeout.as_nanoseconds())
    conn.inner._write_until = after(started, config.response_timeout.as_nanoseconds())
    # Framing faults are answered before a body reader takes the connection.
    mut refusal = 0
    framing = match std.http.request_framing(&head):
        case Ok(found):
            found
        case Err(error):
            refusal = error_status(&error)
            Framing.Empty
    match &framing:
        case Framing.Length(size):
            if *size > config.limits.max_body:
                refusal = 413
        case _:
            pass
    # Host and target faults (RFC 9112 section 3.2) are refused like framing.
    mut checked: Option[RequestTarget] = Nothing
    if refusal == 0:
        match std.http.request_target(&head):
            case Ok(found):
                checked = Some(found)
            case Err(HttpError.Allocation(_)):
                return Nothing
            case Err(error):
                refusal = error_status(&error)
    if refusal != 0:
        report.protocol_errors += 1u64
        answered = refuse(&mut conn.inner, refusal, "").is_ok()
        problem(events, "bad request", refusal, report)
        if not answered:
            return Nothing
        *lingering = True
        return Some(conn)
    target = match checked:
        case Some(found):
            found
        case Nothing:
            return Nothing
    keep = more and std.http.request_keeps_alive(&head)
    expects = wants_continue(&head)
    head_only = head.method == "HEAD"
    mut route = -1
    mut allow = ""
    mut params: list[str] = match list[str].new():
        case Ok(empty):
            empty
        case Err(_):
            return Nothing
    match router.find(&head.method, &target.path):
        case Ok(Match.Found(key, raw)):
            match decoded(&raw):
                case Some(values):
                    route = key
                    params = values
                case Nothing:
                    route = -3
        case Ok(Match.NotFound):
            route = -1
        case Ok(Match.MethodNotAllowed(methods)):
            route = -2
            allow = methods
        case Err(_):
            return Nothing
    body_framing = match std.http.request_framing(&head):
        case Ok(found):
            found
        case Err(_):
            return Nothing
    body = match std.http.body_reader(conn, &body_framing, &config.limits):
        case Ok(made):
            made
        case Err(_):
            return Nothing
    unclaimed: Option[BufReader[Conn[T]]] = Nothing
    mut exchange = Exchange(head, target.authority, target.path, target.query, params, copy_peer(peer), Some(body), unclaimed, framing, copy_limits(&config.limits), stop.share(), cancel.share(), unanswered, 0, head_only, keep, 0, 0, expects, False, 0)
    if route >= 0:
        match handler.handle(router.route(route), &mut exchange):
            case Ok(_):
                if exchange._state == unanswered:
                    report.handler_errors += 1u64
                    problem(events, "handler sent no response", 500, report)
                    drop(plain(&mut exchange, 500))
                elif exchange._state != ended:
                    drop(exchange.end())
            case Err(_):
                # A body the client failed to deliver is the client's error.
                mut status = 500
                if exchange._state == unanswered and exchange._refusal != 0:
                    status = exchange._refusal
                    report.protocol_errors += 1u64
                    problem(events, "bad request body", status, report)
                else:
                    report.handler_errors += 1u64
                    problem(events, "handler failed", 500, report)
                if exchange._state == unanswered:
                    exchange._keep = False
                    drop(plain(&mut exchange, status))
                else:
                    exchange._state = broken
    elif route == -2:
        drop(answer_with_allow(&mut exchange, &allow))
    elif route == -3:
        drop(plain(&mut exchange, 400))
    else:
        drop(plain(&mut exchange, 404))
    returned = replace(exchange._conn, Nothing)
    match &returned:
        case Some(found):
            count_failure(&found.inner._failure, events, report)
        case Nothing:
            match &mut exchange._body:
                case Some(left):
                    match std.http.release(left):
                        case Some(found):
                            count_failure(&found.inner._failure, events, report)
                        case Nothing:
                            pass
                case Nothing:
                    pass
    if exchange._state == ended:
        access(events, &exchange, started, report)
        if exchange._unread:
            *lingering = True
            return returned
    if exchange._state != ended or not exchange._keep:
        return Nothing
    returned

def plain[T: Transport](exchange: &mut Exchange[T], status: i64) -> Result[(), HttpError]:
    text = http_allocated(reason(status).concat("\n"))?
    exchange.send_text(status, &text)

def answer_with_allow[T: Transport](exchange: &mut Exchange[T], allow: &str) -> Result[(), HttpError]:
    mut head = std.http.response(405, reason(405))?
    head.add("Allow", *allow)?
    head.add("Content-Type", "text/plain; charset=utf-8")?
    text = http_allocated(reason(405).concat("\n"))?
    body = http_bytes(std.bytes.from_text(&text))?
    exchange.respond(head, &body)

# Serves one connection over any Transport, such as a TLS session, with the
# same routing, deadlines and counting as `serve`. `stop` begins shutdown:
# an idle connection closes and the current response ends the connection.
# `cancel` fails every further read and write.
pub def serve_connection[T: Transport, R, H: Handler[T, R]](stream: T, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken) -> Report:
    serve_connection_from(stream, Nothing, router, handler, config, stop, cancel)

# `serve_connection` for a stream whose remote address is known, such as an
# accepted TLS session; handlers see it as `exchange.peer`.
pub def serve_connection_from[T: Transport, R, H: Handler[T, R]](stream: T, peer: Option[SocketAddress], router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken) -> Report:
    mut report = empty_report()
    report.connections = 1u64
    mut events = shared_sink(&config.events)
    mut served = 0
    drop(connection(stream, Nothing, 0u64, &mut served, False, &peer, router, handler, config, stop, cancel, &mut events, &mut report))
    report

def copy_peer(peer: &Option[SocketAddress]) -> Option[SocketAddress]:
    match peer:
        case Some(address):
            Some(SocketAddress(address.ip, address.port, address.scope))
        case Nothing:
            Nothing

# Openers

# What a step that does not wait leaves a connection to do: go on to a
# worker, wait parked for the peer, or close.
const proceed: i64 = 0
const wait_parked: i64 = 1
const give_up: i64 = 2

# Why an Opener could not open a connection. TimedOut counts in `timeouts`,
# Cancelled in `cancelled` and Failed in `protocol_errors`; Gone (the client
# went away) is not counted.
pub enum OpenError:
    TimedOut
    Cancelled
    Failed
    Gone

# How a server turns an accepted TCP stream into its transport `T`, for
# transports such as std.http.tls. `open` and `advance` run on a worker,
# `watch` and `unwatch` on the accepting thread. A transport that
# `handshakes` gives new connections `handshake_timeout` from the accept to
# finish `advance`, waiting between steps on the accepting thread, counts
# one that does not finish in that time as a timeout, and closes
# connections it has no room for without a plaintext 503.
pub protocol Opener[T]:
    # The transport for a new connection, made without waiting for the peer.
    def open(self, tcp: TcpStream) -> Result[T, OpenError]:
        pass

    # Advances the transport's opening handshake until it is complete or
    # `deadline` passes (TimedOut). With a deadline already passed, it does
    # only the work possible without waiting.
    def advance(self, stream: &mut T, deadline: &Deadline, cancel: &CancellationToken) -> Result[(), OpenError]:
        pass

    def handshakes(self) -> bool:
        pass

    # Registers `stream` for what it waits for. Only called once a step
    # that does not wait (a read or `advance`) has timed out, so no input
    # is buffered.
    def watch(self, stream: &T, selector: &mut Selector, key: u64) -> bool:
        pass

    def unwatch(self, stream: &T, selector: &mut Selector) -> ():
        pass

class Plain:
    def open(self, tcp: TcpStream) -> Result[TcpStream, OpenError]:
        Ok(tcp)

    def advance(self, stream: &mut TcpStream, deadline: &Deadline, cancel: &CancellationToken) -> Result[(), OpenError]:
        Ok(())

    def handshakes(self) -> bool:
        False

    def watch(self, stream: &TcpStream, selector: &mut Selector, key: u64) -> bool:
        stream.watch(selector, key, Interest.Read).is_ok()

    def unwatch(self, stream: &TcpStream, selector: &mut Selector) -> ():
        drop(stream.unwatch(selector))

def open_failed(error: OpenError, events: &mut Option[ChannelSink], report: &mut Report) -> ():
    match error:
        case OpenError.TimedOut:
            report.timeouts += 1u64
            problem(events, "handshake timed out", 0, report)
        case OpenError.Cancelled:
            report.cancelled += 1u64
            problem(events, "cancelled", 0, report)
        case OpenError.Failed:
            report.protocol_errors += 1u64
            problem(events, "handshake failed", 0, report)
        case OpenError.Gone:
            pass

def opened[T, O: Opener[T]](opener: &O, tcp: TcpStream, events: &mut Option[ChannelSink], report: &mut Report) -> Option[T]:
    match opener.open(tcp):
        case Ok(stream):
            Some(stream)
        case Err(error):
            open_failed(error, events, report)
            Nothing

# Advances a new connection's handshake until `until`, or with `parking`
# only as far as what has arrived allows: `proceed` once complete,
# `wait_parked` while it needs the peer, `give_up` on failure, counted.
def advanced[T, O: Opener[T]](opener: &O, stream: &mut T, parking: bool, until: u64, cancel: &CancellationToken, events: &mut Option[ChannelSink], report: &mut Report) -> i64:
    mut limit = until
    if parking:
        limit = 0u64
    match opener.advance(stream, &deadline_of(limit), cancel):
        case Ok(_):
            proceed
        case Err(OpenError.TimedOut):
            if parking:
                return wait_parked
            open_failed(OpenError.TimedOut, events, report)
            give_up
        case Err(error):
            open_failed(error, events, report)
            give_up

def patience[T, O: Opener[T]](opener: &O, config: &Config) -> u64:
    if opener.handshakes():
        return config.handshake_timeout.as_nanoseconds()
    config.idle_timeout.as_nanoseconds()

# A plaintext answer means nothing to a client expecting a handshake, so it
# is closed instead.
def turn_away[T, O: Opener[T]](opener: &O, tcp: TcpStream, write_ns: u64) -> ():
    if opener.handshakes():
        drop(tcp)
    else:
        reject(tcp, write_ns)

# Workers and admission

# A connection for a worker: a new one (`fresh`) or one returning from being
# parked (`resumed`), with the requests it has served. While parked on the
# accepting thread's selector it waits until `until` for the rest of its
# handshake (`opening`), the rest of a head (`input`), or else its next byte.
# One closing lingering discards up to `linger` more bytes, then closes.
class Job[T]:
    fresh: Option[TcpStream]
    resumed: Option[T]
    served: i64
    peer: Option[SocketAddress]
    accepted: u64
    until: u64
    input: Option[Gathered]
    opening: bool
    linger: i64

def copy_address(address: &SocketAddress) -> SocketAddress:
    SocketAddress(address.ip, address.port, address.scope)

# A socket for waking the accepting thread after parking a connection; none
# when it cannot be bound, and then the worker does not park.
def bell() -> Option[UdpSocket]:
    match std.net.bind_udp(&std.net.loopback_v4(0u16)):
        case Ok(socket):
            Some(socket)
        case Err(_):
            Nothing

# Serves a connection from the queue: opens a new one and advances its
# handshake, then serves its requests. With `park`, neither a handshake nor
# a request head is waited for here: the connection is returned, to wait
# parked for its peer.
def take[T: Transport, O: Opener[T], R, H: Handler[T, R]](received: Job[T], park: bool, opener: &O, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, events: &mut Option[ChannelSink], report: &mut Report) -> Option[Job[T]]:
    mut job = received
    accepted = job.accepted
    mut served = job.served
    mut opening = job.opening
    mut peer = replace(job.peer, Nothing)
    mut stream = replace(job.resumed, Nothing)
    match replace(job.fresh, Nothing):
        case Some(tcp):
            report.connections += 1u64
            match tcp.peer_address():
                case Ok(address):
                    peer = Some(address)
                case Err(_):
                    pass
            stream = opened(opener, tcp, events, report)
            opening = True
        case Nothing:
            pass
    mut open = match stream:
        case Some(found):
            found
        case Nothing:
            return Nothing
    fresh: Option[TcpStream] = Nothing
    if opening:
        # Once shutdown has begun a handshake finishes here, as a head does.
        until = after(accepted, config.handshake_timeout.as_nanoseconds())
        step = advanced(opener, &mut open, park and not stop.is_cancelled(), until, cancel, events, report)
        if step == wait_parked:
            return Some(Job(fresh, Some(open), served, peer, accepted, until, Nothing, True, 0))
        if step == give_up:
            return Nothing
    match connection(open, replace(job.input, Nothing), job.until, &mut served, park, &peer, router, handler, config, stop, cancel, events, report):
        case Some(returned):
            (idle, started, wait_until, left) = returned
            Some(Job(fresh, Some(idle), served, peer, accepted, wait_until, started, False, left))
        case Nothing:
            Nothing

def worker[T: Transport, O: Opener[T], R, H: Handler[T, R]](inbox: Receiver[Job[T]], done: Sender[Report], back: Sender[Job[T]], wake: SocketAddress, opener: &O, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, events: Option[ChannelSink]) -> ():
    mut report = empty_report()
    mut sink = events
    mut ring = bell()
    chime: Option[Bytes] = match std.bytes.from_text("!"):
        case Ok(bytes):
            Some(bytes)
        case Err(_):
            Nothing
    park = config.idle_connections > 0 and ring.is_some() and chime.is_some()
    while True:
        match inbox.recv():
            case Ok(received):
                match take(received, park, opener, router, handler, config, stop, cancel, &mut sink, &mut report):
                    case Some(parked):
                        # A full return channel closes the connection.
                        if back.send_nowait(parked).is_ok():
                            match &mut ring:
                                case Some(socket):
                                    match &chime:
                                        case Some(byte):
                                            drop(socket.send_to(byte, 0, 1, &wake, &deadline_of(0u64), cancel))
                                        case Nothing:
                                            pass
                                case Nothing:
                                    pass
                    case Nothing:
                        pass
            case Err(_):
                break
    # `done` holds one slot per worker, so this cannot be full.
    drop(done.send_nowait(report))

# Answers a connection on the accepting thread with a whole response that
# closes it. Request bytes that have already arrived are read first so that
# closing does not reset the connection before the client sees the answer.
def answer[T: Transport](stream: &mut T, text: &str, write_ns: u64, token: &CancellationToken) -> ():
    match std.bytes.with_capacity(4096):
        case Ok(scratch):
            mut buffer = scratch
            if buffer.resize(4096, 0u8).is_ok():
                drop(stream.read_before(&mut buffer, 0, 4096, &deadline_of(0u64), token))
        case Err(_):
            pass
    match std.bytes.from_text(text):
        case Ok(bytes):
            drop(send_all(stream, &bytes, 0, bytes.len(), write_ns, after(now_ns(), write_ns), token))
        case Err(_):
            pass

# Answers a connection the server has no room for.
def busy[T: Transport](stream: &mut T, write_ns: u64, token: &CancellationToken) -> ():
    answer(stream, "HTTP/1.1 503 Service Unavailable\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 20\r\nRetry-After: 1\r\nConnection: close\r\n\r\nService Unavailable\n", write_ns, token)

def reject(stream: TcpStream, write_ns: u64) -> ():
    mut owned = stream
    match CancellationToken():
        case Ok(token):
            busy(&mut owned, write_ns, &token)
            drop(owned.shutdown(std.net.Shutdown.Write))
        case Err(_):
            pass

def reject_resumed[T: Transport](stream: T, write_ns: u64) -> ():
    mut owned = stream
    match CancellationToken():
        case Ok(token):
            busy(&mut owned, write_ns, &token)
        case Err(_):
            pass

const accept_poll_ns: u64 = 1000000000u64
const accept_backoff_ms: u32 = 10u32
const drain_slice_ms: u64 = 10u64
# Selector keys: the listener, the wake socket, then one per parking slot.
const listener_key: u64 = 0u64
const wake_key: u64 = 1u64
const first_slot: u64 = 2u64
# Connections accepted per listener event, so parked ones are not starved.
const accept_batch: i64 = 16

# The accepting thread's state.
class Admission[T]:
    selector: Selector
    bell: UdpSocket
    returns: Receiver[Job[T]]
    slots: list[Option[Job[T]]]
    parked: i64
    total: Report
    events: Option[ChannelSink]
    # Wake datagrams and lingering connections' discarded input land here.
    scratch: Bytes
    reject_ns: u64
    linger_ns: u64

def watch_job[T, O: Opener[T]](job: &Job[T], selector: &mut Selector, key: u64, opener: &O) -> bool:
    match &job.fresh:
        case Some(tcp):
            return tcp.watch(selector, key, Interest.Read).is_ok()
        case Nothing:
            pass
    match &job.resumed:
        case Some(stream):
            opener.watch(stream, selector, key)
        case Nothing:
            False

def unwatch_job[T, O: Opener[T]](job: &Job[T], selector: &mut Selector, opener: &O) -> ():
    match &job.fresh:
        case Some(tcp):
            drop(tcp.unwatch(selector))
        case Nothing:
            pass
    match &job.resumed:
        case Some(stream):
            opener.unwatch(stream, selector)
        case Nothing:
            pass

# Hands a connection to the workers, or answers 503 when the queue is full.
def send_job[T: Transport, O: Opener[T]](state: &mut Admission[T], job: Job[T], outbox: &Sender[Job[T]], opener: &O) -> ():
    match outbox.send_nowait(job):
        case Ok(_):
            pass
        case Err(SendError.Full(returned)):
            state.total.rejected += 1u64
            problem(&mut state.events, "queue full", 503, &mut state.total)
            mut refused = returned
            match replace(refused.fresh, Nothing):
                case Some(tcp):
                    turn_away(opener, tcp, state.reject_ns)
                case Nothing:
                    match replace(refused.resumed, Nothing):
                        case Some(stream):
                            # As with a new one, a handshake in progress
                            # gets no answer it could not read.
                            if not refused.opening:
                                reject_resumed(stream, state.reject_ns)
                        case Nothing:
                            pass
        case Err(SendError.Disconnected(refused)):
            drop(refused)

# Parks a connection until it is readable or `until` passes. Past `cap`, an
# idle connection is closed, but one partway through a handshake or a head
# is parked anyway: it was admitted while there was room, and only the
# queue, the workers and the return channel hold connections that are not
# parked, so they bound how far past `cap` this goes.
def park[T, O: Opener[T]](state: &mut Admission[T], parked: Job[T], cap: i64, opener: &O) -> ():
    if state.parked >= cap and parked.input.is_none() and not parked.opening:
        drop(parked)
        return
    mut index = 0
    while index < len(state.slots) and state.slots[index].is_some():
        index += 1
    if index == len(state.slots):
        empty: Option[Job[T]] = Nothing
        if state.slots.append(empty).is_err():
            drop(parked)
            return
    if not watch_job(&parked, &mut state.selector, first_slot + u64(index), opener):
        drop(parked)
        return
    state.slots[index] = Some(parked)
    state.parked += 1

# Takes the connection out of slot `index`, if any.
def unpark[T, O: Opener[T]](state: &mut Admission[T], index: i64, opener: &O) -> Option[Job[T]]:
    if index < 0 or index >= len(state.slots):
        return Nothing
    match replace(state.slots[index], Nothing):
        case Some(parked):
            state.parked -= 1
            unwatch_job(&parked, &mut state.selector, opener)
            Some(parked)
        case Nothing:
            Nothing

# Closes a parked connection. A new one counts as a connection, as it would
# had a worker waited for it; one whose handshake did not finish in time
# counts as a timeout.
def retire[T, O: Opener[T]](state: &mut Admission[T], job: Job[T], expired: bool, opener: &O) -> ():
    fresh = job.fresh.is_some()
    if fresh:
        state.total.connections += 1u64
    if expired and opener.handshakes() and (fresh or job.opening):
        state.total.timeouts += 1u64
        problem(&mut state.events, "handshake timed out", 0, &mut state.total)
    drop(job)

# Answers `408` to a parked connection whose head has not arrived by its
# deadline, as a worker reading it would have, then parks it again to close
# lingering.
def time_out[T: Transport, O: Opener[T]](state: &mut Admission[T], job: Job[T], cap: i64, token: &CancellationToken, opener: &O) -> ():
    mut closing = job
    state.total.timeouts += 1u64
    problem(&mut state.events, "timed out", 408, &mut state.total)
    match replace(closing.resumed, Nothing):
        case Some(stream):
            mut owned = stream
            answer(&mut owned, "HTTP/1.1 408 Request Timeout\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 16\r\nConnection: close\r\n\r\nRequest Timeout\n", state.reject_ns, token)
            if owned.shutdown(Shutdown.Write).is_ok():
                fresh: Option[TcpStream] = Nothing
                until = after(now_ns(), state.linger_ns)
                park(state, Job(fresh, Some(owned), closing.served, Nothing, closing.accepted, until, Nothing, False, linger_bytes), cap, opener)
        case Nothing:
            pass

def earliest[T](slots: &list[Option[Job[T]]]) -> u64:
    mut soonest = u64.MAX
    for index in range(len(slots)):
        match &slots[index]:
            case Some(parked):
                soonest = least(soonest, parked.until)
            case Nothing:
                pass
    soonest

def expire_parked[T: Transport, O: Opener[T]](state: &mut Admission[T], cap: i64, cancel: &CancellationToken, opener: &O) -> ():
    now = now_ns()
    for index in range(len(state.slots)):
        due = match &state.slots[index]:
            case Some(parked):
                parked.until <= now
            case Nothing:
                False
        if due:
            match unpark(state, index, opener):
                case Some(job):
                    if job.input.is_some():
                        time_out(state, job, cap, cancel, opener)
                    else:
                        retire(state, job, True, opener)
                case Nothing:
                    pass

# Reads more of the head a parked connection has started: `proceed` once
# the parser could take it without waiting or the input has ended,
# `wait_parked` while more is needed, `give_up` if reading failed. Any
# other parked connection is ready for a worker when anything arrives.
def read_parked[T: Transport](job: &mut Job[T], limits: &Limits, token: &CancellationToken) -> i64:
    match &mut job.resumed:
        case Some(stream):
            match &mut job.input:
                case Some(input):
                    match gather(stream, input, limits, token):
                        case Ok(True):
                            return proceed
                        case Ok(False):
                            return wait_parked
                        case Err(_):
                            return give_up
                case Nothing:
                    pass
        case Nothing:
            pass
    proceed

# Discards what has arrived for a connection closing lingering: the bytes
# it may still discard, or 0 once it should close.
def discarded[T: Transport](job: &mut Job[T], buffer: &mut Bytes, token: &CancellationToken) -> i64:
    match &mut job.resumed:
        case Some(stream):
            discard(stream, buffer, job.linger, 0u64, token)
        case Nothing:
            0

# A parked connection has input. One that has started a head reads it here
# and goes to a worker once the head can be parsed without waiting; one
# closing lingering discards it here and closes once that is done; any
# other goes to a worker at once.
def readied[T: Transport, O: Opener[T]](state: &mut Admission[T], index: i64, outbox: &Sender[Job[T]], config: &Config, cancel: &CancellationToken, opener: &O) -> ():
    if index < 0 or index >= len(state.slots):
        return
    mut job = match replace(state.slots[index], Nothing):
        case Some(parked):
            parked
        case Nothing:
            return
    mut step = proceed
    if job.linger > 0:
        job.linger = discarded(&mut job, &mut state.scratch, cancel)
        step = give_up
        if job.linger > 0:
            step = wait_parked
    else:
        step = read_parked(&mut job, &config.limits, cancel)
    if step == wait_parked:
        # Registered again because a TLS stream's interest changes with
        # the ciphertext it has left to send.
        drop(watch_job(&job, &mut state.selector, first_slot + u64(index), opener))
    state.slots[index] = Some(job)
    if step == wait_parked:
        return
    match unpark(state, index, opener):
        case Some(ready):
            if step == proceed:
                send_job(state, ready, outbox, opener)
            else:
                retire(state, ready, False, opener)
        case Nothing:
            pass

# Takes connections workers have returned, and the datagrams that announced
# them.
def collect[T, O: Opener[T]](state: &mut Admission[T], cap: i64, cancel: &CancellationToken, opener: &O) -> ():
    size = state.scratch.len()
    while True:
        match state.bell.receive_from(&mut state.scratch, 0, size, &deadline_of(0u64), cancel):
            case Ok(_):
                pass
            case Err(_):
                break
    while True:
        match state.returns.recv_nowait():
            case Ok(parked):
                park(state, parked, cap, opener)
            case Err(_):
                break

def admitted[T: Transport, O: Opener[T]](state: &mut Admission[T], tcp: TcpStream, outbox: &Sender[Job[T]], config: &Config, opener: &O) -> ():
    now = now_ns()
    cap = config.idle_connections
    if cap > 0 and state.parked >= cap:
        state.total.rejected += 1u64
        problem(&mut state.events, "too many connections", 503, &mut state.total)
        turn_away(opener, tcp, state.reject_ns)
        return
    resumed: Option[T] = Nothing
    job = Job(Some(tcp), resumed, 0, Nothing, now, after(now, patience(opener, config)), Nothing, False, 0)
    if cap == 0:
        send_job(state, job, outbox, opener)
        return
    park(state, job, cap, opener)

def accept_some[T: Transport, O: Opener[T]](state: &mut Admission[T], listener: &TcpListener, outbox: &Sender[Job[T]], config: &Config, stop: &CancellationToken, opener: &O) -> ():
    for _ in range(accept_batch):
        match listener.accept(&deadline_of(0u64), stop):
            case Ok(accepted):
                # Responses are buffered and flushed whole, so Nagle's
                # algorithm only adds a delayed-ACK stall when a head and a
                # large body go out as two writes.
                mut tcp = accepted
                drop(tcp.set_no_delay(True))
                admitted(state, tcp, outbox, config, opener)
            case Err(NetError.TimedOut):
                return
            case Err(NetError.Cancelled):
                return
            case Err(_):
                state.total.accept_errors += 1u64
                problem(&mut state.events, "accept failed", 0, &mut state.total)
                std.time.sleep(&std.time.milliseconds(accept_backoff_ms))
                return

# Dispatches every connection the last selector wait found ready.
def ready_events[T: Transport, O: Opener[T]](state: &mut Admission[T], count: i64, listener: &TcpListener, outbox: &Sender[Job[T]], config: &Config, stop: &CancellationToken, cancel: &CancellationToken, opener: &O) -> ():
    for index in range(count):
        match state.selector.event(index):
            case Ok(event):
                if event.key == listener_key:
                    accept_some(state, listener, outbox, config, stop, opener)
                elif event.key >= first_slot:
                    readied(state, i64(event.key - first_slot), outbox, config, cancel, opener)
            case Err(_):
                pass

def admit[T: Transport, O: Opener[T]](listener: TcpListener, outbox: Sender[Job[T]], reports: Receiver[Report], admission: Admission[T], opener: &O, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, workers: i64) -> Report:
    mut state = admission
    mut open = listener
    cap = config.idle_connections
    while not stop.is_cancelled():
        limit = least(after(now_ns(), accept_poll_ns), earliest(&state.slots))
        match state.selector.wait(&deadline_of(limit), stop):
            case Ok(count):
                ready_events(&mut state, count, &open, &outbox, config, stop, cancel, opener)
            case Err(WaitError.Cancelled):
                break
            case Err(WaitError.TimedOut):
                pass
            case Err(_):
                state.total.accept_errors += 1u64
                problem(&mut state.events, "accept failed", 0, &mut state.total)
                std.time.sleep(&std.time.milliseconds(accept_backoff_ms))
        collect(&mut state, cap, cancel, opener)
        expire_parked(&mut state, cap, cancel, opener)
    drop(open.close())
    # A parked connection whose request has started arriving is still
    # served; the rest are idle and close at once, as do any returned from
    # now on.
    collect(&mut state, cap, cancel, opener)
    match state.selector.wait(&deadline_of(0u64), cancel):
        case Ok(count):
            for index in range(count):
                match state.selector.event(index):
                    case Ok(event):
                        if event.key >= first_slot:
                            match unpark(&mut state, i64(event.key - first_slot), opener):
                                case Some(job):
                                    if job.linger > 0:
                                        retire(&mut state, job, False, opener)
                                    else:
                                        send_job(&mut state, job, &outbox, opener)
                                case Nothing:
                                    pass
                    case Err(_):
                        pass
        case Err(_):
            pass
    for index in range(len(state.slots)):
        match unpark(&mut state, index, opener):
            case Some(job):
                if job.input.is_some():
                    send_job(&mut state, job, &outbox, opener)
                else:
                    retire(&mut state, job, False, opener)
            case Nothing:
                pass
    drop(outbox)
    drain_until = after(now_ns(), config.drain_timeout.as_nanoseconds())
    mut finished = 0
    while finished < workers:
        drop_returns(&mut state)
        now = now_ns()
        if now >= drain_until:
            break
        wait_ms = least((drain_until - now) // 1000000u64 + 1u64, drain_slice_ms)
        match reports.recv_timeout(wait_ms):
            case Ok(part):
                merge(&mut state.total, &part)
                finished += 1
            case Err(RecvTimeoutError.TimedOut):
                pass
            case Err(RecvTimeoutError.Disconnected):
                break
    cancel.cancel()
    while finished < workers:
        match reports.recv():
            case Ok(part):
                merge(&mut state.total, &part)
                finished += 1
            case Err(_):
                break
    drop_returns(&mut state)
    replace(state.total, empty_report())

def drop_returns[T](state: &mut Admission[T]) -> ():
    while True:
        match state.returns.recv_nowait():
            case Ok(parked):
                drop(parked)
            case Err(_):
                break

# Starts `count` workers, each in its own scope, then admits connections on
# this thread. Every worker is joined before this returns.
def launch[T: Transport, O: Opener[T], R, H: Handler[T, R]](count: i64, listener: TcpListener, inbox: Receiver[Job[T]], outbox: Sender[Job[T]], done: Sender[Report], reports: Receiver[Report], back: Sender[Job[T]], wake: &SocketAddress, admission: Admission[T], opener: &O, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken, cancel: &CancellationToken, workers: i64) -> Result[Report, ThreadError]:
    if count == 0:
        drop(inbox)
        drop(done)
        drop(back)
        return Ok(admit(listener, outbox, reports, admission, opener, config, stop, cancel, workers))
    mut result: Result[Report, ThreadError] = Ok(empty_report())
    with spawn(worker, inbox.share(), done.share(), back.share(), copy_address(wake), opener, router, handler, config, stop, cancel, shared_sink(&config.events))? as task:
        result = launch(count - 1, listener, inbox, outbox, done, reports, back, wake, admission, opener, router, handler, config, stop, cancel, workers)
    result

def valid(config: &Config) -> bool:
    limits = &config.limits
    if limits.max_line <= 0 or limits.max_head <= 0 or limits.max_headers <= 0 or limits.max_body < 0:
        return False
    if config.idle_connections < 0 or config.idle_connections > 1000000:
        return False
    config.workers >= 1 and config.workers <= 1024 and config.queue >= 1 and config.max_requests >= 1

def netted[T](result: Result[T, NetError]) -> Result[T, ServerError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(ServerError.Net(error))

def selected[T](result: Result[T, WaitError]) -> Result[T, ServerError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(WaitError.Stream(cause)):
            Err(ServerError.Net(NetError.Stream(cause)))
        case Err(_):
            Err(ServerError.Net(NetError.TimedOut))

def run[T: Transport, O: Opener[T], R, H: Handler[T, R]](listener: TcpListener, opener: &O, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken) -> Result[Report, ServerError]:
    if not valid(config):
        return Err(ServerError.InvalidConfig)
    cancel = allocated(CancellationToken())?
    (outbox, inbox) = channeled(channel[Job[T]](u64(config.queue)))?
    (done, reports) = channeled(channel[Report](u64(config.workers)))?
    (back, returns) = channeled(channel[Job[T]](u64(config.workers + 64)))?
    mut selector = selected(std.ready.selector(64))?
    netted(listener.watch(&mut selector, listener_key))?
    mut wake = netted(std.net.bind_udp(&std.net.loopback_v4(0u16)))?
    netted(wake.watch(&mut selector, wake_key, Interest.Read))?
    address = netted(wake.local_address())?
    mut scratch = allocated(bytes_of(std.bytes.with_capacity(discard_chunk)))?
    allocated(bytes_of(scratch.resize(discard_chunk, 0u8)))?
    slots = allocated(list[Option[Job[T]]].new())?
    # Rejections must not hold up accepting, so they get a short write budget.
    reject_ns = least(config.write_timeout.as_nanoseconds(), 100000000u64)
    admission = Admission(selector, wake, returns, slots, 0, empty_report(), shared_sink(&config.events), scratch, reject_ns, linger_span(config))
    match launch(config.workers, listener, inbox, outbox, done, reports, back, &address, admission, opener, router, handler, config, stop, &cancel, config.workers):
        case Ok(report):
            Ok(report)
        case Err(error):
            Err(ServerError.Thread(error))

def bytes_of[T](result: Result[T, BytesError]) -> Result[T, AllocError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(_):
            Err(AllocError.OutOfMemory)

# Serves `listener` until `stop` is cancelled, then closes it, lets queued
# and active connections finish within `drain_timeout`, cancels whatever is
# left, joins every worker and returns the counts. Idle keep-alive
# connections wait on the accepting thread, not on a worker.
pub def serve[R, H: Handler[TcpStream, R]](listener: TcpListener, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken) -> Result[Report, ServerError]:
    run(listener, &Plain(), router, handler, config, stop)

# `serve` with a transport made by `opener`; see std.http.tls.
pub def serve_with[T: Transport, O: Opener[T], R, H: Handler[T, R]](listener: TcpListener, opener: &O, router: &Router[R], handler: &H, config: &Config, stop: &CancellationToken) -> Result[Report, ServerError]:
    run(listener, opener, router, handler, config, stop)

def channeled[T](result: Result[T, ChannelError]) -> Result[T, ServerError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(ChannelError.Allocation(cause)):
            Err(ServerError.Allocation(cause))
        case Err(_):
            Err(ServerError.InvalidConfig)
