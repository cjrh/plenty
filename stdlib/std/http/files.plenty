# Static files for std.http.server handlers, confined to one directory. The
# request path is opened one segment at a time through std.fs Root handles,
# whose opens refuse symbolic links, so no path or link inside the directory
# leads out of it. Responses carry a Content-Type from std.mime's table, a weak
# ETag and Last-Modified, answer If-None-Match and If-Modified-Since, and
# stream the file through one fixed buffer.
# See book/src/design/stdlib/http-files.md.
import std.bytes
import std.fs
import std.http
import std.http.server
import std.io
import std.mime
import std.path
from std.bytes import Bytes, BytesError
from std.fs import Root
from std.http import Header, HttpError, ResponseHead
from std.http.server import Exchange, Transport
from std.io import FileStream, StreamError
from std.time import Timestamp

pub enum FilesError:
    Io(IoError)
    Stream(StreamError)
    Http(HttpError)
    # The file ended before the size it had when it was opened.
    Truncated
    Allocation(AllocError)

def allocated[T](result: Result[T, AllocError]) -> Result[T, FilesError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(FilesError.Allocation(cause))

def lifted[T](result: Result[T, BytesError]) -> Result[T, FilesError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(BytesError.Allocation(cause)):
            Err(FilesError.Allocation(cause))
        case Err(_):
            __trap("HTTP files text: invalid internal byte conversion")

def http[T](result: Result[T, HttpError]) -> Result[T, FilesError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(HttpError.Allocation(cause)):
            Err(FilesError.Allocation(cause))
        case Err(cause):
            Err(FilesError.Http(cause))

# Buffer for one read and write of the body.
const chunk: i64 = 16384
# Longest request path accepted, in bytes.
pub const max_path: i64 = 4096

# Errors that mean "no such servable file": missing, not a directory, a link
# (ELOOP from O_NOFOLLOW), a directory where a file was asked for, a name too
# long, no permission, or not a regular file (InvalidInput).
def absent(error: &IoError) -> bool:
    match error:
        case IoError.System(code):
            value = *code
            value == 2i32 or value == 13i32 or value == 20i32 or value == 21i32 or value == 36i32 or value == 40i32 or value == 6i32
        case IoError.InvalidInput:
            True
        case _:
            False

def opened[T](result: Result[T, IoError]) -> Result[Option[T], FilesError]:
    match result:
        case Ok(value):
            Ok(Some(value))
        case Err(error):
            if absent(&error):
                return Ok(Nothing)
            Err(FilesError.Io(error))

def segment(data: &[u8], start: i64, stop: i64) -> Result[Option[std.path.Path], FilesError]:
    # Empty segments come from a leading `/` or `//`; a leading `.` covers
    # `.`, `..` and hidden files such as `.env` or `.git`.
    if stop == start or data[start] == 46u8:
        return Ok(Nothing)
    for index in range(start, stop):
        if data[index] == 0u8:
            return Ok(Nothing)
    text = lifted(std.bytes.to_text(&data[start:stop]))?
    match std.path.from_text(&text):
        case Ok(name):
            Ok(Some(name))
        case Err(_):
            Ok(Nothing)

# Opens the regular file at `path` below `root`. `path` is relative and
# already percent-decoded, such as a `{name...}` capture. `Nothing` when the
# path is refused (empty, absolute, a segment that is empty or starts with
# `.`, a NUL byte, longer than max_path) or names no regular file reachable
# without following a link.
pub def open_file(root: &Root, path: &strview) -> Result[Option[FileStream], FilesError]:
    if path.byte_len() == 0 or path.byte_len() > max_path:
        return Ok(Nothing)
    data = path.as_bytes()
    count = len(data)
    mut directory: Option[Root] = Nothing
    mut at = 0
    while True:
        mut stop = count
        match byte_find_range(data, 47u8, at, count):
            case Some(found):
                stop = found
            case Nothing:
                pass
        name = match segment(data, at, stop)?:
            case Some(value):
                value
            case Nothing:
                return Ok(Nothing)
        if stop == count:
            return match &directory:
                case Some(parent):
                    opened(parent.read_file(&name))
                case Nothing:
                    opened(root.read_file(&name))
        child = match &directory:
            case Some(parent):
                opened(parent.open_dir(&name))?
            case Nothing:
                opened(root.open_dir(&name))?
        match child:
            case Some(next):
                directory = Some(next)
            case Nothing:
                return Ok(Nothing)
        # stop<count<=max_path=4096; the next segment starts within data.
        unchecked:
            at = stop + 1

# The media type for `name`'s extension, compared without case;
# application/octet-stream for any other. The table is std.mime's.
pub def media_type(name: &strview) -> str:
    std.mime.from_file_name(name)

# Dates

def day_names() -> str:
    return "ThuFriSatSunMonTueWed"

def month_names() -> str:
    return "JanFebMarAprMayJunJulAugSepOctNovDec"

def days_from_civil(year: i64, month: i64, day: i64) -> i64:
    # Only parsed dates reach here: 1970<=year<=9999, month=1..12,
    # day=1..31. y is 1969..9999, era<=24, yoe<=399, shifted<=11;
    # all intermediates have magnitude below four million. Divisors are positive.
    unchecked:
        mut y = year
        if month <= 2:
            y -= 1
        era = y // 400
        yoe = y - era * 400
        shifted = (month + 9) % 12
        doy = (153 * shifted + 2) // 5 + day - 1
        doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
        era * 146097 + doe - 719468

# `seconds` since the epoch as an IMF-fixdate (RFC 9110 section 5.6.7), such
# as `Sun, 06 Nov 1994 08:49:37 GMT`. Only 1970 to 9999 are shown.
pub def http_date(timestamp: &Timestamp) -> Result[Option[str], FilesError]:
    http(std.http.http_date(timestamp))

# The decimal number in data[start:start + count], or -1.
def digits(data: &[u8], start: i64, count: i64) -> i64:
    # Only fixed date fields reach here: count is 2 or 4 and
    # start+count<=29. Validated decimal bytes accumulate at most 9999
    # (including the pre-subtraction intermediate, at most 10047).
    unchecked:
        mut value = 0
        for index in range(start, start + count):
            byte = i64(data[index])
            if byte < 48 or byte > 57:
                return -1
            value = value * 10 + byte - 48
        value

def same_bytes(data: &[u8], start: i64, text: &[u8], offset: i64, count: i64) -> bool:
    # Callers validate both byte ranges; index<count implies
    # start+index<len(data) and offset+index<len(text).
    unchecked:
        for index in range(count):
            if data[start + index] != text[offset + index]:
                return False
        True

# Seconds since the epoch of an IMF-fixdate. The obsolete RFC 850 and
# asctime forms are not accepted; a date that does not parse is ignored.
pub def parse_http_date(text: &strview) -> Result[Option[Timestamp], FilesError]:
    # The fixed 29-byte layout bounds digits to four decimal places;
    # validated years are 1970..9999, months 1..12, days 1..31. Month
    # indexes are at most 36. Converted days have magnitude below four
    # million; second totals stay below 4e6*86400+86400, far below MAX.
    unchecked:
        data = text.as_bytes()
        if len(data) != 29:
            return Ok(Nothing)
        tail = allocated(std.bytes.from_text(" GMT"))?
        if not same_bytes(data, 25, &tail, 0, 4) or data[3] != 44u8 or data[4] != 32u8 or data[7] != 32u8 or data[11] != 32u8 or data[16] != 32u8 or data[19] != 58u8 or data[22] != 58u8:
            return Ok(Nothing)
        months = allocated(std.bytes.from_text(month_names()))?
        mut month = 0
        for index in range(12):
            if same_bytes(data, 8, &months, index * 3, 3):
                month = index + 1
        if month == 0:
            return Ok(Nothing)
        day = digits(data, 5, 2)
        year = digits(data, 12, 4)
        hour = digits(data, 17, 2)
        minute = digits(data, 20, 2)
        second = digits(data, 23, 2)
        if day < 1 or day > 31 or year < 1970 or hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59:
            return Ok(Nothing)
        seconds = days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
        # Formatting the result back rejects 31 February and a wrong weekday.
        match http_date(&Timestamp(seconds, 0u32))?:
            case Some(again):
                if again == text:
                    return Ok(Some(Timestamp(seconds, 0u32)))
                Ok(Nothing)
            case Nothing:
                Ok(Nothing)

# Conditional requests

def trimmed(data: &[u8], start: i64, stop: i64) -> (i64, i64):
    # 0<=start<=stop<=len(data); increments require first<last,
    # decrements require last>first>=0, so last-1 and each step fit.
    unchecked:
        mut first = start
        mut last = stop
        while first < last and (data[first] == 32u8 or data[first] == 9u8):
            first += 1
        while last > first and (data[last - 1] == 32u8 or data[last - 1] == 9u8):
            last -= 1
        (first, last)

# Weak comparison (RFC 9110 section 8.8.3.2): `W/` is ignored on both sides.
# `*` matches any existing file, including one without a tag (section 13.1.2).
def tag_listed(field: &strview, tag: &Option[Bytes]) -> Result[bool, FilesError]:
    # Positions stay in 0..count; weak-prefix indexes require
    # last-first>=2. Generated validator tags have at least two bytes.
    # Matching lengths bound same_bytes ranges; stop+1 requires stop<count.
    unchecked:
        data = field.as_bytes()
        count = len(data)
        mut at = 0
        while at <= count:
            mut stop = count
            match byte_find_range(data, 44u8, at, count):
                case Some(found):
                    stop = found
                case Nothing:
                    pass
            (first, last) = trimmed(data, at, stop)
            if last - first == 1 and data[first] == 42u8:
                return Ok(True)
            match tag:
                case Some(value):
                    mut begin = first
                    if last - first >= 2 and data[first] == 87u8 and data[first + 1] == 47u8:
                        begin = first + 2
                    # `value` is `W/"..."`; compare its quoted part.
                    quoted = value.len() - 2
                    if last - begin == quoted and same_bytes(data, begin, value, 2, quoted):
                        return Ok(True)
                case Nothing:
                    pass
            if stop == count:
                break
            at = stop + 1
        Ok(False)

# RFC 9110 section 13.2.2: If-None-Match decides when present; otherwise
# If-Modified-Since, for a file not changed after the given second.
def unchanged(headers: &list[Header], tag: &Option[Bytes], modified: Option[i64]) -> Result[bool, FilesError]:
    mut asked = False
    for index in range(len(headers)):
        if std.http.same_name(&headers[index].name, "if-none-match"):
            asked = True
            if tag_listed(&headers[index].value, tag)?:
                return Ok(True)
    if asked:
        return Ok(False)
    match std.http.find(headers, "if-modified-since"):
        case Some(index):
            match modified:
                case Some(seconds):
                    match parse_http_date(&headers[index].value)?:
                        case Some(since):
                            return Ok(seconds <= since.seconds)
                        case Nothing:
                            pass
                case Nothing:
                    pass
        case Nothing:
            pass
    Ok(False)

# Serving

# The validators of an open file: a weak ETag from its size and modification
# time, and that time in whole seconds.
class Validators:
    tag: Option[Bytes]
    modified: Option[i64]

def validators(size: i64, time: Option[Timestamp]) -> Result[Validators, FilesError]:
    match time:
        case Some(stamp):
            mut text = allocated("W/\"".concat(&allocated(str.from(size))?))?
            text = allocated(text.concat("-"))?
            text = allocated(text.concat(&allocated(str.from(stamp.seconds))?))?
            text = allocated(text.concat("."))?
            text = allocated(text.concat(&allocated(str.from(stamp.nanoseconds))?))?
            text = allocated(text.concat("\""))?
            Ok(Validators(Some(allocated(std.bytes.from_text(&text))?), Some(stamp.seconds)))
        case Nothing:
            Ok(Validators(Nothing, Nothing))

# HTTP lengths are signed i64. Reject metadata outside that domain before
# allocating validators or considering a conditional 304 response (issue #706).
def file_size(size: u64) -> Result[i64, FilesError]:
    match i64.try_from(size):
        case Ok(value):
            Ok(value)
        case Err(_):
            Err(FilesError.Http(HttpError.InvalidContentLength))

# Metadata validation is independent of filesystem size and happens before
# any response write or body read; the conditional decision cannot bypass it.
def prepared(size: u64, time: Option[Timestamp], headers: &list[Header]) -> Result[(i64, Validators, bool), FilesError]:
    length = file_size(size)?
    found = validators(length, time)?
    not_modified = unchanged(headers, &found.tag, found.modified)?
    Ok((length, found, not_modified))

def add_validators(head: &mut ResponseHead, found: &Validators) -> Result[(), FilesError]:
    match &found.tag:
        case Some(tag):
            http(head.add("ETag", lifted(tag.to_text())?))?
        case Nothing:
            pass
    match found.modified:
        case Some(seconds):
            match http_date(&Timestamp(seconds, 0u32))?:
                case Some(date):
                    http(head.add("Last-Modified", date))?
                case Nothing:
                    pass
        case Nothing:
            pass
    Ok(())

# Answers a GET or HEAD request with the file at `path` below `root` (see
# `open_file`) and returns the status sent: 200, 304 when a conditional field
# matches, 404 for a refused or missing path, 405 with `Allow: GET, HEAD` for
# any other method. Memory is one 16 KiB buffer and the response head,
# whatever the file's size.
pub def serve[T: Transport](exchange: &mut Exchange[T], root: &Root, path: &strview) -> Result[i64, FilesError]:
    method = exchange.request.method
    if method != "GET" and method != "HEAD":
        mut head = http(std.http.response(405, "Method Not Allowed"))?
        http(head.add("Allow", "GET, HEAD"))?
        http(head.add("Content-Type", "text/plain; charset=utf-8"))?
        body = allocated(std.bytes.from_text("Method Not Allowed\n"))?
        http(exchange.respond(head, &body))?
        return Ok(405)
    mut stream = match open_file(root, path)?:
        case Some(found):
            found
        case Nothing:
            http(exchange.send_text(404, "Not Found\n"))?
            return Ok(404)
    meta = match std.fs.file_metadata(&stream):
        case Ok(value):
            value
        case Err(error):
            return Err(FilesError.Io(error))
    size, found, not_modified = prepared(meta.size(), meta.modified(), &exchange.request.headers)?
    if not_modified:
        mut head = http(std.http.response(304, "Not Modified"))?
        add_validators(&mut head, &found)?
        http(exchange.respond(head, b""))?
        return Ok(304)
    mut buffer = allocated(std.bytes.with_capacity(chunk))?
    allocated(buffer.resize(chunk, 0u8))?
    mut head = http(std.http.response(200, "OK"))?
    http(head.add("Content-Type", media_type(path)))?
    http(head.add("Content-Length", allocated(str.from(size))?))?
    http(head.add("X-Content-Type-Options", "nosniff"))?
    add_validators(&mut head, &found)?
    http(exchange.start(head))?
    # A HEAD response ends without its body, so the file is not read.
    mut remaining = size
    if method == "HEAD":
        remaining = 0
    while remaining > 0:
        mut want = chunk
        if remaining < want:
            want = remaining
        count = match stream.read(&mut buffer, 0, want):
            case Ok(value):
                value
            case Err(StreamError.Interrupted):
                continue
            case Err(error):
                return Err(FilesError.Stream(error))
        if count == 0:
            return Err(FilesError.Truncated)
        http(exchange.write(&buffer[:count]))?
        # FileStream returns 0<count<=want<=remaining.
        unchecked:
            remaining -= count
    http(exchange.end())?
    Ok(200)

# Internal callers supply 0 <= start <= stop <= len(data). A found
# relative position is below stop - start, so adding start stays in range.
def byte_find_range(data: &[u8], value: u8, start: i64, stop: i64) -> Option[i64]:
    found = __bytes_find(&data[start:stop], value)
    if found < 0:
        return Nothing
    unchecked:
        Some(start + found)
