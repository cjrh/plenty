# Resumable HTTP/1.x request framing over caller-owned input. Every feed is
# bounded and does no I/O. Stored state contains no shared text, so it can
# live in an actor heap; text appears only in the returned transient events.
import std.bytes
import std.http
import std.io
from std.bytes import Bytes
from std.http import Framing, Header, HttpError, Limits, RequestHead, RequestTarget
from std.io import StreamError

# One call consumes at most this many input bytes. Callers must also bound
# the number of calls made per event-loop turn.
pub const feed_budget: i64 = 4096

pub enum Event:
    Head(RequestHead, RequestTarget, Framing)
    Body(Bytes)
    Trailers(list[Header])
    End

const head: i64 = 0
const sized: i64 = 1
const chunk_size: i64 = 2
const chunk_data: i64 = 3
const chunk_end: i64 = 4
const trailers: i64 = 5
const ending: i64 = 6
const done: i64 = 7
const failed: i64 = 8

pub class Decoder:
    _limits: Limits
    _state: i64
    _line: Bytes
    _section: Bytes
    _request_line: bool
    _started: bool
    _fields: i64
    _remaining: i64
    _total: i64

    # True once nonblank request input has arrived, including a partial line.
    pub def is_started(self) -> bool:
        self._started

    # True after Head, including while the body is pending or complete.
    pub def has_head(self) -> bool:
        self._state != head and self._state != failed

    # True only after End was emitted. No next-request byte is consumed until
    # reset, allowing the server to finish its response before reusing input.
    pub def is_done(self) -> bool:
        self._state == done

    pub def total(self) -> i64:
        self._total

    pub def reset(self: &mut Decoder) -> Result[(), HttpError]:
        if self._state != done:
            return Err(HttpError.Unfinished)
        self._state = head
        self._line.clear()
        self._section.clear()
        self._request_line = False
        self._started = False
        self._fields = 0
        self._remaining = 0
        self._total = 0
        Ok(())

    # Explicit EOF, separate from a feed with no currently available bytes.
    # A complete body's End may still be collected with an empty feed.
    pub def finish(self: &mut Decoder) -> Result[(), HttpError]:
        if self._state == failed:
            return Err(HttpError.Broken)
        if self._state == done or self._state == ending:
            return Ok(())
        if self._state == head and not self._started and self._line.len() == 0:
            return Ok(())
        prior = self._state
        self._state = failed
        if prior == head:
            # Preserve the shared parser's error when a complete malformed
            # line is followed by EOF before the final empty line.
            mut raw = allocated(self._section.copy())?
            allocated(raw.extend(&self._line))?
            mut reader = streamed(std.io.buffered_reader(std.io.cursor(raw), feed_budget))?
            drop(std.http.read_request(&mut reader, &self._limits)?)
        elif prior == trailers:
            drop(self.parsed_trailers()?)
        Err(HttpError.Truncated)

    # The count is how many bytes of `source` were consumed. Nothing means no
    # event was produced; it may still consume bytes. An empty feed can emit
    # End, but never EOF. Any framing/allocation failure poisons the decoder
    # until it is dropped.
    pub def feed(self: &mut Decoder, source: &[u8]) -> Result[(i64, Option[Event]), HttpError]:
        match self.step(source):
            case Ok(progress):
                Ok(progress)
            case Err(error):
                self._state = failed
                Err(error)

    def step(self: &mut Decoder, source: &[u8]) -> Result[(i64, Option[Event]), HttpError]:
        if self._state == failed:
            return Err(HttpError.Broken)
        if self._state == done:
            return Ok((0, Nothing))
        if self._state == ending:
            self._state = done
            return Ok((0, Some(Event.End)))
        mut end = len(source)
        if end > feed_budget:
            end = feed_budget
        if self._state == sized or self._state == chunk_data:
            mut count = end
            if count > self._remaining:
                count = self._remaining
            if count == 0:
                return Ok((0, Nothing))
            mut body = allocated(std.bytes.with_capacity(count))?
            allocated(body.extend(&source[:count]))?
            self._remaining -= count
            self._total += count
            if self._remaining == 0:
                self._state = ending if self._state == sized else chunk_end
            return Ok((count, Some(Event.Body(body))))
        mut at = 0
        while at < end:
            taken, complete = self.gather(&source[at:end])?
            at += taken
            if not complete:
                return Ok((at, Nothing))
            size = self._line.len() - 2
            if self._state == head:
                allocated(self._section.extend(&self._line))?
                if not self._request_line:
                    if size > 0:
                        self._request_line = True
                        self._started = True
                elif size == 0:
                    self._line.clear()
                    return Ok((at, Some(self.parsed_head()?)))
                else:
                    if self._fields >= self._limits.max_headers:
                        return Err(HttpError.TooManyHeaders)
                    self._fields += 1
            elif self._state == chunk_size:
                length = std.http.parse_chunk_size(&self._line[:size])?
                if length > self._limits.max_body - self._total:
                    return Err(HttpError.BodyTooLarge)
                self._remaining = length
                self._state = trailers if length == 0 else chunk_data
                self._fields = 0
                self._section.clear()
            elif self._state == chunk_end:
                if size != 0:
                    return Err(HttpError.InvalidChunk)
                self._state = chunk_size
            else:
                allocated(self._section.extend(&self._line))?
                if size == 0:
                    self._line.clear()
                    values = self.parsed_trailers()?
                    self._state = ending
                    return Ok((at, Some(Event.Trailers(values))))
                if self._fields >= self._limits.max_headers:
                    return Err(HttpError.TooManyHeaders)
                self._fields += 1
            self._line.clear()
            if (self._state == head or self._state == trailers) and self._section.len() == self._limits.max_head:
                return Err(HttpError.HeadTooLarge)
            # Body data belongs in a separate bounded event. Returning here
            # also avoids treating its arbitrary bytes as a framing line.
            if self._state == chunk_data:
                return Ok((at, Nothing))
        Ok((at, Nothing))

    # One CRLF line. Reserve/check the section and line budgets before
    # copying input; valid CRLF at exactly the limit remains valid.
    def gather(self: &mut Decoder, source: &[u8]) -> Result[(i64, bool), HttpError]:
        mut limit = self._limits.max_line
        mut overflow = HttpError.LineTooLong
        if self._state == chunk_end:
            limit = 2
            overflow = HttpError.InvalidChunk
        elif self._state == head or self._state == trailers:
            left = self._limits.max_head - self._section.len()
            if left < limit:
                limit = left
                overflow = HttpError.HeadTooLarge
        if limit <= self._line.len():
            return Err(overflow)
        mut end = len(source)
        room = limit - self._line.len()
        if end > room:
            end = room
        mut complete = False
        # The scan is bounded by feed_budget and reads the view in place.
        mut at = 0
        while at < end:
            byte = source[at]
            if self._state == head and byte != 13u8 and byte != 10u8:
                self._started = True
            if byte == 10u8:
                end = at + 1
                complete = True
                break
            at += 1
        allocated(self._line.extend(&source[:end]))?
        if complete:
            length = self._line.len()
            if length < 2 or self._line[length - 2] != 13u8:
                return Err(HttpError.BareLineFeed)
        elif self._line.len() == limit:
            return Err(overflow)
        Ok((end, complete))

    def parsed_head(self: &mut Decoder) -> Result[Event, HttpError]:
        raw = replace(self._section, allocated(std.bytes.empty())?)
        mut reader = streamed(std.io.buffered_reader(std.io.cursor(raw), feed_budget))?
        request = std.http.read_request(&mut reader, &self._limits)?.ok_or(HttpError.Truncated)?
        framing = std.http.request_framing(&request)?
        match &framing:
            case Framing.Length(length):
                if *length > self._limits.max_body:
                    return Err(HttpError.BodyTooLarge)
                self._remaining = *length
                self._state = ending if *length == 0 else sized
            case Framing.Chunked:
                self._state = chunk_size
            case Framing.Empty:
                self._state = ending
            case Framing.UntilClose:
                return Err(HttpError.Broken)
        target = std.http.request_target(&request)?
        Ok(Event.Head(request, target, framing))

    def parsed_trailers(self: &mut Decoder) -> Result[list[Header], HttpError]:
        mut values: list[Header] = allocated(list[Header].new())?
        mut at = 0
        while at < self._section.len():
            end = self._section.find(10u8, at, self._section.len()).ok_or(HttpError.Truncated)?
            size = end - at - 1
            if size == 0:
                break
            line = allocated(self._section.slice(at, end - 1))?
            allocated(values.append(std.http.parse_field(&line[:size])?))?
            at = end + 1
        self._section.clear()
        Ok(values)

pub def decoder(limits: &Limits) -> Result[Decoder, HttpError]:
    if limits.max_line < 2 or limits.max_head < 2 or limits.max_headers < 0 or limits.max_body < 0:
        return Err(HttpError.InvalidLimit)
    owned = Limits(limits.max_line, limits.max_head, limits.max_headers, limits.max_body)
    Ok(Decoder(owned, head, allocated(std.bytes.empty())?, allocated(std.bytes.empty())?, False, False, 0, 0, 0))

def allocated[T](result: Result[T, AllocError]) -> Result[T, HttpError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(HttpError.Allocation(cause))

def streamed[T](result: Result[T, StreamError]) -> Result[T, HttpError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(StreamError.Allocation(cause)):
            Err(HttpError.Allocation(cause))
        case Err(error):
            Err(HttpError.Stream(error))
