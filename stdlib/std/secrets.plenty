# Unpredictable bytes and tokens from the operating system. Policy is checked
# Plenty over one native request per call: short and interrupted requests are
# retried, any other failure is reported, and no weaker source is substituted.
# Seeded simulation generators are std.random. See
# book/src/design/stdlib/secrets.md.
import std.bytes
import std.encoding
from std.bytes import Bytes, BytesError
from std.encoding import EncodingError
from std.io import Reader, StreamError, classify, read_exact

pub enum SecretsError:
    OutOfRange
    EmptyRange
    Entropy(StreamError)
    Allocation(AllocError)

# The kernel's generator, read with getrandom(2). A zero-cost handle: there is
# no descriptor to open or close.
pub class OsEntropy:
    _source: u8

    pub def read(self: &mut OsEntropy, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        match buffer.read_os_entropy(start, stop):
            case Ok(count):
                Ok(count)
            case Err(error):
                Err(classify(error))

pub def os_entropy() -> OsEntropy:
    OsEntropy(0u8)

def allocated[T](result: Result[T, BytesError]) -> Result[T, SecretsError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(SecretsError.Allocation(cause))
                case _:
                    Err(SecretsError.OutOfRange)

def encoded(result: Result[str, EncodingError]) -> Result[str, SecretsError]:
    match result:
        case Ok(text):
            Ok(text)
        case Err(error):
            match error:
                case EncodingError.Allocation(cause):
                    Err(SecretsError.Allocation(cause))
                case _:
                    Err(SecretsError.OutOfRange)

# Overwrites a buffer that held secret bytes before it is released.
def erase(buffer: &mut Bytes) -> ():
    count = buffer.len()
    # The range is the whole buffer, so this cannot fail.
    drop(buffer.fill(0, count, 0u8))

# Secret generation over any byte source. `os()` is the only source that
# should back real secrets; another reader is for tests or a hardware device.
pub class Source[R]:
    pub inner: R

    # Fills target[start:stop] completely or reports why not. After a failure
    # the whole range is zero, so a partial fill cannot be mistaken for a
    # secret.
    pub def fill(self: &mut Source[R], target: &mut Bytes, start: i64, stop: i64) -> Result[(), SecretsError]:
        if start < 0 or start > stop or stop > target.len():
            return Err(SecretsError.OutOfRange)
        match read_exact(&mut self.inner, target, start, stop):
            case Ok(_):
                Ok(())
            case Err(partial):
                drop(target.fill(start, stop, 0u8))
                Err(SecretsError.Entropy(partial.cause))

    # `count` secret bytes in a new exactly sized buffer.
    pub def token_bytes(self: &mut Source[R], count: i64) -> Result[Bytes, SecretsError]:
        if count < 0:
            return Err(SecretsError.OutOfRange)
        mut token = allocated(std.bytes.with_capacity(count))?
        allocated(token.resize(count, 0u8))?
        self.fill(&mut token, 0, count)?
        Ok(token)

    # `count` secret bytes as 2 * count lowercase hex digits.
    pub def token_hex(self: &mut Source[R], count: i64) -> Result[str, SecretsError]:
        mut token = self.token_bytes(count)?
        text = std.encoding.hex_text(&token, 0, count)
        erase(&mut token)
        encoded(text)

    # `count` secret bytes as unpadded RFC 4648 base64url text.
    pub def token_urlsafe(self: &mut Source[R], count: i64) -> Result[str, SecretsError]:
        mut token = self.token_bytes(count)?
        text = std.encoding.base64url_text(&token, 0, count)
        erase(&mut token)
        encoded(text)

    # Eight secret bytes read as a little-endian integer.
    pub def next_u64(self: &mut Source[R]) -> Result[u64, SecretsError]:
        mut scratch = self.token_bytes(8)?
        mut value = 0u64
        for index in range(8):
            value = value | (u64(allocated(scratch.get(index))?) << u64(index * 8))
        erase(&mut scratch)
        Ok(value)

    # Uniform in [0, bound) without modulo bias, by rejection.
    pub def below(self: &mut Source[R], bound: u64) -> Result[u64, SecretsError]:
        if bound == 0u64:
            return Err(SecretsError.EmptyRange)
        threshold = 0u64.wrapping_sub(bound) % bound
        while True:
            value = self.next_u64()?
            if value >= threshold:
                return Ok(value % bound)
        Err(SecretsError.EmptyRange)

pub def source_from[R: Reader](inner: R) -> Source[R]:
    Source[R](inner)

pub def os() -> Source[OsEntropy]:
    Source[OsEntropy](OsEntropy(0u8))

pub def fill(target: &mut Bytes, start: i64, stop: i64) -> Result[(), SecretsError]:
    mut source = os()
    source.fill(target, start, stop)

pub def token_bytes(count: i64) -> Result[Bytes, SecretsError]:
    mut source = os()
    source.token_bytes(count)

pub def token_hex(count: i64) -> Result[str, SecretsError]:
    mut source = os()
    source.token_hex(count)

pub def token_urlsafe(count: i64) -> Result[str, SecretsError]:
    mut source = os()
    source.token_urlsafe(count)

pub def random_u64() -> Result[u64, SecretsError]:
    mut source = os()
    source.next_u64()

pub def below(bound: u64) -> Result[u64, SecretsError]:
    mut source = os()
    source.below(bound)
