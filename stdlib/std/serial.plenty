# Format-neutral, statically dispatched codecs. Formats own parsing, output
# and limits; codecs own field policy and constructor invariants.
# See book/src/design/stdlib/serial.md and issue #781.
import std.encoding
from std.bytes import Bytes
from std.fmt import Formatter, FormatError
import std.report

pub enum Kind:
    Null
    Boolean
    Integer
    Number
    Text
    Array
    Object
    DateTime
    Variant
    Key
    End

    pub def format[W](self, output: &mut Formatter[W]) -> Result[(), FormatError]:
        text = match self:
            case Kind.Null:
                "null"
            case Kind.Boolean:
                "boolean"
            case Kind.Integer:
                "integer"
            case Kind.Number:
                "number"
            case Kind.Text:
                "string"
            case Kind.Array:
                "array"
            case Kind.Object:
                "object"
            case Kind.DateTime:
                "date/time"
            case Kind.Variant:
                "enum tag or tagged object"
            case Kind.Key:
                "object key"
            case Kind.End:
                "end of container or input"
        output.text(&text)

pub enum Fault:
    UnexpectedKind
    KindMismatch(Kind, Kind)
    MissingField(str)
    DuplicateField(str)
    UnknownField(str)
    UnknownVariant(str)
    OutOfRange
    WrongLength(i64, i64)
    DuplicateElement
    Unrepresentable
    InvalidBase64(std.encoding.EncodingError)
    StackLimit

    pub def format[W](self, output: &mut Formatter[W]) -> Result[(), FormatError]:
        match self:
            case Fault.KindMismatch(expected, found):
                output.text("expected ")?
                std.report.render(expected, output)?
                output.text(", found ")?
                std.report.render(found, output)
            case Fault.MissingField(name):
                output.text("missing field ")?
                output.debug_text(name)
            case Fault.DuplicateField(name):
                output.text("duplicate field ")?
                output.debug_text(name)
            case Fault.UnknownField(name):
                output.text("unknown field ")?
                output.debug_text(name)
            case Fault.WrongLength(expected, found):
                output.text("expected ")?
                output.integer(*expected)?
                output.text(" elements, found ")?
                output.integer(*found)
            case Fault.UnexpectedKind:
                output.text("unexpected value kind")
            case Fault.UnknownVariant(_):
                output.text("unknown enum variant")
            case Fault.OutOfRange:
                output.text("value is outside the supported range")
            case Fault.DuplicateElement:
                output.text("duplicate set element")
            case Fault.Unrepresentable:
                output.text("value cannot be represented in this format")
            case Fault.InvalidBase64(_):
                output.text("invalid canonical base64 encoding")
            case Fault.StackLimit:
                output.text("serialization native stack limit exceeded")

pub enum Step:
    Field(str)
    Index(i64)
    Key(str)
    Variant(str)

pub class SerialError[E]:
    pub cause: E
    # Innermost first: propagating outwards appends without shifting.
    pub path: Option[list[Step]]
    pub complete: bool

    pub def source_offset(self) -> Option[i64]:
        self.cause.source_offset()

    pub def format[W](self, output: &mut Formatter[W]) -> Result[(), FormatError]:
        std.report.render(&self.cause, output)?
        output.text(" at $")?
        match &self.path:
            case Some(path):
                for reverse in range(len(path)):
                    index = unchecked:
                        len(path) - reverse - 1
                    match &path[index]:
                        case Step.Field(name) | Step.Key(name):
                            output.text("[")?
                            output.debug_text(name)?
                            output.text("]")?
                        case Step.Index(index):
                            output.text("[")?
                            output.integer(*index)?
                            output.text("]")?
                        case Step.Variant(name):
                            output.text("<")?
                            output.debug_text(name)?
                            output.text(">")?
            case Nothing:
                pass
        if not self.complete:
            output.text(" (path incomplete)")?
        Ok(())

    pub def at(self: SerialError[E], step: Step) -> SerialError[E]:
        mut error = self
        if not error.complete:
            return error
        mut path = match replace(error.path, Nothing):
            case Some(steps):
                steps
            case Nothing:
                match list[Step]():
                    case Ok(steps):
                        steps
                    case Err(_):
                        error.complete = False
                        return error
        if len(path) >= 1024:
            error.complete = False
        else:
            match path.append(step):
                case Ok(_):
                    pass
                case Err(_):
                    error.complete = False
        error.path = Some(path)
        error

# Root errors need no list allocation. Lazily allocate storage on the first
# contextual step; failure keeps the typed cause and marks the path incomplete.
pub def error[E](cause: E) -> SerialError[E]:
    SerialError(cause, Nothing, True)

pub def wrap[T, E](result: Result[T, E]) -> Result[T, SerialError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(error(cause))

pub def at[T, E](result: Result[T, SerialError[E]], step: Step) -> Result[T, SerialError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(cause.at(step))

pub protocol Encoder[E]:
    def reject(self, fault: Fault) -> E:
        pass
    def allocation(self, cause: AllocError) -> E:
        pass
    def null(self: &mut Encoder) -> Result[(), E]:
        pass
    def boolean(self: &mut Encoder, value: bool) -> Result[(), E]:
        pass
    def integer(self: &mut Encoder, value: i64) -> Result[(), E]:
        pass
    def unsigned(self: &mut Encoder, value: u64) -> Result[(), E]:
        pass
    def decimal(self: &mut Encoder, value: f64) -> Result[(), E]:
        pass
    def text(self: &mut Encoder, value: &str) -> Result[(), E]:
        pass
    def start_array(self: &mut Encoder) -> Result[(), E]:
        pass
    def end_array(self: &mut Encoder) -> Result[(), E]:
        pass
    def start_object(self: &mut Encoder) -> Result[(), E]:
        pass
    def key(self: &mut Encoder, name: &str) -> Result[(), E]:
        pass
    # Class fields admit omission of null in formats without null values;
    # ordinary mapping keys must retain their entries or reject the value.
    def field(self: &mut Encoder, name: &str) -> Result[(), E]:
        pass
    def end_object(self: &mut Encoder) -> Result[(), E]:
        pass

pub protocol Decoder[E]:
    # A text tag has no payload; an object tag selects its first value.
    # The caller consumes a payload then checks next_key for an exact one-tag object.
    def variant(self: &mut Decoder) -> Result[(str, bool), E]:
        pass
    def null(self: &mut Decoder) -> Result[bool, E]:
        pass
    def boolean(self: &mut Decoder) -> Result[bool, E]:
        pass
    def integer(self: &mut Decoder) -> Result[i64, E]:
        pass
    def unsigned(self: &mut Decoder) -> Result[u64, E]:
        pass
    def decimal(self: &mut Decoder) -> Result[f64, E]:
        pass
    def text(self: &mut Decoder) -> Result[str, E]:
        pass
    def start_array(self: &mut Decoder) -> Result[(), E]:
        pass
    def next_element(self: &mut Decoder) -> Result[bool, E]:
        pass
    def start_object(self: &mut Decoder) -> Result[(), E]:
        pass
    def next_key(self: &mut Decoder) -> Result[Option[str], E]:
        pass
    def unknown_key(self: &mut Decoder, name: &str) -> Result[(), E]:
        pass
    def reject(self, fault: Fault) -> E:
        pass
    def allocation(self, cause: AllocError) -> E:
        pass

# The compiler specializes these bodies for built-in values or checked hooks.
# Protocols alone cannot admit scalars and collection types.
pub def encode[T, E, S: Encoder[E]](value: &T, out: &mut S) -> Result[(), SerialError[E]]:
    value.__encode__[E, S](out)

pub def decode[T, E, D: Decoder[E]](source: &mut D) -> Result[T, SerialError[E]]:
    __serial_decode[T, E, D](source)

# Caller guards report through the same typed adapter bridge. These helpers
# remain unguarded so an exhausted codec segment can always report its cause.
def decode_stack_error_mut[E, D: Decoder[E]](source: &mut D) -> SerialError[E]:
    error(source.reject(Fault.StackLimit))

def decode_stack_error_ref[E, D: Decoder[E]](source: &D) -> SerialError[E]:
    error(source.reject(Fault.StackLimit))

def encode_stack_error_mut[E, S: Encoder[E]](out: &mut S) -> SerialError[E]:
    error(out.reject(Fault.StackLimit))

def encode_stack_error_ref[E, S: Encoder[E]](out: &S) -> SerialError[E]:
    error(out.reject(Fault.StackLimit))

# Missing-field behavior is selected after aliases and generic arguments are
# resolved, so an Option hidden by either still receives Nothing.
pub def absent[T, E, D: Decoder[E]](source: &D, name: &str) -> Result[T, SerialError[E]]:
    __serial_absent[T, E, D](source, name)

pub enum UnknownFields:
    Reject
    Ignore

# Allocation is part of the decoder's error domain, preserving the adapter's
# position just as a parse or schema rejection does.
pub def allocated[T, E, D: Decoder[E]](result: Result[T, AllocError], source: &D) -> Result[T, SerialError[E]]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(error(source.allocation(cause)))

# Text formats use canonical, padded RFC 4648 base64. Keep the allocation
# cause in the format's domain; malformed input retains the precise codec cause.
pub def encode_bytes[E, S: Encoder[E]](value: &[u8], out: &mut S) -> Result[(), SerialError[E]]:
    text = match std.encoding.base64_text(value):
        case Ok(text):
            text
        case Err(std.encoding.EncodingError.Allocation(cause)):
            return Err(error(out.allocation(cause)))
        case Err(_):
            __trap("base64 encoding a byte view cannot reject its input")
    wrap(out.text(&text))

pub def decode_bytes[E, D: Decoder[E]](source: &mut D) -> Result[Bytes, SerialError[E]]:
    text = wrap(source.text())?
    match std.encoding.base64_from_text(&text):
        case Ok(value):
            Ok(value)
        case Err(std.encoding.EncodingError.Allocation(cause)):
            Err(error(source.allocation(cause)))
        case Err(cause):
            Err(error(source.reject(Fault.InvalidBase64(cause))))

# Ordinary helpers keep the generated object's live locals proportional to
# its fields. In particular, each match arm need not allocate its own set of
# duplicate/error/try temporaries in the compiler's local-slot table.
pub def read_field[T, E, D: Decoder[E]](slot: &mut Option[T], source: &mut D, name: &str) -> Result[(), SerialError[E]]:
    if slot.is_some():
        return at[(), E](Err(error(source.reject(Fault.DuplicateField(*name)))), Step.Field(*name))
    value = at(decode[T, E, D](source), Step.Field(*name))?
    *slot = Some(value)
    Ok(())

pub def require_field[T, E, D: Decoder[E]](slot: &mut Option[T], source: &D, name: &str) -> Result[T, SerialError[E]]:
    match replace(*slot, Nothing):
        case Some(value):
            Ok(value)
        case Nothing:
            at(absent[T, E, D](source, name), Step.Field(*name))

# A validated constructor may reject with format-neutral Fault.
pub def constructed[T, E, D: Decoder[E]](value: Result[T, Fault], source: &D) -> Result[T, SerialError[E]]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(cause):
            Err(error(source.reject(cause)))

# Constructors and defaults that allocate as well as validate route each cause
# to its own decoder domain: allocation as `allocated` does, faults by `reject`.
# Other domain errors still need a handwritten hook to choose a wire mapping.
pub def constructed_or_allocated[T, E, D: Decoder[E]](value: Result[T, AllocError | Fault], source: &D) -> Result[T, SerialError[E]]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(cause):
            match cause:
                case allocation: AllocError:
                    Err(error(source.allocation(allocation)))
                case fault: Fault:
                    Err(error(source.reject(fault)))

# A generic constructor's error domain `X` is known only at specialization.
# The compiler expands this to `constructed`, `allocated` or
# `constructed_or_allocated` for that domain, and rejects any other.
pub def constructed_in[X, T, E, D: Decoder[E]](value: Result[T, X], source: &D) -> Result[T, SerialError[E]]:
    __serial_constructed_in[X, T, E, D](value, source)
