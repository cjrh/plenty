        if offset < 0 or offset > len(values) or len(values) - offset < 4:
            return Nothing
        Some(u32x4.Lanes(values[offset], values[offset + 1], values[offset + 2], values[offset + 3]))

pub enum f32x4:
    Lanes(f32, f32, f32, f32)

    pub def lane(self, index: i64) -> Option[f32]:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                if index == 0:
                    return Some(*a0)
                if index == 1:
                    return Some(*a1)
                if index == 2:
                    return Some(*a2)
                if index == 3:
                    return Some(*a3)
                Nothing

    pub def to_tuple(self) -> (f32, f32, f32, f32):
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                (*a0, *a1, *a2, *a3)

    pub def add(self, other: &f32x4) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        f32x4.Lanes(*a0 + *b0, *a1 + *b1, *a2 + *b2, *a3 + *b3)

    pub def sub(self, other: &f32x4) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        f32x4.Lanes(*a0 - *b0, *a1 - *b1, *a2 - *b2, *a3 - *b3)

    pub def mul(self, other: &f32x4) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        f32x4.Lanes(*a0 * *b0, *a1 * *b1, *a2 * *b2, *a3 * *b3)

    pub def sqrt(self) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                f32x4.Lanes((*a0).sqrt(), (*a1).sqrt(), (*a2).sqrt(), (*a3).sqrt())

    # Lanes 0 and 1, widened exactly. Lanes 2 and 3 are not read.
    pub def to_f64x2(self) -> f64x2:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                f64x2.Lanes(f64(*a0), f64(*a1))

    # Every lane, widened exactly.
    pub def to_f64x4(self) -> f64x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                f64x4.Lanes(f64(*a0), f64(*a1), f64(*a2), f64(*a3))

    pub def div(self, other: &f32x4) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        f32x4.Lanes(*a0 / *b0, *a1 / *b1, *a2 / *b2, *a3 / *b3)

    pub def simd_eq(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 == *b0, *a1 == *b1, *a2 == *b2, *a3 == *b3)

    pub def simd_ne(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 != *b0, *a1 != *b1, *a2 != *b2, *a3 != *b3)

    pub def simd_lt(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 < *b0, *a1 < *b1, *a2 < *b2, *a3 < *b3)

    pub def simd_le(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 <= *b0, *a1 <= *b1, *a2 <= *b2, *a3 <= *b3)

    pub def simd_gt(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 > *b0, *a1 > *b1, *a2 > *b2, *a3 > *b3)

    pub def simd_ge(self, other: &f32x4) -> mask32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 >= *b0, *a1 >= *b1, *a2 >= *b2, *a3 >= *b3)

    def selected(self, mask: &mask32x4, other: &f32x4) -> f32x4:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case f32x4.Lanes(b0, b1, b2, b3):
                        match mask:
                            case mask32x4.Lanes(m0, m1, m2, m3):
                                f32x4.Lanes(*a0 if *m0 else *b0, *a1 if *m1 else *b1, *a2 if *m2 else *b2, *a3 if *m3 else *b3)

    pub def sum_ordered(self, initial: f32) -> f32:
        match self:
            case f32x4.Lanes(a0, a1, a2, a3):
                ((((initial + *a0) + *a1) + *a2) + *a3)

    pub def set(self, values: &mut [f32], index: i64) -> ():
        # Vector `index` covers elements `index * 4` to `index * 4 + 3`;
        # the guard proves that span fits before any element access.
        unchecked:
            if index < 0 or index >= len(values) // 4:
                __trap("f32x4.set: index is outside 0..len_f32x4(values)")
            at = index * 4
            match self:
                case f32x4.Lanes(a0, a1, a2, a3):
                    values[at] = *a0
                    values[at + 1] = *a1
                    values[at + 2] = *a2
                    values[at + 3] = *a3

    pub def store(self, values: &mut list[f32], offset: i64) -> bool:
        # Short-circuit guards prove 0 <= offset <= len before subtraction;
        # the full lane span fits before any offset addition or store.
        unchecked:
            if offset < 0 or offset > len(values) or len(values) - offset < 4:
                return False
