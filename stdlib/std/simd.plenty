pub enum mask32x4:
    Lanes(bool, bool, bool, bool)

    pub def any(self) -> bool:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                *a0 or *a1 or *a2 or *a3

    pub def all(self) -> bool:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                *a0 and *a1 and *a2 and *a3

    pub def count(self) -> i64:
        # Each mask contributes 0 or 1; the total is at most four.
        unchecked:
            match self:
                case mask32x4.Lanes(a0, a1, a2, a3):
                    (1 if *a0 else 0) + (1 if *a1 else 0) + (1 if *a2 else 0) + (1 if *a3 else 0)

    pub def select[T](self, yes: &T, no: &T) -> T:
        yes.selected(self, no)

    pub def invert(self) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                mask32x4.Lanes(not *a0, not *a1, not *a2, not *a3)

    pub def and_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 and *b0, *a1 and *b1, *a2 and *b2, *a3 and *b3)

    pub def or_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 or *b0, *a1 or *b1, *a2 or *b2, *a3 or *b3)

    pub def xor_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 != *b0, *a1 != *b1, *a2 != *b2, *a3 != *b3)

