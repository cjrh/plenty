    if offset < 0 or offset > len(values) or len(values) - offset < 4:
        return Nothing
    Some(f32x4.Lanes(values[offset], values[offset + 1], values[offset + 2], values[offset + 3]))

pub enum f64x2:
    Lanes(f64, f64)

    pub def lane(self, index: i64) -> Option[f64]:
        match self:
            case f64x2.Lanes(a0, a1):
                if index == 0:
                    return Some(*a0)
                if index == 1:
                    return Some(*a1)
                Nothing

    pub def to_tuple(self) -> (f64, f64):
        match self:
            case f64x2.Lanes(a0, a1):
                (*a0, *a1)

    pub def add(self, other: &f64x2) -> f64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        f64x2.Lanes(*a0 + *b0, *a1 + *b1)

    pub def sub(self, other: &f64x2) -> f64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        f64x2.Lanes(*a0 - *b0, *a1 - *b1)

    pub def mul(self, other: &f64x2) -> f64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        f64x2.Lanes(*a0 * *b0, *a1 * *b1)

    pub def div(self, other: &f64x2) -> f64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        f64x2.Lanes(*a0 / *b0, *a1 / *b1)

    pub def simd_eq(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 == *b0, *a1 == *b1)

    pub def simd_ne(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 != *b0, *a1 != *b1)

    pub def simd_lt(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 < *b0, *a1 < *b1)

    pub def simd_le(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 <= *b0, *a1 <= *b1)

    pub def simd_gt(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 > *b0, *a1 > *b1)

    pub def simd_ge(self, other: &f64x2) -> mask64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 >= *b0, *a1 >= *b1)

    def selected(self, mask: &mask64x2, other: &f64x2) -> f64x2:
        match self:
            case f64x2.Lanes(a0, a1):
                match other:
                    case f64x2.Lanes(b0, b1):
                        match mask:
                            case mask64x2.Lanes(m0, m1):
                                f64x2.Lanes(*a0 if *m0 else *b0, *a1 if *m1 else *b1)

    pub def sum_ordered(self, initial: f64) -> f64:
        match self:
            case f64x2.Lanes(a0, a1):
                ((initial + *a0) + *a1)

    pub def store(self, values: &mut list[f64], offset: i64) -> bool:
        if offset < 0 or offset > len(values) or len(values) - offset < 2:
            return False
        match self:
            case f64x2.Lanes(a0, a1):
                values[offset] = *a0
                values[offset + 1] = *a1
        True

pub def splat_f64x2(value: f64) -> f64x2:
    f64x2.Lanes(value, value)

pub def load_f64x2(values: &list[f64], offset: i64 = 0) -> Option[f64x2]:
    if offset < 0 or offset > len(values) or len(values) - offset < 2:
        return Nothing
    Some(f64x2.Lanes(values[offset], values[offset + 1]))

pub enum mask32x4:
    Lanes(bool, bool, bool, bool)

    pub def any(self) -> bool:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                *a0 or *a1 or *a2 or *a3

    pub def all(self) -> bool:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                *a0 and *a1 and *a2 and *a3

    pub def count(self) -> i64:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                (1 if *a0 else 0) + (1 if *a1 else 0) + (1 if *a2 else 0) + (1 if *a3 else 0)

    pub def select[T](self, yes: &T, no: &T) -> T:
        yes.selected(self, no)

    pub def invert(self) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                mask32x4.Lanes(not *a0, not *a1, not *a2, not *a3)

    pub def and_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 and *b0, *a1 and *b1, *a2 and *b2, *a3 and *b3)

    pub def or_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 or *b0, *a1 or *b1, *a2 or *b2, *a3 or *b3)

    pub def xor_mask(self, other: &mask32x4) -> mask32x4:
        match self:
            case mask32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case mask32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 != *b0, *a1 != *b1, *a2 != *b2, *a3 != *b3)

pub enum mask64x2:
    Lanes(bool, bool)

    pub def any(self) -> bool:
        match self:
            case mask64x2.Lanes(a0, a1):
                *a0 or *a1

    pub def all(self) -> bool:
        match self:
            case mask64x2.Lanes(a0, a1):
                *a0 and *a1

    pub def count(self) -> i64:
        match self:
            case mask64x2.Lanes(a0, a1):
                (1 if *a0 else 0) + (1 if *a1 else 0)

    pub def select[T](self, yes: &T, no: &T) -> T:
        yes.selected(self, no)

    pub def invert(self) -> mask64x2:
        match self:
            case mask64x2.Lanes(a0, a1):
                mask64x2.Lanes(not *a0, not *a1)

    pub def and_mask(self, other: &mask64x2) -> mask64x2:
        match self:
            case mask64x2.Lanes(a0, a1):
                match other:
                    case mask64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 and *b0, *a1 and *b1)

    pub def or_mask(self, other: &mask64x2) -> mask64x2:
        match self:
            case mask64x2.Lanes(a0, a1):
                match other:
                    case mask64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 or *b0, *a1 or *b1)

    pub def xor_mask(self, other: &mask64x2) -> mask64x2:
        match self:
            case mask64x2.Lanes(a0, a1):
                match other:
                    case mask64x2.Lanes(b0, b1):
                        mask64x2.Lanes(*a0 != *b0, *a1 != *b1)
