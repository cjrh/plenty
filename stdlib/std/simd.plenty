# Portable logical vectors. Ordinary scalar bodies are the reference implementation;
# optimized builds may replace supported operations with native SIMD instructions.

pub enum i32x4:
    Lanes(i32, i32, i32, i32)

    pub def lane(self, index: i64) -> Option[i32]:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                if index == 0:
                    return Some(*a0)
                if index == 1:
                    return Some(*a1)
                if index == 2:
                    return Some(*a2)
                if index == 3:
                    return Some(*a3)
                Nothing

    pub def to_tuple(self) -> (i32, i32, i32, i32):
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                (*a0, *a1, *a2, *a3)

    pub def add(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes(*a0 + *b0, *a1 + *b1, *a2 + *b2, *a3 + *b3)

    pub def sub(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes(*a0 - *b0, *a1 - *b1, *a2 - *b2, *a3 - *b3)

    pub def mul(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes(*a0 * *b0, *a1 * *b1, *a2 * *b2, *a3 * *b3)

    pub def wrapping_add(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes((*a0).wrapping_add(*b0), (*a1).wrapping_add(*b1), (*a2).wrapping_add(*b2), (*a3).wrapping_add(*b3))

    pub def wrapping_sub(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes((*a0).wrapping_sub(*b0), (*a1).wrapping_sub(*b1), (*a2).wrapping_sub(*b2), (*a3).wrapping_sub(*b3))

    pub def wrapping_mul(self, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        i32x4.Lanes((*a0).wrapping_mul(*b0), (*a1).wrapping_mul(*b1), (*a2).wrapping_mul(*b2), (*a3).wrapping_mul(*b3))

    pub def simd_eq(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 == *b0, *a1 == *b1, *a2 == *b2, *a3 == *b3)

    pub def simd_ne(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 != *b0, *a1 != *b1, *a2 != *b2, *a3 != *b3)

    pub def simd_lt(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 < *b0, *a1 < *b1, *a2 < *b2, *a3 < *b3)

    pub def simd_le(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 <= *b0, *a1 <= *b1, *a2 <= *b2, *a3 <= *b3)

    pub def simd_gt(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 > *b0, *a1 > *b1, *a2 > *b2, *a3 > *b3)

    pub def simd_ge(self, other: &i32x4) -> mask32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 >= *b0, *a1 >= *b1, *a2 >= *b2, *a3 >= *b3)

    def selected(self, mask: &mask32x4, other: &i32x4) -> i32x4:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case i32x4.Lanes(b0, b1, b2, b3):
                        match mask:
                            case mask32x4.Lanes(m0, m1, m2, m3):
                                i32x4.Lanes(*a0 if *m0 else *b0, *a1 if *m1 else *b1, *a2 if *m2 else *b2, *a3 if *m3 else *b3)

    pub def wrapping_sum(self) -> i32:
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                (((*a0).wrapping_add(*a1)).wrapping_add(*a2)).wrapping_add(*a3)

    pub def store(self, values: &mut list[i32], offset: i64) -> bool:
        if offset < 0 or offset > len(values) or len(values) - offset < 4:
            return False
        match self:
            case i32x4.Lanes(a0, a1, a2, a3):
                values[offset] = *a0
                values[offset + 1] = *a1
                values[offset + 2] = *a2
                values[offset + 3] = *a3
        True

pub def splat_i32x4(value: i32) -> i32x4:
    i32x4.Lanes(value, value, value, value)

pub def load_i32x4(values: &list[i32], offset: i64 = 0) -> Option[i32x4]:
    if offset < 0 or offset > len(values) or len(values) - offset < 4:
        return Nothing
    Some(i32x4.Lanes(values[offset], values[offset + 1], values[offset + 2], values[offset + 3]))

pub enum u32x4:
    Lanes(u32, u32, u32, u32)

    pub def lane(self, index: i64) -> Option[u32]:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                if index == 0:
                    return Some(*a0)
                if index == 1:
                    return Some(*a1)
                if index == 2:
                    return Some(*a2)
                if index == 3:
                    return Some(*a3)
                Nothing

    pub def to_tuple(self) -> (u32, u32, u32, u32):
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                (*a0, *a1, *a2, *a3)

    pub def add(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes(*a0 + *b0, *a1 + *b1, *a2 + *b2, *a3 + *b3)

    pub def sub(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes(*a0 - *b0, *a1 - *b1, *a2 - *b2, *a3 - *b3)

    pub def mul(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes(*a0 * *b0, *a1 * *b1, *a2 * *b2, *a3 * *b3)

    pub def wrapping_add(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes((*a0).wrapping_add(*b0), (*a1).wrapping_add(*b1), (*a2).wrapping_add(*b2), (*a3).wrapping_add(*b3))

    pub def wrapping_sub(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes((*a0).wrapping_sub(*b0), (*a1).wrapping_sub(*b1), (*a2).wrapping_sub(*b2), (*a3).wrapping_sub(*b3))

    pub def wrapping_mul(self, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        u32x4.Lanes((*a0).wrapping_mul(*b0), (*a1).wrapping_mul(*b1), (*a2).wrapping_mul(*b2), (*a3).wrapping_mul(*b3))

    pub def simd_eq(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 == *b0, *a1 == *b1, *a2 == *b2, *a3 == *b3)

    pub def simd_ne(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 != *b0, *a1 != *b1, *a2 != *b2, *a3 != *b3)

    pub def simd_lt(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 < *b0, *a1 < *b1, *a2 < *b2, *a3 < *b3)

    pub def simd_le(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 <= *b0, *a1 <= *b1, *a2 <= *b2, *a3 <= *b3)

    pub def simd_gt(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 > *b0, *a1 > *b1, *a2 > *b2, *a3 > *b3)

    pub def simd_ge(self, other: &u32x4) -> mask32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        mask32x4.Lanes(*a0 >= *b0, *a1 >= *b1, *a2 >= *b2, *a3 >= *b3)

    def selected(self, mask: &mask32x4, other: &u32x4) -> u32x4:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                match other:
                    case u32x4.Lanes(b0, b1, b2, b3):
                        match mask:
                            case mask32x4.Lanes(m0, m1, m2, m3):
                                u32x4.Lanes(*a0 if *m0 else *b0, *a1 if *m1 else *b1, *a2 if *m2 else *b2, *a3 if *m3 else *b3)

    pub def wrapping_sum(self) -> u32:
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                (((*a0).wrapping_add(*a1)).wrapping_add(*a2)).wrapping_add(*a3)

    pub def store(self, values: &mut list[u32], offset: i64) -> bool:
        if offset < 0 or offset > len(values) or len(values) - offset < 4:
            return False
        match self:
            case u32x4.Lanes(a0, a1, a2, a3):
                values[offset] = *a0
                values[offset + 1] = *a1
                values[offset + 2] = *a2
                values[offset + 3] = *a3
        True

