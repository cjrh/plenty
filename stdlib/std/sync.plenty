# `Mutex[T]`: a value and the futex words that guard it. `lock()`,
# `lock_now()`, `lock_when()` and `into_inner()` are provided by the compiler;
# see book/src/design/stdlib/sync.md. `CancellationToken` is also
# compiler-provided.
from std.atomic import Atomic

# State bits 0-1 are 0 unlocked, 1 locked, and 2 locked with possible lock
# waiters; bit 2 records `lock_when` waiters. Each unlock that finds that bit
# advances `sequence`, which those waiters sleep on.
pub class Mutex[T]:
    state: Atomic[u32]
    sequence: Atomic[u32]
    value: T

    pub def __init__(self, value: T) -> ():
        self.state = Atomic[u32](0)
        self.sequence = Atomic[u32](0)
        self.value = value

# Why a lock was not acquired. `with mutex.lock_now()? as value:` fails with
# WouldBlock when another holder has the lock;
# `with mutex.lock_when(ready, &deadline, &cancel)? as value:` fails with
# TimedOut or Cancelled when its predicate did not become true in time.
pub enum LockError:
    WouldBlock
    TimedOut
    Cancelled

# Typed total-budget waits over the compiler's millisecond primitives. Polling
# is bounded because channel and future condition variables do not observe a
# separate cancellation token. A failed send always returns the owned value.
from std.time import Deadline, monotonic_now

pub enum WaitError:
    TimedOut
    Cancelled
    Disconnected

pub enum SendBeforeError[T]:
    TimedOut(T)
    Cancelled(T)
    Disconnected(T)

# At most ten milliseconds of sleeping before checking caller cancellation.
def wait_slice(deadline: &Deadline) -> u64:
    remaining = deadline.remaining(&monotonic_now()).as_timeout_ms()
    if remaining > 10u64:
        10u64
    else:
        remaining

pub def recv_before[T](receiver: &Receiver[T], deadline: &Deadline, cancel: &CancellationToken) -> Result[T, WaitError]:
    while True:
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        match receiver.recv_timeout_ms(wait_slice(deadline)):
            case Ok(value):
                return Ok(value)
            case Err(RecvTimeoutError.Disconnected):
                return Err(WaitError.Disconnected)
            case Err(RecvTimeoutError.TimedOut):
                if cancel.is_cancelled():
                    return Err(WaitError.Cancelled)
                if deadline.expired(&monotonic_now()):
                    return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

pub def send_before[T](sender: &Sender[T], value: T, deadline: &Deadline, cancel: &CancellationToken) -> Result[(), SendBeforeError[T]]:
    mut pending = value
    while True:
        if cancel.is_cancelled():
            return Err(SendBeforeError[T].Cancelled(pending))
        match sender.send_timeout_ms(pending, wait_slice(deadline)):
            case Ok(_):
                return Ok(())
            case Err(SendTimeoutError.Disconnected(unsent)):
                return Err(SendBeforeError[T].Disconnected(unsent))
            case Err(SendTimeoutError.TimedOut(unsent)):
                pending = unsent
                if cancel.is_cancelled():
                    return Err(SendBeforeError[T].Cancelled(pending))
                if deadline.expired(&monotonic_now()):
                    return Err(SendBeforeError[T].TimedOut(pending))
    Err(SendBeforeError[T].TimedOut(pending))

pub def future_before[T](future: &Future[T], deadline: &Deadline, cancel: &CancellationToken) -> Result[(), WaitError]:
    while True:
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        if future.wait_timeout_ms(wait_slice(deadline)):
            return Ok(())
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        if deadline.expired(&monotonic_now()):
            return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

pub def cancelled_before(token: &CancellationToken, deadline: &Deadline, cancel: &CancellationToken) -> Result[(), WaitError]:
    while True:
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        if token.wait_timeout_ms(wait_slice(deadline)):
            return Ok(())
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        if deadline.expired(&monotonic_now()):
            return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

pub def select_recv_before[A, B](first: &Receiver[A], second: &Receiver[B], deadline: &Deadline, cancel: &CancellationToken) -> Result[Selected[A, B], WaitError]:
    while True:
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        match select_recv_timeout_ms(first, second, wait_slice(deadline)):
            case Ok(selected):
                return Ok(selected)
            case Err(SelectError.Disconnected):
                return Err(WaitError.Disconnected)
            case Err(SelectError.TimedOut) | Err(SelectError.Empty):
                if cancel.is_cancelled():
                    return Err(WaitError.Cancelled)
                if deadline.expired(&monotonic_now()):
                    return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

# Results of pool jobs, collected in completion order. Each accepted job keeps
# its future in one of `capacity` slots until its result is taken, so a worker
# never waits to deliver a result, and a blocking pool submission waits only
# for queue space that running workers free. That removes the cycle in which
# workers block on a full completion channel while its only receiver waits to
# submit. Futures have no wait-for-any primitive: waits sleep on one future for
# at most ten milliseconds and then check every slot, like the typed waits above.
pub class Completions[T]:
    _slots: list[Option[Future[T]]]
    _count: i64

    pub def __init__(self, capacity: Positive[i64]) -> Result[(), AllocError]:
        size = capacity.get()
        self._slots = list[Option[Future[T]]].with_capacity(size)?
        for index in range(size):
            self._slots.append(Nothing)?
        self._count = 0
        Ok(())

    pub def len(self) -> i64:
        self._count

    pub def is_empty(self) -> bool:
        self._count == 0

    pub def is_full(self) -> bool:
        self._count == len(self._slots)

    pub def capacity(self) -> i64:
        len(self._slots)

    # When every slot is occupied, waits for a finished job first and returns
    # its result after the new job is accepted. A rejected job comes back intact
    # in its error and the finished result stays queued for `next`.
    pub def submit[F: OnceCallable[[], T]](self: &mut Completions[T], pool: &ThreadPoolExecutor, job: F) -> Result[Option[Result[T, FutureError]], SubmitError[F]]:
        if self._count < len(self._slots):
            future = pool.submit(job)?
            index = self.vacant()
            replace(self._slots[index], Some(future))
            # Bounded by the slot count.
            unchecked:
                self._count += 1
            return Ok(Nothing)
        mut index = self.finished()
        while index < 0:
            self.pause(10u64)
            index = self.finished()
        future = pool.submit(job)?
        match replace(self._slots[index], Some(future)):
            case Some(previous):
                Ok(Some(previous.result()))
            case Nothing:
                __trap("Completions.submit: finished slot is empty")

    pub def next_now(self: &mut Completions[T]) -> Option[Result[T, FutureError]]:
        index = self.finished()
        if index < 0:
            return Nothing
        Some(self.take(index))

    pub def next(self: &mut Completions[T]) -> Result[T, FutureError]:
        if self._count == 0:
            __trap("Completions.next: no job is outstanding")
        while True:
            index = self.finished()
            if index >= 0:
                return self.take(index)
            self.pause(10u64)
        __trap("Completions.next: unreachable")

    pub def next_before(self: &mut Completions[T], deadline: &Deadline, cancel: &CancellationToken) -> Result[Result[T, FutureError], WaitError]:
        if self._count == 0:
            __trap("Completions.next_before: no job is outstanding")
        while True:
            index = self.finished()
            if index >= 0:
                return Ok(self.take(index))
            if cancel.is_cancelled():
                return Err(WaitError.Cancelled)
            if deadline.expired(&monotonic_now()):
                return Err(WaitError.TimedOut)
            self.pause(wait_slice(deadline))
        Err(WaitError.TimedOut)

    # Waits for a finished job or a message, whichever is seen first. With no
    # outstanding job it waits for the message alone.
    pub def next_or_recv_before[M](self: &mut Completions[T], receiver: &Receiver[M], deadline: &Deadline, cancel: &CancellationToken) -> Result[Selected[Result[T, FutureError], M], WaitError]:
        while True:
            index = self.finished()
            if index >= 0:
                return Ok(Selected[Result[T, FutureError], M].First(self.take(index)))
            if cancel.is_cancelled():
                return Err(WaitError.Cancelled)
            match receiver.recv_timeout_ms(0u64 if self._count > 0 else wait_slice(deadline)):
                case Ok(message):
                    return Ok(Selected[Result[T, FutureError], M].Second(message))
                case Err(RecvTimeoutError.Disconnected):
                    return Err(WaitError.Disconnected)
                case Err(RecvTimeoutError.TimedOut):
                    pass
            if deadline.expired(&monotonic_now()):
                return Err(WaitError.TimedOut)
            self.pause(wait_slice(deadline))
        Err(WaitError.TimedOut)

    # Cancels jobs that have not started. Their results arrive from `next` as
    # `FutureError.Cancelled`; running jobs finish normally.
    pub def cancel_queued(self) -> i64:
        mut cancelled = 0
        for index in range(len(self._slots)):
            match &self._slots[index]:
                case Some(future):
                    if future.cancel():
                        unchecked:
                            cancelled += 1
                case Nothing:
                    pass
        cancelled

    def vacant(self) -> i64:
        for index in range(len(self._slots)):
            if self._slots[index].is_none():
                return index
        __trap("Completions: no vacant slot below capacity")

    def finished(self) -> i64:
        for index in range(len(self._slots)):
            match &self._slots[index]:
                case Some(future):
                    if future.done():
                        return index
                case Nothing:
                    pass
        -1

    # Sleeps on the first occupied slot for at most `slice` milliseconds.
    def pause(self, slice: u64) -> ():
        for index in range(len(self._slots)):
            match &self._slots[index]:
                case Some(future):
                    drop(future.wait_timeout_ms(slice))
                    return
                case Nothing:
                    pass

    def take(self: &mut Completions[T], index: i64) -> Result[T, FutureError]:
        match replace(self._slots[index], Nothing):
            case Some(future):
                unchecked:
                    self._count -= 1
                future.result()
            case Nothing:
                __trap("Completions: slot is empty")
