pub enum TimeUnit:
    Milliseconds
    Microseconds
    Nanoseconds

def time_unit_code(unit: TimeUnit) -> i32:
    match unit:
        case TimeUnit.Milliseconds:
            0i32
        case TimeUnit.Microseconds:
            1i32
        case TimeUnit.Nanoseconds:
            2i32

pub enum DType:
    I64
    F64
    Bool
    String
    Date
    Datetime(TimeUnit, Option[str])
    List
    Struct
    Other(str)

pub class Field:
    pub name: str
    pub dtype: DType

# Preorder indexes describe a tree without making ordinary DType values recursive.
pub class SchemaNode:
    pub parent: i64
    pub name: str
    pub dtype: DType

class SchemaTree:
    raw: RawSchemaTree
    def __init__(self) -> ():
        self.raw = RawSchemaTree.null()
    def __del__(self) -> ():
        schema_tree_drop(self.raw)
    def unpack(self) -> Result[list[SchemaNode], DataFrameError]:
        mut count = 0
        checked(schema_tree_len_raw(self.raw, &mut count))?
        mut parents = allocated([0 for _ in range(count)])?
        mut strings = Strings()
        checked(schema_tree_copy_raw(self.raw, &mut parents, &mut strings.raw))?
        descriptions = fields(strings)?
        allocated([SchemaNode(parents[i], descriptions[i].name, descriptions[i].dtype) for i in range(count)])

pub class ListParts:
    pub values: Column
    pub offsets: list[i64]
    pub valid: list[bool]

pub class StructParts:
    pub fields: DataFrame
    pub valid: list[bool]

def scalar_dtype(dtype: DType) -> Result[i32, DataFrameError]:
    match dtype:
        case DType.I64:
            Ok(0i32)
        case DType.F64:
            Ok(1i32)
        case DType.Bool:
            Ok(2i32)
        case DType.String:
            Ok(3i32)
        case _:
            Err(DataFrameError.Schema("cast and CSV schema overrides require I64, F64, Bool or String"))

class CsvSchema:
    raw: RawCsvSchema
    def __init__(self) -> ():
        self.raw = RawCsvSchema.null()
    def __del__(self) -> ():
        csv_schema_drop(self.raw)

pub enum JoinKind:
    Inner
    Left
    Full
    Semi
    Anti

pub enum AsOfStrategy:
    Backward
    Forward
    Nearest

pub class SortKey:
    expr: Expr
    descending: bool
    nulls_last: bool
    pub def __init__(self, expression: Expr, descending: bool = False, nulls_last: bool = True) -> ():
        self.expr = expression
        self.descending = descending
        self.nulls_last = nulls_last

pub enum DataFrameError:
    Schema(str)
    Query(str)
    Io(str)
    NativePanic(str)
    Null(str)
    Bounds(str)
    Allocation(AllocError)
    Message(IoError)

def allocated[T](result: Result[T, AllocError]) -> Result[T, DataFrameError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(DataFrameError.Allocation(error))

class ErrorOwner:
    raw: RawError
    def __init__(self, raw: RawError) -> ():
        self.raw = raw
    def __del__(self) -> ():
        error_drop(self.raw)

def checked(raw: RawError) -> Result[(), DataFrameError]:
    if raw.is_null():
        return Ok(())
    owner = ErrorOwner(raw)
    kind = error_kind(owner.raw)
    count = error_len(owner.raw)
    mut bytes = allocated([0u8 for _ in range(count)])?
    error_copy(owner.raw, &mut bytes)
    message = match decode_utf8(&bytes):
        case Ok(value):
            value
        case Err(error):
            return Err(DataFrameError.Message(error))
    match kind:
        case 2:
            Err(DataFrameError.Query(message))
        case 3:
            Err(DataFrameError.Io(message))
        case 4:
            Err(DataFrameError.NativePanic(message))
        case 5:
            Err(DataFrameError.Null(message))
        case 7:
            Err(DataFrameError.Bounds(message))
        case _:
            Err(DataFrameError.Schema(message))


# Transport nullable values as scalar payloads plus explicit validity bytes.
# No native code observes Plenty's Option, bool, string, or object layout.
def validity[T](value: &Option[T]) -> u8:
    match value:
        case Some(_):
            1u8
        case Nothing:
            0u8

def payload[T](value: &Option[T], fallback: T) -> T:
    match value:
        case Some(item):
            *item
        case Nothing:
            fallback

def optional[T](value: T, valid: u8) -> Option[T]:
    if valid == 0u8:
        return Nothing
    Some(value)

class Strings:
    raw: RawStrings
    def __init__(self) -> ():
        self.raw = RawStrings.null()
    def __del__(self) -> ():
        strings_drop(self.raw)
    def unpack(self) -> Result[list[Option[str]], DataFrameError]:
        mut rows = 0
        mut count = 0
        checked(strings_meta(self.raw, &mut rows, &mut count))?
        mut bytes = allocated([0u8 for _ in range(count)])?
        mut offsets = allocated([0 for _ in range(rows + 1)])?
        mut valid = allocated([0u8 for _ in range(rows)])?
        checked(strings_copy(self.raw, &mut bytes, &mut offsets, &mut valid))?
        mut out = allocated(list[Option[str]]())?
        for i in range(rows):
            if valid[i] == 0u8:
                allocated(out.append(Nothing))?
            else:
                # Byte ranges, not str.slice's Unicode-scalar offsets.
                part = allocated(bytes.slice(offsets[i], offsets[i + 1]))?
                value = match decode_utf8(part):
                    case Ok(text):
                        text
                    case Err(error):
                        return Err(DataFrameError.Message(error))
                allocated(out.append(Some(value)))?
        Ok(out)

def datetime_dtype(native: &str, unit: TimeUnit) -> Result[DType, DataFrameError]:
    zone = allocated(native.slice(12, len(native)))?
    Ok(DType.Datetime(unit, Nothing if len(zone) == 0 else Some(zone)))

def temporal_dtype(native: &str) -> Result[DType, DataFrameError]:
    if native.startswith("Datetime:ms:"):
        return datetime_dtype(native, TimeUnit.Milliseconds)
    elif native.startswith("Datetime:us:"):
        return datetime_dtype(native, TimeUnit.Microseconds)
    elif native.startswith("Datetime:ns:"):
        return datetime_dtype(native, TimeUnit.Nanoseconds)
    Ok(DType.Other(*native))

def fields(strings: &Strings) -> Result[list[Field], DataFrameError]:
    entries = strings.unpack()?
    mut out = allocated(list[Field]())?
    for i in range(0, len(entries), 2):
        name = entries[i].unwrap()
        native = entries[i + 1].unwrap()
        dtype = match native:
            case "Int64":
                DType.I64
            case "Float64":
                DType.F64
            case "Boolean":
                DType.Bool
            case "String":
                DType.String
            case "Date":
                DType.Date
            case "List":
                DType.List
            case "Struct":
                DType.Struct
            case _:
                temporal_dtype(native)?
        allocated(out.append(Field(name, dtype)))?
    Ok(out)

def string_offsets(values: &list[str]) -> Result[list[i64], DataFrameError]:
    mut offsets = allocated([0])?
    mut total = 0
    for value in values:
        total += value.byte_len()
        allocated(offsets.append(total))?
    Ok(offsets)

pub class Column:
    raw: RawColumn
    def __init__(self) -> ():
        self.raw = RawColumn.null()
    def __del__(self) -> ():
        column_drop(self.raw)
    pub def len(self) -> Result[i64, DataFrameError]:
        mut out = 0
        checked(column_len_raw(self.raw, &mut out))?
        Ok(out)
    pub def to_frame(self) -> Result[DataFrame, DataFrameError]:
        mut out = DataFrame()
        checked(column_frame_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def list_parts(self) -> Result[ListParts, DataFrameError]:
        count = self.len()?
        mut values = Column()
        mut offsets = allocated([0 for _ in range(count + 1)])?
        mut valid = allocated([0u8 for _ in range(count)])?
        checked(list_parts_raw(self.raw, &mut values.raw, &mut offsets, &mut valid))?
        present = allocated([*v != 0u8 for v in &valid])?
        Ok(ListParts(values, offsets, present))
    pub def struct_parts(self) -> Result[StructParts, DataFrameError]:
        count = self.len()?
        mut fields = DataFrame()
        mut valid = allocated([0u8 for _ in range(count)])?
        checked(struct_parts_raw(self.raw, &mut fields.raw, &mut valid))?
        present = allocated([*v != 0u8 for v in &valid])?
        Ok(StructParts(fields, present))

pub class DataFrame:
    raw: RawFrame
    def __init__(self) -> ():
        self.raw = RawFrame.null()
    def __del__(self) -> ():
        frame_drop(self.raw)
    pub def column(self, name: &str) -> Result[Column, DataFrameError]:
        mut out = Column()
        checked(frame_column_raw(self.raw, name, &mut out.raw))?
        Ok(out)
    pub def schema_tree(self) -> Result[list[SchemaNode], DataFrameError]:
        mut out = SchemaTree()
        checked(frame_schema_tree_raw(self.raw, &mut out.raw))?
        out.unpack()
    pub def height(self) -> Result[i64, DataFrameError]:
        mut out = 0
        checked(height_raw(self.raw, &mut out))?
        Ok(out)
    pub def lazy(self) -> Result[Query, DataFrameError]:
        mut out = Query()
        checked(lazy_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def write_parquet(self, path: &str) -> Result[(), DataFrameError]:
        checked(write_raw(self.raw, path))
    pub def write_csv(self, path: &str, has_header: bool = True, separator: &str = ",", null_value: &str = "") -> Result[(), DataFrameError]:
        checked(write_csv_raw(self.raw, path, 1u8 if has_header else 0u8, separator, null_value))
    pub def get_date_days(self, name: &str, row: i64) -> Result[Option[i32], DataFrameError]:
        mut out = 0i32
        mut valid = 0u8
