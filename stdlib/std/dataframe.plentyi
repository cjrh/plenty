extern def strings_drop(raw: RawStrings) -> () = "pldf_v1_strings_drop"
extern def strings_meta(raw: RawStrings, rows: &mut i64, bytes: &mut i64) -> RawError = "pldf_v1_strings_meta"
extern def strings_copy(raw: RawStrings, bytes: &mut list[u8] as strided, offsets: &mut list[i64] as strided, valid: &mut list[u8] as strided) -> RawError = "pldf_v1_strings_copy"
extern def get_str_raw(frame: RawFrame, name: &str as utf8, row: i64, out: &mut RawStrings) -> RawError = "pldf_v1_get_str"
extern def values_str_raw(frame: RawFrame, name: &str as utf8, nullable: u8, out: &mut RawStrings) -> RawError = "pldf_v1_values_str"
extern def frame_schema_raw(frame: RawFrame, out: &mut RawStrings) -> RawError = "pldf_v1_frame_schema"
extern def query_schema_raw(query: RawQuery, out: &mut RawStrings) -> RawError = "pldf_v1_query_schema"
extern def native_str(name: &str as utf8, packed: &str as utf8, offsets: &list[i64] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_str"
extern def native_str_nullable(name: &str as utf8, packed: &str as utf8, offsets: &list[i64] as strided, valid: &list[u8] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_str_nullable"
extern def native_bool(name: &str as utf8, values: &list[u8] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_bool"
extern def get_bool_raw(frame: RawFrame, name: &str as utf8, row: i64, out: &mut u8, valid: &mut u8) -> RawError = "pldf_v1_get_bool"
extern def values_bool_raw(frame: RawFrame, name: &str as utf8, values: &mut list[u8] as strided) -> RawError = "pldf_v1_values_bool"
extern def native_i64_nullable(name: &str as utf8, values: &list[i64] as strided, valid: &list[u8] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_i64_nullable"
extern def values_i64_nullable_raw(frame: RawFrame, name: &str as utf8, values: &mut list[i64] as strided, valid: &mut list[u8] as strided) -> RawError = "pldf_v1_values_i64_nullable"
extern def native_f64_nullable(name: &str as utf8, values: &list[f64] as strided, valid: &list[u8] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_f64_nullable"
extern def values_f64_nullable_raw(frame: RawFrame, name: &str as utf8, values: &mut list[f64] as strided, valid: &mut list[u8] as strided) -> RawError = "pldf_v1_values_f64_nullable"
extern def native_bool_nullable(name: &str as utf8, values: &list[u8] as strided, valid: &list[u8] as strided, out: &mut RawColumn) -> RawError = "pldf_v1_bool_nullable"
extern def values_bool_nullable_raw(frame: RawFrame, name: &str as utf8, values: &mut list[u8] as strided, valid: &mut list[u8] as strided) -> RawError = "pldf_v1_values_bool_nullable"

pub enum DType:
    I64
    F64
    Bool
    String
    Other(str)

pub class Field:
    pub name: str
    pub dtype: DType

def scalar_dtype(dtype: DType) -> Result[i32, DataFrameError]:
    match dtype:
        case DType.I64:
            Ok(0i32)
        case DType.F64:
            Ok(1i32)
        case DType.Bool:
            Ok(2i32)
        case DType.String:
            Ok(3i32)
        case DType.Other(_):
            Err(DataFrameError.Schema("dtype must be I64, F64, Bool or String"))

class CsvSchema:
    raw: RawCsvSchema
    def __init__(self) -> ():
        self.raw = RawCsvSchema.null()
    def __del__(self) -> ():
        csv_schema_drop(self.raw)

pub enum JoinKind:
    Inner
    Left

pub class SortKey:
    expr: Expr
    descending: bool
    nulls_last: bool
    pub def __init__(self, expression: Expr, descending: bool = False, nulls_last: bool = True) -> ():
        self.expr = expression
        self.descending = descending
        self.nulls_last = nulls_last

pub enum DataFrameError:
    Schema(str)
    Query(str)
    Io(str)
    NativePanic(str)
    Null(str)
    Bounds(str)
    Allocation(AllocError)
    Message(IoError)

def allocated[T](result: Result[T, AllocError]) -> Result[T, DataFrameError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(DataFrameError.Allocation(error))

class ErrorOwner:
    raw: RawError
    def __init__(self, raw: RawError) -> ():
        self.raw = raw
    def __del__(self) -> ():
        error_drop(self.raw)

def checked(raw: RawError) -> Result[(), DataFrameError]:
    if raw.is_null():
        return Ok(())
    owner = ErrorOwner(raw)
    kind = error_kind(owner.raw)
    count = error_len(owner.raw)
    mut bytes = allocated([0u8 for _ in range(count)])?
    error_copy(owner.raw, &mut bytes)
    message = match decode_utf8(&bytes):
        case Ok(value):
            value
        case Err(error):
            return Err(DataFrameError.Message(error))
    match kind:
        case 2:
            Err(DataFrameError.Query(message))
        case 3:
            Err(DataFrameError.Io(message))
        case 4:
            Err(DataFrameError.NativePanic(message))
        case 5:
            Err(DataFrameError.Null(message))
        case 7:
            Err(DataFrameError.Bounds(message))
        case _:
            Err(DataFrameError.Schema(message))


# Transport nullable values as scalar payloads plus explicit validity bytes.
# No native code observes Plenty's Option, bool, string, or object layout.
def validity[T](value: &Option[T]) -> u8:
    match value:
        case Some(_):
            1u8
        case Nothing:
            0u8

def payload[T](value: &Option[T], fallback: T) -> T:
    match value:
        case Some(item):
            *item
        case Nothing:
            fallback

def optional[T](value: T, valid: u8) -> Option[T]:
    if valid == 0u8:
        return Nothing
    Some(value)

class Strings:
    raw: RawStrings
    def __init__(self) -> ():
        self.raw = RawStrings.null()
    def __del__(self) -> ():
        strings_drop(self.raw)
    def unpack(self) -> Result[list[Option[str]], DataFrameError]:
        mut rows = 0
        mut count = 0
        checked(strings_meta(self.raw, &mut rows, &mut count))?
        mut bytes = allocated([0u8 for _ in range(count)])?
        mut offsets = allocated([0 for _ in range(rows + 1)])?
        mut valid = allocated([0u8 for _ in range(rows)])?
        checked(strings_copy(self.raw, &mut bytes, &mut offsets, &mut valid))?
        mut out = allocated(list[Option[str]]())?
        for i in range(rows):
            if valid[i] == 0u8:
                allocated(out.append(Nothing))?
            else:
                # Byte ranges, not str.slice's Unicode-scalar offsets.
                part = allocated(bytes.slice(offsets[i], offsets[i + 1]))?
                value = match decode_utf8(part):
                    case Ok(text):
                        text
                    case Err(error):
                        return Err(DataFrameError.Message(error))
                allocated(out.append(Some(value)))?
        Ok(out)

def fields(strings: &Strings) -> Result[list[Field], DataFrameError]:
    entries = strings.unpack()?
    mut out = allocated(list[Field]())?
    for i in range(0, len(entries), 2):
        name = entries[i].unwrap()
        native = entries[i + 1].unwrap()
        dtype = match native:
            case "Int64":
                DType.I64
            case "Float64":
                DType.F64
            case "Boolean":
                DType.Bool
            case "String":
                DType.String
            case _:
                DType.Other(native)
        allocated(out.append(Field(name, dtype)))?
    Ok(out)

def string_offsets(values: &list[str]) -> Result[list[i64], DataFrameError]:
    mut offsets = allocated([0])?
    mut total = 0
    for value in values:
        total += value.byte_len()
        allocated(offsets.append(total))?
    Ok(offsets)

pub class Column:
    raw: RawColumn
    def __init__(self) -> ():
        self.raw = RawColumn.null()
    def __del__(self) -> ():
        column_drop(self.raw)

pub class DataFrame:
    raw: RawFrame
    def __init__(self) -> ():
        self.raw = RawFrame.null()
    def __del__(self) -> ():
        frame_drop(self.raw)
    pub def height(self) -> Result[i64, DataFrameError]:
        mut out = 0
        checked(height_raw(self.raw, &mut out))?
        Ok(out)
    pub def lazy(self) -> Result[Query, DataFrameError]:
        mut out = Query()
        checked(lazy_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def write_parquet(self, path: &str) -> Result[(), DataFrameError]:
        checked(write_raw(self.raw, path))
    pub def write_csv(self, path: &str, has_header: bool = True, separator: &str = ",", null_value: &str = "") -> Result[(), DataFrameError]:
        checked(write_csv_raw(self.raw, path, 1u8 if has_header else 0u8, separator, null_value))
    pub def get_i64(self, name: &str, row: i64) -> Result[Option[i64], DataFrameError]:
        mut out = 0
        mut valid = 0u8
        checked(get_i64_raw(self.raw, name, row, &mut out, &mut valid))?
        if valid == 0u8:
            return Ok(Nothing)
        Ok(Some(out))
    pub def values_i64(self, name: &str) -> Result[list[i64], DataFrameError]:
        count = self.height()?
        mut out = allocated([0 for _ in range(count)])?
        checked(values_i64_raw(self.raw, name, &mut out))?
        Ok(out)
    pub def get_f64(self, name: &str, row: i64) -> Result[Option[f64], DataFrameError]:
        mut out = 0.0
        mut valid = 0u8
        checked(get_f64_raw(self.raw, name, row, &mut out, &mut valid))?
        if valid == 0u8:
            return Ok(Nothing)
        Ok(Some(out))
    pub def values_f64(self, name: &str) -> Result[list[f64], DataFrameError]:
        count = self.height()?
        mut out = allocated([0.0 for _ in range(count)])?
        checked(values_f64_raw(self.raw, name, &mut out))?
        Ok(out)

    pub def schema(self) -> Result[list[Field], DataFrameError]:
        mut out = Strings()
        checked(frame_schema_raw(self.raw, &mut out.raw))?
        fields(out)
    pub def get_bool(self, name: &str, row: i64) -> Result[Option[bool], DataFrameError]:
        mut out = 0u8
        mut valid = 0u8
        checked(get_bool_raw(self.raw, name, row, &mut out, &mut valid))?
        Ok(optional(out != 0u8, valid))
    pub def get_str(self, name: &str, row: i64) -> Result[Option[str], DataFrameError]:
        mut out = Strings()
        checked(get_str_raw(self.raw, name, row, &mut out.raw))?
        values = out.unpack()?
        Ok(values[0])
    pub def values_bool(self, name: &str) -> Result[list[bool], DataFrameError]:
        count = self.height()?
        mut out = allocated([0u8 for _ in range(count)])?
        checked(values_bool_raw(self.raw, name, &mut out))?
        allocated([*value != 0u8 for value in &out])
    pub def values_str(self, name: &str) -> Result[list[str], DataFrameError]:
        mut out = Strings()
        checked(values_str_raw(self.raw, name, 0u8, &mut out.raw))?
        values = out.unpack()?
        allocated([payload(value, "") for value in &values])
    pub def values_str_nullable(self, name: &str) -> Result[list[Option[str]], DataFrameError]:
        mut out = Strings()
        checked(values_str_raw(self.raw, name, 1u8, &mut out.raw))?
        out.unpack()
    pub def values_i64_nullable(self, name: &str) -> Result[list[Option[i64]], DataFrameError]:
        count = self.height()?
        mut out = allocated([0 for _ in range(count)])?
        mut valid = allocated([0u8 for _ in range(count)])?
        checked(values_i64_nullable_raw(self.raw, name, &mut out, &mut valid))?
        allocated([optional(out[i], valid[i]) for i in range(count)])
    pub def values_f64_nullable(self, name: &str) -> Result[list[Option[f64]], DataFrameError]:
        count = self.height()?
        mut out = allocated([0.0 for _ in range(count)])?
        mut valid = allocated([0u8 for _ in range(count)])?
        checked(values_f64_nullable_raw(self.raw, name, &mut out, &mut valid))?
        allocated([optional(out[i], valid[i]) for i in range(count)])
    pub def values_bool_nullable(self, name: &str) -> Result[list[Option[bool]], DataFrameError]:
        count = self.height()?
        mut out = allocated([0u8 for _ in range(count)])?
        mut valid = allocated([0u8 for _ in range(count)])?
        checked(values_bool_nullable_raw(self.raw, name, &mut out, &mut valid))?
        allocated([optional(out[i] != 0u8, valid[i]) for i in range(count)])

pub class Expr:
    raw: RawExpr
    def __init__(self) -> ():
        self.raw = RawExpr.null()
    def __del__(self) -> ():
        expr_drop(self.raw)
    pub def cast(self, dtype: DType, strict: bool = True) -> Result[Expr, DataFrameError]:
        kind = scalar_dtype(dtype)?
        mut out = Expr()
        checked(cast_raw(self.raw, kind, 1u8 if strict else 0u8, &mut out.raw))?
        Ok(out)
    pub def str_lower(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_unary_raw(self.raw, 0i32, &mut out.raw))?
        Ok(out)
    pub def str_upper(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_unary_raw(self.raw, 1i32, &mut out.raw))?
        Ok(out)
    pub def str_len(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_unary_raw(self.raw, 2i32, &mut out.raw))?
        Ok(out)
    pub def str_contains(self, pattern: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_binary_raw(self.raw, pattern.raw, 0i32, &mut out.raw))?
        Ok(out)
    pub def str_starts_with(self, prefix: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_binary_raw(self.raw, prefix.raw, 1i32, &mut out.raw))?
        Ok(out)
    pub def str_ends_with(self, suffix: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(string_binary_raw(self.raw, suffix.raw, 2i32, &mut out.raw))?
        Ok(out)
    pub def n_unique(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(n_unique_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def over(self, partition_by: &list[Expr]) -> Result[Expr, DataFrameError]:
        keys = expression_list(partition_by)?
        mut out = Expr()
        checked(over_raw(self.raw, keys.raw, &mut out.raw))?
        Ok(out)
    pub def gt(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 0i32, &mut out.raw))?
        Ok(out)
    pub def mul(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 1i32, &mut out.raw))?
        Ok(out)
    pub def add(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 2i32, &mut out.raw))?
        Ok(out)
    pub def sub(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 3i32, &mut out.raw))?
        Ok(out)
    pub def div(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 4i32, &mut out.raw))?
        Ok(out)
    pub def eq(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 5i32, &mut out.raw))?
        Ok(out)
    pub def lt(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 6i32, &mut out.raw))?
        Ok(out)
    pub def ge(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 7i32, &mut out.raw))?
        Ok(out)
    pub def le(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 8i32, &mut out.raw))?
        Ok(out)
    pub def and_(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 9i32, &mut out.raw))?
        Ok(out)
    pub def or_(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 10i32, &mut out.raw))?
        Ok(out)
    pub def fill_null(self, other: &Expr) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(binary_raw(self.raw, other.raw, 11i32, &mut out.raw))?
        Ok(out)
    pub def sum(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 0i32, &mut out.raw))?
        Ok(out)
    pub def count(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 1i32, &mut out.raw))?
        Ok(out)
    pub def mean(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 2i32, &mut out.raw))?
        Ok(out)
    pub def min(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 3i32, &mut out.raw))?
        Ok(out)
    pub def max(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 4i32, &mut out.raw))?
        Ok(out)
    pub def is_null(self) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(unary_raw(self.raw, 5i32, &mut out.raw))?
        Ok(out)
    pub def alias(self, name: &str) -> Result[Expr, DataFrameError]:
        mut out = Expr()
        checked(alias_raw(self.raw, name, &mut out.raw))?
        Ok(out)

class Exprs:
    raw: RawExprs
    def __init__(self) -> ():
        self.raw = RawExprs.null()
    def __del__(self) -> ():
        exprs_drop(self.raw)

class SortKeys:
    raw: RawSortKeys
    def __init__(self) -> ():
        self.raw = RawSortKeys.null()
    def __del__(self) -> ():
        sort_keys_drop(self.raw)

pub class Query:
    raw: RawQuery
    def __init__(self) -> ():
        self.raw = RawQuery.null()
    def __del__(self) -> ():
        query_drop(self.raw)
    pub def schema(self) -> Result[list[Field], DataFrameError]:
        mut out = Strings()
        checked(query_schema_raw(self.raw, &mut out.raw))?
        fields(out)
    pub def filter(self, predicate: &Expr) -> Result[Query, DataFrameError]:
        mut out = Query()
        checked(filter_raw(self.raw, predicate.raw, &mut out.raw))?
        Ok(out)
    pub def with_columns(self, expressions: &list[Expr]) -> Result[Query, DataFrameError]:
        native_expressions = expression_list(expressions)?
        mut out = Query()
        checked(with_columns_raw(self.raw, native_expressions.raw, &mut out.raw))?
        Ok(out)
    pub def select(self, expressions: &list[Expr]) -> Result[Query, DataFrameError]:
        native_expressions = expression_list(expressions)?
        mut out = Query()
        checked(select_raw(self.raw, native_expressions.raw, &mut out.raw))?
        Ok(out)
    pub def group_by(self, keys: &list[Expr], aggregates: &list[Expr]) -> Result[Query, DataFrameError]:
        native_keys = expression_list(keys)?
        native_aggregates = expression_list(aggregates)?
        mut out = Query()
        checked(group_raw(self.raw, native_keys.raw, native_aggregates.raw, &mut out.raw))?
        Ok(out)
    pub def collect(self) -> Result[DataFrame, DataFrameError]:
        mut out = DataFrame()
        checked(collect_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def collect_streaming(self) -> Result[DataFrame, DataFrameError]:
        mut out = DataFrame()
        checked(collect_streaming_raw(self.raw, &mut out.raw))?
        Ok(out)
    pub def sink_parquet(self, path: &str) -> Result[(), DataFrameError]:
        checked(sink_parquet_raw(self.raw, path))
    pub def join(self, other: &Query, left_keys: &list[Expr], right_keys: &list[Expr], how: JoinKind = JoinKind.Inner, suffix: &str = "_right", nulls_equal: bool = False) -> Result[Query, DataFrameError]:
        native_left = expression_list(left_keys)?
        native_right = expression_list(right_keys)?
        kind = match how:
            case JoinKind.Inner:
                0i32
            case JoinKind.Left:
                1i32
        mut out = Query()
        checked(join_raw(self.raw, other.raw, native_left.raw, native_right.raw, kind, suffix, 1u8 if nulls_equal else 0u8, &mut out.raw))?
        Ok(out)
    pub def sort(self, keys: &list[SortKey]) -> Result[Query, DataFrameError]:
        mut native_keys = SortKeys()
        checked(sort_keys_new(&mut native_keys.raw))?
        for key in keys:
            checked(sort_keys_add(native_keys.raw, key.expr.raw, 1u8 if key.descending else 0u8, 1u8 if key.nulls_last else 0u8))?
        mut out = Query()
        checked(sort_raw(self.raw, native_keys.raw, &mut out.raw))?
        Ok(out)
    pub def slice(self, offset: i64, length: i64) -> Result[Query, DataFrameError]:
        mut out = Query()
        checked(slice_raw(self.raw, offset, length, &mut out.raw))?
        Ok(out)
    pub def limit(self, count: i64) -> Result[Query, DataFrameError]:
        self.slice(0, count)

def expression_list(expressions: &list[Expr]) -> Result[Exprs, DataFrameError]:
    mut out = Exprs()
    checked(exprs_new_raw(&mut out.raw))?
    for expr in expressions:
        checked(exprs_add_raw(out.raw, expr.raw))?
    Ok(out)

pub def frame(columns: &list[Column]) -> Result[DataFrame, DataFrameError]:
    mut out = DataFrame()
    checked(frame_new_raw(&mut out.raw))?
    for column in columns:
        checked(frame_add_raw(out.raw, column.raw))?
    Ok(out)

pub def column_i64(name: &str, values: &list[i64]) -> Result[Column, DataFrameError]:
    mut out = Column()
    checked(native_i64(name, values, &mut out.raw))?
    Ok(out)

pub def column_f64(name: &str, values: &list[f64]) -> Result[Column, DataFrameError]:
    mut out = Column()
    checked(native_f64(name, values, &mut out.raw))?
    Ok(out)

pub def col(name: &str) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(col_raw(name, &mut out.raw))?
    Ok(out)

pub def lit(value: f64) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(lit_f64_raw(value, &mut out.raw))?
    Ok(out)

pub def lit_i64(value: i64) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(lit_i64_raw(value, &mut out.raw))?
    Ok(out)

pub def lit_str(value: &str) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(lit_str_raw(value, &mut out.raw))?
    Ok(out)

pub def lit_bool(value: bool) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(lit_bool_raw(1u8 if value else 0u8, &mut out.raw))?
    Ok(out)

pub def when(predicate: &Expr, then_value: &Expr, otherwise: &Expr) -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(when_raw(predicate.raw, then_value.raw, otherwise.raw, &mut out.raw))?
    Ok(out)

pub def null_f64() -> Result[Expr, DataFrameError]:
    mut out = Expr()
    checked(null_f64_raw(&mut out.raw))?
    Ok(out)

pub def scan_parquet(path: &str) -> Result[Query, DataFrameError]:
    mut out = Query()
    checked(scan_raw(path, &mut out.raw))?
    Ok(out)

pub def scan_csv(path: &str, has_header: bool = True, separator: &str = ",", infer_rows: i64 = 100, null_value: Option[str] = Nothing, schema_overrides: Option[list[Field]] = Nothing) -> Result[Query, DataFrameError]:
    mut schema = CsvSchema()
    checked(csv_schema_new(&mut schema.raw))?
    match schema_overrides:
        case Some(fields):
            for field in &fields:
                checked(csv_schema_add(schema.raw, field.name, scalar_dtype(field.dtype)?))?
        case Nothing:
            pass
    mut out = Query()
    checked(scan_csv_raw(path, 1u8 if has_header else 0u8, separator, infer_rows, null_value.unwrap_or(""), 1u8 if null_value.is_some() else 0u8, schema.raw, &mut out.raw))?
    Ok(out)

pub def column_bool(name: &str, values: &list[bool]) -> Result[Column, DataFrameError]:
    packed = allocated([1u8 if *value else 0u8 for value in values])?
    mut out = Column()
    checked(native_bool(name, packed, &mut out.raw))?
    Ok(out)

pub def column_str(name: &str, values: &list[str]) -> Result[Column, DataFrameError]:
    packed = allocated("".join(values))?
    offsets = string_offsets(values)?
    mut out = Column()
    checked(native_str(name, packed, offsets, &mut out.raw))?
    Ok(out)

pub def column_i64_nullable(name: &str, values: &list[Option[i64]]) -> Result[Column, DataFrameError]:
    scalars = allocated([payload(value, 0) for value in values])?
    valid = allocated([validity(value) for value in values])?
    mut out = Column()
    checked(native_i64_nullable(name, scalars, valid, &mut out.raw))?
    Ok(out)

pub def column_f64_nullable(name: &str, values: &list[Option[f64]]) -> Result[Column, DataFrameError]:
    scalars = allocated([payload(value, 0.0) for value in values])?
    valid = allocated([validity(value) for value in values])?
    mut out = Column()
    checked(native_f64_nullable(name, scalars, valid, &mut out.raw))?
    Ok(out)

pub def column_bool_nullable(name: &str, values: &list[Option[bool]]) -> Result[Column, DataFrameError]:
    scalars = allocated([1u8 if payload(value, False) else 0u8 for value in values])?
    valid = allocated([validity(value) for value in values])?
    mut out = Column()
    checked(native_bool_nullable(name, scalars, valid, &mut out.raw))?
    Ok(out)

pub def column_str_nullable(name: &str, values: &list[Option[str]]) -> Result[Column, DataFrameError]:
    scalars = allocated([payload(value, "") for value in values])?
    valid = allocated([validity(value) for value in values])?
    packed = allocated("".join(scalars))?
    offsets = string_offsets(scalars)?
    mut out = Column()
    checked(native_str_nullable(name, packed, offsets, valid, &mut out.raw))?
    Ok(out)
