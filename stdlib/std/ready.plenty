# Bounded readiness waits on native handles, one at a time or through a
# selector. The runtime makes one ppoll per call with a nanosecond timeout; a
# cancellable wait also polls the token's wake descriptor, so `cancel()` ends
# it at once. Deadlines, interruption retries and event decoding are the
# checked policy below. See book/src/design/stdlib/ready.md.
import std.bytes
from std.bytes import ByteSource, Bytes, BytesError
from std.io import FileStream, StreamError, classify
from std.sync import CancellationToken
from std.time import Deadline, monotonic_now

# Bytes per event record that the runtime writes, and records per wait.
const event_size: i64 = 16
const most_events: i64 = 64
# Bound writes for pipes; readiness alone is not a guarantee that a blocking
# socket can accept this many bytes. std.net keeps its sockets nonblocking.
const pipe_page: i64 = 4096

pub enum Interest:
    Read
    Write
    ReadWrite

# What the descriptor reported. Hang-up and error are reported whatever the
# interest: a read then returns end of input or the pending error.
pub class Readiness:
    pub readable: bool
    pub writable: bool
    pub hangup: bool
    pub error: bool

pub enum WaitError:
    TimedOut
    Cancelled
    Stream(StreamError)

def mask(interest: &Interest) -> u8:
    match interest:
        case Interest.Read:
            1u8
        case Interest.Write:
            2u8
        case Interest.ReadWrite:
            3u8

def bit(bits: i64, value: i64) -> bool:
    (bits // value) % 2 == 1

# One native wait's outcome. An interrupted wait reports nothing ready; the
# caller's loop then rechecks its deadline and token.
def polled(result: Result[i64, IoError]) -> Result[i64, WaitError]:
    match result:
        case Ok(bits):
            Ok(bits)
        case Err(error):
            match classify(error):
                case StreamError.Interrupted:
                    Ok(0)
                case _ as other:
                    Err(WaitError.Stream(other))

def ready(bits: i64) -> Readiness:
    Readiness(bit(bits, 1), bit(bits, 2), bit(bits, 4), bit(bits, 8))

# Waits until `file` is ready for `interest` or the deadline passes. A handle
# that is already ready succeeds even when the deadline has passed.
pub def wait_until(file: &File, interest: Interest, deadline: &Deadline) -> Result[Readiness, WaitError]:
    wanted = mask(&interest)
    while True:
        now = monotonic_now()
        bits = polled(__io_wait(file, wanted, deadline.remaining(&now).as_nanoseconds()))?
        if bits != 0:
            return Ok(ready(bits))
        if deadline.expired(&monotonic_now()):
            return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

# As wait_until, and also stops with Cancelled once `cancel` is requested.
# A request made before the call wins even over a ready handle; one made
# during the wait wakes it at once.
pub def wait(file: &File, interest: Interest, deadline: &Deadline, cancel: &CancellationToken) -> Result[Readiness, WaitError]:
    wanted = mask(&interest)
    while True:
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        now = monotonic_now()
        bits = polled(__ready_wait(file, wanted, deadline.remaining(&now).as_nanoseconds(), cancel))?
        if bits != 0:
            return Ok(ready(bits))
        if cancel.is_cancelled():
            return Err(WaitError.Cancelled)
        if deadline.expired(&monotonic_now()):
            return Err(WaitError.TimedOut)
    Err(WaitError.TimedOut)

def moved(result: Result[i64, StreamError]) -> Result[i64, WaitError]:
    match result:
        case Ok(count):
            Ok(count)
        case Err(cause):
            Err(WaitError.Stream(cause))

# Waits for input, then makes one read into buffer[start:stop]. Zero is end of
# input. Readiness can become stale; this helper does not change descriptor
# mode or retry a transfer that would block. A regular file is always ready.
pub def read_before(stream: &mut FileStream, buffer: &mut Bytes, start: i64, stop: i64, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, WaitError]:
    wait(&stream.file, Interest.Read, deadline, cancel)?
    moved(stream.read(buffer, start, stop))

# Waits for space, then makes one write of at most 4096 bytes from
# source[start:stop] and reports the bytes it moved.
pub def write_before[S: ByteSource](stream: &mut FileStream, source: &S, start: i64, stop: i64, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, WaitError]:
    mut end = stop
    if start >= 0 and stop - start > pipe_page:
        end = start + pipe_page
    wait(&stream.file, Interest.Write, deadline, cancel)?
    moved(stream.write(source, start, end))

def lifted[T](result: Result[T, BytesError]) -> Result[T, WaitError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(WaitError.Stream(StreamError.Allocation(cause)))
                case _:
                    Err(WaitError.Stream(StreamError.OutOfRange))

def changed(result: Result[i64, IoError]) -> Result[(), WaitError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(error):
            Err(WaitError.Stream(classify(error)))

# One handle the last selector wait found ready, under the key it was
# registered with.
pub class Event:
    pub key: u64
    pub readiness: Readiness

# Waits on many handles in one call. Registrations are level-triggered: a
# handle stays reported while it is ready. Closing a registered handle
# removes it.
pub class Selector:
    _file: File
    _events: Bytes
    _count: i64

    # Registers `file` under `key`, or changes its key and interest.
    pub def watch(self: &mut Selector, file: &File, key: u64, interest: Interest) -> Result[(), WaitError]:
        changed(__ready_watch(self._file, file, key, mask(&interest)))

    # Removes `file`; a handle that is not registered is not an error.
    pub def unwatch(self: &mut Selector, file: &File) -> Result[(), WaitError]:
        changed(__ready_watch(self._file, file, 0u64, 0u8))

    # Waits until at least one registered handle is ready and returns how
    # many events `event` can read, at most the selector's capacity. A ready
    # handle is reported even when the deadline has passed; a cancellation
    # requested before the call wins.
    pub def wait(self: &mut Selector, deadline: &Deadline, cancel: &CancellationToken) -> Result[i64, WaitError]:
        self._count = 0
        while True:
            if cancel.is_cancelled():
                return Err(WaitError.Cancelled)
            now = monotonic_now()
            budget = deadline.remaining(&now).as_nanoseconds()
            count = polled(self._events.ready_select(&self._file, budget, cancel))?
            if count > 0:
                self._count = count
                return Ok(count)
            if cancel.is_cancelled():
                return Err(WaitError.Cancelled)
            if deadline.expired(&monotonic_now()):
                return Err(WaitError.TimedOut)
        Err(WaitError.TimedOut)

    # Event `index` of the last wait, for 0 <= index < its count.
    pub def event(self, index: i64) -> Result[Event, WaitError]:
        if index < 0 or index >= self._count:
            return Err(WaitError.Stream(StreamError.OutOfRange))
        at = index * event_size
        mut key = 0u64
        for offset in range(8):
            key = (key << 8u64) | u64(self._events[at + 7 - offset])
        Ok(Event(key, ready(i64(self._events[at + 8]))))

    pub def close(self: &mut Selector) -> Result[(), WaitError]:
        self._count = 0
        match self._file.close():
            case Ok(_):
                Ok(())
            case Err(error):
                Err(WaitError.Stream(classify(error)))

# A selector that reports up to `capacity` ready handles per wait; capacity
# is clamped to 1..64. It owns one descriptor and a buffer of 16 bytes per
# event.
pub def selector(capacity: i64) -> Result[Selector, WaitError]:
    mut size = capacity
    if size < 1:
        size = 1
    if size > most_events:
        size = most_events
    mut events = lifted(std.bytes.with_capacity(size * event_size))?
    lifted(events.resize(size * event_size, 0u8))?
    match __ready_selector():
        case Ok(file):
            Ok(Selector(file, events, 0))
        case Err(error):
            Err(WaitError.Stream(classify(error)))
