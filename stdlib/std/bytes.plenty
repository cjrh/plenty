# Contiguous native byte storage; invalid positions trap. Views hold owner loans.
# Binary methods model Python bytes operations:
# https://docs.python.org/3/library/stdtypes.html#bytes-and-bytearray-operations
# Reverse search uses already-shipped memchr 2.8.0 (MIT OR Unlicense):
# its constant-space linear algorithm avoids quadratic searches.

pub enum BytesError:
    InvalidUtf8
    Allocation(AllocError)

# Operations read bytes in place through a `&[u8]` view: `&buffer`, a
# `b"..."` literal, or `&buffer[a:b]` for part of one. One body serves every
# byte owner; the view's bounds clamp, so no range result is needed.

pub class Bytes:
    _owner: ByteStorage

    pub def len(self) -> i64:
        __bytes_len(self._owner)

    pub def is_empty(self) -> bool:
        __bytes_len(self._owner) == 0

    # Bounded scientific f64 spelling for reusable output scratch buffers.
    pub def write_float(self: &mut Bytes, value: f64) -> i64:
        if self.len() < 32:
            __trap("Bytes.write_float: the buffer is shorter than 32 bytes")
        __bytes_write_float(self._owner, value)

    # Python format-spec float spellings for std.fmt: style 1 fixed, 2 exponent,
    # 3 general, 4 general keeping `.0`, 5 f64 display, 6 f32 display; add 16
    # for `#`. Writes at `offset` and returns the spelling's length, or the
    # negated total length needed when the buffer is shorter.
    pub def write_float_spec(self: &mut Bytes, value: f64, style: i64, precision: i64, offset: i64) -> i64:
        if style & 15 < 1 or style & 15 > 6 or style & ~31 != 0:
            __trap("Bytes.write_float_spec: style is not a format-spec style")
        if precision < 0 or precision > 4096:
            __trap("Bytes.write_float_spec: precision is outside 0..=4096")
        if offset < 0 or offset > self.len():
            __trap("Bytes.write_float_spec: offset is outside 0..=len()")
        __bytes_write_float_spec(self._owner, value, style, precision, offset)

    pub def capacity(self) -> i64:
        __bytes_capacity(self._owner)

    pub def get(self, index: i64) -> u8:
        if index < 0 or index >= __bytes_len(self._owner):
            __trap("Bytes.get: index is outside 0..len()")
        __bytes_get(self._owner, index)

    pub def set(self: &mut Bytes, index: i64, value: u8) -> ():
        if index < 0 or index >= __bytes_len(self._owner):
            __trap("Bytes.set: index is outside 0..len()")
        __bytes_set(self._owner, index, value)
        ()

    pub def push(self: &mut Bytes, value: u8) -> Result[(), AllocError]:
        __bytes_push(self._owner, value)

    pub def pop(self: &mut Bytes) -> Option[u8]:
        count = __bytes_len(self._owner)
        if count == 0:
            return Nothing
        # A nonempty buffer has 1 <= count <= i64.MAX.
        last = unchecked:
            count - 1
        value = __bytes_get(self._owner, last)
        # Shrinking never allocates, so this cannot fail.
        drop(__bytes_resize(self._owner, last, 0u8))
        Some(value)

    pub def reserve(self: &mut Bytes, additional: i64) -> Result[(), AllocError]:
        if additional < 0:
            return Err(AllocError.CapacityOverflow)
        __bytes_reserve(self._owner, additional)

    pub def resize(self: &mut Bytes, count: i64, fill: u8) -> Result[(), AllocError]:
        if count < 0:
            return Err(AllocError.CapacityOverflow)
        __bytes_resize(self._owner, count, fill)

    pub def truncate(self: &mut Bytes, count: i64) -> ():
        if count < 0 or count > __bytes_len(self._owner):
            __trap("Bytes.truncate: count is outside 0..=len()")
        # Shrinking never allocates, so this cannot fail.
        drop(__bytes_resize(self._owner, count, 0u8))

    pub def clear(self: &mut Bytes) -> ():
        drop(__bytes_resize(self._owner, 0, 0u8))

    pub def fill(self: &mut Bytes, start: i64, stop: i64, value: u8) -> ():
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.fill: start..stop is outside 0..=len()")
        __bytes_fill(self._owner, start, stop, value)
        ()

    pub def extend(self: &mut Bytes, source: &[u8]) -> Result[(), AllocError]:
        __bytes_append(self._owner, source)

    # Writes `source` at `offset`; the buffer keeps its length.
    pub def overwrite(self: &mut Bytes, offset: i64, source: &[u8]) -> ():
        # Both lengths are in 0..=i64.MAX, so their signed difference fits.
        available = unchecked:
            __bytes_len(self._owner) - len(source)
        if offset < 0 or offset > available:
            __trap("Bytes.overwrite: offset..offset + len(source) is outside 0..=len()")
        __bytes_overwrite(self._owner, offset, source)
        ()

    # Copies self[start:stop] to `to` in the same buffer, as memmove does: the
    # ranges may overlap. `overwrite` cannot read the buffer it writes, since
    # that needs shared and exclusive loans at once.
    pub def copy_within(self: &mut Bytes, start: i64, stop: i64, to: i64) -> ():
        count = __bytes_len(self._owner)
        if not within(start, stop, count):
            __trap("Bytes.copy_within: start..stop is outside 0..=len()")
        # Validated bounds give 0 <= stop - start <= count <= i64.MAX.
        available = unchecked:
            count - (stop - start)
        if to < 0 or to > available:
            __trap("Bytes.copy_within: the destination is outside 0..=len()")
        __bytes_copy_within(self._owner, start, stop, to)
        ()

    pub def slice(self, start: i64, stop: i64) -> Result[Bytes, AllocError]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.slice: start..stop is outside 0..=len()")
        # Validated bounds make the width nonnegative and at most len().
        width = unchecked:
            stop - start
        mut owner = __bytes_new(width)?
        __bytes_append(owner, &self[start:stop])?
        Ok(Bytes(owner))

    pub def copy(self) -> Result[Bytes, AllocError]:
        from_bytes(&self[:])

    # Bulk scans. Each is one native call over the checked range, so prefer
    # them to a loop of `get` calls. An index result is absolute, not relative
    # to `start`.
    pub def find(self, value: u8, start: i64, stop: i64) -> Option[i64]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.find: start..stop is outside 0..=len()")
        after(start, __bytes_find(&self[start:stop], value))

    # The first byte that equals any byte of `set`. An empty set finds nothing.
    pub def find_in(self, set: &[u8], start: i64, stop: i64) -> Option[i64]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.find_in: start..stop is outside 0..=len()")
        after(start, __bytes_find_in(&self[start:stop], set, 1u8))

    # The first byte that equals no byte of `set`: the end of a run.
    pub def find_not_in(self, set: &[u8], start: i64, stop: i64) -> Option[i64]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.find_not_in: start..stop is outside 0..=len()")
        after(start, __bytes_find_in(&self[start:stop], set, 0u8))

    # The first position where all of `needle` occurs inside the range. An
    # empty needle is found at `start`.
    pub def find_bytes(self, needle: &[u8], start: i64, stop: i64) -> Option[i64]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.find_bytes: start..stop is outside 0..=len()")
        after(start, __bytes_find_bytes(&self[start:stop], needle))

    pub def count(self, value: u8, start: i64, stop: i64) -> i64:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.count: start..stop is outside 0..=len()")
        __bytes_count(&self[start:stop], value)

    # Whether `source` occurs at `offset`. Too few bytes after `offset` is
    # False, not an error.
    pub def matches(self, offset: i64, source: &[u8]) -> bool:
        if offset < 0 or offset > __bytes_len(self._owner):
            __trap("Bytes.matches: offset is outside 0..=len()")
        __bytes_matches(&self[:], offset, source)

    # Whether the UTF-8 bytes of `text` occur at `offset`.
    pub def matches_text(self, offset: i64, text: &str) -> bool:
        if offset < 0 or offset > __bytes_len(self._owner):
            __trap("Bytes.matches_text: offset is outside 0..=len()")
        __bytes_matches_text(&self[:], offset, text)

    # The index after the run of bytes below 128 that begins at `start`.
    pub def ascii_run(self, start: i64, stop: i64) -> i64:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.ascii_run: start..stop is outside 0..=len()")
        # The native run length is at most stop - start, so the sum <= stop.
        unchecked:
            start + __bytes_run(&self[start:stop], 0u8)

    # The index after the longest valid UTF-8 that begins at `start`. A
    # sequence cut off by `stop` is not included.
    pub def utf8_run(self, start: i64, stop: i64) -> i64:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.utf8_run: start..stop is outside 0..=len()")
        # The native run length is at most stop - start, so the sum <= stop.
        unchecked:
            start + __bytes_run(&self[start:stop], 1u8)

    pub def to_list(self) -> Result[list[u8], AllocError]:
        __bytes_to_list(self._owner)

    pub def to_text(self) -> Result[str, BytesError]:
        text_in(&self[:])

    # `self[start:stop]` as text: validated and copied once, with no
    # intermediate `Bytes`.
    pub def to_text_range(self, start: i64, stop: i64) -> Result[str, BytesError]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.to_text_range: start..stop is outside 0..=len()")
        text_in(&self[start:stop])

    # Each maximal subpart of an ill-formed sequence becomes U+FFFD, as in
    # Unicode chapter 3 ("U+FFFD Substitution of Maximal Subparts") and the
    # WHATWG Encoding Standard's UTF-8 decoder. The result holds at most three
    # bytes per input byte.
    pub def to_text_lossy(self) -> Result[str, AllocError]:
        lossy_in(&self[:], True)

    # A sequence that `stop` cuts short is a truncated, replaced subpart.
    pub def to_text_lossy_range(self, start: i64, stop: i64) -> Result[str, AllocError]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.to_text_lossy_range: start..stop is outside 0..=len()")
        lossy_in(&self[start:stop], False)

    # Direct transport. Each call makes at most one native read or write and
    # returns the bytes moved, so a short count is success. std.io adds the
    # retry, end-of-input and partial-progress policy. A range outside the
    # buffer traps before touching the buffer or the stream. Writes are
    # the module functions below, which read a view.
    pub def read_file(self: &mut Bytes, file: &mut File, start: i64, stop: i64) -> Result[i64, IoError]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.read_file: start..stop is outside 0..=len()")
        __io_file_read(self._owner, start, stop, file)

    pub def read_stdin(self: &mut Bytes, start: i64, stop: i64) -> Result[i64, IoError]:
        if not within(start, stop, __bytes_len(self._owner)):
            __trap("Bytes.read_stdin: start..stop is outside 0..=len()")
        __io_stdin_read(self._owner, start, stop)

# A scan's index into a view starting at `start`, or Nothing for -1.
def after(start: i64, index: i64) -> Option[i64]:
    if index < 0:
        return Nothing
    # Callers scan validated start..stop; a found index is <= stop - start.
    unchecked:
        Some(start + index)

# The one range rule: 0 <= start <= stop <= count. No clamping, no negatives.
def within(start: i64, stop: i64, count: i64) -> bool:
    start >= 0 and start <= stop and stop <= count

def text_in(source: &[u8]) -> Result[str, BytesError]:
    match allocated(__bytes_to_text(source))?:
        case Some(text):
            Ok(text)
        case Nothing:
            Err(BytesError.InvalidUtf8)

# `whole` only selects the method named by the unreachable trap.
def lossy_in(source: &[u8], whole: bool) -> Result[str, AllocError]:
    count = len(source)
    first_run = __bytes_run(source, 1u8)
    if first_run == count:
        return valid_text(source, whole)
    # Size the output first so the scratch buffer is allocated once, exactly.
    # Each step consumes at least one byte and adds at most three, so the
    # total is at most 3 * count, which fits for any in-memory view.
    unchecked:
        mut size = first_run
        mut at = first_run
        while at < count:
            at += invalid_prefix(source, at)
            run = __bytes_run(&source[at:count], 1u8)
            size += 3 + run
            at += run
        mut owner = __bytes_new(size)?
        __bytes_append(owner, &source[0:first_run])?
        at = first_run
        while at < count:
            at += invalid_prefix(source, at)
            __bytes_append(owner, b"\xef\xbf\xbd")?
            run = __bytes_run(&source[at:count], 1u8)
            __bytes_append(owner, &source[at:at + run])?
            at += run
        output = Bytes(owner)
        valid_text(&output[:], whole)

# `source` is known to be valid UTF-8, so only allocation can fail.
def valid_text(source: &[u8], whole: bool) -> Result[str, AllocError]:
    match __bytes_to_text(source)?:
        case Some(text):
            Ok(text)
        case Nothing:
            if whole:
                __trap("Bytes.to_text_lossy: replacement produced invalid UTF-8")
            __trap("Bytes.to_text_lossy_range: replacement produced invalid UTF-8")

# Length of the maximal subpart at `at`: the longest prefix of a well-formed
# sequence, or one byte when `source[at]` cannot start one. Only called where
# the UTF-8 run stopped, so the subpart is never a complete sequence.
def invalid_prefix(source: &[u8], at: i64) -> i64:
    count = len(source)
    lead = source[at]
    # The second byte's range narrows for E0, ED, F0 and F4 (Unicode table 3-7),
    # which excludes overlong forms, surrogates and scalars above U+10FFFF.
    mut low = 0x80u8
    mut high = 0xBFu8
    mut needed = 0
    if lead >= 0xC2u8 and lead <= 0xDFu8:
        needed = 1
    elif lead >= 0xE0u8 and lead <= 0xEFu8:
        needed = 2
        if lead == 0xE0u8:
            low = 0xA0u8
        elif lead == 0xEDu8:
            high = 0x9Fu8
    elif lead >= 0xF0u8 and lead <= 0xF4u8:
        needed = 3
        if lead == 0xF0u8:
            low = 0x90u8
        elif lead == 0xF4u8:
            high = 0x8Fu8
    # At most four steps from a valid index into the view.
    unchecked:
        mut length = 1
        while length <= needed and at + length < count:
            byte = source[at + length]
            if byte < low or byte > high:
                break
            low = 0x80u8
            high = 0xBFu8
            length += 1
        length

def allocated[T](result: Result[T, AllocError]) -> Result[T, BytesError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(BytesError.Allocation(error))

# Constructors fail only to allocate. A negative capacity is a size that
# cannot be allocated, as for `list.with_capacity`.
pub def empty() -> Result[Bytes, AllocError]:
    Ok(Bytes(__bytes_new(0)?))

pub def with_capacity(capacity: i64) -> Result[Bytes, AllocError]:
    if capacity < 0:
        return Err(AllocError.CapacityOverflow)
    Ok(Bytes(__bytes_new(capacity)?))

pub def from_list(values: &list[u8]) -> Result[Bytes, AllocError]:
    Ok(Bytes(__bytes_from_list(values)?))

pub def from_text(text: &strview) -> Result[Bytes, AllocError]:
    from_bytes(text.as_bytes())

# An owned, growable copy of any byte view: a literal, `Bytes`, `list[u8]`
# or a subview of one.
pub def from_bytes(source: &[u8]) -> Result[Bytes, AllocError]:
    mut owner = __bytes_new(len(source))?
    __bytes_append(owner, source)?
    Ok(Bytes(owner))

# Direct transport out of a view: at most one native write, returning the
# bytes moved. The view carries its own range, so there is no range error.
pub def write_file(file: &mut File, source: &[u8]) -> Result[i64, IoError]:
    __io_file_write(source, file)

# Binary string operations share one view-based implementation across static
# literals, buffers and selected ranges. No function decodes Unicode.
pub def find(source: &[u8], needle: &[u8]) -> Option[i64]:
    after(0, __bytes_find_bytes(source, needle))

pub def find_byte(source: &[u8], value: u8) -> Option[i64]:
    after(0, __bytes_find(source, value))

pub def rfind(source: &[u8], needle: &[u8]) -> Option[i64]:
    after(0, __bytes_rfind_bytes(source, needle))

pub def rfind_byte(source: &[u8], value: u8) -> Option[i64]:
    mut at = len(source)
    while at > 0:
        # at is positive, so subtraction and the following index are valid.
        unchecked:
            at -= 1
        if source[at] == value:
            return Some(at)
    Nothing

pub def count(source: &[u8], needle: &[u8]) -> i64:
    if len(needle) == 0:
        # An addressable allocation cannot occupy i64.MAX bytes plus its
        # storage metadata, so the number of boundaries fits in i64.
        unchecked:
            return len(source) + 1
    mut found = 0
    mut at = 0
    while at < len(source):
        match find(&source[at:], needle):
            case Some(offset):
                # Each nonempty match consumes bytes within the source.
                unchecked:
                    at += offset + len(needle)
                    found += 1
            case Nothing:
                break
    found

pub def count_byte(source: &[u8], value: u8) -> i64:
    __bytes_count(source, value)

pub def starts_with(source: &[u8], prefix: &[u8]) -> bool:
    __bytes_matches(source, 0, prefix)

pub def ends_with(source: &[u8], suffix: &[u8]) -> bool:
    if len(suffix) > len(source):
        return False
    unchecked:
        __bytes_matches(source, len(source) - len(suffix), suffix)

pub def is_ascii(source: &[u8]) -> bool:
    __bytes_run(source, 0u8) == len(source)

pub def is_space(source: &[u8]) -> bool:
    len(source) > 0 and __bytes_find_in(source, b" \t\n\r\x0b\x0c", 0u8) < 0

pub def is_digit(source: &[u8]) -> bool:
    if len(source) == 0:
        return False
    for byte in source:
        if byte < 48u8 or byte > 57u8:
            return False
    True

pub def is_alpha(source: &[u8]) -> bool:
    if len(source) == 0:
        return False
    for byte in source:
        if not ascii_alpha(*byte):
            return False
    True

pub def is_alnum(source: &[u8]) -> bool:
    if len(source) == 0:
        return False
    for byte in source:
        if not ascii_alpha(*byte) and (byte < 48u8 or byte > 57u8):
            return False
    True

def ascii_alpha(byte: u8) -> bool:
    (byte >= 65u8 and byte <= 90u8) or (byte >= 97u8 and byte <= 122u8)

pub def lower(source: &[u8]) -> Result[Bytes, AllocError]:
    mut result = from_bytes(source)?
    for at in range(len(source)):
        byte = source[at]
        if byte >= 65u8 and byte <= 90u8:
            # ASCII uppercase plus 32 is always an ASCII lowercase byte.
            unchecked:
                result.set(at, byte + 32u8)
    Ok(result)

pub def upper(source: &[u8]) -> Result[Bytes, AllocError]:
    mut result = from_bytes(source)?
    for at in range(len(source)):
        byte = source[at]
        if byte >= 97u8 and byte <= 122u8:
            unchecked:
                result.set(at, byte - 32u8)
    Ok(result)

pub def lstrip(source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
    start = strip_start(source, set)
    from_bytes(&source[start:])

pub def rstrip(source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
    stop = strip_stop(source, set)
    from_bytes(&source[:stop])

pub def strip(source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
    start = strip_start(source, set)
    stop = strip_stop(source, set)
    if start >= stop:
        return empty()
    from_bytes(&source[start:stop])

def strip_start(source: &[u8], set: &[u8]) -> i64:
    match after(0, __bytes_find_in(source, set, 0u8)):
        case Some(at):
            at
        case Nothing:
            len(source)

def strip_stop(source: &[u8], set: &[u8]) -> i64:
    mut at = len(source)
    while at > 0:
        mut last = at
        unchecked:
            last -= 1
        if __bytes_find(set, source[last]) < 0:
            break
        at = last
    at

# Explicit separators preserve empty fields. An empty separator is invalid,
# matching text split's programmer-error policy.
pub def split(source: &[u8], separator: &[u8]) -> Result[list[Bytes], AllocError]:
    if len(separator) == 0:
        __trap("bytes.split: separator is empty")
    mut result: list[Bytes] = []?
    mut at = 0
    while True:
        match find(&source[at:], separator):
            case Some(offset):
                mut stop = at
                unchecked:
                    stop += offset
                result.append(from_bytes(&source[at:stop])?)?
                unchecked:
                    at = stop + len(separator)
            case Nothing:
                result.append(from_bytes(&source[at:])?)?
                break
    Ok(result)

pub def split_whitespace(source: &[u8]) -> Result[list[Bytes], AllocError]:
    mut result: list[Bytes] = []?
    mut at = strip_start(source, b" \t\n\r\x0b\x0c")
    while at < len(source):
        width = __bytes_find_in(&source[at:], b" \t\n\r\x0b\x0c", 1u8)
        mut stop = len(source)
        if width >= 0:
            unchecked:
                stop = at + width
        result.append(from_bytes(&source[at:stop])?)?
        unchecked:
            at = stop + strip_start(&source[stop:], b" \t\n\r\x0b\x0c")
    Ok(result)

pub def replace(source: &[u8], old: &[u8], replacement: &[u8]) -> Result[Bytes, AllocError]:
    # Grow the result through checked byte-buffer operations. Even an empty
    # needle consumes a byte between insertions, so the loop always advances.
    mut result = empty()?
    if len(old) == 0:
        result.extend(replacement)?
        for at in range(len(source)):
            result.push(source[at])?
            result.extend(replacement)?
        return Ok(result)
    mut at = 0
    while at < len(source):
        match find(&source[at:], old):
            case Some(offset):
                mut stop = at
                unchecked:
                    stop += offset
                result.extend(&source[at:stop])?
                result.extend(replacement)?
                unchecked:
                    at = stop + len(old)
            case Nothing:
                result.extend(&source[at:])?
                break
    Ok(result)

pub def join[T](separator: &[u8], parts: &list[T]) -> Result[Bytes, AllocError]:
    mut size = 0
    mut first = True
    # Preflight every addition before allocating the result. The same checked
    # bound also covers multiplication by the number of separators.
    for part in parts:
        if not first:
            unchecked:
                if len(separator) > i64.MAX - size:
                    return Err(AllocError.CapacityOverflow)
                size += len(separator)
        first = False
        unchecked:
            if len(part) > i64.MAX - size:
                return Err(AllocError.CapacityOverflow)
            size += len(part)
    mut result = with_capacity(size)?
    first = True
    for part in parts:
        if not first:
            result.extend(separator)?
        first = False
        result.extend(part)?
    Ok(result)
