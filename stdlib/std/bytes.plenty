# One byte per element in contiguous native storage. Every offset is validated
# here and reported as a value; the native primitives only repeat the check.
# A view is an ordinary `&Bytes` or `&mut Bytes` loan plus explicit offsets, so
# the borrow checker already rejects growth or movement while one is live.
from std.sync import CancellationToken

pub enum BytesError:
    OutOfRange
    InvalidUtf8
    Allocation(AllocError)

pub class Bytes:
    _owner: ByteStorage

    pub def len(self) -> i64:
        __bytes_len(self._owner)

    pub def is_empty(self) -> bool:
        __bytes_len(self._owner) == 0

    # Bounded scientific f64 spelling for reusable output scratch buffers.
    pub def write_float(self: &mut Bytes, value: f64) -> Result[i64, BytesError]:
        if self.len() < 32:
            return Err(BytesError.OutOfRange)
        Ok(__bytes_write_float(self._owner, value))

    pub def capacity(self) -> i64:
        __bytes_capacity(self._owner)

    pub def get(self, index: i64) -> Result[u8, BytesError]:
        if index < 0 or index >= __bytes_len(self._owner):
            return Err(BytesError.OutOfRange)
        Ok(__bytes_get(self._owner, index))

    pub def set(self: &mut Bytes, index: i64, value: u8) -> Result[(), BytesError]:
        if index < 0 or index >= __bytes_len(self._owner):
            return Err(BytesError.OutOfRange)
        __bytes_set(self._owner, index, value)
        Ok(())

    pub def push(self: &mut Bytes, value: u8) -> Result[(), BytesError]:
        stored(__bytes_push(self._owner, value))

    pub def pop(self: &mut Bytes) -> Option[u8]:
        count = __bytes_len(self._owner)
        if count == 0:
            return Nothing
        value = __bytes_get(self._owner, count - 1)
        # Shrinking never allocates, so this cannot fail.
        drop(__bytes_resize(self._owner, count - 1, 0u8))
        Some(value)

    pub def reserve(self: &mut Bytes, additional: i64) -> Result[(), BytesError]:
        if additional < 0:
            return Err(BytesError.OutOfRange)
        stored(__bytes_reserve(self._owner, additional))

    pub def resize(self: &mut Bytes, count: i64, fill: u8) -> Result[(), BytesError]:
        if count < 0:
            return Err(BytesError.OutOfRange)
        stored(__bytes_resize(self._owner, count, fill))

    pub def truncate(self: &mut Bytes, count: i64) -> Result[(), BytesError]:
        if count < 0 or count > __bytes_len(self._owner):
            return Err(BytesError.OutOfRange)
        stored(__bytes_resize(self._owner, count, 0u8))

    pub def clear(self: &mut Bytes) -> ():
        drop(__bytes_resize(self._owner, 0, 0u8))

    pub def fill(self: &mut Bytes, start: i64, stop: i64, value: u8) -> Result[(), BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        __bytes_fill(self._owner, start, stop, value)
        Ok(())

    pub def extend(self: &mut Bytes, source: &Bytes) -> Result[(), BytesError]:
        stored(__bytes_append(self._owner, source._owner, 0, __bytes_len(source._owner)))

    pub def extend_range(self: &mut Bytes, source: &Bytes, start: i64, stop: i64) -> Result[(), BytesError]:
        checked(start, stop, __bytes_len(source._owner))?
        stored(__bytes_append(self._owner, source._owner, start, stop))

    pub def overwrite(self: &mut Bytes, offset: i64, source: &Bytes, start: i64, stop: i64) -> Result[(), BytesError]:
        checked(start, stop, __bytes_len(source._owner))?
        if offset < 0 or offset > __bytes_len(self._owner) - (stop - start):
            return Err(BytesError.OutOfRange)
        __bytes_overwrite(self._owner, offset, source._owner, start, stop)
        Ok(())

    pub def slice(self, start: i64, stop: i64) -> Result[Bytes, BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        mut owner = allocated(__bytes_new(stop - start))?
        stored(__bytes_append(owner, self._owner, start, stop))?
        Ok(Bytes(owner))

    pub def copy(self) -> Result[Bytes, BytesError]:
        self.slice(0, __bytes_len(self._owner))

    # Bulk scans. Each is one native call over the checked range, so prefer
    # them to a loop of `get` calls. An index result is absolute, not relative
    # to `start`.
    pub def find(self, value: u8, start: i64, stop: i64) -> Result[Option[i64], BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(located(__bytes_find(self._owner, value, start, stop)))

    # The first byte that equals any byte of `set`. An empty set finds nothing.
    pub def find_in(self, set: &Bytes, start: i64, stop: i64) -> Result[Option[i64], BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(located(__bytes_find_in(self._owner, set._owner, start, stop, 1u8)))

    # The first byte that equals no byte of `set`: the end of a run.
    pub def find_not_in(self, set: &Bytes, start: i64, stop: i64) -> Result[Option[i64], BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(located(__bytes_find_in(self._owner, set._owner, start, stop, 0u8)))

    # The first position where all of `needle` occurs inside the range. An
    # empty needle is found at `start`.
    pub def find_bytes(self, needle: &Bytes, start: i64, stop: i64) -> Result[Option[i64], BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(located(__bytes_find_bytes(self._owner, needle._owner, start, stop)))

    pub def count(self, value: u8, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(__bytes_count(self._owner, value, start, stop))

    # Whether source[start:stop] occurs at `offset`. Too few bytes after
    # `offset` is False, not an error.
    pub def matches(self, offset: i64, source: &Bytes, start: i64, stop: i64) -> Result[bool, BytesError]:
        checked(start, stop, __bytes_len(source._owner))?
        if offset < 0 or offset > __bytes_len(self._owner):
            return Err(BytesError.OutOfRange)
        Ok(__bytes_matches(self._owner, offset, source._owner, start, stop))

    # Whether the UTF-8 bytes of `text` occur at `offset`.
    pub def matches_text(self, offset: i64, text: &str) -> Result[bool, BytesError]:
        if offset < 0 or offset > __bytes_len(self._owner):
            return Err(BytesError.OutOfRange)
        Ok(__bytes_matches_text(self._owner, offset, text))

    # The index after the run of bytes below 128 that begins at `start`.
    pub def ascii_run(self, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(__bytes_run(self._owner, start, stop, 0u8))

    # The index after the longest valid UTF-8 that begins at `start`. A
    # sequence cut off by `stop` is not included.
    pub def utf8_run(self, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(__bytes_run(self._owner, start, stop, 1u8))

    pub def to_list(self) -> Result[list[u8], BytesError]:
        allocated(__bytes_to_list(self._owner))

    pub def to_text(self) -> Result[str, BytesError]:
        match allocated(__bytes_to_text(self._owner))?:
            case Some(text):
                Ok(text)
            case Nothing:
                Err(BytesError.InvalidUtf8)

    # Direct transport. Each call makes at most one native read or write and
    # returns the bytes moved, so a short count is success. std.io adds the
    # retry, end-of-input and partial-progress policy. A bad range is
    # InvalidInput and touches neither the buffer nor the stream.
    pub def read_file(self: &mut Bytes, file: &mut File, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_file_read(self._owner, start, stop, file)

    pub def write_file(self, file: &mut File, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_file_write(self._owner, start, stop, file)

    pub def read_stdin(self: &mut Bytes, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_stdin_read(self._owner, start, stop)

    pub def write_stdout(self, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_std_write(self._owner, start, stop, 1u8)

    pub def write_stderr(self, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_std_write(self._owner, start, stop, 2u8)

    # One OS entropy request into self[start:stop]; a short count is success.
    # std.secrets owns the retry policy and is the API to import.
    pub def read_os_entropy(self: &mut Bytes, start: i64, stop: i64) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __io_entropy_read(self._owner, start, stop)

    # std.crypto's native back end; import that module instead. A receiver
    # that did not come from `crypto_state` stops the process. Each returns
    # false (or -1) once the state has finished.
    pub def crypto_update(self: &mut Bytes, data: &Bytes, start: i64, stop: i64) -> Result[bool, BytesError]:
        checked(start, stop, __bytes_len(data._owner))?
        Ok(__crypto_update(self._owner, data._owner, start, stop))

    pub def crypto_update_text(self: &mut Bytes, text: &str) -> bool:
        __crypto_update_text(self._owner, text)

    # Writes `size` output bytes at target[offset:]; `size` must be the
    # algorithm's output size.
    pub def crypto_finish(self: &mut Bytes, target: &mut Bytes, offset: i64, size: i64) -> Result[bool, BytesError]:
        count = __bytes_len(target._owner)
        if offset < 0 or offset > count or size > count - offset:
            return Err(BytesError.OutOfRange)
        Ok(__crypto_finish(self._owner, target._owner, offset))

    # 1 when the output equals expected[start:stop], 0 when not.
    pub def crypto_verify(self: &mut Bytes, expected: &Bytes, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(expected._owner))?
        Ok(__crypto_verify(self._owner, expected._owner, start, stop))

    # Whole-buffer equality whose time depends only on the two lengths.
    pub def crypto_equal(self, other: &Bytes) -> bool:
        __crypto_equal(self._owner, other._owner)

    # std.compress's native back end; import that module instead. A receiver
    # that did not come from `compress_state` stops the process. Its bytes are
    # the codec's pending output, which a step never grows past the capacity
    # reserved at creation.
    pub def compress_step(self: &mut Bytes, input: &Bytes, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(input._owner))?
        Ok(__compress_step(self._owner, input._owner, start, stop))

    pub def compress_flush(self: &mut Bytes, mode: i64) -> i64:
        __compress_flush(self._owner, mode)

    pub def compress_ended(self) -> bool:
        __compress_ended(self._owner)

    pub def compress_restart(self: &mut Bytes) -> bool:
        __compress_restart(self._owner)

    # The CRC-32 of self[start:stop], continuing from `seed`.
    pub def compress_crc32(self, seed: i64, start: i64, stop: i64) -> Result[i64, BytesError]:
        checked(start, stop, __bytes_len(self._owner))?
        Ok(__compress_crc32(seed, self._owner, start, stop))

    # std.db.sqlite's blob binding; import that module instead. A handle
    # that is not a prepared statement stops the process.
    pub def sqlite_bind(self, statement: &ByteStorage, index: i64) -> i64:
        __sqlite_bind_blob(statement, index, self._owner)

    # std.net's datagram transfers; import that module instead. `address` is
    # std.net's encoded form.
    pub def net_send_to(self, socket: &mut File, start: i64, stop: i64, address: &list[u8]) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __net_send_to(self._owner, start, stop, socket, address)

    pub def net_receive_from(self: &mut Bytes, socket: &mut File, start: i64, stop: i64, sender: &mut Bytes) -> Result[i64, IoError]:
        transported(start, stop, __bytes_len(self._owner))?
        __net_receive_from(self._owner, start, stop, socket, sender._owner)

    # std.ready's selector wait; import that module instead. Events are
    # written as 16-byte records from offset 0.
    pub def ready_select(self: &mut Bytes, selector: &File, timeout: u64, cancel: &CancellationToken) -> Result[i64, IoError]:
        __ready_select(self._owner, selector, timeout, cancel)

def transported(start: i64, stop: i64, count: i64) -> Result[(), IoError]:
    if start < 0 or start > stop or stop > count:
        return Err(IoError.InvalidInput)
    Ok(())

def located(index: i64) -> Option[i64]:
    if index < 0:
        return Nothing
    Some(index)

# The one range rule: 0 <= start <= stop <= count. No clamping, no negatives.
def checked(start: i64, stop: i64, count: i64) -> Result[(), BytesError]:
    if start < 0 or start > stop or stop > count:
        return Err(BytesError.OutOfRange)
    Ok(())

def allocated[T](result: Result[T, AllocError]) -> Result[T, BytesError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(BytesError.Allocation(error))

def stored(result: Result[(), AllocError]) -> Result[(), BytesError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(error):
            Err(BytesError.Allocation(error))

pub def empty() -> Result[Bytes, BytesError]:
    Ok(Bytes(allocated(__bytes_new(0))?))

pub def with_capacity(capacity: i64) -> Result[Bytes, BytesError]:
    if capacity < 0:
        return Err(BytesError.OutOfRange)
    Ok(Bytes(allocated(__bytes_new(capacity))?))

pub def from_list(values: &list[u8]) -> Result[Bytes, BytesError]:
    Ok(Bytes(allocated(__bytes_from_list(values))?))

pub def from_text(text: &str) -> Result[Bytes, BytesError]:
    Ok(Bytes(allocated(__bytes_from_text(text))?))

# std.crypto's hasher states, behind a `Bytes` that byte operations see as
# empty. Import std.crypto instead.
pub def crypto_state(kind: u8) -> Result[Bytes, BytesError]:
    Ok(Bytes(allocated(__crypto_new(kind))?))

pub def crypto_keyed_state(kind: u8, key: &Bytes, start: i64, stop: i64) -> Result[Bytes, BytesError]:
    checked(start, stop, __bytes_len(key._owner))?
    Ok(Bytes(allocated(__crypto_new_keyed(kind, key._owner, start, stop))?))

# std.compress's codec states. Import std.compress instead.
pub def compress_state(kind: u8, level: i64, capacity: i64) -> Result[Bytes, BytesError]:
    if capacity < 0:
        return Err(BytesError.OutOfRange)
    Ok(Bytes(allocated(__compress_new(kind, level, capacity))?))

# std.db.sqlite's blob column read. Import std.db.sqlite instead.
pub def sqlite_column(statement: &ByteStorage, column: i64) -> Result[Bytes, BytesError]:
    Ok(Bytes(allocated(__sqlite_column_blob(statement, column))?))
