import std.bytes
import std.error
import std.io
from std.bytes import Bytes, BytesError
from std.io import Writer, StreamError

pub enum MarkdownFault:
    InvalidUtf8
    InputTooLarge
    OutputTooLarge
    DepthExceeded
    InvalidLimits
    InvalidState
    Stream(StreamError)
    Allocation(AllocError)

# `offset` is the input byte at fault for `InvalidUtf8`, `max_input` for
# `InputTooLarge`, and the start of the offending line for `DepthExceeded`,
# whose `line` counts from one. Renderer errors carry the bytes produced so
# far. Other errors carry zero for both.
pub class MarkdownError:
    pub fault: MarkdownFault
    pub offset: i64
    pub line: i64

# `max_depth` bounds block quotes and list items open at once.
pub class Limits:
    pub max_input: i64
    pub max_depth: i64
    pub max_output: i64

pub enum Tag:
    Paragraph
    Heading(i64)
    BlockQuote
    CodeBlock(str)
    BulletList
    OrderedList(i64)
    Item
    Emphasis
    Strong
    Link(str, str)
    Image(str, str)

# Paragraphs directly inside a tight list item produce no `Paragraph` events.
# Adjacent text arrives as one `Text`. `Html` is a raw block without its final
# line ending; `InlineHtml` is a raw tag inside a paragraph or heading.
pub enum Event:
    Start(Tag)
    End(Tag)
    Text(str)
    Code(str)
    Html(str)
    InlineHtml(str)
    SoftBreak
    HardBreak
    Rule
    Done

const default_size: i64 = 64 * 1024 * 1024
const flush_size: i64 = 65536

const k_document: i64 = 0
const k_quote: i64 = 1
const k_list: i64 = 2
const k_item: i64 = 3
const k_paragraph: i64 = 4
const k_heading: i64 = 5
const k_rule: i64 = 6
const k_code: i64 = 7
const k_html: i64 = 8

const i_root: i64 = 0
const i_text: i64 = 1
const i_soft: i64 = 2
const i_hard: i64 = 3
const i_code: i64 = 4
const i_html: i64 = 5
const i_emphasis: i64 = 6
const i_strong: i64 = 7
const i_link: i64 = 8
const i_image: i64 = 9

pub def limits() -> Limits:
    Limits(default_size, 64, default_size)

def valid(bounds: &Limits) -> bool:
    bounds.max_input >= 0 and bounds.max_depth >= 0 and bounds.max_output >= 0

def faulted[T](result: Result[T, BytesError]) -> Result[T, MarkdownFault]:
    std.error.map_error(result, def once (cause: BytesError) -> MarkdownFault: bytes_fault(cause))

def bytes_fault(error: BytesError) -> MarkdownFault:
    match error:
        case BytesError.Allocation(cause):
            MarkdownFault.Allocation(cause)
        case BytesError.InvalidUtf8:
            MarkdownFault.InvalidUtf8
        case BytesError.OutOfRange:
            MarkdownFault.InvalidState

def reserved[T](result: Result[T, AllocError]) -> Result[T, MarkdownFault]:
    std.error.map_error(result, def once (cause: AllocError) -> MarkdownFault: MarkdownFault.Allocation(cause))

def unplaced[T](result: Result[T, MarkdownFault]) -> Result[T, MarkdownError]:
    std.error.map_error(result, def once (fault: MarkdownFault) -> MarkdownError: MarkdownError(fault, 0, 0))

def push_byte(target: &mut Bytes, value: i64) -> Result[(), MarkdownFault]:
    faulted(target.push(u8(value)))

def push_scalar(target: &mut Bytes, code: i64) -> Result[(), MarkdownFault]:
    if code < 128:
        return push_byte(target, code)
    if code < 2048:
        push_byte(target, 192 | (code >> 6))?
        return push_byte(target, 128 | (code & 63))
    if code < 65536:
        push_byte(target, 224 | (code >> 12))?
        push_byte(target, 128 | ((code >> 6) & 63))?
        return push_byte(target, 128 | (code & 63))
    push_byte(target, 240 | (code >> 18))?
    push_byte(target, 128 | ((code >> 12) & 63))?
    push_byte(target, 128 | ((code >> 6) & 63))?
    push_byte(target, 128 | (code & 63))

def text_of(source: &Bytes, start: i64, stop: i64) -> Result[str, MarkdownFault]:
    faulted(source.to_text_range(start, stop))

# Byte `index` of `source`, or -1 at or past `stop`.
def peek(source: &Bytes, index: i64, stop: i64) -> i64:
    if index < stop:
        return i64(source[index])
    -1

def is_space_or_tab(c: i64) -> bool:
    c == 32 or c == 9

# Space, tab, and the ASCII line and page breaks.
def is_ascii_space(c: i64) -> bool:
    c == 32 or c == 9 or c == 10 or c == 11 or c == 12 or c == 13

def is_letter(c: i64) -> bool:
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

def is_digit(c: i64) -> bool:
    c >= 48 and c <= 57

def is_alnum(c: i64) -> bool:
    is_letter(c) or is_digit(c)

def is_ascii_punctuation(c: i64) -> bool:
    (c >= 33 and c <= 47) or (c >= 58 and c <= 64) or (c >= 91 and c <= 96) or (c >= 123 and c <= 126)

def lower(c: i64) -> i64:
    if c >= 65 and c <= 90:
        return c + 32
    c

def hex_value(c: i64) -> i64:
    if is_digit(c):
        return c - 48
    folded = lower(c)
    if folded >= 97 and folded <= 102:
        return folded - 87
    -1

# The scalar that starts at `index`; `source` is valid UTF-8.
def scalar_at(source: &Bytes, index: i64) -> i64:
    first = i64(source[index])
    if first < 128:
        return first
    if first < 224:
        return ((first & 31) << 6) | (i64(source[index + 1]) & 63)
    if first < 240:
        return ((first & 15) << 12) | ((i64(source[index + 1]) & 63) << 6) | (i64(source[index + 2]) & 63)
    ((first & 7) << 18) | ((i64(source[index + 1]) & 63) << 12) | ((i64(source[index + 2]) & 63) << 6) | (i64(source[index + 3]) & 63)

# The scalar that ends just before `index`.
def scalar_before(source: &Bytes, index: i64) -> i64:
    mut start = index - 1
    while start > 0 and (i64(source[start]) & 192) == 128:
        start -= 1
    scalar_at(source, start)

def is_unicode_whitespace(code: i64) -> bool:
    if code < 128:
        return is_ascii_space(code) and code != 11
    code == 160 or code == 5760 or (code >= 8192 and code <= 8202) or code == 8239 or code == 8287 or code == 12288

def is_unicode_punctuation(code: i64) -> bool:
    if code < 128:
        return is_ascii_punctuation(code)
    table = punctuation_ranges(punctuation_chunk(code))
    mut low = 0
    mut high = len(table) // 6
    while low < high:
        middle = (low + high) // 2
        base = middle * 6
        first = (i64(table[base]) << 16) | (i64(table[base + 1]) << 8) | i64(table[base + 2])
        last = (i64(table[base + 3]) << 16) | (i64(table[base + 4]) << 8) | i64(table[base + 5])
        if code < first:
            high = middle
        elif code > last:
            low = middle + 1
        else:
            return True
    False

# Appends the value of the named reference `source[start:stop]`, which excludes
# `&` and `;`, and reports whether the name exists.
def push_named(source: &Bytes, start: i64, stop: i64, target: &mut Bytes) -> Result[bool, MarkdownFault]:
    table = entity_bucket(i64(source[start]))
    rest = stop - start - 1
    mut index = 0
    while index < len(table):
        size = i64(table[index])
        value_at = index + 1 + size
        value_size = i64(table[value_at])
        if size == rest:
            mut same = True
            for position in range(size):
                if i64(table[index + 1 + position]) != i64(source[start + 1 + position]):
                    same = False
                    break
            if same:
                for position in range(value_size):
                    push_byte(target, i64(table[value_at + 1 + position]))?
                return Ok(True)
        index = value_at + 1 + value_size
    Ok(False)

# Decodes the entity or numeric character reference at `start`, which holds
# `&`, appending its value. Returns the index after `;`, or -1 when there is no
# valid reference, having appended nothing.
def push_entity(source: &Bytes, start: i64, stop: i64, target: &mut Bytes) -> Result[i64, MarkdownFault]:
    mut index = start + 1
    if peek(source, index, stop) == 35:
        index += 1
        mut value = 0
        mut digits = 0
        if lower(peek(source, index, stop)) == 120:
            index += 1
            while digits < 6 and hex_value(peek(source, index, stop)) >= 0:
                value = value * 16 + hex_value(peek(source, index, stop))
                digits += 1
                index += 1
        else:
            while digits < 7 and is_digit(peek(source, index, stop)):
                value = value * 10 + peek(source, index, stop) - 48
                digits += 1
                index += 1
        if digits == 0 or peek(source, index, stop) != 59:
            return Ok(-1)
        if value == 0 or value > 1114111 or (value >= 55296 and value <= 57343):
            value = 65533
        push_scalar(target, value)?
        return Ok(index + 1)
    if not is_letter(peek(source, index, stop)):
        return Ok(-1)
    while index - start <= 32 and is_alnum(peek(source, index, stop)):
        index += 1
    size = index - start - 1
    if size < 2 or size > 32 or peek(source, index, stop) != 59:
        return Ok(-1)
    if push_named(source, start + 1, index, target)?:
        return Ok(index + 1)
    Ok(-1)

# Appends `source[start:stop]` with backslash escapes and character references
# resolved, as for link destinations, titles, and info strings.
def push_unescaped(source: &Bytes, start: i64, stop: i64, target: &mut Bytes) -> Result[(), MarkdownFault]:
    mut index = start
    while index < stop:
        c = i64(source[index])
        if c == 92 and index + 1 < stop and is_ascii_punctuation(i64(source[index + 1])):
            push_byte(target, i64(source[index + 1]))?
            index += 2
        elif c == 38:
            after = push_entity(source, index, stop, target)?
            if after < 0:
                push_byte(target, c)?
                index += 1
            else:
                index = after
        else:
            push_byte(target, c)?
            index += 1
    Ok(())

def unescaped(source: &Bytes, start: i64, stop: i64, scratch: &mut Bytes) -> Result[str, MarkdownFault]:
    scratch.clear()
    push_unescaped(source, start, stop, scratch)?
    text_of(scratch, 0, scratch.len())

# The case-folded form under which a link label matches: inner whitespace runs
# become one space, outer whitespace goes, and the text is lowered then raised
# so that, for example, `ß` and `SS` match.
def normalized_label(source: &Bytes, start: i64, stop: i64, scratch: &mut Bytes) -> Result[str, MarkdownFault]:
    scratch.clear()
    mut pending = False
    for index in range(start, stop):
        c = i64(source[index])
        if c == 32 or c == 9 or c == 10 or c == 13:
            pending = scratch.len() > 0
        else:
            if pending:
                push_byte(scratch, 32)?
                pending = False
            push_byte(scratch, c)?
    raw = text_of(scratch, 0, scratch.len())?
    folded = reserved(raw.lower())?
    reserved(folded.upper())

def skip_spaces(source: &Bytes, index: i64, stop: i64) -> i64:
    mut at = index
    while is_space_or_tab(peek(source, at, stop)):
        at += 1
    at

def skip_whitespace(source: &Bytes, index: i64, stop: i64) -> i64:
    mut at = index
    while is_ascii_space(peek(source, at, stop)):
        at += 1
    at

# Spaces or tabs, including up to one line ending.
def skip_spnl(source: &Bytes, index: i64, stop: i64) -> i64:
    mut at = skip_spaces(source, index, stop)
    if peek(source, at, stop) == 10:
        at = skip_spaces(source, at + 1, stop)
    at

# The index after a link label that starts at `index`, or -1.
def scan_label(source: &Bytes, index: i64, stop: i64) -> i64:
    if peek(source, index, stop) != 91:
        return -1
    mut at = index + 1
    mut count = 0
    while at < stop:
        c = i64(source[at])
        if c == 93:
            return at + 1
        if c == 91 or count >= 999:
            return -1
        if c == 92 and at + 1 < stop:
            at += 1
        at += 1
        while at < stop and (i64(source[at]) & 192) == 128:
            at += 1
        count += 1
    -1

# A link destination at `index`: the index after it and the bounds of its
# content, or -1 first.
def scan_destination(source: &Bytes, index: i64, stop: i64) -> (i64, i64, i64):
    if peek(source, index, stop) == 60:
        mut at = index + 1
        while at < stop:
            c = i64(source[at])
            if c == 62:
                return (at + 1, index + 1, at)
            if c == 60 or c == 10:
                return (-1, 0, 0)
            if c == 92:
                if peek(source, at + 1, stop) == 10 or at + 1 >= stop:
                    return (-1, 0, 0)
                at += 2
            else:
                at += 1
        return (-1, 0, 0)
    mut at = index
    mut depth = 0
    while at < stop:
        c = i64(source[at])
        if c == 92 and is_ascii_punctuation(peek(source, at + 1, stop)):
            at += 2
        elif c == 40:
            # As in cmark: a bound on nesting keeps failed scans short.
            if depth >= 32:
                return (-1, 0, 0)
            depth += 1
            at += 1
        elif c == 41:
            if depth < 1:
                break
            depth -= 1
            at += 1
        elif c <= 32 or c == 127:
            break
        else:
            at += 1
    if at == index and peek(source, at, stop) != 41:
        return (-1, 0, 0)
    if depth != 0:
        return (-1, 0, 0)
    (at, index, at)

# The index after a link title that starts at `index`, or -1.
def scan_title(source: &Bytes, index: i64, stop: i64) -> i64:
    open = peek(source, index, stop)
    mut close = open
    if open == 40:
        close = 41
    elif open != 34 and open != 39:
        return -1
    mut at = index + 1
    while at < stop:
        c = i64(source[at])
        if c == close:
            return at + 1
        if c == 40 and open == 40:
            return -1
        if c == 92 and at + 1 < stop:
            at += 2
        else:
            at += 1
    -1

# Spaces or tabs to the end of a line: the index after its line ending, `stop`
# at the end of input, or -1.
def scan_line_end(source: &Bytes, index: i64, stop: i64) -> i64:
    at = skip_spaces(source, index, stop)
    if at >= stop:
        return stop
    if i64(source[at]) == 10:
        return at + 1
    -1

def scan_tag_name(source: &Bytes, index: i64, stop: i64) -> i64:
    if not is_letter(peek(source, index, stop)):
        return -1
    mut at = index + 1
    while is_alnum(peek(source, at, stop)) or peek(source, at, stop) == 45:
        at += 1
    at

def is_attribute_start(c: i64) -> bool:
    is_letter(c) or c == 95 or c == 58

def is_attribute_part(c: i64) -> bool:
    is_alnum(c) or c == 95 or c == 46 or c == 58 or c == 45

# An HTML open tag at `index`, which holds `<`: the index after `>`, or -1.
def scan_open_tag(source: &Bytes, index: i64, stop: i64) -> i64:
    mut at = scan_tag_name(source, index + 1, stop)
    if at < 0:
        return -1
    while True:
        gap = skip_whitespace(source, at, stop)
        if gap == at or not is_attribute_start(peek(source, gap, stop)):
            at = gap
            break
        mut name = gap + 1
        while is_attribute_part(peek(source, name, stop)):
            name += 1
        at = name
        equals = skip_whitespace(source, name, stop)
        if peek(source, equals, stop) == 61:
            value = skip_whitespace(source, equals + 1, stop)
            quote = peek(source, value, stop)
            if quote == 34 or quote == 39:
                mut end = value + 1
                while end < stop and i64(source[end]) != quote:
                    end += 1
                if end >= stop:
                    return -1
                at = end + 1
            else:
                mut end = value
                while end < stop:
                    c = i64(source[end])
                    if c <= 32 or c == 34 or c == 39 or c == 61 or c == 60 or c == 62 or c == 96:
                        break
                    end += 1
                if end == value:
                    return -1
                at = end
    if peek(source, at, stop) == 47:
        at += 1
    if peek(source, at, stop) == 62:
        return at + 1
    -1

# An HTML closing tag at `index`, which holds `<`: the index after `>`, or -1.
def scan_close_tag(source: &Bytes, index: i64, stop: i64) -> i64:
    if peek(source, index + 1, stop) != 47:
        return -1
    name = scan_tag_name(source, index + 2, stop)
    if name < 0:
        return -1
    at = skip_whitespace(source, name, stop)
    if peek(source, at, stop) == 62:
        return at + 1
    -1

# Whether `source[index:]` starts with `word`, ignoring ASCII case.
def starts_folded(source: &Bytes, index: i64, stop: i64, word: bytes) -> bool:
    if stop - index < len(word):
        return False
    for position in range(len(word)):
        if lower(i64(source[index + position])) != i64(word[position]):
            return False
    True

def starts_exact(source: &Bytes, index: i64, stop: i64, word: bytes) -> bool:
    if stop - index < len(word):
        return False
    for position in range(len(word)):
        if i64(source[index + position]) != i64(word[position]):
            return False
    True

# The first index at or after `index` where `word` starts, or -1.
def find_folded(source: &Bytes, index: i64, stop: i64, word: bytes) -> i64:
    mut at = index
    while at + len(word) <= stop:
        if starts_folded(source, at, stop, word):
            return at
        at += 1
    -1

def raw_text_tag(which: i64) -> bytes:
    match which:
        case 0:
            b"script"
        case 1:
            b"pre"
        case 2:
            b"textarea"
        case _:
            b"style"

def raw_text_close(which: i64) -> bytes:
    match which:
        case 0:
            b"</script>"
        case 1:
            b"</pre>"
        case 2:
            b"</textarea>"
        case _:
            b"</style>"

def block_tag_names() -> bytes:
    b" address article aside base basefont blockquote body caption center col colgroup dd details dialog dir div dl dt fieldset figcaption figure footer form frame frameset h1 h2 h3 h4 h5 h6 head header hr html iframe legend li link main menu menuitem nav noframes ol optgroup option p param search section summary table tbody td tfoot th thead title tr track ul "

def is_block_tag(source: &Bytes, start: i64, stop: i64) -> bool:
    names = block_tag_names()
    size = stop - start
    mut at = 1
    while at < len(names):
        mut end = at
        while i64(names[end]) != 32:
            end += 1
        if end - at == size:
            mut same = True
            for position in range(size):
                if lower(i64(source[start + position])) != i64(names[at + position]):
                    same = False
                    break
            if same:
                return True
        at = end + 1
    False

def html_block_ends(kind: i64, source: &Bytes, start: i64, stop: i64) -> bool:
    match kind:
        case 1:
            for which in range(4):
                if find_folded(source, start, stop, raw_text_close(which)) >= 0:
                    return True
            False
        case 2:
            find_folded(source, start, stop, b"-->") >= 0
        case 3:
            find_folded(source, start, stop, b"?>") >= 0
        case 4:
            find_folded(source, start, stop, b">") >= 0
        case 5:
            find_folded(source, start, stop, b"]]>") >= 0
        case _:
            False

class Block:
    kind: i64
    parent: i64
    first: i64
    last: i64
    prev: i64
    next: i64
    open: bool
    start_line: i64
    end_line: i64
    content: Bytes
    level: i64
    fenced: bool
    fence_char: i64
    fence_length: i64
    fence_offset: i64
    html_kind: i64
    info: str
    ordered: bool
    bullet: i64
    delimiter: i64
    start: i64
    marker_offset: i64
    padding: i64
    tight: bool
    depth: i64

class Refs:
    index: dict[str, i64]
    destinations: list[str]
    titles: list[str]

class Inline:
    kind: i64
    parent: i64
    first: i64
    last: i64
    prev: i64
    next: i64
    start: i64
    stop: i64
    destination: str
    title: str

class Delimiter:
    cc: i64
    count: i64
    original: i64
    node: i64
    previous: i64
    next: i64
    can_open: bool
    can_close: bool

class Bracket:
    node: i64
    previous: i64
    previous_delimiter: i64
    index: i64
    image: bool
    bracket_after: bool
    sequence: i64

# Parses a link reference definition at the start of `content[start:]` into
# `refs`, keeping an earlier definition of the same label. Returns the bytes
# consumed, or zero when there is none.
def parse_reference(content: &Bytes, start: i64, refs: &mut Refs, scratch: &mut Bytes) -> Result[i64, MarkdownFault]:
    stop = content.len()
    label_end = scan_label(content, start, stop)
    if label_end < 0 or peek(content, label_end, stop) != 58:
        return Ok(0)
    destination_at = skip_spnl(content, label_end + 1, stop)
    found = scan_destination(content, destination_at, stop)
    destination_end, destination_start, destination_stop = found
    if destination_end < 0:
        return Ok(0)
    title_at = skip_spnl(content, destination_end, stop)
    mut end = -1
    mut title_end = -1
    if title_at != destination_end:
        title_end = scan_title(content, title_at, stop)
        if title_end >= 0:
            end = scan_line_end(content, title_end, stop)
    if end < 0:
        title_end = -1
        end = scan_line_end(content, destination_end, stop)
        if end < 0:
            return Ok(0)
    label = normalized_label(content, start + 1, label_end - 1, scratch)?
    if label == "":
        return Ok(0)
    if refs.index.get(label).is_none():
        destination = unescaped(content, destination_start, destination_stop, scratch)?
        mut title = ""
        if title_end >= 0:
            title = unescaped(content, title_at + 1, title_end - 1, scratch)?
        reserved(refs.index.insert(label, len(refs.destinations)))?
        reserved(refs.destinations.append(destination))?
        reserved(refs.titles.append(title))?
    Ok(end - start)

def is_blank(content: &Bytes, start: i64) -> bool:
    for index in range(start, content.len()):
        if not is_ascii_space(i64(content[index])):
            return False
    True

def can_contain(parent: i64, child: i64) -> bool:
    if parent == k_document or parent == k_quote:
        return child != k_item
    if parent == k_item:
        return child != k_item
    if parent == k_list:
        return child == k_item
    False

def accepts_lines(kind: i64) -> bool:
    kind == k_paragraph or kind == k_code or kind == k_html

# Iterates over the events of one document. Block structure is parsed when
# the parser is created; inline content is parsed one paragraph or heading at
# a time as events are taken.
pub class Parser:
    _text: Bytes
    _blocks: list[Block]
    _refs: Refs
    _scratch: Bytes
    _max_depth: i64
    _line_end: i64
    _line_number: i64
    _offset: i64
    _column: i64
    _next_nonspace: i64
    _next_nonspace_column: i64
    _indent: i64
    _indented: bool
    _blank: bool
    _partial_tab: bool
    _all_closed: bool
    _tip: i64
    _old_tip: i64
    _last_matched: i64
    _subject: Bytes
    _pool: Bytes
    _inlines: list[Inline]
    _delimiters: list[Delimiter]
    _brackets: list[Bracket]
    _delimiter_top: i64
    _bracket_top: i64
    _bracket_count: i64
    _link_floor: i64
    _pos: i64
    _ticks_scanned: bool
    _tick_last: list[i64]
    _missing: list[i64]
    _queue: list[Event]
    _queued: i64
    _node: i64
    _entering: bool
    _finished: bool
    _broken: bool
    _target_destination: str
    _target_title: str

    # Block parsing.

    def block_kind(self, index: i64) -> i64:
        self._blocks[index].kind

    def at(self, index: i64) -> i64:
        peek(&self._text, index, self._line_end)

    def find_next_nonspace(self: &mut Parser) -> ():
        mut index = self._offset
        mut columns = self._column
        mut c = self.at(index)
        while c == 32 or c == 9:
            if c == 32:
                columns += 1
            else:
                columns += 4 - columns % 4
            index += 1
            c = self.at(index)
        self._blank = c == -1
        self._next_nonspace = index
        self._next_nonspace_column = columns
        self._indent = columns - self._column
        self._indented = self._indent >= 4

    def advance_next_nonspace(self: &mut Parser) -> ():
        self._offset = self._next_nonspace
        self._column = self._next_nonspace_column
        self._partial_tab = False

    # Moves over `count` bytes, or with `columns` over `count` columns, in
    # which case a tab may be consumed only partly.
    def advance_offset(self: &mut Parser, count: i64, columns: bool) -> ():
        mut remaining = count
        while remaining > 0 and self._offset < self._line_end:
            if i64(self._text[self._offset]) == 9:
                to_tab = 4 - self._column % 4
                if columns:
                    self._partial_tab = to_tab > remaining
                    step = to_tab if to_tab < remaining else remaining
                    self._column += step
                    if not self._partial_tab:
                        self._offset += 1
                    remaining -= step
                else:
                    self._partial_tab = False
                    self._column += to_tab
                    self._offset += 1
                    remaining -= 1
            else:
                self._partial_tab = False
                self._offset += 1
                self._column += 1
                remaining -= 1

    def add_line(self: &mut Parser) -> Result[(), MarkdownFault]:
        tip = self._tip
        if self._partial_tab:
            self._offset += 1
            for _ in range(4 - self._column % 4):
                push_byte(&mut self._blocks[tip].content, 32)?
        faulted(self._blocks[tip].content.extend_range(&self._text, self._offset, self._line_end))?
        push_byte(&mut self._blocks[tip].content, 10)

    def add_child(self: &mut Parser, kind: i64, offset: i64) -> Result[i64, MarkdownFault]:
        while not can_contain(self.block_kind(self._tip), kind):
            self.finalize(self._tip, self._line_number - 1)?
        parent = self._tip
        mut depth = self._blocks[parent].depth
        if kind == k_quote or kind == k_item:
            depth += 1
        if depth > self._max_depth:
            return Err(MarkdownFault.DepthExceeded)
        content = faulted(std.bytes.empty())?
        index = len(self._blocks)
        previous = self._blocks[parent].last
        block = Block(kind, parent, -1, -1, previous, -1, True, self._line_number, self._line_number, content, 0, False, 0, 0, 0, 0, "", False, 0, 0, 0, 0, 0, True, depth)
        reserved(self._blocks.append(block))?
        if previous >= 0:
            self._blocks[previous].next = index
        else:
            self._blocks[parent].first = index
        self._blocks[parent].last = index
        self._tip = index
        Ok(index)

    def unlink_block(self: &mut Parser, index: i64) -> ():
        parent = self._blocks[index].parent
        previous = self._blocks[index].prev
        following = self._blocks[index].next
        if previous >= 0:
            self._blocks[previous].next = following
        else:
            self._blocks[parent].first = following
        if following >= 0:
            self._blocks[following].prev = previous
        else:
            self._blocks[parent].last = previous

    # Consumes the link reference definitions that start a paragraph's
    # content and reports whether any content remains.
    def take_references(self: &mut Parser, index: i64) -> Result[bool, MarkdownFault]:
        mut start = 0
        while peek(&self._blocks[index].content, start, self._blocks[index].content.len()) == 91:
            used = parse_reference(&self._blocks[index].content, start, &mut self._refs, &mut self._scratch)?
            if used == 0:
                break
            start += used
        if start > 0:
            rest = faulted(self._blocks[index].content.slice(start, self._blocks[index].content.len()))?
            self._blocks[index].content = rest
        Ok(not is_blank(&self._blocks[index].content, 0))

    def finalize(self: &mut Parser, index: i64, line: i64) -> Result[(), MarkdownFault]:
        above = self._blocks[index].parent
        self._blocks[index].open = False
        self._blocks[index].end_line = line
        kind = self.block_kind(index)
        if kind == k_paragraph:
            if not self.take_references(index)?:
                self.unlink_block(index)
        elif kind == k_code:
            self.finalize_code(index)?
        elif kind == k_html:
            size = self._blocks[index].content.len()
            if size > 0 and i64(self._blocks[index].content[size - 1]) == 10:
                faulted(self._blocks[index].content.truncate(size - 1))?
        elif kind == k_list:
            self.finalize_list(index)
        elif kind == k_item:
            last = self._blocks[index].last
            if last >= 0:
                self._blocks[index].end_line = self._blocks[last].end_line
            else:
                self._blocks[index].end_line = self._blocks[index].start_line
        self._tip = above
        Ok(())

    def finalize_code(self: &mut Parser, index: i64) -> Result[(), MarkdownFault]:
        size = self._blocks[index].content.len()
        if self._blocks[index].fenced:
            mut newline = 0
            while i64(self._blocks[index].content[newline]) != 10:
                newline += 1
            first = skip_whitespace(&self._blocks[index].content, 0, newline)
            mut last = newline
            while last > first and is_ascii_space(i64(self._blocks[index].content[last - 1])):
                last -= 1
            info = unescaped(&self._blocks[index].content, first, last, &mut self._scratch)?
            self._blocks[index].info = info
            rest = faulted(self._blocks[index].content.slice(newline + 1, size))?
            self._blocks[index].content = rest
            return Ok(())
        # Trailing blank lines are not part of an indented block.
        mut end = size
        while end > 0:
            mut line_start = end - 1
            while line_start > 0 and i64(self._blocks[index].content[line_start - 1]) != 10:
                line_start -= 1
            if skip_spaces(&self._blocks[index].content, line_start, end - 1) != end - 1:
                break
            end = line_start
        lines = faulted(self._blocks[index].content.count(10u8, 0, end))?
        faulted(self._blocks[index].content.truncate(end))?
        self._blocks[index].end_line = self._blocks[index].start_line + lines - 1
        Ok(())

    # A list is loose when a blank line separates two of its items or two
    # blocks directly inside one item.
    def finalize_list(self: &mut Parser, index: i64) -> ():
        mut item = self._blocks[index].first
        mut tight = True
        while item >= 0 and tight:
            following = self._blocks[item].next
            if following >= 0 and self._blocks[item].end_line != self._blocks[following].start_line - 1:
                tight = False
            mut child = self._blocks[item].first
            while child >= 0 and tight:
                after = self._blocks[child].next
                if after >= 0 and self._blocks[child].end_line != self._blocks[after].start_line - 1:
                    tight = False
                child = after
            item = following
        self._blocks[index].tight = tight
        last = self._blocks[index].last
        if last >= 0:
            self._blocks[index].end_line = self._blocks[last].end_line

    def close_unmatched(self: &mut Parser) -> Result[(), MarkdownFault]:
        if not self._all_closed:
            while self._old_tip != self._last_matched:
                parent = self._blocks[self._old_tip].parent
                self.finalize(self._old_tip, self._line_number - 1)?
                self._old_tip = parent
            self._all_closed = True
        Ok(())

    # 0 when the line continues `container`, 1 when it does not, and 2 when
    # it closed a fenced code block and the line is finished.
    def continues(self: &mut Parser, container: i64) -> Result[i64, MarkdownFault]:
        kind = self.block_kind(container)
        if kind == k_quote:
            if not self._indented and self.at(self._next_nonspace) == 62:
                self.advance_next_nonspace()
                self.advance_offset(1, False)
                if is_space_or_tab(self.at(self._offset)):
                    self.advance_offset(1, True)
                return Ok(0)
            return Ok(1)
        if kind == k_item:
            if self._blank:
                if self._blocks[container].first < 0:
                    return Ok(1)
                self.advance_next_nonspace()
                return Ok(0)
            width = self._blocks[container].marker_offset + self._blocks[container].padding
            if self._indent >= width:
                self.advance_offset(width, True)
                return Ok(0)
            return Ok(1)
        if kind == k_heading or kind == k_rule:
            return Ok(1)
        if kind == k_code:
            if self._blocks[container].fenced:
                fence = self._blocks[container].fence_char
                if self._indent <= 3 and self.at(self._next_nonspace) == fence:
                    mut end = self._next_nonspace
                    while self.at(end) == fence:
                        end += 1
                    if end - self._next_nonspace >= self._blocks[container].fence_length and skip_spaces(&self._text, end, self._line_end) == self._line_end:
                        self.finalize(container, self._line_number)?
                        return Ok(2)
                mut skip = self._blocks[container].fence_offset
                while skip > 0 and is_space_or_tab(self.at(self._offset)):
                    self.advance_offset(1, True)
                    skip -= 1
                return Ok(0)
            if self._indent >= 4:
                self.advance_offset(4, True)
                return Ok(0)
            if self._blank:
                self.advance_next_nonspace()
                return Ok(0)
            return Ok(1)
        if kind == k_html:
            html_kind = self._blocks[container].html_kind
            if self._blank and (html_kind == 6 or html_kind == 7):
                return Ok(1)
            return Ok(0)
        if kind == k_paragraph:
            if self._blank:
                return Ok(1)
            return Ok(0)
        Ok(0)

    def html_start(self, container: i64) -> i64:
        start = self._next_nonspace
        stop = self._line_end
        if self.at(start) != 60:
            return 0
        for which in range(4):
            tag = raw_text_tag(which)
            if starts_folded(&self._text, start + 1, stop, tag):
                after = self.at(start + 1 + len(tag))
                if after == -1 or after == 62 or is_ascii_space(after):
                    return 1
        if starts_folded(&self._text, start, stop, b"<!--"):
            return 2
        if self.at(start + 1) == 63:
            return 3
        if self.at(start + 1) == 33 and is_letter(self.at(start + 2)):
            return 4
        if starts_exact(&self._text, start, stop, b"<![CDATA["):
            return 5
        mut name = start + 1
        if self.at(name) == 47:
            name += 1
        mut end = name
        while is_alnum(self.at(end)):
            end += 1
        if end > name and is_block_tag(&self._text, name, end):
            after = self.at(end)
            if after == -1 or after == 62 or is_ascii_space(after) or (after == 47 and self.at(end + 1) == 62):
                return 6
        if self.block_kind(container) == k_paragraph:
            return 0
        if not self._all_closed and not self._blank and self.block_kind(self._tip) == k_paragraph:
            return 0
        mut tag_end = scan_open_tag(&self._text, start, stop)
        if tag_end < 0:
            tag_end = scan_close_tag(&self._text, start, stop)
        if tag_end >= 0 and skip_whitespace(&self._text, tag_end, stop) == stop:
            return 7
        0

    # Recognizes a list marker at the current position, filling `marker`'s
    # list fields and consuming the marker and its padding.
    def list_marker(self: &mut Parser, container: i64, marker: &mut Block) -> bool:
        if self._indent >= 4:
            return False
        start = self._next_nonspace
        c = self.at(start)
        mut size = 0
        if c == 42 or c == 43 or c == 45:
            marker.ordered = False
            marker.bullet = c
            size = 1
        else:
            mut end = start
            mut value = 0
            while end - start < 9 and is_digit(self.at(end)):
                value = value * 10 + self.at(end) - 48
                end += 1
            delimiter = self.at(end)
            if end == start or (delimiter != 46 and delimiter != 41):
                return False
            if self.block_kind(container) == k_paragraph and value != 1:
                return False
            marker.ordered = True
            marker.start = value
            marker.delimiter = delimiter
            size = end - start + 1
        after = self.at(start + size)
        if not (after == -1 or after == 9 or after == 32):
            return False
        if self.block_kind(container) == k_paragraph and skip_spaces(&self._text, start + size, self._line_end) == self._line_end:
            return False
        marker.marker_offset = self._indent
        self.advance_next_nonspace()
        self.advance_offset(size, True)
        spaces_column = self._column
        spaces_offset = self._offset
        while True:
            self.advance_offset(1, True)
            if not (self._column - spaces_column < 5 and is_space_or_tab(self.at(self._offset))):
                break
        blank_item = self.at(self._offset) == -1
        spaces = self._column - spaces_column
        if spaces >= 5 or spaces < 1 or blank_item:
            marker.padding = size + 1
            self._column = spaces_column
            self._offset = spaces_offset
            if is_space_or_tab(self.at(self._offset)):
                self.advance_offset(1, True)
        else:
            marker.padding = size + spaces
        True

    # Tries each block start in turn: 0 when none applies, 1 for a new
    # container, and 2 for a new leaf that takes the rest of the line.
    def block_start(self: &mut Parser, container: i64) -> Result[i64, MarkdownFault]:
        start = self._next_nonspace
        stop = self._line_end
        c = self.at(start)
        if not self._indented and c == 62:
            self.advance_next_nonspace()
            self.advance_offset(1, False)
            if is_space_or_tab(self.at(self._offset)):
                self.advance_offset(1, True)
            self.close_unmatched()?
            self.add_child(k_quote, self._next_nonspace)?
            return Ok(1)
        if not self._indented and c == 35:
            mut end = start
            while self.at(end) == 35 and end - start < 7:
                end += 1
            level = end - start
            after = self.at(end)
            if level <= 6 and (after == -1 or is_space_or_tab(after)):
                self.advance_next_nonspace()
                self.advance_offset(level, False)
                self._offset = skip_spaces(&self._text, self._offset, stop)
                self.close_unmatched()?
                heading = self.add_child(k_heading, self._next_nonspace)?
                self._blocks[heading].level = level
                first = self._offset
                mut last = stop
                while last > first and is_space_or_tab(self.at(last - 1)):
                    last -= 1
                mut hashes = last
                while hashes > first and self.at(hashes - 1) == 35:
                    hashes -= 1
                if hashes < last:
                    if hashes == first:
                        last = first
                    elif is_space_or_tab(self.at(hashes - 1)):
                        last = hashes
                faulted(self._blocks[heading].content.extend_range(&self._text, first, last))?
                self._offset = stop
                return Ok(2)
        if not self._indented and (c == 96 or c == 126):
            mut end = start
            while self.at(end) == c:
                end += 1
            size = end - start
            mut fenced = size >= 3
            if fenced and c == 96:
                found = faulted(self._text.find(96u8, end, stop))?
                fenced = found.is_none()
            if fenced:
                self.close_unmatched()?
                code = self.add_child(k_code, self._next_nonspace)?
                self._blocks[code].fenced = True
                self._blocks[code].fence_length = size
                self._blocks[code].fence_char = c
                self._blocks[code].fence_offset = self._indent
                self.advance_next_nonspace()
                self.advance_offset(size, False)
                return Ok(2)
        if not self._indented and c == 60:
            html_kind = self.html_start(container)
            if html_kind > 0:
                self.close_unmatched()?
                html = self.add_child(k_html, self._offset)?
                self._blocks[html].html_kind = html_kind
                return Ok(2)
        if not self._indented and self.block_kind(container) == k_paragraph and (c == 61 or c == 45):
            mut end = start
            while self.at(end) == c:
                end += 1
            if skip_spaces(&self._text, end, stop) == stop:
                self.close_unmatched()?
                if self.take_references(container)?:
                    self._blocks[container].kind = k_heading
                    self._blocks[container].level = 1 if c == 61 else 2
                    self._offset = stop
                    return Ok(2)
        if not self._indented and (c == 42 or c == 95 or c == 45):
            mut count = 0
            mut at = start
            mut rule = True
            while at < stop:
                d = self.at(at)
                if d == c:
                    count += 1
                elif not is_space_or_tab(d):
                    rule = False
                    break
                at += 1
            if rule and count >= 3:
                self.close_unmatched()?
                self.add_child(k_rule, self._next_nonspace)?
                self._offset = stop
                return Ok(2)
        if not self._indented or self.block_kind(container) == k_list:
            mut marker = Block(k_item, 0, -1, -1, -1, -1, True, 0, 0, faulted(std.bytes.empty())?, 0, False, 0, 0, 0, 0, "", False, 0, 0, 0, 0, 0, True, 0)
            if self.list_marker(container, &mut marker):
                self.close_unmatched()?
                tip = self._tip
                same = self.block_kind(tip) == k_list and self._blocks[tip].ordered == marker.ordered and self._blocks[tip].bullet == marker.bullet and self._blocks[tip].delimiter == marker.delimiter
                if not same:
                    list = self.add_child(k_list, self._next_nonspace)?
                    self._blocks[list].ordered = marker.ordered
                    self._blocks[list].bullet = marker.bullet
                    self._blocks[list].delimiter = marker.delimiter
                    self._blocks[list].start = marker.start
                item = self.add_child(k_item, self._next_nonspace)?
                self._blocks[item].ordered = marker.ordered
                self._blocks[item].bullet = marker.bullet
                self._blocks[item].delimiter = marker.delimiter
                self._blocks[item].start = marker.start
                self._blocks[item].marker_offset = marker.marker_offset
                self._blocks[item].padding = marker.padding
                return Ok(1)
        if self._indented and self.block_kind(self._tip) != k_paragraph and not self._blank:
            self.advance_offset(4, True)
            self.close_unmatched()?
            self.add_child(k_code, self._offset)?
            return Ok(2)
        Ok(0)

    def incorporate_line(self: &mut Parser, start: i64, stop: i64) -> Result[(), MarkdownFault]:
        self._line_end = stop
        self._line_number += 1
        self._offset = start
        self._column = 0
        self._blank = False
        self._partial_tab = False
        self._old_tip = self._tip
        mut container = k_document
        while True:
            last = self._blocks[container].last
            if last < 0 or not self._blocks[last].open:
                break
            container = last
            self.find_next_nonspace()
            outcome = self.continues(container)?
            if outcome == 2:
                return Ok(())
            if outcome == 1:
                container = self._blocks[container].parent
                break
        self._all_closed = container == self._old_tip
        self._last_matched = container
        kind = self.block_kind(container)
        mut leaf = kind != k_paragraph and accepts_lines(kind)
        while not leaf:
            self.find_next_nonspace()
            c = self.at(self._next_nonspace)
            special = c == 35 or c == 96 or c == 126 or c == 42 or c == 43 or c == 95 or c == 61 or c == 60 or c == 62 or c == 45 or is_digit(c)
            if not self._indented and not special:
                self.advance_next_nonspace()
                break
            started = self.block_start(container)?
            if started == 0:
                self.advance_next_nonspace()
                break
            container = self._tip
            if started == 2:
                leaf = True
        if not self._all_closed and not self._blank and self.block_kind(self._tip) == k_paragraph:
            return self.add_line()
        self.close_unmatched()?
        kind_now = self.block_kind(container)
        if accepts_lines(kind_now):
            self.add_line()?
            html_kind = self._blocks[container].html_kind
            if kind_now == k_html and html_kind >= 1 and html_kind <= 5 and html_block_ends(html_kind, &self._text, self._offset, stop):
                self.finalize(container, self._line_number)?
        elif self._offset < stop and not self._blank:
            self.add_child(k_paragraph, self._offset)?
            self.advance_next_nonspace()
            self.add_line()?
        Ok(())

    def parse_blocks(self: &mut Parser) -> Result[(), MarkdownFault]:
        size = self._text.len()
        mut start = 0
        while start < size:
            found = faulted(self._text.find(10u8, start, size))?
            stop = found.unwrap_or(size)
            self.incorporate_line(start, stop)?
            start = stop + 1
        while self._tip >= 0:
            self.finalize(self._tip, self._line_number)?
        Ok(())

    # Inline parsing.

    def subject_at(self, index: i64) -> i64:
        peek(&self._subject, index, self._subject.len())

    def new_inline(self: &mut Parser, kind: i64, start: i64, stop: i64) -> Result[i64, MarkdownFault]:
        index = len(self._inlines)
        reserved(self._inlines.append(Inline(kind, -1, -1, -1, -1, -1, start, stop, "", "")))?
        Ok(index)

    def append_inline(self: &mut Parser, parent: i64, child: i64) -> ():
        previous = self._inlines[parent].last
        self._inlines[child].parent = parent
        self._inlines[child].prev = previous
        self._inlines[child].next = -1
        if previous >= 0:
            self._inlines[previous].next = child
        else:
            self._inlines[parent].first = child
        self._inlines[parent].last = child

    def unlink_inline(self: &mut Parser, index: i64) -> ():
        parent = self._inlines[index].parent
        previous = self._inlines[index].prev
        following = self._inlines[index].next
        if previous >= 0:
            self._inlines[previous].next = following
        elif parent >= 0:
            self._inlines[parent].first = following
        if following >= 0:
            self._inlines[following].prev = previous
        elif parent >= 0:
            self._inlines[parent].last = previous
        self._inlines[index].parent = -1
        self._inlines[index].prev = -1
        self._inlines[index].next = -1

    def insert_after(self: &mut Parser, anchor: i64, child: i64) -> ():
        parent = self._inlines[anchor].parent
        following = self._inlines[anchor].next
        self._inlines[child].parent = parent
        self._inlines[child].prev = anchor
        self._inlines[child].next = following
        self._inlines[anchor].next = child
        if following >= 0:
            self._inlines[following].prev = child
        else:
            self._inlines[parent].last = child

    # Moves every sibling after `first` up to, not including, `stop` into
    # `target`; -1 for `stop` moves the rest.
    def adopt(self: &mut Parser, target: i64, first: i64, stop: i64) -> ():
        mut node = self._inlines[first].next
        while node >= 0 and node != stop:
            following = self._inlines[node].next
            self.unlink_inline(node)
            self.append_inline(target, node)
            node = following

    # A text node holding `subject[start:stop]`.
    def add_text(self: &mut Parser, start: i64, stop: i64) -> Result[i64, MarkdownFault]:
        at = self._pool.len()
        faulted(self._pool.extend_range(&self._subject, start, stop))?
        node = self.new_inline(i_text, at, self._pool.len())?
        self.append_inline(i_root, node)
        Ok(node)

    def add_byte_text(self: &mut Parser, value: i64) -> Result[i64, MarkdownFault]:
        at = self._pool.len()
        push_byte(&mut self._pool, value)?
        node = self.new_inline(i_text, at, at + 1)?
        self.append_inline(i_root, node)
        Ok(node)

    def add_node(self: &mut Parser, kind: i64) -> Result[i64, MarkdownFault]:
        node = self.new_inline(kind, 0, 0)?
        self.append_inline(i_root, node)
        Ok(node)

    def parse_newline(self: &mut Parser) -> Result[(), MarkdownFault]:
        self._pos += 1
        last = self._inlines[i_root].last
        mut kind = i_soft
        if last >= 0 and self._inlines[last].kind == i_text:
            stop = self._inlines[last].stop
            start = self._inlines[last].start
            if stop > start and i64(self._pool[stop - 1]) == 32:
                if stop - start >= 2 and i64(self._pool[stop - 2]) == 32:
                    kind = i_hard
                mut trimmed = stop
                while trimmed > start and i64(self._pool[trimmed - 1]) == 32:
                    trimmed -= 1
                self._inlines[last].stop = trimmed
        self.add_node(kind)?
        while self.subject_at(self._pos) == 32:
            self._pos += 1
        Ok(())

    def parse_backslash(self: &mut Parser) -> Result[(), MarkdownFault]:
        self._pos += 1
        c = self.subject_at(self._pos)
        if c == 10:
            self._pos += 1
            self.add_node(i_hard)?
        elif is_ascii_punctuation(c):
            self.add_byte_text(c)?
            self._pos += 1
        else:
            self.add_byte_text(92)?
        Ok(())

    # Finds the next run of exactly `size` backticks at or after `from`. Runs
    # seen during a scan to the end are remembered, so failed searches stay
    # linear overall.
    def closing_ticks(self: &mut Parser, origin: i64, size: i64) -> i64:
        if self._ticks_scanned and size < len(self._tick_last) and self._tick_last[size] < origin:
            return -1
        stop = self._subject.len()
        mut at = origin
        while at < stop:
            if i64(self._subject[at]) == 96:
                mut end = at
                while end < stop and i64(self._subject[end]) == 96:
                    end += 1
                run = end - at
                if run < len(self._tick_last):
                    self._tick_last[run] = at
                if run == size:
                    return at
                at = end
            else:
                at += 1
        self._ticks_scanned = True
        -1

    def parse_backticks(self: &mut Parser) -> Result[(), MarkdownFault]:
        start = self._pos
        mut after = start
        while self.subject_at(after) == 96:
            after += 1
        size = after - start
        close = self.closing_ticks(after, size)
        if close < 0:
            self._pos = after
            self.add_text(start, after)?
            return Ok(())
        at = self._pool.len()
        mut nonspace = False
        for index in range(after, close):
            c = i64(self._subject[index])
            if c == 10:
                push_byte(&mut self._pool, 32)?
            else:
                if c != 32:
                    nonspace = True
                push_byte(&mut self._pool, c)?
        mut first = at
        mut last = self._pool.len()
        if nonspace and last - first >= 2 and i64(self._pool[first]) == 32 and i64(self._pool[last - 1]) == 32:
            first += 1
            last -= 1
        node = self.new_inline(i_code, first, last)?
        self.append_inline(i_root, node)
        self._pos = close + size
        Ok(())

    def scan_delimiters(self: &mut Parser, cc: i64) -> (i64, bool, bool):
        start = self._pos
        mut end = start
        while self.subject_at(end) == cc:
            end += 1
        before = 10 if start == 0 else scalar_before(&self._subject, start)
        after = 10 if end >= self._subject.len() else scalar_at(&self._subject, end)
        after_space = is_unicode_whitespace(after)
        after_punct = is_unicode_punctuation(after)
        before_space = is_unicode_whitespace(before)
        before_punct = is_unicode_punctuation(before)
        left = not after_space and (not after_punct or before_space or before_punct)
        right = not before_space and (not before_punct or after_space or after_punct)
        if cc == 95:
            return (end - start, left and (not right or before_punct), right and (not left or after_punct))
        (end - start, left, right)

    def handle_delimiter(self: &mut Parser, cc: i64) -> Result[(), MarkdownFault]:
        found = self.scan_delimiters(cc)
        count, can_open, can_close = found
        start = self._pos
        self._pos += count
        node = self.add_text(start, self._pos)?
        if can_open or can_close:
            index = len(self._delimiters)
            reserved(self._delimiters.append(Delimiter(cc, count, count, node, self._delimiter_top, -1, can_open, can_close)))?
            if self._delimiter_top >= 0:
                self._delimiters[self._delimiter_top].next = index
            self._delimiter_top = index
        Ok(())

    def remove_delimiter(self: &mut Parser, index: i64) -> ():
        previous = self._delimiters[index].previous
        following = self._delimiters[index].next
        if previous >= 0:
            self._delimiters[previous].next = following
        if following >= 0:
            self._delimiters[following].previous = previous
        else:
            self._delimiter_top = previous

    def process_emphasis(self: &mut Parser, bottom: i64) -> Result[(), MarkdownFault]:
        mut openers_bottom = reserved(list[i64]())?
        for _ in range(12):
            reserved(openers_bottom.append(bottom))?
        # The first delimiter above `bottom`, if any.
        mut closer = -1
        mut candidate = self._delimiter_top
        while candidate >= 0 and candidate != bottom:
            closer = candidate
            candidate = self._delimiters[candidate].previous
        while closer >= 0:
            if not self._delimiters[closer].can_close:
                closer = self._delimiters[closer].next
                continue
            cc = self._delimiters[closer].cc
            closer_open = self._delimiters[closer].can_open
            closer_original = self._delimiters[closer].original
            slot = (0 if cc == 95 else 6) + (3 if closer_open else 0) + closer_original % 3
            mut opener = self._delimiters[closer].previous
            mut found = False
            while opener >= 0 and opener != bottom and opener != openers_bottom[slot]:
                odd = (closer_open or self._delimiters[opener].can_close) and closer_original % 3 != 0 and (self._delimiters[opener].original + closer_original) % 3 == 0
                if self._delimiters[opener].cc == cc and self._delimiters[opener].can_open and not odd:
                    found = True
                    break
                opener = self._delimiters[opener].previous
            old_closer = closer
            if not found:
                closer = self._delimiters[closer].next
                openers_bottom[slot] = self._delimiters[old_closer].previous
                if not closer_open:
                    self.remove_delimiter(old_closer)
                continue
            used = 2 if self._delimiters[closer].count >= 2 and self._delimiters[opener].count >= 2 else 1
            opener_node = self._delimiters[opener].node
            closer_node = self._delimiters[closer].node
            self._delimiters[opener].count -= used
            self._delimiters[closer].count -= used
            self._inlines[opener_node].stop -= used
            self._inlines[closer_node].stop -= used
            emphasis = self.new_inline(i_emphasis if used == 1 else i_strong, 0, 0)?
            self.adopt(emphasis, opener_node, closer_node)
            self.insert_after(opener_node, emphasis)
            if self._delimiters[opener].next != closer:
                self._delimiters[opener].next = closer
                self._delimiters[closer].previous = opener
            if self._delimiters[opener].count == 0:
                self.unlink_inline(opener_node)
                self.remove_delimiter(opener)
            if self._delimiters[closer].count == 0:
                self.unlink_inline(closer_node)
                following = self._delimiters[closer].next
                self.remove_delimiter(closer)
                closer = following
        while self._delimiter_top >= 0 and self._delimiter_top != bottom:
            self.remove_delimiter(self._delimiter_top)
        Ok(())

    def add_bracket(self: &mut Parser, node: i64, index: i64, image: bool) -> Result[(), MarkdownFault]:
        if self._bracket_top >= 0:
            self._brackets[self._bracket_top].bracket_after = True
        self._bracket_count += 1
        reserved(self._brackets.append(Bracket(node, self._bracket_top, self._delimiter_top, index, image, False, self._bracket_count)))?
        self._bracket_top = len(self._brackets) - 1
        Ok(())

    def parse_open_bracket(self: &mut Parser) -> Result[(), MarkdownFault]:
        start = self._pos
        self._pos += 1
        node = self.add_text(start, self._pos)?
        self.add_bracket(node, start, False)

    def parse_bang(self: &mut Parser) -> Result[(), MarkdownFault]:
        start = self._pos
        self._pos += 1
        if self.subject_at(self._pos) == 91:
            self._pos += 1
            node = self.add_text(start, self._pos)?
            return self.add_bracket(node, start + 1, True)
        self.add_text(start, self._pos)?
        Ok(())

    # An inline link's `(destination "title")` at the current position.
    def inline_target(self: &mut Parser) -> Result[bool, MarkdownFault]:
        stop = self._subject.len()
        if self.subject_at(self._pos) != 40:
            return Ok(False)
        destination_at = skip_spnl(&self._subject, self._pos + 1, stop)
        found = scan_destination(&self._subject, destination_at, stop)
        destination_end, destination_start, destination_stop = found
        if destination_end < 0:
            return Ok(False)
        title_at = skip_spnl(&self._subject, destination_end, stop)
        mut end = title_at
        mut title_end = -1
        if title_at > destination_end:
            title_end = scan_title(&self._subject, title_at, stop)
            if title_end >= 0:
                end = skip_spnl(&self._subject, title_end, stop)
        if peek(&self._subject, end, stop) != 41:
            return Ok(False)
        self._target_destination = unescaped(&self._subject, destination_start, destination_stop, &mut self._scratch)?
        self._target_title = ""
        if title_end >= 0:
            self._target_title = unescaped(&self._subject, title_at + 1, title_end - 1, &mut self._scratch)?
        self._pos = end + 1
        Ok(True)

    def lookup(self: &mut Parser, start: i64, stop: i64) -> Result[bool, MarkdownFault]:
        label = normalized_label(&self._subject, start, stop, &mut self._scratch)?
        match self._refs.index.get(label):
            case Some(found):
                self._target_destination = self._refs.destinations[found]
                self._target_title = self._refs.titles[found]
                Ok(True)
            case Nothing:
                Ok(False)

    def parse_close_bracket(self: &mut Parser) -> Result[(), MarkdownFault]:
        self._pos += 1
        start = self._pos
        opener = self._bracket_top
        if opener < 0:
            self.add_text(start - 1, start)?
            return Ok(())
        image = self._brackets[opener].image
        if not image and self._brackets[opener].sequence <= self._link_floor:
            self.add_text(start - 1, start)?
            self._bracket_top = self._brackets[opener].previous
            return Ok(())
        mut matched = self.inline_target()?
        if not matched:
            stop = self._subject.len()
            label_end = scan_label(&self._subject, self._pos, stop)
            if label_end - self._pos > 2:
                matched = self.lookup(self._pos + 1, label_end - 1)?
                if matched:
                    self._pos = label_end
            elif not self._brackets[opener].bracket_after:
                first = self._brackets[opener].index
                if scan_label(&self._subject, first, stop) == start:
                    matched = self.lookup(first + 1, start - 1)?
                    if matched and label_end >= 0:
                        self._pos = label_end
        if not matched:
            self._bracket_top = self._brackets[opener].previous
            self._pos = start
            self.add_text(start - 1, start)?
            return Ok(())
        node = self.new_inline(i_image if image else i_link, 0, 0)?
        self._inlines[node].destination = self._target_destination
        self._inlines[node].title = self._target_title
        opener_node = self._brackets[opener].node
        self.adopt(node, opener_node, -1)
        self.append_inline(i_root, node)
        self.process_emphasis(self._brackets[opener].previous_delimiter)?
        self._bracket_top = self._brackets[opener].previous
        self.unlink_inline(opener_node)
        if not image:
            # No links in links: every earlier `[` is now inactive.
            self._link_floor = self._bracket_count
        Ok(())

    def add_link_text(self: &mut Parser, destination_prefix: bool, start: i64, stop: i64) -> Result[(), MarkdownFault]:
        self._scratch.clear()
        if destination_prefix:
            faulted(self._scratch.extend(&b"mailto:"))?
        faulted(self._scratch.extend_range(&self._subject, start, stop))?
        destination = text_of(&self._scratch, 0, self._scratch.len())?
        link = self.add_node(i_link)?
        self._inlines[link].destination = destination
        at = self._pool.len()
        faulted(self._pool.extend_range(&self._subject, start, stop))?
        text = self.new_inline(i_text, at, self._pool.len())?
        self.append_inline(link, text)
        Ok(())

    def parse_autolink(self: &mut Parser) -> Result[bool, MarkdownFault]:
        start = self._pos
        stop = self._subject.len()
        mut at = start + 1
        if is_letter(self.subject_at(at)):
            at += 1
            while at - start - 1 < 32 and (is_alnum(self.subject_at(at)) or self.subject_at(at) == 46 or self.subject_at(at) == 43 or self.subject_at(at) == 45):
                at += 1
            scheme = at - start - 1
            if scheme >= 2 and scheme <= 32 and self.subject_at(at) == 58:
                at += 1
                while at < stop:
                    c = i64(self._subject[at])
                    if c == 62:
                        self.add_link_text(False, start + 1, at)?
                        self._pos = at + 1
                        return Ok(True)
                    if c == 60 or c <= 32:
                        break
                    at += 1
        at = start + 1
        while at < stop:
            c = i64(self._subject[at])
            if is_alnum(c) or (c >= 35 and c <= 39) or c == 33 or c == 42 or c == 43 or c == 45 or c == 46 or c == 47 or c == 61 or c == 63 or (c >= 94 and c <= 96) or (c >= 123 and c <= 126):
                at += 1
            else:
                break
        if at == start + 1 or self.subject_at(at) != 64:
            return Ok(False)
        at += 1
        while True:
            label = at
            while is_alnum(self.subject_at(at)) or self.subject_at(at) == 45:
                at += 1
            size = at - label
            if size < 1 or size > 63 or not is_alnum(self.subject_at(label)) or not is_alnum(self.subject_at(at - 1)):
                return Ok(False)
            c = self.subject_at(at)
            if c == 62:
                self.add_link_text(True, start + 1, at)?
                self._pos = at + 1
                return Ok(True)
            if c != 46:
                return Ok(False)
            at += 1
        Ok(False)

    # The index after `word` at or after `from`, or -1. A failed search is
    # remembered under `which`, so repeated failures stay linear.
    def find_end(self: &mut Parser, which: i64, origin: i64, word: bytes) -> i64:
        if origin >= self._missing[which]:
            return -1
        found = find_folded(&self._subject, origin, self._subject.len(), word)
        if found < 0:
            self._missing[which] = origin
            return -1
        found + len(word)

    def parse_html_tag(self: &mut Parser) -> Result[bool, MarkdownFault]:
        start = self._pos
        stop = self._subject.len()
        c = self.subject_at(start + 1)
        mut end = -1
        if c == 33:
            if starts_folded(&self._subject, start, stop, b"<!-->"):
                end = start + 5
            elif starts_folded(&self._subject, start, stop, b"<!--->"):
                end = start + 6
            elif starts_folded(&self._subject, start, stop, b"<!--"):
                end = self.find_end(0, start + 4, b"-->")
            elif starts_folded(&self._subject, start, stop, b"<![cdata["):
                if starts_exact(&self._subject, start, stop, b"<![CDATA["):
                    end = self.find_end(1, start + 9, b"]]>")
            elif is_letter(self.subject_at(start + 2)):
                end = self.find_end(2, start + 3, b">")
        elif c == 63:
            end = self.find_end(3, start + 2, b"?>")
        elif c == 47:
            end = scan_close_tag(&self._subject, start, stop)
        else:
            end = scan_open_tag(&self._subject, start, stop)
        if end < 0:
            return Ok(False)
        at = self._pool.len()
        faulted(self._pool.extend_range(&self._subject, start, end))?
        node = self.new_inline(i_html, at, self._pool.len())?
        self.append_inline(i_root, node)
        self._pos = end
        Ok(True)

    def parse_entity(self: &mut Parser) -> Result[bool, MarkdownFault]:
        at = self._pool.len()
        end = push_entity(&self._subject, self._pos, self._subject.len(), &mut self._pool)?
        if end < 0:
            return Ok(False)
        node = self.new_inline(i_text, at, self._pool.len())?
        self.append_inline(i_root, node)
        self._pos = end
        Ok(True)

    def parse_string(self: &mut Parser) -> Result[(), MarkdownFault]:
        start = self._pos
        stop = self._subject.len()
        mut at = start + 1
        while at < stop:
            c = i64(self._subject[at])
            if c == 10 or c == 96 or c == 91 or c == 93 or c == 92 or c == 33 or c == 60 or c == 38 or c == 42 or c == 95:
                break
            at += 1
        self._pos = at
        self.add_text(start, at)?
        Ok(())

    def parse_inline(self: &mut Parser) -> Result[(), MarkdownFault]:
        c = i64(self._subject[self._pos])
        if c == 10:
            return self.parse_newline()
        if c == 92:
            return self.parse_backslash()
        if c == 96:
            return self.parse_backticks()
        if c == 42 or c == 95:
            return self.handle_delimiter(c)
        if c == 91:
            return self.parse_open_bracket()
        if c == 33:
            return self.parse_bang()
        if c == 93:
            return self.parse_close_bracket()
        if c == 60:
            if self.parse_autolink()? or self.parse_html_tag()?:
                return Ok(())
            self._pos += 1
            self.add_text(self._pos - 1, self._pos)?
            return Ok(())
        if c == 38:
            if self.parse_entity()?:
                return Ok(())
            self._pos += 1
            self.add_text(self._pos - 1, self._pos)?
            return Ok(())
        self.parse_string()

    # Parses the inline content of block `index` into `_inlines`.
    def parse_inlines(self: &mut Parser, index: i64) -> Result[(), MarkdownFault]:
        size = self._blocks[index].content.len()
        first = skip_whitespace(&self._blocks[index].content, 0, size)
        mut last = size
        while last > first and is_ascii_space(i64(self._blocks[index].content[last - 1])):
            last -= 1
        self._subject.clear()
        faulted(self._subject.extend_range(&self._blocks[index].content, first, last))?
        self._pool.clear()
        self._inlines.clear()
        self._delimiters.clear()
        self._brackets.clear()
        self._delimiter_top = -1
        self._bracket_top = -1
        self._bracket_count = 0
        self._link_floor = 0
        self._pos = 0
        self._ticks_scanned = False
        for which in range(len(self._missing)):
            self._missing[which] = i64.MAX
        self.new_inline(i_root, 0, 0)?
        while self._pos < self._subject.len():
            self.parse_inline()?
        self.process_emphasis(-1)

    # Events.

    def push_event(self: &mut Parser, event: Event) -> Result[(), MarkdownFault]:
        reserved(self._queue.append(event))

    def flush_text(self: &mut Parser) -> Result[(), MarkdownFault]:
        if self._scratch.len() > 0:
            text = text_of(&self._scratch, 0, self._scratch.len())?
            self._scratch.clear()
            self.push_event(Event.Text(text))?
        Ok(())

    def inline_tag(self, node: i64) -> Tag:
        kind = self._inlines[node].kind
        if kind == i_emphasis:
            return Tag.Emphasis
        if kind == i_strong:
            return Tag.Strong
        if kind == i_link:
            return Tag.Link(self._inlines[node].destination, self._inlines[node].title)
        Tag.Image(self._inlines[node].destination, self._inlines[node].title)

    def pool_text(self, node: i64) -> Result[str, MarkdownFault]:
        text_of(&self._pool, self._inlines[node].start, self._inlines[node].stop)

    # Queues the events of the parsed inline tree, merging adjacent text.
    def queue_inlines(self: &mut Parser) -> Result[(), MarkdownFault]:
        self._scratch.clear()
        mut node = self._inlines[i_root].first
        mut entering = True
        while node >= 0 and node != i_root:
            kind = self._inlines[node].kind
            if entering:
                if kind == i_text:
                    faulted(self._scratch.extend_range(&self._pool, self._inlines[node].start, self._inlines[node].stop))?
                else:
                    self.flush_text()?
                    if kind == i_soft:
                        self.push_event(Event.SoftBreak)?
                    elif kind == i_hard:
                        self.push_event(Event.HardBreak)?
                    elif kind == i_code:
                        self.push_event(Event.Code(self.pool_text(node)?))?
                    elif kind == i_html:
                        self.push_event(Event.InlineHtml(self.pool_text(node)?))?
                    else:
                        self.push_event(Event.Start(self.inline_tag(node)))?
                        if self._inlines[node].first >= 0:
                            node = self._inlines[node].first
                            continue
                        self.push_event(Event.End(self.inline_tag(node)))?
            else:
                self.flush_text()?
                self.push_event(Event.End(self.inline_tag(node)))?
            following = self._inlines[node].next
            if following >= 0:
                node = following
                entering = True
            else:
                node = self._inlines[node].parent
                entering = False
        self.flush_text()

    def in_tight_list(self, index: i64) -> bool:
        parent = self._blocks[index].parent
        if self.block_kind(parent) != k_item:
            return False
        self._blocks[self._blocks[parent].parent].tight

    def block_tag(self, index: i64) -> Tag:
        kind = self.block_kind(index)
        if kind == k_quote:
            return Tag.BlockQuote
        if kind == k_item:
            return Tag.Item
        if self._blocks[index].ordered:
            return Tag.OrderedList(self._blocks[index].start)
        Tag.BulletList

    def queue_leaf(self: &mut Parser, index: i64) -> Result[(), MarkdownFault]:
        kind = self.block_kind(index)
        if kind == k_rule:
            return self.push_event(Event.Rule)
        if kind == k_html:
            text = text_of(&self._blocks[index].content, 0, self._blocks[index].content.len())?
            return self.push_event(Event.Html(text))
        if kind == k_code:
            info = self._blocks[index].info
            self.push_event(Event.Start(Tag.CodeBlock(info)))?
            if self._blocks[index].content.len() > 0:
                text = text_of(&self._blocks[index].content, 0, self._blocks[index].content.len())?
                self.push_event(Event.Text(text))?
            return self.push_event(Event.End(Tag.CodeBlock(info)))
        self.parse_inlines(index)?
        if kind == k_heading:
            level = self._blocks[index].level
            self.push_event(Event.Start(Tag.Heading(level)))?
            self.queue_inlines()?
            return self.push_event(Event.End(Tag.Heading(level)))
        tight = self.in_tight_list(index)
        if not tight:
            self.push_event(Event.Start(Tag.Paragraph))?
        self.queue_inlines()?
        if not tight:
            self.push_event(Event.End(Tag.Paragraph))?
        Ok(())

    # Queues the events of the next step through the block tree.
    def advance(self: &mut Parser) -> Result[(), MarkdownFault]:
        while len(self._queue) == 0:
            if self._finished:
                return self.push_event(Event.Done)
            node = self._node
            kind = self.block_kind(node)
            container = kind == k_document or kind == k_quote or kind == k_list or kind == k_item
            if self._entering and container:
                if kind != k_document:
                    self.push_event(Event.Start(self.block_tag(node)))?
                first = self._blocks[node].first
                if first >= 0:
                    self._node = first
                    continue
                if kind == k_document:
                    self._finished = True
                    continue
                self.push_event(Event.End(self.block_tag(node)))?
            elif self._entering:
                self.queue_leaf(node)?
            elif kind != k_document:
                self.push_event(Event.End(self.block_tag(node)))?
            if node == k_document:
                self._finished = True
                continue
            following = self._blocks[node].next
            if following >= 0:
                self._node = following
                self._entering = True
            else:
                self._node = self._blocks[node].parent
                self._entering = False
        Ok(())

    # The next event. After `Done`, every call returns `Done` again. After an
    # error the parser is unusable and returns `InvalidState`.
    pub def next(self: &mut Parser) -> Result[Event, MarkdownError]:
        if self._broken:
            return Err(MarkdownError(MarkdownFault.InvalidState, 0, 0))
        if self._queued >= len(self._queue):
            self._queue.clear()
            self._queued = 0
            outcome = self.advance()
            match outcome:
                case Ok(_):
                    pass
                case Err(fault):
                    self._broken = True
                    return Err(MarkdownError(fault, 0, 0))
        index = self._queued
        self._queued += 1
        Ok(replace(self._queue[index], Event.Done))

# The start of line `line`, counted from one, in the original input.
def line_offset(source: &Bytes, line: i64) -> i64:
    mut current = 1
    mut index = 0
    size = source.len()
    while current < line and index < size:
        c = i64(source[index])
        if c == 10:
            current += 1
        elif c == 13:
            if index + 1 < size and i64(source[index + 1]) == 10:
                index += 1
            current += 1
        index += 1
    index

# Line endings become LF, NUL becomes U+FFFD, and a final line ending is added.
def normalized(source: &Bytes) -> Result[Bytes, MarkdownFault]:
    size = source.len()
    mut text = faulted(std.bytes.with_capacity(size + 1))?
    mut index = 0
    while index < size:
        c = i64(source[index])
        if c == 13:
            push_byte(&mut text, 10)?
            if index + 1 < size and i64(source[index + 1]) == 10:
                index += 1
        elif c == 0:
            push_scalar(&mut text, 65533)?
        else:
            push_byte(&mut text, c)?
        index += 1
    if size > 0 and i64(text[text.len() - 1]) != 10:
        push_byte(&mut text, 10)?
    Ok(text)

# Validates `source` as UTF-8 and parses its block structure.
pub def parser(source: &Bytes, bounds: &Limits) -> Result[Parser, MarkdownError]:
    if not valid(bounds):
        return Err(MarkdownError(MarkdownFault.InvalidLimits, 0, 0))
    size = source.len()
    if size > bounds.max_input:
        return Err(MarkdownError(MarkdownFault.InputTooLarge, bounds.max_input, 0))
    run = unplaced(faulted(source.utf8_run(0, size)))?
    if run < size:
        return Err(MarkdownError(MarkdownFault.InvalidUtf8, run, 0))
    text = unplaced(normalized(source))?
    mut blocks = unplaced(reserved(list[Block]()))?
    root = Block(k_document, -1, -1, -1, -1, -1, True, 1, 1, unplaced(faulted(std.bytes.empty()))?, 0, False, 0, 0, 0, 0, "", False, 0, 0, 0, 0, 0, True, 0)
    unplaced(reserved(blocks.append(root)))?
    index = unplaced(reserved(dict[str, i64]()))?
    destinations = unplaced(reserved(list[str]()))?
    titles = unplaced(reserved(list[str]()))?
    refs = Refs(index, destinations, titles)
    scratch = unplaced(faulted(std.bytes.empty()))?
    subject = unplaced(faulted(std.bytes.empty()))?
    pool = unplaced(faulted(std.bytes.empty()))?
    inlines = unplaced(reserved(list[Inline]()))?
    delimiters = unplaced(reserved(list[Delimiter]()))?
    brackets = unplaced(reserved(list[Bracket]()))?
    mut tick_last = unplaced(reserved(list[i64]()))?
    for _ in range(81):
        unplaced(reserved(tick_last.append(-1)))?
    mut missing = unplaced(reserved(list[i64]()))?
    for _ in range(4):
        unplaced(reserved(missing.append(i64.MAX)))?
    queue = unplaced(reserved(list[Event]()))?
    mut result = Parser(text, blocks, refs, scratch, bounds.max_depth, 0, 0, 0, 0, 0, 0, 0, False, False, False, True, 0, 0, 0, subject, pool, inlines, delimiters, brackets, -1, -1, 0, 0, 0, False, tick_last, missing, queue, 0, 0, True, False, False, "", "")
    outcome = result.parse_blocks()
    match outcome:
        case Ok(_):
            Ok(result)
        case Err(fault):
            match fault:
                case MarkdownFault.DepthExceeded:
                    line = result._line_number
                    Err(MarkdownError(fault, line_offset(source, line), line))
                case _:
                    Err(MarkdownError(fault, 0, 0))

pub def parser_text(text: &str, bounds: &Limits) -> Result[Parser, MarkdownError]:
    source = unplaced(faulted(std.bytes.from_text(text)))?
    parser(&source, bounds)

# Writes HTML for events into an owned buffer. `_written` counts every byte
# produced, so the output limit also covers bytes already taken or written out.
pub class HtmlRenderer:
    _out: Bytes
    _written: i64
    _max_output: i64
    _last: i64
    _image_depth: i64
    _broken: bool

    # Bytes produced and not yet taken.
    pub def pending(self) -> i64:
        self._out.len()

    # Bytes produced since the renderer was created.
    pub def written(self) -> i64:
        self._written

    def room(self: &mut HtmlRenderer, size: i64) -> Result[(), MarkdownFault]:
        if size > self._max_output - self._written:
            return Err(MarkdownFault.OutputTooLarge)
        self._written += size
        Ok(())

    def put(self: &mut HtmlRenderer, markup: bytes) -> Result[(), MarkdownFault]:
        if len(markup) == 0:
            return Ok(())
        self.room(len(markup))?
        faulted(self._out.extend(&markup))?
        self._last = i64(markup[len(markup) - 1])
        Ok(())

    def put_byte(self: &mut HtmlRenderer, value: i64) -> Result[(), MarkdownFault]:
        self.room(1)?
        push_byte(&mut self._out, value)?
        self._last = value
        Ok(())

    def cr(self: &mut HtmlRenderer) -> Result[(), MarkdownFault]:
        if self._last != 10:
            self.put_byte(10)?
        Ok(())

    def put_raw(self: &mut HtmlRenderer, text: &str) -> Result[(), MarkdownFault]:
        if text.byte_len() == 0:
            return Ok(())
        source = faulted(std.bytes.from_text(text))?
        self.room(source.len())?
        faulted(self._out.extend(&source))?
        self._last = i64(source[source.len() - 1])
        Ok(())

    # Escapes `&`, `<`, `>`, and `"`; with `href`, also percent-encodes bytes
    # that do not belong in a URL and escapes `'`.
    def put_escaped(self: &mut HtmlRenderer, text: &str, href: bool) -> Result[(), MarkdownFault]:
        source = faulted(std.bytes.from_text(text))?
        for index in range(source.len()):
            c = i64(source[index])
            if c == 38:
                self.put(b"&amp;")?
            elif c == 60 and not href:
                self.put(b"&lt;")?
            elif c == 62 and not href:
                self.put(b"&gt;")?
            elif c == 34 and not href:
                self.put(b"&quot;")?
            elif href and c == 39:
                self.put(b"&#x27;")?
            elif href and not href_safe(c):
                self.put_byte(37)?
                self.put_byte(hex_digit(c >> 4))?
                self.put_byte(hex_digit(c & 15))?
            else:
                self.put_byte(c)?
        Ok(())

    def put_number(self: &mut HtmlRenderer, value: i64) -> Result[(), MarkdownFault]:
        text = reserved(str.from(value))?
        self.put_raw(&text)

    def put_title(self: &mut HtmlRenderer, title: &str) -> Result[(), MarkdownFault]:
        if title.byte_len() > 0:
            self.put(b" title=\"")?
            self.put_escaped(title, False)?
            self.put(b"\"")?
        Ok(())

    def put_start(self: &mut HtmlRenderer, tag: &Tag) -> Result[(), MarkdownFault]:
        match tag:
            case Tag.Paragraph:
                self.cr()?
                self.put(b"<p>")
            case Tag.Heading(level):
                self.cr()?
                self.put(b"<h")?
                self.put_byte(48 + *level)?
                self.put(b">")
            case Tag.BlockQuote:
                self.cr()?
                self.put(b"<blockquote>")?
                self.cr()
            case Tag.CodeBlock(info):
                self.cr()?
                self.put(b"<pre><code")?
                source = faulted(std.bytes.from_text(info))?
                mut end = 0
                while end < source.len() and not is_ascii_space(i64(source[end])):
                    end += 1
                if end > 0:
                    word = text_of(&source, 0, end)?
                    self.put(b" class=\"language-")?
                    self.put_escaped(&word, False)?
                    self.put(b"\"")?
                self.put(b">")
            case Tag.BulletList:
                self.cr()?
                self.put(b"<ul>")?
                self.cr()
            case Tag.OrderedList(start):
                self.cr()?
                if *start == 1:
                    self.put(b"<ol>")?
                else:
                    self.put(b"<ol start=\"")?
                    self.put_number(*start)?
                    self.put(b"\">")?
                self.cr()
            case Tag.Item:
                self.put(b"<li>")
            case Tag.Emphasis:
                self.put(b"<em>")
            case Tag.Strong:
                self.put(b"<strong>")
            case Tag.Link(destination, title):
                self.put(b"<a href=\"")?
                self.put_escaped(destination, True)?
                self.put(b"\"")?
                self.put_title(title)?
                self.put(b">")
            case Tag.Image(destination, _):
                self.put(b"<img src=\"")?
                self.put_escaped(destination, True)?
                self.put(b"\" alt=\"")

    def put_end(self: &mut HtmlRenderer, tag: &Tag) -> Result[(), MarkdownFault]:
        match tag:
            case Tag.Paragraph:
                self.put(b"</p>")?
                self.cr()
            case Tag.Heading(level):
                self.put(b"</h")?
                self.put_byte(48 + *level)?
                self.put(b">")?
                self.cr()
            case Tag.BlockQuote:
                self.cr()?
                self.put(b"</blockquote>")?
                self.cr()
            case Tag.CodeBlock(_):
                self.put(b"</code></pre>")?
                self.cr()
            case Tag.BulletList:
                self.cr()?
                self.put(b"</ul>")?
                self.cr()
            case Tag.OrderedList(_):
                self.cr()?
                self.put(b"</ol>")?
                self.cr()
            case Tag.Item:
                self.put(b"</li>")?
                self.cr()
            case Tag.Emphasis:
                self.put(b"</em>")
            case Tag.Strong:
                self.put(b"</strong>")
            case Tag.Link(_, _):
                self.put(b"</a>")
            case Tag.Image(_, title):
                self.put(b"\"")?
                self.put_title(title)?
                self.put(b" />")

    def render(self: &mut HtmlRenderer, event: &Event) -> Result[(), MarkdownFault]:
        if self._image_depth > 0:
            # Inside an image only text survives, as its `alt` attribute.
            match event:
                case Event.Start(tag):
                    match tag:
                        case Tag.Image(_, _):
                            self._image_depth += 1
                        case _:
                            pass
                case Event.End(tag):
                    match tag:
                        case Tag.Image(_, _):
                            self._image_depth -= 1
                            if self._image_depth == 0:
                                self.put_end(tag)?
                        case _:
                            pass
                case Event.Text(text):
                    self.put_escaped(text, False)?
                case Event.Code(text):
                    self.put_escaped(text, False)?
                case Event.InlineHtml(text):
                    self.put_escaped(text, False)?
                case Event.SoftBreak:
                    self.put_byte(32)?
                case Event.HardBreak:
                    self.put_byte(32)?
                case _:
                    pass
            return Ok(())
        match event:
            case Event.Start(tag):
                self.put_start(tag)?
                match tag:
                    case Tag.Image(_, _):
                        self._image_depth = 1
                    case _:
                        pass
            case Event.End(tag):
                self.put_end(tag)?
            case Event.Text(text):
                self.put_escaped(text, False)?
            case Event.Code(text):
                self.put(b"<code>")?
                self.put_escaped(text, False)?
                self.put(b"</code>")?
            case Event.Html(text):
                self.cr()?
                self.put_raw(text)?
                self.cr()?
            case Event.InlineHtml(text):
                self.put_raw(text)?
            case Event.SoftBreak:
                self.put_byte(10)?
            case Event.HardBreak:
                self.put(b"<br />")?
                self.cr()?
            case Event.Rule:
                self.cr()?
                self.put(b"<hr />")?
                self.cr()?
            case Event.Done:
                pass
        Ok(())

    # Appends the HTML for one event. Events must come from one parser, in
    # order. After an error the renderer is unusable.
    pub def event(self: &mut HtmlRenderer, event: &Event) -> Result[(), MarkdownError]:
        if self._broken:
            return Err(MarkdownError(MarkdownFault.InvalidState, self._written, 0))
        outcome = self.render(event)
        match outcome:
            case Ok(_):
                Ok(())
            case Err(fault):
                self._broken = True
                Err(MarkdownError(fault, self._written, 0))

    # Removes and returns the bytes produced so far.
    pub def take(self: &mut HtmlRenderer) -> Result[Bytes, MarkdownError]:
        match faulted(std.bytes.empty()):
            case Ok(fresh):
                Ok(replace(self._out, fresh))
            case Err(fault):
                Err(MarkdownError(fault, self._written, 0))

def href_safe(c: i64) -> bool:
    if c >= 128 or c <= 32 or c == 127:
        return False
    if is_alnum(c):
        return True
    c == 33 or (c >= 35 and c <= 37) or (c >= 40 and c <= 47) or c == 58 or c == 59 or c == 61 or c == 63 or c == 64 or c == 94 or c == 95 or c == 126

def hex_digit(value: i64) -> i64:
    if value < 10:
        return 48 + value
    55 + value

pub def renderer(bounds: &Limits) -> Result[HtmlRenderer, MarkdownError]:
    if not valid(bounds):
        return Err(MarkdownError(MarkdownFault.InvalidLimits, 0, 0))
    out = unplaced(faulted(std.bytes.empty()))?
    Ok(HtmlRenderer(out, 0, bounds.max_output, 10, 0, False))

# Delivers every pending byte to `writer` and keeps the buffer's capacity.
# Does not flush. On failure only the bytes the writer did not accept stay
# pending, so a retry cannot repeat output.
pub def write_pending[W: Writer](source: &mut HtmlRenderer, writer: &mut W) -> Result[(), MarkdownError]:
    outcome = std.io.write_all(writer, &source._out, 0, source._out.len())
    match outcome:
        case Ok(_):
            source._out.clear()
            Ok(())
        case Err(partial):
            kept = source._out.len() - partial.completed
            # Shifted in place: a failure path must not need memory.
            for index in range(kept):
                match source._out.get(partial.completed + index):
                    case Ok(byte):
                        drop(source._out.set(index, byte))
                    case Err(_):
                        pass
            drop(source._out.truncate(kept))
            Err(MarkdownError(MarkdownFault.Stream(partial.cause), source._written, 0))

def is_done(event: &Event) -> bool:
    match event:
        case Event.Done:
            True
        case _:
            False

# Renders every remaining event of `source` as HTML to `writer`, writing in
# chunks as output accumulates. Does not flush.
pub def write_html[W: Writer](source: &mut Parser, writer: &mut W, bounds: &Limits) -> Result[(), MarkdownError]:
    mut target = renderer(bounds)?
    while True:
        event = source.next()?
        if is_done(&event):
            break
        target.event(&event)?
        if target.pending() >= flush_size:
            write_pending(&mut target, writer)?
    write_pending(&mut target, writer)

# Renders a whole document as HTML.
pub def render(source: &Bytes, bounds: &Limits) -> Result[Bytes, MarkdownError]:
    mut events = parser(source, bounds)?
    mut target = renderer(bounds)?
    while True:
        event = events.next()?
        if is_done(&event):
            break
        target.event(&event)?
    target.take()

pub def to_html(text: &str, bounds: &Limits) -> Result[str, MarkdownError]:
    source = unplaced(faulted(std.bytes.from_text(text)))?
    html = render(&source, bounds)?
    match faulted(html.to_text()):
        case Ok(result):
            Ok(result)
        case Err(fault):
            Err(MarkdownError(fault, html.len(), 0))

