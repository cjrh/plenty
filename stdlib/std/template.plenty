# A deliberately bounded Jinja-style language, not an evaluator for Plenty.
# Strict HTML grammar terminology follows WHATWG HTML syntax (independent code):
# https://html.spec.whatwg.org/multipage/syntax.html
import std.bytes
import std.math
from std.bytes import Bytes, BytesError
from std.json import Json

pub enum TemplateError:
    LimitExceeded
    Syntax(i64)
    UnknownTemplate(str)
    DuplicateTemplate(str)
    MissingValue(str)
    TypeMismatch
    InheritanceCycle
    InvalidHtml(str, i64)
    Allocation(AllocError)
    Bytes(BytesError)

pub enum HtmlContext:
    Text
    DoubleQuotedAttribute
    SingleQuotedAttribute
    TextAndAttributes

pub class Limits:
    pub max_source: NonNegative[i64]
    pub max_tokens: NonNegative[i64]
    pub max_expression_nodes: NonNegative[i64]
    pub max_templates: NonNegative[i64]
    pub max_context_nodes: Positive[i64]
    pub max_context_bytes: NonNegative[i64]
    pub max_depth: Positive[i64] __max(64)
    pub max_steps: NonNegative[i64]
    pub max_output: NonNegative[i64]

pub def limits() -> Limits:
    Limits(1048576, 16384, 16384, 128, 65536, 16777216, 64, 1000000, 16777216)

def allocated[T](value: Result[T, AllocError]) -> Result[T, TemplateError]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(error):
            Err(TemplateError.Allocation(error))

def bytes_result[T](value: Result[T, BytesError]) -> Result[T, TemplateError]:
    match value:
        case Ok(result):
            Ok(result)
        case Err(error):
            Err(TemplateError.Bytes(error))

def identifier(text: &str) -> bool:
    if len(text) == 0:
        return False
    for index, scalar in enumerate(text):
        if scalar not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789":
            return False
        if index == 0 and scalar in "0123456789":
            return False
    True

# Context selections apply only when emitting this expression. They never
# turn raw text into an unqualified trusted value.
enum Emission:
    Default
    Trusted
    Escape(HtmlContext)

class Value:
    kind: i64
    text: str
    integer: i64
    real: f64
    node: i64
    emission: Emission

def empty_value() -> Value:
    Value(0, "", 0, 0.0, -1, Emission.Default)

# Postorder, immutable after registration: every child precedes its parent.
# Kinds: value, not, ==, !=, and, or. Filters apply before the parent consumes
# this node's result, including on parenthesized expressions.
class ExprNode:
    kind: i64
    literal: Value
    path: list[str]
    filters: list[str]
    left: i64
    right: i64
    depth: i64

class Expression:
    nodes: list[ExprNode]
    root: i64

def empty_expression() -> Result[Expression, TemplateError]:
    Ok(Expression(allocated(list[ExprNode]())?, -1))

def quoted(text: &str, at: i64) -> Result[str, TemplateError]:
    if len(text) < 2 or text[-1] != text[0]:
        return Err(TemplateError.Syntax(at))
    mut pieces: list[str] = allocated(list[str]())?
    mut escaped = False
    # The length check proves at least two scalars.
    last = unchecked:
        len(text) - 1
    for index, scalar in enumerate(text):
        if index == 0 or index == last:
            continue
        if escaped:
            if scalar == "n":
                allocated(pieces.append("\n"))?
            elif scalar == "r":
                allocated(pieces.append("\r"))?
            elif scalar == "t":
                allocated(pieces.append("\t"))?
            elif scalar == "\\" or scalar == "'" or scalar == "\"":
                allocated(pieces.append(*scalar))?
            else:
                return Err(TemplateError.Syntax(at))
            escaped = False
        elif scalar == "\\":
            escaped = True
        elif scalar == text[0]:
            return Err(TemplateError.Syntax(at))
        else:
            allocated(pieces.append(*scalar))?
    if escaped:
        return Err(TemplateError.Syntax(at))
    allocated("".join(&pieces))

def valid_filter(name: &str) -> bool:
    name == "upper" or name == "lower" or name == "trim" or name == "length" or name == "escape" or name == "safe" or name == "escape_text" or name == "escape_double_quoted" or name == "escape_single_quoted"

def expression_words(source: &str, at: i64) -> Result[list[str], TemplateError]:
    data = allocated(std.bytes.from_text(source))?
    mut words = allocated(list[str]())?
    mut index = 0
    while index < data.len():
        byte = data[index]
        next = unchecked:
            index + 1
        if byte == 32u8 or byte == 9u8 or byte == 10u8 or byte == 13u8 or byte == 11u8 or byte == 12u8:
            index = next
            continue
        start = index
        if byte == 39u8 or byte == 34u8:
            index = next
            mut escaped = False
            mut closed = False
            while index < data.len():
                current = data[index]
                unchecked:
                    index += 1
                if escaped:
                    escaped = False
                elif current == 92u8:
                    escaped = True
                elif current == byte:
                    closed = True
                    break
            if not closed:
                return Err(TemplateError.Syntax(at))
        elif byte == 61u8 or byte == 33u8:
            if next >= data.len() or data[next] != 61u8:
                return Err(TemplateError.Syntax(at))
            unchecked:
                index = next + 1
        elif byte == 40u8 or byte == 41u8 or byte == 124u8:
            index = next
        else:
            index = next
            while index < data.len():
                current = data[index]
                if current == 32u8 or current == 9u8 or current == 10u8 or current == 13u8 or current == 11u8 or current == 12u8 or current == 39u8 or current == 34u8 or current == 61u8 or current == 33u8 or current == 40u8 or current == 41u8 or current == 124u8:
                    break
                unchecked:
                    index += 1
        word = bytes_result(data.to_text_range(start, index))?
        # Preserve Unicode whitespace around the old path/filter forms too.
        text = allocated(word.strip())?
        if text != "":
            allocated(words.append(text))?
    Ok(words)

class ExprParser:
    words: list[str]
    position: i64
    nodes: list[ExprNode]
    at: i64
    node_limit: i64

    def peek(self) -> str:
        self.words[self.position] if self.position < len(self.words) else ""

    def take(self: &mut ExprParser) -> str:
        word = self.words[self.position]
        # All callers established that peek is nonempty.
        unchecked:
            self.position += 1
        word

    def push(self: &mut ExprParser, node: ExprNode, bounds: &Limits) -> Result[i64, TemplateError]:
        if len(self.nodes) >= self.node_limit or node.depth > bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        index = len(self.nodes)
        allocated(self.nodes.append(node))?
        Ok(index)

    def operator(self: &mut ExprParser, kind: i64, left: i64, right: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        mut depth = self.nodes[left].depth
        if right >= 0 and self.nodes[right].depth > depth:
            depth = self.nodes[right].depth
        if depth >= bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        unchecked:
            depth += 1
        self.push(ExprNode(kind, empty_value(), allocated(list[str]())?, allocated(list[str]())?, left, right, depth), bounds)

    def disjunction(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        mut left = self.conjunction(depth, bounds)?
        while self.peek() == "or":
            drop(self.take())
            right = self.conjunction(depth, bounds)?
            left = self.operator(5, left, right, bounds)?
        Ok(left)

    def conjunction(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        mut left = self.negation(depth, bounds)?
        while self.peek() == "and":
            drop(self.take())
            right = self.negation(depth, bounds)?
            left = self.operator(4, left, right, bounds)?
        Ok(left)

    def negation(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        if self.peek() == "not":
            if depth >= bounds.max_depth.get():
                return Err(TemplateError.LimitExceeded)
            drop(self.take())
            next_depth = unchecked:
                depth + 1
            child = self.negation(next_depth, bounds)?
            return self.operator(1, child, -1, bounds)
        self.equality(depth, bounds)

    def equality(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        left = self.filtered(depth, bounds)?
        operation = self.peek()
        if operation != "==" and operation != "!=":
            return Ok(left)
        drop(self.take())
        right = self.filtered(depth, bounds)?
        self.operator(2 if operation == "==" else 3, left, right, bounds)

    def filtered(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        node = self.atom(depth, bounds)?
        while self.peek() == "|":
            drop(self.take())
            filter = self.peek()
            if not valid_filter(&filter):
                return Err(TemplateError.Syntax(self.at))
            drop(self.take())
            allocated(self.nodes[node].filters.append(filter))?
        Ok(node)

    def atom(self: &mut ExprParser, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
        if depth > bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        base = self.peek()
        if base == "" or base == ")" or base == "|" or base == "==" or base == "!=" or base == "and" or base == "or" or base == "not":
            return Err(TemplateError.Syntax(self.at))
        drop(self.take())
        if base == "(":
            if depth >= bounds.max_depth.get():
                return Err(TemplateError.LimitExceeded)
            next_depth = unchecked:
                depth + 1
            node = self.disjunction(next_depth, bounds)?
            if self.peek() != ")":
                return Err(TemplateError.Syntax(self.at))
            drop(self.take())
            return Ok(node)
        mut value = empty_value()
        mut path = allocated(list[str]())?
        if base[0] == "'" or base[0] == "\"":
            value.kind = 4
            value.text = quoted(&base, self.at)?
        elif base == "true" or base == "false":
            value.kind = 1
            value.integer = 1 if base == "true" else 0
        elif base == "null":
            pass
        elif base[0] in "-0123456789":
            match i64.parse(base):
                case Ok(number):
                    value.kind = 2
                    value.integer = number
                case Err(_):
                    match f64.parse(base):
                        case Ok(number):
                            if not std.math.isfinite(number):
                                return Err(TemplateError.Syntax(self.at))
                            value.kind = 3
                            value.real = number
                        case Err(_):
                            return Err(TemplateError.Syntax(self.at))
        else:
            path = allocated(base.split("."))?
            for index in range(len(path)):
                if not identifier(&path[index]):
                    if index == 0:
                        return Err(TemplateError.Syntax(self.at))
                    match i64.parse(path[index]):
                        case Ok(number):
                            if number < 0:
                                return Err(TemplateError.Syntax(self.at))
                        case Err(_):
                            return Err(TemplateError.Syntax(self.at))
        self.push(ExprNode(0, value, path, allocated(list[str]())?, -1, -1, 1), bounds)

def expression(source: &str, at: i64, bounds: &Limits, remaining: &mut i64) -> Result[Expression, TemplateError]:
    mut parser = ExprParser(expression_words(source, at)?, 0, allocated(list[ExprNode]())?, at, *remaining)
    root = parser.disjunction(1, bounds)?
    if parser.peek() != "":
        return Err(TemplateError.Syntax(at))
    # push admitted every node against this registration's remaining budget.
    unchecked:
        *remaining -= len(parser.nodes)
    Ok(Expression(parser.nodes, root))

# Kinds: text, expression, if, else, endif, for, endfor, block, endblock, include, elif.
class Token:
    kind: i64
    text: str
    expr: Expression
    jump: i64
    alternate: i64
    at: i64

class Template:
    name: str
    parent: str
    tokens: list[Token]

# Both positions are nonnegative byte endpoints, so their difference fits
# even when index is the final endpoint i64.MAX.
def has_pair(index: i64, stop: i64) -> bool:
    unchecked:
        stop - index >= 2

# Exact budget growth: overflow has the same meaning as exceeding the limit.
def bounded_total(current: i64, amount: i64, limit: i64) -> Result[i64, TemplateError]:
    total = checked:
        current + amount
    match total:
        case Ok(value):
            if value > limit:
                return Err(TemplateError.LimitExceeded)
            Ok(value)
        case Err(_):
            Err(TemplateError.LimitExceeded)

# Delimiter trimming is byte-local and deliberately narrower than Unicode strip.
def trim_space(byte: u8) -> bool:
    byte == 32u8 or (byte >= 9u8 and byte <= 13u8)

def closing(source: &Bytes, start: i64, close: u8, comment: bool) -> Result[i64, TemplateError]:
    mut quote = 0u8
    mut escaped = False
    mut index = start
    while has_pair(index, source.len()):
        # has_pair proves index + 1 < source.len().
        next = unchecked:
            index + 1
        scalar = source[index]
        if escaped:
            escaped = False
        elif quote != 0u8:
            if scalar == 92u8:
                escaped = True
            elif scalar == quote:
                quote = 0u8
        elif source[index] == close and source[next] == 125u8:
            return Ok(index)
        elif not comment and (scalar == 39u8 or scalar == 34u8):
            quote = scalar
        index = next
    # parse passes the endpoint just after a two-byte opening delimiter.
    at = unchecked:
        start - 2
    Err(TemplateError.Syntax(at))

def push_token(tokens: &mut list[Token], token: Token, bounds: &Limits) -> Result[(), TemplateError]:
    if len(tokens) >= bounds.max_tokens.get():
        return Err(TemplateError.LimitExceeded)
    allocated(tokens.append(token))

def include_expression(source: &str, at: i64, bounds: &Limits, remaining: &mut i64) -> Result[(str, Expression, i64), TemplateError]:
    if len(source) < 2 or (source[0] != "'" and source[0] != "\""):
        return Err(TemplateError.Syntax(at))
    mut escaped = False
    for index, scalar in enumerate(source):
        if index == 0:
            continue
        if escaped:
            escaped = False
        elif scalar == "\\":
            escaped = True
        elif scalar == source[0]:
            # enumerate supplies a scalar position below len(source).
            after = unchecked:
                index + 1
            name = quoted(&allocated(source.slice(0, after))?, at)?
            if name == "":
                return Err(TemplateError.Syntax(at))
            rest = allocated(allocated(source.slice(after, len(source)))?.strip())?
            if rest == "":
                return Ok((name, empty_expression()?, 0))
            if not rest.startswith("with "):
                return Err(TemplateError.Syntax(at))
            expr = expression(&allocated(allocated(rest.slice(5, len(rest)))?.strip())?, at, bounds, remaining)?
            return Ok((name, expr, 1))
    Err(TemplateError.Syntax(at))

def parse(name: str, source: &str, bounds: &Limits, node_budget: i64) -> Result[Template, TemplateError]:
    mut remaining = node_budget
    data = allocated(std.bytes.from_text(source))?
    mut tokens: list[Token] = allocated(list[Token]())?
    mut stack: list[i64] = allocated(list[i64]())?
    mut blocks: list[str] = allocated(list[str]())?
    mut parent = ""
    mut index = 0
    mut start = 0
    mut significant = False
    while index < data.len():
        # The loop guard proves index + 1 <= data.len().
        next = unchecked:
            index + 1
        if not has_pair(index, data.len()) or data[index] != 123u8 or (data[next] != 123u8 and data[next] != 37u8 and data[next] != 35u8):
            index = next
            continue
        # Keep original byte endpoints for syntax errors and source budgets.
        opening_end = unchecked:
            index + 2
        marker = data[next]
        mut content_start = opening_end
        mut literal_end = index
        mut trim_left = opening_end < data.len() and data[opening_end] == 45u8
        # Compact negative literals predate trimming; their sign stays content.
        if trim_left and marker == 123u8 and has_pair(opening_end, data.len()):
            following = unchecked:
                opening_end + 1
            byte = data[following]
            if byte == 46u8 or (byte >= 48u8 and byte <= 57u8):
                trim_left = False
        if trim_left:
            while literal_end > start:
                previous = unchecked:
                    literal_end - 1
                if not trim_space(data[previous]):
                    break
                literal_end = previous
            content_start = unchecked:
                opening_end + 1
        if literal_end > start:
            text = bytes_result(data.to_text_range(start, literal_end))?
            if allocated(text.strip())? != "":
                significant = True
                if parent != "" and len(stack) == 0:
                    return Err(TemplateError.Syntax(start))
            push_token(&mut tokens, Token(0, text, empty_expression()?, -1, -1, start), bounds)?
        close = 125u8 if marker == 123u8 else marker
        end = closing(&data, opening_end, close, marker == 35u8)?
        mut content_end = end
        mut trim_right = False
        if end > content_start:
            previous = unchecked:
                end - 1
            if data[previous] == 45u8:
                content_end = previous
                trim_right = True
        content = allocated(bytes_result(data.to_text_range(content_start, content_end))?.strip())?
        at = index
        # closing only returns an index with two bytes still present.
        unchecked:
            index = end + 2
        if trim_right:
            while index < data.len() and trim_space(data[index]):
                index = unchecked:
                    index + 1
        start = index
        if marker == 35u8:
            continue
        if marker == 123u8:
            if parent != "" and len(stack) == 0:
                return Err(TemplateError.Syntax(at))
            push_token(&mut tokens, Token(1, "", expression(&content, at, bounds, &mut remaining)?, -1, -1, at), bounds)?
            significant = True
            continue
        if content.startswith("extends "):
            if significant or parent != "" or len(stack) != 0:
                return Err(TemplateError.Syntax(at))
            raw = allocated(allocated(content.slice(8, len(content)))?.strip())?
            if len(raw) == 0 or (raw[0] != "'" and raw[0] != "\""):
                return Err(TemplateError.Syntax(at))
            parent = quoted(&raw, at)?
            if parent == "":
                return Err(TemplateError.Syntax(at))
            significant = True
            continue
        significant = True
        mut kind = -1
        mut label = ""
        mut expr = empty_expression()?
        mut alternate = -1
        if content.startswith("if "):
            kind = 2
            expr = expression(&allocated(content.slice(3, len(content)))?, at, bounds, &mut remaining)?
        elif content.startswith("elif "):
            if len(stack) == 0 or tokens[stack[-1]].kind != 2:
                return Err(TemplateError.Syntax(at))
            opening = stack[-1]
            previous = tokens[opening].jump if tokens[opening].jump >= 0 else opening
            if tokens[previous].kind == 3:
                return Err(TemplateError.Syntax(at))
            tokens[previous].alternate = len(tokens)
            # During parsing, the opening if's jump temporarily tracks the
            # branch tail. Closing endif replaces every branch jump below.
            tokens[opening].jump = len(tokens)
            kind = 10
            expr = expression(&allocated(content.slice(5, len(content)))?, at, bounds, &mut remaining)?
        elif content.startswith("for "):
            words = allocated(content.split())?
            if len(words) != 4 or words[2] != "in" or not identifier(&words[1]) or words[1] == "loop":
                return Err(TemplateError.Syntax(at))
            kind = 5
            label = words[1]
            expr = expression(&words[3], at, bounds, &mut remaining)?
        elif content.startswith("include "):
            kind = 9
            (included_name, included_expr, explicit) = include_expression(&allocated(allocated(content.slice(8, len(content)))?.strip())?, at, bounds, &mut remaining)?
            label = included_name
            expr = included_expr
            alternate = explicit
        elif content.startswith("block "):
            label = allocated(allocated(content.slice(6, len(content)))?.strip())?
            if len(stack) != 0 or not identifier(&label) or label in blocks:
                return Err(TemplateError.Syntax(at))
            allocated(blocks.append(label))?
            kind = 7
        elif content == "else":
            if len(stack) == 0:
                return Err(TemplateError.Syntax(at))
            opening = stack[-1]
            if tokens[opening].kind != 2 and tokens[opening].kind != 5:
                return Err(TemplateError.Syntax(at))
            previous = tokens[opening].jump if tokens[opening].kind == 2 and tokens[opening].jump >= 0 else opening
            if tokens[previous].kind == 3 or tokens[previous].alternate != -1:
                return Err(TemplateError.Syntax(at))
            tokens[previous].alternate = len(tokens)
            if tokens[opening].kind == 2:
                tokens[opening].jump = len(tokens)
            kind = 3
        elif content == "endif" or content == "endfor" or content == "endblock":
            if len(stack) == 0:
                return Err(TemplateError.Syntax(at))
            opening = stack.pop().unwrap()
            kind = 4 if content == "endif" else (6 if content == "endfor" else 8)
            # Closing kinds are exactly 4, 6 or 8.
            opening_kind = unchecked:
                kind - 1
            if tokens[opening].kind != opening_kind and kind != 4:
                return Err(TemplateError.Syntax(at))
            if kind == 4 and tokens[opening].kind != 2:
                return Err(TemplateError.Syntax(at))
            if kind == 4:
                mut branch = opening
                while True:
                    alternate = tokens[branch].alternate
                    tokens[branch].jump = len(tokens)
                    if alternate < 0 or tokens[alternate].kind != 10:
                        break
                    branch = alternate
            else:
                tokens[opening].jump = len(tokens)
        else:
            return Err(TemplateError.Syntax(at))
        if parent != "" and len(stack) == 0 and kind != 7 and kind != 8:
            return Err(TemplateError.Syntax(at))
        if kind == 2 or kind == 5 or kind == 7:
            if len(stack) >= bounds.max_depth.get():
                return Err(TemplateError.LimitExceeded)
            allocated(stack.append(len(tokens)))?
        push_token(&mut tokens, Token(kind, label, expr, -1, alternate, at), bounds)?
    if len(stack) != 0:
        return Err(TemplateError.Syntax(tokens[stack[-1]].at))
    if index > start:
        text = bytes_result(data.to_text_range(start, index))?
        if parent != "" and allocated(text.strip())? != "":
            return Err(TemplateError.Syntax(start))
        push_token(&mut tokens, Token(0, text, empty_expression()?, -1, -1, start), bounds)?
    Ok(Template(name, parent, tokens))

class Node:
    key: str
    value: Value
    children: list[i64]

class Binding:
    name: str
    node: i64
    index: i64
    count: i64

class Override:
    name: str
    template: i64
    token: i64

class State:
    nodes: list[Node]
    bindings: list[Binding]
    root: i64
    binding_start: i64
    active: list[i64]
    bytes: i64
    steps: i64
    output: Bytes
    html: bool
    strict: Option[HtmlState]

def step(state: &mut State, bounds: &Limits) -> Result[(), TemplateError]:
    if state.steps >= bounds.max_steps.get():
        return Err(TemplateError.LimitExceeded)
    state.steps = bounded_total(state.steps, 1, bounds.max_steps.get())?
    Ok(())

def context_bytes(state: &mut State, text: &str, bounds: &Limits) -> Result[(), TemplateError]:
    state.bytes = bounded_total(state.bytes, text.byte_len(), bounds.max_context_bytes.get())?
    Ok(())

def flatten(state: &mut State, key: str, data: &Json, depth: i64, bounds: &Limits) -> Result[i64, TemplateError]:
    if depth > bounds.max_depth.get() or len(state.nodes) >= bounds.max_context_nodes.get():
        return Err(TemplateError.LimitExceeded)
    # engine validates max_depth <= 64; this frame passed its depth check.
    next_depth = unchecked:
        depth + 1
    step(state, bounds)?
    context_bytes(state, &key, bounds)?
    node = len(state.nodes)
    allocated(state.nodes.append(Node(key, empty_value(), allocated(list[i64]())?)))?
    state.nodes[node].value.node = node
    match data:
        case Json.Null:
            pass
        case Json.Bool(value):
            state.nodes[node].value.kind = 1
            state.nodes[node].value.integer = 1 if *value else 0
        case Json.Int(value):
            state.nodes[node].value.kind = 2
            state.nodes[node].value.integer = *value
        case Json.Float(value):
            if not std.math.isfinite(*value):
                return Err(TemplateError.TypeMismatch)
            state.nodes[node].value.kind = 3
            state.nodes[node].value.real = *value
        case Json.Text(value):
            context_bytes(state, value, bounds)?
            state.nodes[node].value.kind = 4
            state.nodes[node].value.text = *value
        case Json.Array(items):
            state.nodes[node].value.kind = 5
            for item in items:
                child = flatten(state, "", item, next_depth, bounds)?
                allocated(state.nodes[node].children.append(child))?
        case Json.Object(items):
            state.nodes[node].value.kind = 6
            for item in items:
                for position in range(len(state.nodes[node].children)):
                    child = state.nodes[node].children[position]
                    step(state, bounds)?
                    if state.nodes[child].key == item.key:
                        return Err(TemplateError.TypeMismatch)
                child = flatten(state, item.key, &item.value, next_depth, bounds)?
                allocated(state.nodes[node].children.append(child))?
    Ok(node)

def value_copy(value: &Value) -> Value:
    Value(value.kind, value.text, value.integer, value.real, value.node, value.emission)

def truth(value: &Value, state: &State) -> bool:
    if value.kind == 0:
        False
    elif value.kind == 1 or value.kind == 2:
        value.integer != 0
    elif value.kind == 3:
        value.real != 0.0
    elif value.kind == 4:
        len(value.text) != 0
    else:
        len(state.nodes[value.node].children) != 0

def path_value(path: &list[str], state: &mut State, bounds: &Limits) -> Result[Value, TemplateError]:
    mut node = state.root
    mut start = 0
    mut index = len(state.bindings)
    while index > state.binding_start:
        # The loop guard proves index > 0.
        unchecked:
            index -= 1
        step(state, bounds)?
        if path[0] == "loop":
            if len(path) != 2:
                return Err(TemplateError.MissingValue(path[0]))
            name = path[1]
            position = state.bindings[index].index
            count = state.bindings[index].count
            # Bindings are created by range(count): 0 <= position < count.
            ordinal = unchecked:
                position + 1
            if name == "index":
                return Ok(Value(2, "", ordinal, 0.0, -1, Emission.Default))
            elif name == "index0":
                return Ok(Value(2, "", position, 0.0, -1, Emission.Default))
            elif name == "first":
                return Ok(Value(1, "", 1 if position == 0 else 0, 0.0, -1, Emission.Default))
            elif name == "last":
                return Ok(Value(1, "", 1 if ordinal == count else 0, 0.0, -1, Emission.Default))
            elif name == "length":
                return Ok(Value(2, "", count, 0.0, -1, Emission.Default))
            return Err(TemplateError.MissingValue(name))
        if state.bindings[index].name == path[0]:
            node = state.bindings[index].node
            start = 1
            break
    for part in range(start, len(path)):
        step(state, bounds)?
        kind = state.nodes[node].value.kind
        if kind == 6:
            mut found = -1
            for position in range(len(state.nodes[node].children)):
                child = state.nodes[node].children[position]
                step(state, bounds)?
                if state.nodes[child].key == path[part]:
                    found = child
                    break
            if found < 0:
                return Err(TemplateError.MissingValue(path[part]))
            node = found
        elif kind == 5:
            match i64.parse(path[part]):
                case Ok(position):
                    if position < 0 or position >= len(state.nodes[node].children):
                        return Err(TemplateError.MissingValue(path[part]))
                    node = state.nodes[node].children[position]
                case Err(_):
                    return Err(TemplateError.MissingValue(path[part]))
        else:
            return Err(TemplateError.TypeMismatch)
    Ok(value_copy(&state.nodes[node].value))

pub def escape(text: &str, context: HtmlContext, max_bytes: NonNegative[i64] = 16777216) -> Result[str, TemplateError]:
    escape_bounded(text, context, max_bytes.get())

def escape_bounded(text: &str, context: HtmlContext, max_bytes: i64) -> Result[str, TemplateError]:
    # Escaping never shrinks its input. Reject before copying an oversized
    # source so the output cap also bounds input scanning and temporary bytes.
    if text.byte_len() > max_bytes:
        return Err(TemplateError.LimitExceeded)
    angles = context == HtmlContext.Text or context == HtmlContext.TextAndAttributes
    double_quote = context == HtmlContext.DoubleQuotedAttribute or context == HtmlContext.TextAndAttributes
    single_quote = context == HtmlContext.SingleQuotedAttribute or context == HtmlContext.TextAndAttributes
    mut output = allocated(std.bytes.empty())?
    encoded = allocated(std.bytes.from_text(text))?
    for byte in &encoded:
        mut replacement = b""
        if *byte == 38u8:
            replacement = b"&amp;"
        elif *byte == 60u8 and angles:
            replacement = b"&lt;"
        elif *byte == 62u8 and angles:
            replacement = b"&gt;"
        elif *byte == 34u8 and double_quote:
            replacement = b"&quot;"
        elif *byte == 39u8 and single_quote:
            replacement = b"&#x27;"
        size = 1 if len(replacement) == 0 else len(replacement)
        # Both budget and output length are nonnegative i64 values.
        remaining = unchecked:
            max_bytes - output.len()
        if size > remaining:
            return Err(TemplateError.LimitExceeded)
        if len(replacement) == 0:
            allocated(output.push(*byte))?
        else:
            allocated(output.extend(&replacement))?
    bytes_result(output.to_text())

def scalar_equal(left: &Value, right: &Value) -> Result[bool, TemplateError]:
    if left.kind >= 5 or right.kind >= 5:
        return Err(TemplateError.TypeMismatch)
    if left.kind != right.kind:
        return Ok(False)
    if left.kind == 0:
        Ok(True)
    elif left.kind == 1 or left.kind == 2:
        Ok(left.integer == right.integer)
    elif left.kind == 3:
        Ok(left.real == right.real)
    else:
        Ok(left.text == right.text)

def boolean_value(value: bool) -> Value:
    Value(1, "", 1 if value else 0, 0.0, -1, Emission.Default)

def evaluate(expr: &Expression, state: &mut State, bounds: &Limits) -> Result[Value, TemplateError]:
    evaluate_node(expr, expr.root, state, bounds, 1)

def evaluate_node(expr: &Expression, index: i64, state: &mut State, bounds: &Limits, depth: i64) -> Result[Value, TemplateError]:
    if depth > bounds.max_depth.get():
        return Err(TemplateError.LimitExceeded)
    step(state, bounds)?
    node = &expr.nodes[index]
    mut value = empty_value()
    if node.kind == 0:
        value = value_copy(&node.literal)
        if len(node.path) != 0:
            value = path_value(&node.path, state, bounds)?
    else:
        # The engine validates max_depth <=64 and this frame passed its check.
        next_depth = unchecked:
            depth + 1
        left = evaluate_node(expr, node.left, state, bounds, next_depth)?
        if node.kind == 1:
            value = boolean_value(not truth(&left, state))
        elif node.kind == 4 or node.kind == 5:
            first = truth(&left, state)
            if (node.kind == 4 and not first) or (node.kind == 5 and first):
                value = boolean_value(first)
            else:
                right = evaluate_node(expr, node.right, state, bounds, next_depth)?
                value = boolean_value(truth(&right, state))
        else:
            right = evaluate_node(expr, node.right, state, bounds, next_depth)?
            equal = scalar_equal(&left, &right)?
            value = boolean_value(equal if node.kind == 2 else not equal)
    for filter in &node.filters:
        step(state, bounds)?
        if filter == "length":
            mut count = 0
            if value.kind == 4:
                count = len(value.text)
            elif value.kind == 5 or value.kind == 6:
                count = len(state.nodes[value.node].children)
            else:
                return Err(TemplateError.TypeMismatch)
            value = Value(2, "", count, 0.0, -1, Emission.Default)
        else:
            if value.kind != 4:
                return Err(TemplateError.TypeMismatch)
            if filter == "upper":
                value.text = allocated(value.text.upper())?
                value.emission = Emission.Default
            elif filter == "lower":
                value.text = allocated(value.text.lower())?
                value.emission = Emission.Default
            elif filter == "trim":
                value.text = allocated(value.text.strip())?
            elif filter == "escape":
                value.text = escape_bounded(&value.text, HtmlContext.TextAndAttributes, bounds.max_output.get())?
                value.emission = Emission.Trusted
            elif filter == "safe":
                value.emission = Emission.Trusted
            elif filter == "escape_text":
                value.emission = Emission.Escape(HtmlContext.Text)
            elif filter == "escape_double_quoted":
                value.emission = Emission.Escape(HtmlContext.DoubleQuotedAttribute)
            elif filter == "escape_single_quoted":
                value.emission = Emission.Escape(HtmlContext.SingleQuotedAttribute)
            if value.text.byte_len() > bounds.max_output.get():
                return Err(TemplateError.LimitExceeded)
    Ok(value)

def append(state: &mut State, text: &str, bounds: &Limits) -> Result[(), TemplateError]:
    # Both operands are nonnegative; append keeps output within this budget.
    remaining = unchecked:
        bounds.max_output.get() - state.output.len()
    if text.byte_len() > remaining:
        return Err(TemplateError.LimitExceeded)
    encoded = allocated(std.bytes.from_text(text))?
    allocated(state.output.extend(&encoded))

def emit(state: &mut State, value: &Value, bounds: &Limits, name: &str, at: i64) -> Result[(), TemplateError]:
    mut text = ""
    if value.kind == 1:
        text = "true" if value.integer != 0 else "false"
    elif value.kind == 2:
        text = allocated(str.from(value.integer))?
    elif value.kind == 3:
        text = allocated(str.from(value.real))?
    elif value.kind == 4:
        text = value.text
    elif value.kind != 0:
        return Err(TemplateError.TypeMismatch)
    mut context: Option[HtmlContext] = match value.emission:
        case Emission.Default:
            Some(HtmlContext.TextAndAttributes) if state.html else Nothing
        case Emission.Trusted:
            Nothing
        case Emission.Escape(context):
            Some(context)
    match &mut state.strict:
        case Some(html):
            inferred = html_context(html, name, at)?
            match value.emission:
                case Emission.Trusted:
                    return Err(TemplateError.InvalidHtml(*name, at))
                case Emission.Escape(selected):
                    if selected != inferred:
                        return Err(TemplateError.InvalidHtml(*name, at))
                case Emission.Default:
                    pass
            context = Some(inferred)
            html.start = False
        case Nothing:
            pass
    match context:
        case Nothing:
            pass
        case Some(mode):
            # Output has only grown through budget-checked append.
            remaining = unchecked:
                bounds.max_output.get() - state.output.len()
            text = escape_bounded(&text, mode, remaining)?
    append(state, &text, bounds)

# A conservative streaming recognizer, not the HTML5 tree-construction algorithm.
# Token offsets and the scalar's UTF-8 byte width retain original diagnostics.
class HtmlState:
    mode: i64
    tag: str
    attribute: str
    closing: bool
    attributes: list[str]
    stack: list[str]
    start: bool
    source: str
    offset: i64

class HtmlCheck:
    html: HtmlState
    active: list[i64]
    steps: i64

def html_state() -> Result[HtmlState, TemplateError]:
    Ok(HtmlState(0, "", "", False, allocated(list[str]())?, allocated(list[str]())?, True, "", 0))

def html_space(text: &str) -> bool:
    text in " \t\n\r\u{c}"

def html_letter(text: &str) -> bool:
    text in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

def html_name(text: &str) -> bool:
    html_letter(text) or text in "0123456789-_"

def html_tag(name: &str) -> bool:
    # Unknown/custom, foreign, scripting, raw-text and parser-special elements
    # are excluded. title is the only supported escapable raw-text element.
    if name == "a" or name == "abbr" or name == "address" or name == "article" or name == "aside" or name == "audio" or name == "b" or name == "bdi" or name == "bdo" or name == "blockquote" or name == "body" or name == "br" or name == "button" or name == "caption" or name == "cite" or name == "code":
        return True
    if name == "col" or name == "colgroup" or name == "data" or name == "datalist" or name == "dd" or name == "del" or name == "details" or name == "dfn" or name == "dialog" or name == "div" or name == "dl" or name == "dt" or name == "em" or name == "fieldset" or name == "figcaption" or name == "figure":
        return True
    if name == "footer" or name == "form" or name == "h1" or name == "h2" or name == "h3" or name == "h4" or name == "h5" or name == "h6" or name == "head" or name == "header" or name == "hgroup" or name == "hr" or name == "html" or name == "i" or name == "img" or name == "input":
        return True
    if name == "ins" or name == "kbd" or name == "label" or name == "legend" or name == "li" or name == "link" or name == "main" or name == "map" or name == "mark" or name == "menu" or name == "meta" or name == "meter" or name == "nav" or name == "ol" or name == "optgroup" or name == "option":
        return True
    if name == "output" or name == "p" or name == "picture" or name == "pre" or name == "progress" or name == "q" or name == "rp" or name == "rt" or name == "ruby" or name == "s" or name == "samp" or name == "search" or name == "section" or name == "select" or name == "slot" or name == "small":
        return True
    if name == "source" or name == "span" or name == "strong" or name == "sub" or name == "summary" or name == "sup" or name == "table" or name == "tbody" or name == "td" or name == "tfoot" or name == "th" or name == "thead" or name == "time" or name == "title" or name == "tr" or name == "track":
        return True
    if name == "u" or name == "ul" or name == "var" or name == "video" or name == "wbr":
        return True
    False

def html_void(name: &str) -> bool:
    name == "br" or name == "col" or name == "hr" or name == "img" or name == "input" or name == "link" or name == "meta" or name == "source" or name == "track" or name == "wbr"

def html_attribute(name: &str) -> bool:
    # URL attributes are allowed only as trusted literal source. The emitter
    # separately rejects interpolation there; no URL policy is inferred.
    if name.startswith("data-") or name.startswith("aria-"):
        return len(name) > 5
    name == "id" or name == "class" or name == "title" or name == "role" or name == "lang" or name == "dir" or name == "name" or name == "value" or name == "type" or name == "placeholder" or name == "alt" or name == "for" or name == "tabindex" or name == "width" or name == "height" or name == "disabled" or name == "checked" or name == "selected" or name == "multiple" or name == "required" or name == "readonly" or name == "hidden" or name == "open" or name == "method" or name == "enctype" or name == "autocomplete" or name == "min" or name == "max" or name == "step" or name == "rows" or name == "cols" or name == "colspan" or name == "rowspan" or name == "scope" or name == "datetime" or name == "rel" or name == "target" or name == "media" or name == "href" or name == "src" or name == "action" or name == "formaction" or name == "poster" or name == "cite" or name == "srcset"

def html_url(name: &str) -> bool:
    name == "href" or name == "src" or name == "action" or name == "formaction" or name == "poster" or name == "cite" or name == "srcset"

def html_piece(current: &str, text: &str) -> Result[str, TemplateError]:
    if current.byte_len() >= 64:
        return Err(TemplateError.LimitExceeded)
    allocated(*current + allocated(text.lower())?)

def html_finish(html: &mut HtmlState, name: &str, at: i64, bounds: &Limits) -> Result[(), TemplateError]:
    if html.closing:
        if len(html.stack) == 0 or html.stack[-1] != html.tag:
            return Err(TemplateError.InvalidHtml(*name, at))
        drop(html.stack.pop())
        html.mode = 0
    elif html_void(&html.tag):
        html.mode = 0
    else:
        if len(html.stack) >= bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        allocated(html.stack.append(html.tag))?
        html.mode = 14 if html.tag == "title" else 0
    html.start = False
    Ok(())

def html_attribute_end(html: &mut HtmlState, name: &str, at: i64) -> Result[(), TemplateError]:
    if len(html.attributes) >= 128:
        return Err(TemplateError.LimitExceeded)
    if not html_attribute(&html.attribute) or html.attribute in html.attributes:
        return Err(TemplateError.InvalidHtml(*name, at))
    allocated(html.attributes.append(html.attribute))

def html_text(html: &mut HtmlState, text: &str, name: &str, start: i64, bounds: &Limits) -> Result[(), TemplateError]:
    mut offset = start
    for scalar in text:
        html.source = *name
        html.offset = offset
        if scalar == "\0":
            return Err(TemplateError.InvalidHtml(*name, offset))
        mut again = True
        while again:
            again = False
            if html.mode == 0 or html.mode == 14:
                if scalar == "<":
                    html.closing = html.mode == 14
                    html.tag = ""
                    html.attributes.clear()
                    html.mode = 1
                elif not html_space(scalar):
                    html.start = False
            elif html.mode == 1:
                if scalar == "/":
                    html.closing = True
                    html.mode = 2
                elif html.closing:
                    return Err(TemplateError.InvalidHtml(*name, offset))
                elif scalar == "!" and html.start and len(html.stack) == 0:
                    html.tag = "!"
                    html.mode = 13
                elif html_letter(scalar):
                    html.mode = 2
                    again = True
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 2:
                if html_letter(scalar) or scalar in "0123456789":
                    html.tag = html_piece(&html.tag, scalar)?
                else:
                    if not html_tag(&html.tag) or (len(html.stack) > 0 and html.stack[-1] == "title" and (not html.closing or html.tag != "title")):
                        return Err(TemplateError.InvalidHtml(*name, offset))
                    html.mode = 10 if html.closing else 3
                    again = True
            elif html.mode == 3:
                if html_space(scalar):
                    pass
                elif scalar == ">":
                    html_finish(html, name, offset, bounds)?
                elif scalar == "/" and html_void(&html.tag):
                    html.mode = 11
                elif html_letter(scalar):
                    html.attribute = ""
                    html.mode = 4
                    again = True
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 4:
                if html_name(scalar):
                    html.attribute = html_piece(&html.attribute, scalar)?
                else:
                    html_attribute_end(html, name, offset)?
                    html.mode = 5
                    again = True
            elif html.mode == 5:
                if html_space(scalar):
                    pass
                elif scalar == "=":
                    html.mode = 6
                elif scalar == ">" or scalar == "/" or html_letter(scalar):
                    html.mode = 3
                    again = True
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 6:
                if html_space(scalar):
                    pass
                elif scalar == "\"":
                    html.mode = 7
                elif scalar == "'":
                    html.mode = 8
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 7 or html.mode == 8:
                if (html.mode == 7 and scalar == "\"") or (html.mode == 8 and scalar == "'"):
                    html.mode = 9
            elif html.mode == 9:
                if html_space(scalar):
                    html.mode = 3
                elif scalar == ">" or scalar == "/":
                    html.mode = 3
                    again = True
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 10:
                if html_space(scalar):
                    pass
                elif scalar == ">":
                    html_finish(html, name, offset, bounds)?
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            elif html.mode == 11:
                if scalar != ">":
                    return Err(TemplateError.InvalidHtml(*name, offset))
                html_finish(html, name, offset, bounds)?
            elif html.mode == 13:
                if scalar == ">":
                    words = allocated(html.tag.split())?
                    if len(words) != 2 or words[0] != "!doctype" or words[1] != "html":
                        return Err(TemplateError.InvalidHtml(*name, offset))
                    html.start = False
                    html.mode = 0
                elif html_letter(scalar) or html_space(scalar):
                    html.tag = html_piece(&html.tag, scalar)?
                else:
                    return Err(TemplateError.InvalidHtml(*name, offset))
            else:
                return Err(TemplateError.InvalidHtml(*name, offset))
        # offset begins inside the registered original UTF-8 source and each
        # scalar advances by its original width, never by rendered/entity bytes.
        unchecked:
            offset += scalar.byte_len()
    Ok(())

def html_context(html: &HtmlState, name: &str, at: i64) -> Result[HtmlContext, TemplateError]:
    if html.mode == 0 or html.mode == 14:
        return Ok(HtmlContext.Text)
    if (html.mode == 7 or html.mode == 8) and not html_url(&html.attribute):
        return Ok(HtmlContext.DoubleQuotedAttribute if html.mode == 7 else HtmlContext.SingleQuotedAttribute)
    Err(TemplateError.InvalidHtml(*name, at))

def html_policy(expr: &Expression, context: HtmlContext, name: &str, at: i64, check: &mut HtmlCheck, bounds: &Limits) -> Result[(), TemplateError]:
    # Inspect every syntactic arm, including short-circuited operands. Parent
    # operators produce fresh default-policy booleans, so only the root's final
    # selector reaches emission. Legacy trust filters remain wholly excluded.
    mut selected: Option[HtmlContext] = Nothing
    for index in range(len(expr.nodes)):
        check.steps = bounded_total(check.steps, 1, bounds.max_steps.get())?
        for filter in &expr.nodes[index].filters:
            check.steps = bounded_total(check.steps, 1, bounds.max_steps.get())?
            if filter == "safe" or filter == "escape":
                return Err(TemplateError.InvalidHtml(*name, at))
            if index != expr.root:
                continue
            if filter == "upper" or filter == "lower" or filter == "length":
                selected = Nothing
            elif filter == "escape_text":
                selected = Some(HtmlContext.Text)
            elif filter == "escape_double_quoted":
                selected = Some(HtmlContext.DoubleQuotedAttribute)
            elif filter == "escape_single_quoted":
                selected = Some(HtmlContext.SingleQuotedAttribute)
    match selected:
        case Some(mode):
            if mode != context:
                return Err(TemplateError.InvalidHtml(*name, at))
        case Nothing:
            pass
    Ok(())

def html_boundary(check: &mut HtmlCheck, name: &str, at: i64) -> Result[list[str], TemplateError]:
    if check.html.mode != 0:
        return Err(TemplateError.InvalidHtml(*name, at))
    check.html.start = False
    allocated(copy(check.html.stack))

def html_preserved(check: &HtmlCheck, stack: &list[str], name: &str, at: i64) -> Result[(), TemplateError]:
    if check.html.mode != 0 or len(check.html.stack) != len(stack):
        return Err(TemplateError.InvalidHtml(*name, at))
    for index in range(len(stack)):
        if check.html.stack[index] != stack[index]:
            return Err(TemplateError.InvalidHtml(*name, at))
    Ok(())

pub class Engine:
    _bounds: Limits
    _templates: list[Template]
    _source_bytes: i64
    _token_count: i64
    _expression_nodes: i64

    # Registration is transactional: a failure leaves the registry unchanged.
    pub def add(self: &mut Engine, name: &str, source: &str) -> Result[(), TemplateError]:
        if name == "":
            return Err(TemplateError.Syntax(0))
        for template in &self._templates:
            if template.name == name:
                return Err(TemplateError.DuplicateTemplate(*name))
        if len(self._templates) >= self._bounds.max_templates.get():
            return Err(TemplateError.LimitExceeded)
        named_bytes = bounded_total(self._source_bytes, name.byte_len(), self._bounds.max_source.get())?
        source_bytes = bounded_total(named_bytes, source.byte_len(), self._bounds.max_source.get())?
        remaining_nodes = unchecked:
            self._bounds.max_expression_nodes.get() - self._expression_nodes
        template = parse(*name, source, &self._bounds, remaining_nodes)?
        count = len(template.tokens)
        token_count = bounded_total(self._token_count, count, self._bounds.max_tokens.get())?
        mut expression_nodes = self._expression_nodes
        for token in &template.tokens:
            expression_nodes = bounded_total(expression_nodes, len(token.expr.nodes), self._bounds.max_expression_nodes.get())?
        allocated(self._templates.append(template))?
        self._source_bytes = source_bytes
        self._token_count = token_count
        self._expression_nodes = expression_nodes
        Ok(())

    pub def render(self, name: &str, context: &Json, html: bool = True) -> Result[str, TemplateError]:
        mut state = State(allocated(list[Node]())?, allocated(list[Binding]())?, 0, 0, allocated(list[i64]())?, 0, 0, allocated(std.bytes.empty())?, html, Nothing)
        match context:
            case Json.Object(_):
                pass
            case _:
                return Err(TemplateError.TypeMismatch)
        drop(flatten(&mut state, "", context, 0, &self._bounds)?)
        self.render_registered(name, &mut state, 0)?
        bytes_result(state.output.to_text())

    # Preflight visits every reachable syntactic branch before values/output.
    # It validates the effective inheritance layout, not unused registry entries.
    pub def validate_html(self, name: &str) -> Result[(), TemplateError]:
        drop(self.html_preflight(name)?)
        Ok(())

    pub def render_html(self, name: &str, context: &Json) -> Result[str, TemplateError]:
        check = self.html_preflight(name)?
        mut state = State(allocated(list[Node]())?, allocated(list[Binding]())?, 0, 0, allocated(list[i64]())?, 0, check.steps, allocated(std.bytes.empty())?, True, Some(html_state()?))
        match context:
            case Json.Object(_):
                pass
            case _:
                return Err(TemplateError.TypeMismatch)
        drop(flatten(&mut state, "", context, 0, &self._bounds)?)
        self.render_registered(name, &mut state, 0)?
        bytes_result(state.output.to_text())

    def html_preflight(self, name: &str) -> Result[HtmlCheck, TemplateError]:
        mut check = HtmlCheck(html_state()?, allocated(list[i64]())?, 0)
        self.html_registered(name, &mut check, 0)?
        if check.html.mode != 0 or len(check.html.stack) != 0:
            return Err(TemplateError.InvalidHtml(check.html.source, check.html.offset))
        Ok(check)

    def html_registered(self, name: &str, check: &mut HtmlCheck, depth: i64) -> Result[(), TemplateError]:
        if depth > self._bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        mut current = self.find(name)?
        for item in &check.active:
            check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
            if *item == current:
                return Err(TemplateError.InheritanceCycle)
        allocated(check.active.append(current))?
        mut visited = allocated(list[i64]())?
        mut overrides = allocated(list[Override]())?
        mut chain_depth = depth
        while True:
            if current in visited:
                return Err(TemplateError.InheritanceCycle)
            if chain_depth >= self._bounds.max_depth.get():
                return Err(TemplateError.LimitExceeded)
            allocated(visited.append(current))?
            for token in range(len(self._templates[current].tokens)):
                check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
                if self._templates[current].tokens[token].kind == 7:
                    label = self._templates[current].tokens[token].text
                    mut found = False
                    for item in &overrides:
                        check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
                        if item.name == label:
                            found = True
                            break
                    if not found:
                        allocated(overrides.append(Override(label, current, token)))?
            parent = self._templates[current].parent
            if parent == "":
                break
            current = self.find(&parent)?
            # chain_depth < configured maximum <=64.
            unchecked:
                chain_depth += 1
        self.html_run(current, 0, len(self._templates[current].tokens), check, &overrides, chain_depth)?
        drop(check.active.pop())
        Ok(())

    def html_run(self, template: i64, begin: i64, end: i64, check: &mut HtmlCheck, overrides: &list[Override], depth: i64) -> Result[(), TemplateError]:
        if depth > self._bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        next_depth = unchecked:
            depth + 1
        name = self._templates[template].name
        mut index = begin
        while index < end:
            next = unchecked:
                index + 1
            token = &self._templates[template].tokens[index]
            check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
            if token.kind == 0:
                check.steps = bounded_total(check.steps, token.text.byte_len(), self._bounds.max_steps.get())?
                html_text(&mut check.html, &token.text, &name, token.at, &self._bounds)?
            elif token.kind == 1:
                context = html_context(&check.html, &name, token.at)?
                html_policy(&token.expr, context, &name, token.at, check, &self._bounds)?
                check.html.start = False
            elif token.kind == 2:
                stack = html_boundary(check, &name, token.at)?
                mut branch = index
                while True:
                    candidate = &self._templates[template].tokens[branch]
                    html_policy(&candidate.expr, HtmlContext.Text, &name, candidate.at, check, &self._bounds)?
                    stop = candidate.jump if candidate.alternate < 0 else candidate.alternate
                    after_branch = unchecked:
                        branch + 1
                    self.html_run(template, after_branch, stop, check, overrides, next_depth)?
                    html_preserved(check, &stack, &name, candidate.at)?
                    if candidate.alternate < 0:
                        break
                    alternate = candidate.alternate
                    if self._templates[template].tokens[alternate].kind == 3:
                        after_else = unchecked:
                            alternate + 1
                        self.html_run(template, after_else, candidate.jump, check, overrides, next_depth)?
                        html_preserved(check, &stack, &name, candidate.at)?
                        break
                    # Each flat elif is visited once, without recursive depth.
                    check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
                    branch = alternate
                index = token.jump
            elif token.kind == 5:
                stack = html_boundary(check, &name, token.at)?
                html_policy(&token.expr, HtmlContext.Text, &name, token.at, check, &self._bounds)?
                stop = token.jump if token.alternate < 0 else token.alternate
                self.html_run(template, next, stop, check, overrides, next_depth)?
                html_preserved(check, &stack, &name, token.at)?
                if token.alternate >= 0:
                    after_else = unchecked:
                        token.alternate + 1
                    self.html_run(template, after_else, token.jump, check, overrides, next_depth)?
                    html_preserved(check, &stack, &name, token.at)?
                index = token.jump
            elif token.kind == 9:
                stack = html_boundary(check, &name, token.at)?
                if token.alternate == 1:
                    html_policy(&token.expr, HtmlContext.Text, &name, token.at, check, &self._bounds)?
                self.html_registered(&token.text, check, next_depth)?
                html_preserved(check, &stack, &name, token.at)?
            elif token.kind == 7:
                stack = html_boundary(check, &name, token.at)?
                for item in overrides:
                    check.steps = bounded_total(check.steps, 1, self._bounds.max_steps.get())?
                    if item.name == token.text:
                        stop = self._templates[item.template].tokens[item.token].jump
                        after_block = unchecked:
                            item.token + 1
                        self.html_run(item.template, after_block, stop, check, overrides, next_depth)?
                        break
                html_preserved(check, &stack, &name, token.at)?
                index = token.jump
            else:
                return Err(TemplateError.InvalidHtml(name, token.at))
            # Each jump references a closing token below len(tokens).
            unchecked:
                index += 1
        Ok(())

    # Each invocation owns its inheritance overrides and loop scope, while all
    # invocations charge the same context, output and work budgets.
    def render_registered(self, name: &str, state: &mut State, depth: i64) -> Result[(), TemplateError]:
        if depth > self._bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        mut current = self.find(name)?
        active_start = len(state.active)
        for position in range(len(state.active)):
            step(state, &self._bounds)?
            if state.active[position] == current:
                return Err(TemplateError.InheritanceCycle)
        allocated(state.active.append(current))?
        mut visited: list[i64] = allocated(list[i64]())?
        mut overrides: list[Override] = allocated(list[Override]())?
        mut chain_depth = depth
        while True:
            if current in visited:
                return Err(TemplateError.InheritanceCycle)
            if chain_depth >= self._bounds.max_depth.get():
                return Err(TemplateError.LimitExceeded)
            allocated(visited.append(current))?
            for token in range(len(self._templates[current].tokens)):
                step(state, &self._bounds)?
                if self._templates[current].tokens[token].kind == 7:
                    label = self._templates[current].tokens[token].text
                    mut found = False
                    for item in &overrides:
                        step(state, &self._bounds)?
                        if item.name == label:
                            found = True
                            break
                    if not found:
                        allocated(overrides.append(Override(label, current, token)))?
            parent = self._templates[current].parent
            if parent == "":
                break
            current = self.find(&parent)?
            # chain_depth is strictly below the configured maximum (at most64).
            unchecked:
                chain_depth += 1
        self.run(current, 0, len(self._templates[current].tokens), state, &overrides, chain_depth)?
        while len(state.active) > active_start:
            drop(state.active.pop())
        Ok(())

    def find(self, name: &str) -> Result[i64, TemplateError]:
        for index in range(len(self._templates)):
            if self._templates[index].name == name:
                return Ok(index)
        Err(TemplateError.UnknownTemplate(*name))

    def run(self, template: i64, begin: i64, end: i64, state: &mut State, overrides: &list[Override], depth: i64) -> Result[(), TemplateError]:
        if depth > self._bounds.max_depth.get():
            return Err(TemplateError.LimitExceeded)
        # engine validates max_depth <= 64; this frame passed its depth check.
        next_depth = unchecked:
            depth + 1
        mut index = begin
        while index < end:
            # index < end <= len(tokens), so the following endpoint fits.
            next = unchecked:
                index + 1
            step(state, &self._bounds)?
            token = &self._templates[template].tokens[index]
            if token.kind == 0:
                match &mut state.strict:
                    case Some(html):
                        state.steps = bounded_total(state.steps, token.text.byte_len(), self._bounds.max_steps.get())?
                        html_text(html, &token.text, &self._templates[template].name, token.at, &self._bounds)?
                    case Nothing:
                        pass
                append(state, &token.text, &self._bounds)?
            elif token.kind == 1:
                value = evaluate(&token.expr, state, &self._bounds)?
                emit(state, &value, &self._bounds, &self._templates[template].name, token.at)?
            elif token.kind == 2:
                mut branch = index
                while True:
                    candidate = &self._templates[template].tokens[branch]
                    value = evaluate(&candidate.expr, state, &self._bounds)?
                    stop = candidate.jump if candidate.alternate < 0 else candidate.alternate
                    after_branch = unchecked:
                        branch + 1
                    if truth(&value, state):
                        self.run(template, after_branch, stop, state, overrides, next_depth)?
                        break
                    if candidate.alternate < 0:
                        break
                    alternate = candidate.alternate
                    if self._templates[template].tokens[alternate].kind == 3:
                        after_else = unchecked:
                            alternate + 1
                        self.run(template, after_else, candidate.jump, state, overrides, next_depth)?
                        break
                    # A flat elif chain does not consume recursive render depth.
                    step(state, &self._bounds)?
                    branch = alternate
                index = token.jump
            elif token.kind == 5:
                value = evaluate(&token.expr, state, &self._bounds)?
                if value.kind != 5:
                    return Err(TemplateError.TypeMismatch)
                count = len(state.nodes[value.node].children)
                stop = token.jump if token.alternate < 0 else token.alternate
                for item in range(count):
                    step(state, &self._bounds)?
                    child = state.nodes[value.node].children[item]
                    allocated(state.bindings.append(Binding(token.text, child, item, count)))?
                    self.run(template, next, stop, state, overrides, next_depth)?
                    drop(state.bindings.pop())
                if count == 0 and token.alternate >= 0:
                    # Parser links alternate to an existing else token.
                    after_else = unchecked:
                        token.alternate + 1
                    self.run(template, after_else, token.jump, state, overrides, next_depth)?
                index = token.jump
            elif token.kind == 9:
                saved_root = state.root
                saved_start = state.binding_start
                if token.alternate == 1:
                    value = evaluate(&token.expr, state, &self._bounds)?
                    if value.kind != 6:
                        return Err(TemplateError.TypeMismatch)
                    state.root = value.node
                # An include receives an object context, never the caller's
                # loop locals. Explicit arguments are evaluated before hiding it.
                state.binding_start = len(state.bindings)
                self.render_registered(&token.text, state, next_depth)?
                state.root = saved_root
                state.binding_start = saved_start
            elif token.kind == 7:
                for item in overrides:
                    step(state, &self._bounds)?
                    if item.name == token.text:
                        stop = self._templates[item.template].tokens[item.token].jump
                        # Overrides refer to existing block tokens.
                        after_block = unchecked:
                            item.token + 1
                        self.run(item.template, after_block, stop, state, overrides, next_depth)?
                        break
                index = token.jump
            else:
                return Err(TemplateError.Syntax(token.at))
            # A jump targets an existing closing token; otherwise index was
            # already below end. Both endpoints are below their token length.
            unchecked:
                index += 1
        Ok(())

pub def engine(bounds: &Limits) -> Result[Engine, TemplateError]:
    if bounds.max_depth.get() > 64:
        __trap("std.template.engine: max_depth is above 64")
    saved = Limits(bounds.max_source, bounds.max_tokens, bounds.max_expression_nodes, bounds.max_templates, bounds.max_context_nodes, bounds.max_context_bytes, bounds.max_depth, bounds.max_steps, bounds.max_output)
    Ok(Engine(saved, allocated(list[Template]())?, 0, 0, 0))
