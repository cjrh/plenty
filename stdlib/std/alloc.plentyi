# Explicit retained allocators. Native storage and atomic retention require the
# runtime ABI; construction wrappers and policy-independent adapters use Plenty.
# Explicit allocator passing is modelled on Zig (https://ziglang.org/).
# No Zig code is included.
from std.bytes import Bytes, BytesError

@thread_shareable
opaque Handle

@copy
pub enum LayoutError:
    InvalidAlignment
    Allocation(AllocError)

@copy
pub class Layout:
    _size: i64
    _alignment: i64

    pub def size(self) -> i64:
        self._size

    pub def alignment(self) -> i64:
        self._alignment

pub def layout(size: i64, alignment: i64 = 8) -> Result[Layout, LayoutError]:
    if alignment <= 0:
        return Err(LayoutError.InvalidAlignment)
    # Positive alignment makes subtraction safe; the rounded extent must fit i64.
    unchecked:
        mask = alignment - 1
        if alignment & mask != 0:
            return Err(LayoutError.InvalidAlignment)
        if size < 0 or size > i64.MAX - mask:
            return Err(LayoutError.Allocation(AllocError.CapacityOverflow))
    Ok(Layout(size, alignment))

pub class ByteBlock:
    # Compiler-private inline ABI: backing, data, extent. Never exposed as bytes.
    _storage: array[u64, 3]

    def __del__(self: &mut ByteBlock) -> ():
        __allocator_block_release(&mut self._storage)

    pub def len(self) -> i64:
        __allocator_block_len(&self._storage)

    pub def is_empty(self) -> bool:
        self.len() == 0

    pub def alignment(self) -> i64:
        __allocator_block_alignment(&self._storage)

    pub def get(self, index: i64) -> u8:
        if index < 0 or index >= self.len():
            __trap("ByteBlock.get: index is outside 0..len()")
        __allocator_block_get(&self._storage, index)

    pub def set(self: &mut ByteBlock, index: i64, value: u8) -> ():
        if index < 0 or index >= self.len():
            __trap("ByteBlock.set: index is outside 0..len()")
        __allocator_block_set(&mut self._storage, index, value)

    pub def split_off(self: &mut ByteBlock, at: i64) -> ByteBlock:
        if at < 0 or at > self.len():
            __trap("ByteBlock.split_off: at is outside 0..len() inclusive")
        ByteBlock(__allocator_block_split(&mut self._storage, at))

pub enum BoxError[T]:
    Allocation(T, AllocError)

@copy
pub enum Unset:
    Unset

def _slice_bound(bound: i64 | Unset) -> Option[i64]:
    match bound:
        case index: i64:
            Some(index)
        case _:
            Nothing

pub class Allocator:
    _handle: Handle

    def __del__(self: &mut Allocator) -> ():
        __allocator_release(self._handle)

    pub def block(self, layout: &Layout) -> Result[ByteBlock, AllocError]:
        Ok(ByteBlock(__allocator_block(self._handle, layout.size(), layout.alignment())?))

    pub def share(self) -> Allocator:
        Allocator(__allocator_share(self._handle))

    pub def copy[T](self, value: &T) -> Result[T, AllocError]:
        __allocator_copy[T](self._handle, value)

    pub def box[T](self, value: T) -> Result[Box[T], BoxError[T]]:
        mut content = value
        match __allocator_box[T](self._handle, &mut content):
            case Ok(boxed):
                # Relocation succeeded: commit before any fallible or user code.
                __allocator_commit[T](content)
                Ok(boxed)
            case Err(error):
                Err(BoxError[T].Allocation(content, error))

    pub def list[T](self, source: Generator[T]) -> Result[list[T], AllocError]:
        mut output = self.empty_list[T]()?
        for value in source:
            output.append(value)?
        Ok(output)

    pub def slice[T](self, source: &list[T], start: i64 | Unset = Unset.Unset, stop: i64 | Unset = Unset.Unset, step: NonZero[i64] = 1) -> Result[list[T], AllocError]:
        __allocator_list_slice[T](self._handle, source, _slice_bound(start), _slice_bound(stop), step.get())

    pub def slice_clist[T](self, source: &clist[T], start: i64 | Unset = Unset.Unset, stop: i64 | Unset = Unset.Unset, step: NonZero[i64] = 1) -> Result[clist[T], AllocError]:
        __allocator_clist_slice[T](self._handle, source, _slice_bound(start), _slice_bound(stop), step.get())

    pub def slice_bytes(self, source: &[u8], start: i64 | Unset = Unset.Unset, stop: i64 | Unset = Unset.Unset, step: NonZero[i64] = 1) -> Result[Bytes, AllocError]:
        __allocator_bytes_slice(self._handle, source, _slice_bound(start), _slice_bound(stop), step.get())

    pub def lower_bytes(self, source: &[u8]) -> Result[Bytes, AllocError]:
        mut result = self.slice_bytes(source)?
        for at in range(len(source)):
            byte = source[at]
            if byte >= 65u8 and byte <= 90u8:
                unchecked:
                    result.set(at, byte + 32u8)
        Ok(result)

    pub def upper_bytes(self, source: &[u8]) -> Result[Bytes, AllocError]:
        mut result = self.slice_bytes(source)?
        for at in range(len(source)):
            byte = source[at]
            if byte >= 97u8 and byte <= 122u8:
                unchecked:
                    result.set(at, byte - 32u8)
        Ok(result)

    def _strip_bytes(self, source: &[u8], set: &[u8], left: bool, right: bool) -> Result[Bytes, AllocError]:
        mut start = 0
        mut stop = len(source)
        if left:
            while start < stop and source[start] in set:
                unchecked:
                    start += 1
        if right:
            while stop > start:
                last = unchecked:
                    stop - 1
                if source[last] not in set:
                    break
                stop = last
        self.slice_bytes(&source[start:stop])

    pub def strip_bytes(self, source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
        self._strip_bytes(source, set, True, True)

    pub def lstrip_bytes(self, source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
        self._strip_bytes(source, set, True, False)

    pub def rstrip_bytes(self, source: &[u8], set: &[u8] = b" \t\n\r\x0b\x0c") -> Result[Bytes, AllocError]:
        self._strip_bytes(source, set, False, True)

    pub def decode_text(self, source: &Bytes) -> Result[str, BytesError]:
        if source.utf8_run(0, source.len()) != source.len():
            return Err(BytesError.InvalidUtf8)
        __allocator_text_finish(self._handle, &source[:]).map_error(BytesError.Allocation)

    pub def join_text_stream(self, separator: &strview, source: Generator[str]) -> Result[str, AllocError]:
        mut scratch = self.slice_bytes(b"")?
        mut first = True
        for piece in source:
            if not first:
                scratch.extend(separator.as_bytes())?
            scratch.extend(piece.as_bytes())?
            drop(piece)
            first = False
        __allocator_text_finish(self._handle, &scratch[:])

    pub def join_text(self, separator: &strview, parts: &[str]) -> Result[str, AllocError]:
        __allocator_text_join(self._handle, separator, parts)

    pub def removeprefix_text(self, source: &strview, prefix: &strview) -> Result[str, AllocError]:
        if source.startswith(prefix):
            return self.slice_text(source, start=len(prefix))
        self.slice_text(source)

    pub def removesuffix_text(self, source: &strview, suffix: &strview) -> Result[str, AllocError]:
        if suffix.byte_len() != 0 and source.endswith(suffix):
            # A matching nonempty suffix has a positive, representable scalar count.
            stop = unchecked:
                -len(suffix)
            return self.slice_text(source, stop=stop)
        self.slice_text(source)

    def _split_text_whitespace(self, source: &strview) -> Result[list[str], AllocError]:
        __allocator_text_split_whitespace(self._handle, source)

    pub def split_text(self, source: &strview, separator: &strview) -> Result[list[str], AllocError]:
        if separator.byte_len() == 0:
            __trap("string split requires a nonempty separator")
        __allocator_text_split(self._handle, source, separator)

    pub def splitlines_text(self, source: &strview, keepends: bool = False) -> Result[list[str], AllocError]:
        __allocator_text_splitlines(self._handle, source, keepends)

    pub def quote_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_quote(self._handle, source)

    pub def lower_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_case(self._handle, source, False)

    pub def upper_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_case(self._handle, source, True)

    pub def strip_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_strip(self._handle, source, 3)

    pub def lstrip_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_strip(self._handle, source, 1)

    pub def rstrip_text(self, source: &strview) -> Result[str, AllocError]:
        __allocator_text_strip(self._handle, source, 2)

    pub def replace_text(self, source: &strview, old: &strview, new: &strview) -> Result[str, AllocError]:
        __allocator_text_replace(self._handle, source, old, new)

    pub def repeat_text(self, source: &strview, count: i64) -> Result[str, AllocError]:
        __allocator_text_repeat(self._handle, source, count)

    pub def concat_text(self, left: &strview, right: &strview) -> Result[str, AllocError]:
        __allocator_text_concat(self._handle, left, right)

    pub def slice_text(self, source: &strview, start: i64 | Unset = Unset.Unset, stop: i64 | Unset = Unset.Unset, step: NonZero[i64] = 1) -> Result[str, AllocError]:
        __allocator_text_slice(self._handle, source, _slice_bound(start), _slice_bound(stop), step.get())

    pub def copy_view[T](self, source: &[T]) -> Result[list[T], AllocError]:
        mut output = self.list_with_capacity[T](len(source))?
        for element in source:
            output.append(self.copy(element)?)?
        Ok(output)

    pub def share_view[T](self, source: &[Shared[T]]) -> Result[list[Shared[T]], AllocError]:
        mut output = self.list_with_capacity[Shared[T]](len(source))?
        for handle in source:
            output.append(handle.share())?
        Ok(output)

    pub def empty_list[T](self) -> Result[list[T], AllocError]:
        __allocator_list[T](self._handle, 0)

    pub def list_with_capacity[T](self, capacity: i64) -> Result[list[T], AllocError]:
        __allocator_list[T](self._handle, capacity)

    pub def empty_dict[K: KeyType, V](self) -> Result[dict[K, V], AllocError]:
        __allocator_dict_set[dict[K, V]](self._handle, 0)

    pub def dict_with_capacity[K: KeyType, V](self, capacity: i64) -> Result[dict[K, V], AllocError]:
        __allocator_dict_set[dict[K, V]](self._handle, capacity)

    pub def empty_set[T: KeyType](self) -> Result[set[T], AllocError]:
        __allocator_dict_set[set[T]](self._handle, 0)

    pub def set_with_capacity[T: KeyType](self, capacity: i64) -> Result[set[T], AllocError]:
        __allocator_dict_set[set[T]](self._handle, capacity)

    pub def to_set[K: KeyType](self, view: KeyView[K]) -> Result[set[K], AllocError]:
        __allocator_key_view_to_set[set[K]](self._handle, view)

    pub def union[K: KeyType](self, left: &set[K], right: &set[K]) -> Result[set[K], AllocError]:
        __allocator_set_union[set[K]](self._handle, left, right)

    pub def intersection[K: KeyType](self, left: &set[K], right: &set[K]) -> Result[set[K], AllocError]:
        __allocator_set_intersection[set[K]](self._handle, left, right)

    pub def difference[K: KeyType](self, left: &set[K], right: &set[K]) -> Result[set[K], AllocError]:
        __allocator_set_difference[set[K]](self._handle, left, right)

    pub def symmetric_difference[K: KeyType](self, left: &set[K], right: &set[K]) -> Result[set[K], AllocError]:
        __allocator_set_symmetric_difference[set[K]](self._handle, left, right)

pub def system() -> Allocator:
    Allocator(__allocator_system())


pub protocol Provider:
    def allocate(self: &mut Provider, request: &Layout) -> Result[ByteBlock, AllocError]:
        pass
    def release(self: &mut Provider, storage: ByteBlock) -> ():
        pass

pub enum RegistrationError[P]:
    Allocation(P, AllocError)
    UnsupportedContext(P)

# Scalar statuses are private ABI constants, mirrored by allocator/compiled.rs.
const _PROVIDER_OK: i64 = 0
const _PROVIDER_OUT_OF_MEMORY: i64 = 1
const _PROVIDER_CAPACITY_OVERFLOW: i64 = 2
const _REGISTRATION_OUT_OF_MEMORY: i64 = 0
const _REGISTRATION_CAPACITY_OVERFLOW: i64 = 1
const _REGISTRATION_UNSUPPORTED_CONTEXT: i64 = 2

def _provider_allocate[P: Provider](state: &mut P, size: i64, alignment: i64) -> (i64, array[u64, 3]):
    request = layout(size, alignment).unwrap()
    match state.allocate(&request):
        case Ok(storage):
            (_PROVIDER_OK, __allocator_block_take(storage))
        case Err(AllocError.OutOfMemory):
            (_PROVIDER_OUT_OF_MEMORY, array[u64, 3].filled(0u64))
        case Err(AllocError.CapacityOverflow):
            (_PROVIDER_CAPACITY_OVERFLOW, array[u64, 3].filled(0u64))

def _provider_release[P: Provider](state: &mut P, storage: array[u64, 3]) -> ():
    state.release(ByteBlock(storage))

pub def allocator[P: Provider](bootstrap: &Allocator, provider: P) -> Result[Allocator, RegistrationError[P]]:
    mut state = provider
    match __allocator_register[P](bootstrap._handle, &mut state):
        case Ok(handle):
            # No code that can fail or call user code may precede this commit.
            __allocator_commit[P](state)
            Ok(Allocator(handle))
        case Err(status):
            if status == _REGISTRATION_OUT_OF_MEMORY:
                return Err(RegistrationError[P].Allocation(state, AllocError.OutOfMemory))
            if status == _REGISTRATION_CAPACITY_OVERFLOW:
                return Err(RegistrationError[P].Allocation(state, AllocError.CapacityOverflow))
            if status == _REGISTRATION_UNSUPPORTED_CONTEXT:
                return Err(RegistrationError[P].UnsupportedContext(state))
            __trap("invalid allocator registration status")
