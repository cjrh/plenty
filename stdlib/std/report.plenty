from std.fmt import Formatter, FormatError, Formattable, string_formatter, finish

pub def render[T: Formattable, W](value: &T, output: &mut Formatter[W]) -> Result[(), FormatError]:
    output.enter()?
    result = value.format(output)
    output.leave()
    result

pub def to_string[T: Formattable](value: &T, max_bytes: i64, max_depth: i64) -> Result[str, FormatError]:
    mut output = string_formatter(max_bytes, max_depth)?
    render(value, &mut output)?
    finish(&output)
