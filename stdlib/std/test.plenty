# Assertions and fixtures for the tests that `plenty test` runs. A failed
# assertion writes its explanation to standard error at once and returns
# Err(TestError.Assertion), so the explanation survives `?` erasing the error
# into Failure. See book/src/design/stdlib/test.md.
import std.bytes
import std.env
import std.fs
import std.random
from std.bytes import Bytes, BytesError
from std.fs import FsError, Root, TempDir
from std.io import StreamError
from std.path import Path, from_text
from std.random import Rng
from std.sync import CancellationToken
from std.time import Duration, Instant, instant_at

pub enum TestError:
    # The explanation is already on standard error.
    Assertion
    Fixture(FsError)
    Allocation(AllocError)
    # PLENTY_TEST_SEED is set but is not a decimal u64.
    InvalidSeed

# Removal budgets for a scratch directory: beyond them cleanup reports
# FsError.Limit and leaves the remaining entries in place.
const max_scratch_entries: i64 = 100000
const max_scratch_depth: i64 = 64

# Standard error is the report channel; a write that fails cannot be reported
# anywhere, so it is dropped. Several small writes need no allocation.
def say(text: &str) -> ():
    drop(write_stderr(text))

def heading(what: &str) -> ():
    drop(flush_stdout())
    say("assertion failed: ")
    say(what)
    say("\n")

def shown[T](label: &str, value: &T) -> ():
    say(label)
    match str.repr(value):
        case Ok(text):
            say(&text)
        case Err(_):
            say("<no memory to show the value>")
    say("\n")

def failed() -> Result[(), TestError]:
    Err(TestError.Assertion)

pub def fail(message: &str) -> Result[(), TestError]:
    heading(message)
    failed()

pub def check(condition: bool, message: &str) -> Result[(), TestError]:
    if condition:
        return Ok(())
    fail(message)

pub def equal[T](left: &T, right: &T) -> Result[(), TestError]:
    if left == right:
        return Ok(())
    heading("left == right")
    shown("  left: ", left)
    shown(" right: ", right)
    failed()

pub def not_equal[T](left: &T, right: &T) -> Result[(), TestError]:
    if left != right:
        return Ok(())
    heading("left != right")
    shown("  both: ", left)
    failed()

pub def less[T](left: &T, right: &T) -> Result[(), TestError]:
    if left < right:
        return Ok(())
    heading("left < right")
    shown("  left: ", left)
    shown(" right: ", right)
    failed()

# NaN is never close to anything, so a NaN on either side fails.
pub def close(left: f64, right: f64, tolerance: f64) -> Result[(), TestError]:
    difference = left - right
    if difference <= tolerance and difference >= -tolerance:
        return Ok(())
    heading("|left - right| <= tolerance")
    shown("      left: ", &left)
    shown("     right: ", &right)
    shown(" tolerance: ", &tolerance)
    failed()

pub def is_ok[T, E](result: &Result[T, E]) -> Result[(), TestError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(error):
            heading("result is Ok")
            shown("  error: ", error)
            failed()

pub def is_err[T, E](result: &Result[T, E]) -> Result[(), TestError]:
    match result:
        case Ok(value):
            heading("result is Err")
            shown("  value: ", value)
            failed()
        case Err(_):
            Ok(())

def fixture[T](result: Result[T, FsError]) -> Result[T, TestError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(TestError.Fixture(error))

def fixture_io[T](result: Result[T, IoError]) -> Result[T, TestError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(TestError.Fixture(FsError.Io(error)))

def allocated[T](result: Result[T, AllocError]) -> Result[T, TestError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(TestError.Allocation(error))

# A directory that exists for one test. Destruction removes it and everything
# in it, dropping any error; call cleanup to observe one.
pub class Scratch:
    _parent: Root
    _directory: TempDir
    _path: Path
    _active: bool

    # Absolute, for operations that take a path.
    pub def path(self) -> &Path:
        &self._path

    # Anchors operations to the directory itself; see std.fs.Root.
    pub def root(self) -> &Root:
        self._directory.root()

    # The absolute path text of `name` inside the directory, for builtins such
    # as write_text and open that take a str.
    pub def file(self, name: &str) -> Result[str, TestError]:
        leaf = fixture_io(from_text(name))?
        joined = fixture_io(self._path.join(&leaf))?
        fixture_io(joined.to_text())

    pub def cleanup(self: &mut Scratch) -> Result[(), TestError]:
        if not self._active:
            return Ok(())
        token = allocated(CancellationToken())?
        fixture(std.fs.remove_tree(&self._parent, self._directory.name(), max_scratch_entries, max_scratch_depth, &token))?
        self._directory.keep()
        self._active = False
        Ok(())

    def __del__(self) -> ():
        drop(self.cleanup())

# TMPDIR when it is set to an absolute path, otherwise /tmp.
def temporary_base() -> Result[Path, TestError]:
    match fixture_io(std.env.get("TMPDIR"))?:
        case Some(text):
            path = fixture_io(from_text(&text))?
            if path.is_absolute():
                return Ok(path)
        case Nothing:
            pass
    fixture_io(from_text("/tmp"))

# Creates an empty directory with an unpredictable `plenty-test-` name.
pub def scratch() -> Result[Scratch, TestError]:
    base = temporary_base()?
    parent = fixture_io(std.fs.root(&base))?
    prefix = fixture_io(from_text("plenty-test-"))?
    directory = fixture(std.fs.temporary_dir(&parent, &prefix, 16))?
    path = fixture_io(base.join(directory.name()))?
    Ok(Scratch(parent, directory, path, True))

# The seed `plenty test --seed N` passes in PLENTY_TEST_SEED; 0 without it.
pub def seed() -> Result[u64, TestError]:
    match fixture_io(std.env.get("PLENTY_TEST_SEED"))?:
        case Some(text):
            match u64.parse(text):
                case Ok(value):
                    Ok(value)
                case Err(_):
                    drop(flush_stdout())
                    say("PLENTY_TEST_SEED is not a decimal u64\n")
                    Err(TestError.InvalidSeed)
        case Nothing:
            Ok(0u64)

# A generator seeded from seed(), so a run repeats exactly under one seed.
pub def rng() -> Result[Rng, TestError]:
    Ok(std.random.seeded(seed()?))

# A std.time.Clock that moves only when told to.
pub class FakeClock:
    _at: u64

    pub def now(self) -> Instant:
        instant_at(self._at)

    pub def advance(self: &mut FakeClock, span: &Duration) -> Result[(), RangeError]:
        later = instant_at(self._at).checked_add(span)?
        self._at = later.duration_since(&instant_at(0u64))?.as_nanoseconds()
        Ok(())

    pub def set(self: &mut FakeClock, nanoseconds_after_origin: u64) -> ():
        self._at = nanoseconds_after_origin

pub def fake_clock(nanoseconds_after_origin: u64) -> FakeClock:
    FakeClock(nanoseconds_after_origin)

# A std.io Reader and Writer over memory that can be told to move fewer bytes
# per call or to fail one call, for exercising retry and partial-progress code.
pub class FakeStream:
    # What reads return, from the start.
    pub input: Bytes
    # Every byte that writes accepted, in order.
    pub output: Bytes
    _read: i64
    _limit: i64
    _calls: i64
    _fault_at: i64
    _fault: Option[StreamError]

    # read, write and flush calls made so far, including failed ones.
    pub def calls(self) -> i64:
        self._calls

    # Each later call moves at most `bytes` bytes; 0 or less removes the limit.
    pub def limit(self: &mut FakeStream, bytes: i64) -> ():
        self._limit = bytes

    # The call `after` calls from now fails with `error` and moves nothing;
    # 0 fails the next call. One failure is pending at a time; a later
    # request replaces it.
    pub def fail_after(self: &mut FakeStream, after: i64, error: StreamError) -> ():
        self._fault_at = self._calls + after
        drop(replace(self._fault, Some(error)))

    def begin(self: &mut FakeStream) -> Result[(), StreamError]:
        call = self._calls
        self._calls += 1
        if call != self._fault_at:
            return Ok(())
        self._fault_at = -1
        match replace(self._fault, Nothing):
            case Some(error):
                Err(error)
            case Nothing:
                Ok(())

    def allowed(self, offered: i64) -> i64:
        if self._limit > 0 and offered > self._limit:
            return self._limit
        offered

    pub def read(self: &mut FakeStream, buffer: &mut Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        span(start, stop, buffer.len())?
        self.begin()?
        mut count = self.allowed(stop - start)
        left = self.input.len() - self._read
        if count > left:
            count = left
        if count <= 0:
            return Ok(0)
        stream_bytes(buffer.overwrite(start, &self.input, self._read, self._read + count))?
        self._read += count
        Ok(count)

    pub def write(self: &mut FakeStream, source: &Bytes, start: i64, stop: i64) -> Result[i64, StreamError]:
        span(start, stop, source.len())?
        self.begin()?
        count = self.allowed(stop - start)
        stream_bytes(self.output.extend_range(source, start, start + count))?
        Ok(count)

    pub def flush(self: &mut FakeStream) -> Result[(), StreamError]:
        self.begin()

def span(start: i64, stop: i64, size: i64) -> Result[(), StreamError]:
    if start < 0 or start > stop or stop > size:
        return Err(StreamError.OutOfRange)
    Ok(())

def stream_bytes(result: Result[(), BytesError]) -> Result[(), StreamError]:
    match result:
        case Ok(_):
            Ok(())
        case Err(BytesError.Allocation(cause)):
            Err(StreamError.Allocation(cause))
        case Err(_):
            Err(StreamError.OutOfRange)

# Reads return `input`; nothing is limited or failing until asked.
pub def fake_stream(input: Bytes) -> Result[FakeStream, BytesError]:
    Ok(FakeStream(input, std.bytes.empty()?, 0, 0, 0, -1, Nothing))
