# TOML 1.0 documents: a strict parser, a value-tree writer, and a source editor
# that preserves untouched statement bytes, with checked typed codecs.
# Everything is Plenty over `std.bytes`; `Limits` and `TreeLimits` bound work.
# See book/src/design/stdlib/toml.md.
import std.bytes
import std.io
import std.serial
from std.bytes import Bytes, BytesError
from std.io import Reader, Writer, StreamError

pub enum TomlFault:
    UnexpectedByte
    UnexpectedEnd
    InvalidUtf8
    ControlCharacter
    InvalidEscape
    InvalidNumber
    NumberOutOfRange
    InvalidDateTime
    DuplicateKey
    DuplicateTable
    KeyConflict
    DepthExceeded
    InputTooLarge
    OutputTooLarge
    NotATable
    InvalidState
    Serialization(std.serial.Fault)
    Stream(StreamError)
    Allocation(AllocError)

# Parser errors locate the offending input byte: `offset` counts bytes from
# zero, `line` and `column` count from one, and a column is one Unicode scalar.
# Writer and stream errors carry a byte count and zero for both.
pub class TomlError:
    pub fault: TomlFault
    pub offset: i64
    pub line: i64
    pub column: i64

pub class Limits:
    pub max_depth: NonNegative[i64] __max(1024)
    pub max_input: NonNegative[i64]
    pub max_output: NonNegative[i64]

pub enum DateTimeKind:
    OffsetDateTime
    LocalDateTime
    LocalDate
    LocalTime

# Fields a kind does not use are zero. `offset_minutes` is east of UTC.
pub class DateTime:
    pub kind: DateTimeKind
    pub year: i64
    pub month: i64
    pub day: i64
    pub hour: i64
    pub minute: i64
    pub second: i64
    pub nanosecond: i64
    pub offset_minutes: i64

pub enum Toml:
    Bool(bool)
    Int(i64)
    Float(f64)
    Text(str)
    DateTime(DateTime)
    Array(list[Toml])
    Table(list[Entry])

# Entries keep their source order.
pub class Entry:
    pub key: str
    pub value: Toml

# Writer recursion over a tree is bounded by the depth limit, so the limit
# itself is capped to keep that recursion within the native stack; a larger
# `max_depth` traps.
const depth_ceiling: i64 = 1024
const read_chunk: i64 = 4096

const kind_value: i64 = 0
const kind_table: i64 = 1
const kind_array: i64 = 2
const kind_tables: i64 = 3

# How a table came to exist, which decides what may later extend it.
const origin_none: i64 = 0
const origin_implicit: i64 = 1
const origin_header: i64 = 2
const origin_dotted: i64 = 3
const origin_inline: i64 = 4

# 64 MiB of input and of output.
pub def limits() -> Limits:
    Limits(64, 67108864, 67108864)

def check_depth(bounds: &Limits) -> ():
    if bounds.max_depth.get() > depth_ceiling:
        __trap("std.toml: max_depth is above 1024")

def faulted[T](result: Result[T, BytesError]) -> Result[T, TomlFault]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            match error:
                case BytesError.Allocation(cause):
                    Err(TomlFault.Allocation(cause))
                case BytesError.InvalidUtf8:
                    Err(TomlFault.InvalidUtf8)

def reserved[T](result: Result[T, AllocError]) -> Result[T, TomlFault]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(cause):
            Err(TomlFault.Allocation(cause))

def unplaced[T](result: Result[T, TomlFault]) -> Result[T, TomlError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(fault):
            Err(TomlError(fault, 0, 0, 0))

# A fault before scanning starts, such as an allocation failure while setting
# up, points at the start of the document.
def started[T](result: Result[T, TomlFault]) -> Result[T, TomlError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(fault):
            Err(TomlError(fault, 0, 1, 1))

def push_byte(target: &mut Bytes, value: i64) -> Result[(), TomlFault]:
    reserved(target.push(u8(value)))

# `code` is a Unicode scalar value; the caller has excluded surrogates.
def push_scalar(target: &mut Bytes, code: i64) -> Result[(), TomlFault]:
    if code < 128:
        return push_byte(target, code)
    if code < 2048:
        push_byte(target, 192 | (code >> 6))?
        return push_byte(target, 128 | (code & 63))
    if code < 65536:
        push_byte(target, 224 | (code >> 12))?
        push_byte(target, 128 | ((code >> 6) & 63))?
        return push_byte(target, 128 | (code & 63))
    push_byte(target, 240 | (code >> 18))?
    push_byte(target, 128 | ((code >> 12) & 63))?
    push_byte(target, 128 | ((code >> 6) & 63))?
    push_byte(target, 128 | (code & 63))

def push_range(target: &mut Bytes, low: i64, high: i64) -> Result[(), TomlFault]:
    for value in range(low, high):
        push_byte(target, value)?
    Ok(())

# Bytes allowed in a bare key: ASCII letters, digits, `_`, and `-`.
def bare_bytes() -> Result[Bytes, TomlFault]:
    mut set = reserved(std.bytes.with_capacity(64))?
    push_range(&mut set, 48, 58)?
    push_range(&mut set, 65, 91)?
    push_range(&mut set, 97, 123)?
    push_byte(&mut set, 95)?
    push_byte(&mut set, 45)?
    Ok(set)

# Control characters other than tab, which no string or comment may hold
# unescaped, plus `extra` when it is not negative.
def control_bytes(extra: i64, other: i64) -> Result[Bytes, TomlFault]:
    mut set = reserved(std.bytes.with_capacity(36))?
    push_range(&mut set, 0, 9)?
    push_range(&mut set, 10, 32)?
    push_byte(&mut set, 127)?
    if extra >= 0:
        push_byte(&mut set, extra)?
    if other >= 0:
        push_byte(&mut set, other)?
    Ok(set)

# Bytes that may continue a number, `inf`, or `nan` token.
def numeric_bytes() -> Result[Bytes, TomlFault]:
    mut set = bare_bytes()?
    push_byte(&mut set, 43)?
    push_byte(&mut set, 46)?
    Ok(set)

# The first index in [start, stop) that `found` located, or `stop`.
def run_end(found: Option[i64], stop: i64) -> i64:
    match found:
        case Some(index):
            index
        case Nothing:
            stop

def hex_value(code: i64) -> i64:
    # Every subtraction is guarded by its ASCII hex digit range.
    unchecked:
        if code >= 48 and code <= 57:
            return code - 48
        if code >= 97 and code <= 102:
            return code - 87
        if code >= 65 and code <= 70:
            return code - 55
        -1

def leap(year: i64) -> bool:
    # All divisors are positive constants; remainder has no overflow case.
    unchecked:
        (year % 4 == 0 and year % 100 != 0) or year % 400 == 0

def days_in(year: i64, month: i64) -> i64:
    if month == 2:
        if leap(year):
            return 29
        return 28
    if month == 4 or month == 6 or month == 9 or month == 11:
        return 30
    31

def valid_date(year: i64, month: i64, day: i64) -> bool:
    year >= 0 and year <= 9999 and month >= 1 and month <= 12 and day >= 1 and day <= days_in(year, month)

# RFC 3339 permits a leap second, so `second` may be 60.
def valid_time(hour: i64, minute: i64, second: i64, nanosecond: i64) -> bool:
    hour >= 0 and hour <= 23 and minute >= 0 and minute <= 59 and second >= 0 and second <= 60 and nanosecond >= 0 and nanosecond <= 999999999

# A lookahead beyond representable offsets is also beyond the held input.
def lookahead_offset(at: i64, ahead: i64) -> i64:
    offset = checked:
        at + ahead
    match offset:
        case Ok(value):
            value
        case Err(_):
            -1

# One-based coordinates need a representation check separate from input size.
def located_position(fault: TomlFault, offset: i64, breaks: i64, scalars: i64) -> TomlError:
    position = checked:
        (breaks + 1, scalars + 1)
    match position:
        case Ok(pair):
            line, column = pair
            TomlError(fault, offset, line, column)
        case Err(_):
            TomlError(TomlFault.InputTooLarge, offset, 0, 0)

# The parser owns `have` bytes within its input budget. One extra byte detects
# oversize input, but its allocation extent must fit before resize or read.
def read_extent(have: i64, max_input: i64) -> Result[(i64, i64), TomlFault]:
    remaining = unchecked:
        max_input - have
    room = unchecked:
        remaining + 1 if remaining < read_chunk else read_chunk
    extent = checked:
        have + room
    match extent:
        case Ok(stop):
            Ok((room, stop))
        case Err(_):
            Err(TomlFault.Allocation(AllocError.CapacityOverflow))

# One key, table, or value. Children are node indices in source order; array
# elements have no name and are not in the name index.
class Node:
    kind: i64
    origin: i64
    level: i64
    key: str
    value: Toml
    children: list[i64]
    parent: i64

class Statement:
    node: i64
    start: i64
    stop: i64
    value_start: i64
    value_stop: i64
    header: bool

# Parses a whole document held in `src` into an arena of nodes, then assembles
# the tree. Named children are found through `index`, so a lookup costs the
# same however many keys a table has. Only `at` moves; a fault leaves it at the
# offending byte, or at the start of the key, header, or value it concerns.
class Parser:
    src: Bytes
    at: i64
    nodes: list[Node]
    index: dict[(i64, str), i64]
    table: i64
    max_depth: i64
    scratch: Bytes
    bare: Bytes
    basic_stop: Bytes
    literal_stop: Bytes
    comment_stop: Bytes
    numeric: Bytes
    tracking: bool
    statements: list[Statement]
    value_start: i64

    def byte_at(self, where: i64) -> i64:
        if where >= 0 and where < self.src.len():
            return i64(self.src.get(where))
        -1

    def peek(self, ahead: i64) -> i64:
        self.byte_at(lookahead_offset(self.at, ahead))

    def is_digit(self, ahead: i64) -> bool:
        byte = self.peek(ahead)
        byte >= 48 and byte <= 57

    # 1 for a line feed, 2 for a carriage return and line feed, else 0.
    def newline(self) -> i64:
        byte = self.peek(0)
        if byte == 10:
            return 1
        if byte == 13 and self.peek(1) == 10:
            return 2
        0

    def unexpected(self) -> TomlFault:
        if self.peek(0) < 0:
            return TomlFault.UnexpectedEnd
        TomlFault.UnexpectedByte

    def located(self, fault: TomlFault) -> TomlError:
        breaks = self.src.count(10u8, 0, self.at)
        mut scalars = 0
        # 0 <= at <= src.len(); index decrements only as far as -1, and the
        # zero-based scalar count cannot exceed at. Add the one-based bias later.
        unchecked:
            mut index = self.at - 1
            while index >= 0:
                byte = self.byte_at(index)
                if byte == 10:
                    break
                if byte & 192 != 128:
                    scalars += 1
                index -= 1
        located_position(fault, self.at, breaks, scalars)

    def add(self: &mut Parser, parent: i64, key: str, kind: i64, origin: i64, named: bool) -> Result[i64, TomlFault]:
        # Node levels are 0..max_depth <= 1024. Increment at most to 1025.
        unchecked:
            mut level = self.nodes[parent].level
            if kind != kind_value:
                level += 1
                if level > self.max_depth:
                    return Err(TomlFault.DepthExceeded)
            child = len(self.nodes)
            children = reserved(list[i64]())?
            reserved(self.nodes.append(Node(kind, origin, level, key, Toml.Bool(False), children, parent)))?
            reserved(self.nodes[parent].children.append(child))?
            if named:
                reserved(self.index.insert((parent, key), child))?
            Ok(child)

    def blank(self: &mut Parser) -> ():
        # Each increment consumes a whitespace byte observed within src.
        unchecked:
            while True:
                byte = self.peek(0)
                if byte == 32 or byte == 9:
                    self.at += 1
                else:
                    return

    def comment(self: &mut Parser) -> Result[(), TomlFault]:
        # Called only after observing #, hence at < src.len().
        unchecked:
            self.at += 1
            stop = self.src.len()
            self.at = run_end(self.src.find_in(&self.comment_stop, self.at, stop), stop)
            if self.peek(0) < 0 or self.newline() > 0:
                return Ok(())
            Err(TomlFault.ControlCharacter)

    # Whitespace, an optional comment, then a newline or the end of input.
    def end_line(self: &mut Parser) -> Result[(), TomlFault]:
        # newline() reports only bytes present in src; at + count <= src.len().
        unchecked:
            self.blank()
            if self.peek(0) == 35:
                self.comment()?
            if self.peek(0) < 0:
                return Ok(())
            count = self.newline()
            if count == 0:
                return Err(TomlFault.UnexpectedByte)
            self.at += count
            Ok(())

    # Whitespace, comments, and newlines between array elements.
    def array_space(self: &mut Parser) -> Result[(), TomlFault]:
        # newline() reports only bytes present in src; at + count <= src.len().
        unchecked:
            while True:
                self.blank()
                if self.peek(0) == 35:
                    self.comment()?
                count = self.newline()
                if count == 0:
                    return Ok(())
                self.at += count
            Ok(())

    def document(self: &mut Parser) -> Result[(), TomlFault]:
        while True:
            start = self.at
            self.blank()
            byte = self.peek(0)
            if byte < 0:
                return Ok(())
            mut node = -1
            header = byte == 91
            if header:
                self.header()?
                node = self.table
            elif byte != 35 and byte != 10 and byte != 13:
                node = self.entry(self.table)?
            value_start = self.value_start
            value_stop = self.at
            self.end_line()?
            if self.tracking and node >= 0:
                reserved(self.statements.append(Statement(node, start, self.at, value_start, value_stop, header)))?
        Ok(())

    def key_part(self: &mut Parser) -> Result[str, TomlFault]:
        byte = self.peek(0)
        if byte == 34 or byte == 39:
            return self.quoted(byte, False)
        stop = self.src.len()
        end = run_end(self.src.find_not_in(&self.bare, self.at, stop), stop)
        if end == self.at:
            return Err(self.unexpected())
        self.scratch.clear()
        reserved(self.scratch.extend(&self.src[self.at:end]))?
        self.at = end
        faulted(self.scratch.to_text())

    def key_path(self: &mut Parser) -> Result[list[str], TomlFault]:
        # Each increment follows an observed dot, so at + 1 <= src.len().
        unchecked:
            mut parts = reserved(list[str]())?
            while True:
                self.blank()
                part = self.key_part()?
                reserved(parts.append(part))?
                self.blank()
                if self.peek(0) != 46:
                    break
                self.at += 1
            Ok(parts)

    # `[a.b]` or `[[a.b]]`. Intermediate names may be new, implicit, header,
    # or dotted tables; an array of tables continues through its last table.
    def header(self: &mut Parser) -> Result[(), TomlFault]:
        # Advances consume observed brackets. key_path returns at least one
        # component; an array-of-tables node always has a successfully added child.
        # Thus both last-index subtractions use positive allocated lengths.
        start = self.at
        unchecked:
            self.at += 1
        array = self.peek(0) == 91
        if array:
            unchecked:
                self.at += 1
        parts = self.key_path()?
        if self.peek(0) != 93:
            return Err(self.unexpected())
        unchecked:
            self.at += 1
        if array:
            if self.peek(0) != 93:
                return Err(self.unexpected())
            unchecked:
                self.at += 1
        end = self.at
        self.at = start
        mut parent = 0
        last = unchecked:
            len(parts) - 1
        for position in range(last):
            part = parts[position]
            match self.index.get((parent, part)):
                case Some(found):
                    kind = self.nodes[found].kind
                    if kind == kind_tables:
                        count = len(self.nodes[found].children)
                        parent = unchecked:
                            self.nodes[found].children[count - 1]
                    elif kind == kind_table and self.nodes[found].origin != origin_inline:
                        parent = found
                    else:
                        return Err(TomlFault.KeyConflict)
                case Nothing:
                    parent = self.add(parent, part, kind_table, origin_implicit, True)?
        name = parts[last]
        match self.index.get((parent, name)):
            case Some(found):
                kind = self.nodes[found].kind
                origin = self.nodes[found].origin
                if array:
                    if kind != kind_tables:
                        return Err(TomlFault.KeyConflict)
                    self.table = self.add(found, "", kind_table, origin_header, False)?
                elif kind == kind_table and origin == origin_implicit:
                    self.nodes[found].origin = origin_header
                    self.table = found
                elif kind == kind_table:
                    return Err(TomlFault.DuplicateTable)
                else:
                    return Err(TomlFault.KeyConflict)
            case Nothing:
                if array:
                    tables = self.add(parent, name, kind_tables, origin_none, True)?
                    self.table = self.add(tables, "", kind_table, origin_header, False)?
                else:
                    self.table = self.add(parent, name, kind_table, origin_header, True)?
        self.at = end
        Ok(())

    # `key = value` within `table`. Dotted keys create or continue tables
    # that other dotted keys made; they never reopen a header or inline table.
    def entry(self: &mut Parser, table: i64) -> Result[i64, TomlFault]:
        # The observed = bounds the cursor increment. key_path is nonempty,
        # so its final component index is nonnegative and representable.
        start = self.at
        parts = self.key_path()?
        if self.peek(0) != 61:
            return Err(self.unexpected())
        unchecked:
            self.at += 1
        self.blank()
        value_at = self.at
        self.at = start
        mut parent = table
        last = unchecked:
            len(parts) - 1
        for position in range(last):
            part = parts[position]
            match self.index.get((parent, part)):
                case Some(found):
                    origin = self.nodes[found].origin
                    if self.nodes[found].kind != kind_table or origin == origin_header or origin == origin_inline:
                        return Err(TomlFault.KeyConflict)
                    self.nodes[found].origin = origin_dotted
                    parent = found
                case Nothing:
                    parent = self.add(parent, part, kind_table, origin_dotted, True)?
        name = parts[last]
        match self.index.get((parent, name)):
            case Some(_):
                return Err(TomlFault.DuplicateKey)
            case Nothing:
                pass
        self.at = value_at
        node = len(self.nodes)
        self.value(parent, name, True)?
        self.value_start = value_at
        Ok(node)

    def value(self: &mut Parser, parent: i64, name: str, named: bool) -> Result[(), TomlFault]:
        byte = self.peek(0)
        if byte == 91:
            return self.array(parent, name, named)
        if byte == 123:
            return self.inline_table(parent, name, named)
        scalar = self.scalar()?
        child = self.add(parent, name, kind_value, origin_none, named)?
        self.nodes[child].value = scalar
        Ok(())

    def array(self: &mut Parser, parent: i64, name: str, named: bool) -> Result[(), TomlFault]:
        # Opening/closing brackets and commas are observed before advancing;
        # every cursor sum is at most src.len().
        node = self.add(parent, name, kind_array, origin_none, named)?
        unchecked:
            self.at += 1
        while True:
            self.array_space()?
            if self.peek(0) == 93:
                unchecked:
                    self.at += 1
                return Ok(())
            self.value(node, "", False)?
            self.array_space()?
            byte = self.peek(0)
            if byte == 44:
                unchecked:
                    self.at += 1
            elif byte == 93:
                unchecked:
                    self.at += 1
                return Ok(())
            else:
                return Err(self.unexpected())
        Ok(())

    # One line, no trailing comma, and closed to later extension.
    def inline_table(self: &mut Parser, parent: i64, name: str, named: bool) -> Result[(), TomlFault]:
        # Opening/closing braces and commas are observed before advancing;
        # every cursor sum is at most src.len().
        node = self.add(parent, name, kind_table, origin_inline, named)?
        unchecked:
            self.at += 1
        self.blank()
        if self.peek(0) == 125:
            unchecked:
                self.at += 1
            return Ok(())
        while True:
            drop(self.entry(node)?)
            self.blank()
            byte = self.peek(0)
            if byte == 44:
                unchecked:
                    self.at += 1
            elif byte == 125:
                unchecked:
                    self.at += 1
                return Ok(())
            else:
                return Err(self.unexpected())
        Ok(())

    def scalar(self: &mut Parser) -> Result[Toml, TomlFault]:
        byte = self.peek(0)
        if byte == 34 or byte == 39:
            multi = self.peek(1) == byte and self.peek(2) == byte
            return Ok(Toml.Text(self.quoted(byte, multi)?))
        if byte == 116:
            return self.word("true", True)
        if byte == 102:
            return self.word("false", False)
        if self.is_digit(0):
            if (self.is_digit(1) and self.is_digit(2) and self.is_digit(3) and self.peek(4) == 45) or (self.is_digit(1) and self.peek(2) == 58):
                return self.moment()
        if self.is_digit(0) or byte == 43 or byte == 45 or byte == 105 or byte == 110:
            return self.number()
        Err(self.unexpected())

    def word(self: &mut Parser, text: &str, flag: bool) -> Result[Toml, TomlFault]:
        # matches_text proved the complete token fits at this input position.
        if not self.src.matches_text(self.at, text):
            return Err(TomlFault.UnexpectedByte)
        unchecked:
            self.at += text.byte_len()
        Ok(Toml.Bool(flag))

    # A basic (`quote` 34) or literal (39) string, single- or multi-line.
    # Plain content is found by one scan and copied in one step.
    def quoted(self: &mut Parser, quote: i64, multi: bool) -> Result[str, TomlFault]:
        # Opening quotes were validated by scalar/key_part. Runs count at most
        # six quotes, keep 0..2, and advance only over observed bytes. newline()
        # likewise bounds every cursor/slice endpoint by src.len().
        self.scratch.clear()
        if multi:
            unchecked:
                self.at += 3
            unchecked:
                self.at += self.newline()
        else:
            unchecked:
                self.at += 1
        stop = self.src.len()
        while True:
            mut end = stop
            if quote == 34:
                end = run_end(self.src.find_in(&self.basic_stop, self.at, stop), stop)
            else:
                end = run_end(self.src.find_in(&self.literal_stop, self.at, stop), stop)
            reserved(self.scratch.extend(&self.src[self.at:end]))?
            self.at = end
            byte = self.peek(0)
            if byte < 0:
                return Err(TomlFault.UnexpectedEnd)
            if byte == quote:
                if not multi:
                    unchecked:
                        self.at += 1
                    break
                # One or two quotes are content; three end the string, and
                # up to two more before them still belong to it.
                mut run = 1
                while run < 6 and self.peek(run) == quote:
                    unchecked:
                        run += 1
                if run == 6:
                    unchecked:
                        self.at += 5
                    return Err(TomlFault.UnexpectedByte)
                mut kept = run
                if run >= 3:
                    kept = unchecked:
                        run - 3
                for _ in range(kept):
                    push_byte(&mut self.scratch, quote)?
                unchecked:
                    self.at += run
                if run >= 3:
                    break
            elif byte == 92:
                self.escape(multi)?
            else:
                count = self.newline()
                if not multi or count == 0:
                    return Err(TomlFault.ControlCharacter)
                unchecked:
                    reserved(self.scratch.extend(&self.src[self.at:self.at + count]))?
                unchecked:
                    self.at += count
        faulted(self.scratch.to_text())

    def escape(self: &mut Parser, multi: bool) -> Result[(), TomlFault]:
        # At most eight hex digits produce <= u32.MAX in i64; widths are 4/8.
        # Cursor advances follow validated escape bytes. Whitespace lookahead
        # increments only while a byte exists; a CR lookahead + 1 is at most EOF.
        # Thus ahead and all consumed spans fit within src.len().
        code = self.peek(1)
        mut plain = -1
        if code == 98:
            plain = 8
        elif code == 116:
            plain = 9
        elif code == 110:
            plain = 10
        elif code == 102:
            plain = 12
        elif code == 114:
            plain = 13
        elif code == 34 or code == 92:
            plain = code
        if plain >= 0:
            push_byte(&mut self.scratch, plain)?
            unchecked:
                self.at += 2
            return Ok(())
        if code == 117 or code == 85:
            mut width = 4
            if code == 85:
                width = 8
            mut value = 0
            for position in range(width):
                digit = unchecked:
                    hex_value(self.peek(2 + position))
                if digit < 0:
                    return Err(TomlFault.InvalidEscape)
                value = unchecked:
                    value * 16 + digit
            if (value >= 55296 and value <= 57343) or value > 1114111:
                return Err(TomlFault.InvalidEscape)
            push_scalar(&mut self.scratch, value)?
            unchecked:
                self.at += 2 + width
            return Ok(())
        if multi:
            # A backslash that ends a line removes it and all whitespace and
            # newlines up to the next other character.
            mut ahead = 1
            while self.peek(ahead) == 32 or self.peek(ahead) == 9:
                unchecked:
                    ahead += 1
            after = self.peek(ahead)
            joins_line = unchecked:
                after == 10 or (after == 13 and self.peek(ahead + 1) == 10)
            if joins_line:
                unchecked:
                    self.at += ahead
                while True:
                    byte = self.peek(0)
                    count = self.newline()
                    if byte == 32 or byte == 9:
                        unchecked:
                            self.at += 1
                    elif count > 0:
                        unchecked:
                            self.at += count
                    else:
                        break
                return Ok(())
        Err(TomlFault.InvalidEscape)

    # Integers, floats, `inf`, and `nan`. The whole token is taken first; a
    # fault is placed at its first byte.
    def number(self: &mut Parser) -> Result[Toml, TomlFault]:
        start = self.at
        stop = self.src.len()
        end = run_end(self.src.find_not_in(&self.numeric, start, stop), stop)
        value = self.numeral(start, end)?
        self.at = end
        Ok(value)

    def numeral(self: &mut Parser, start: i64, end: i64) -> Result[Toml, TomlFault]:
        # start <= at/index <= end <= src.len(). Each increment consumes an
        # observed sign, decimal point or exponent byte. The radix prefix proves
        # two bytes exist before at + 2; end - at avoids unchecked lookahead sums.
        mut at = start
        first = self.byte_at(at)
        signed = first == 43 or first == 45
        if signed:
            unchecked:
                at += 1
        remaining = unchecked:
            end - at
        if remaining == 3:
            if self.src.matches_text(at, "inf"):
                if first == 45:
                    return Ok(Toml.Float(-f64.INF))
                return Ok(Toml.Float(f64.INF))
            if self.src.matches_text(at, "nan"):
                return Ok(Toml.Float(f64.NAN))
        if not signed and self.byte_at(at) == 48:
            prefix = unchecked:
                self.byte_at(at + 1)
            if prefix == 120:
                unchecked:
                    return self.radix(at + 2, end, 16)
            if prefix == 111:
                unchecked:
                    return self.radix(at + 2, end, 8)
            if prefix == 98:
                unchecked:
                    return self.radix(at + 2, end, 2)
        self.scratch.clear()
        if signed:
            push_byte(&mut self.scratch, first)?
        mut index = self.digits(at, end, True)?
        mut float = False
        if index < end and self.byte_at(index) == 46:
            float = True
            push_byte(&mut self.scratch, 46)?
            index = unchecked:
                self.digits(index + 1, end, False)?
        if index < end and (self.byte_at(index) == 101 or self.byte_at(index) == 69):
            float = True
            push_byte(&mut self.scratch, 101)?
            unchecked:
                index += 1
            sign = self.byte_at(index)
            if index < end and (sign == 43 or sign == 45):
                push_byte(&mut self.scratch, sign)?
                unchecked:
                    index += 1
            index = self.digits(index, end, False)?
        if index != end:
            return Err(TomlFault.InvalidNumber)
        text = faulted(self.scratch.to_text())?
        if float:
            match f64.parse(&text):
                case Ok(value):
                    return Ok(Toml.Float(value))
                case Err(error):
                    match error:
                        case ParseError.OutOfRange:
                            return Err(TomlFault.NumberOutOfRange)
                        case _:
                            return Err(TomlFault.InvalidNumber)
        match i64.parse(&text):
            case Ok(value):
                Ok(Toml.Int(value))
            case Err(error):
                match error:
                    case ParseError.OutOfRange:
                        Err(TomlFault.NumberOutOfRange)
                    case _:
                        Err(TomlFault.InvalidNumber)

    # Decimal digits from `start`, each `_` between two digits, copied to the
    # scratch buffer without the underscores. The index after them.
    def digits(self: &mut Parser, start: i64, end: i64, whole: bool) -> Result[i64, TomlFault]:
        # index increments only below end; digit count is at most end - start.
        unchecked:
            mut index = start
            mut count = 0
            mut after_underscore = True
            while index < end:
                byte = self.byte_at(index)
                if byte >= 48 and byte <= 57:
                    push_byte(&mut self.scratch, byte)?
                    count += 1
                    after_underscore = False
                elif byte == 95:
                    if after_underscore:
                        return Err(TomlFault.InvalidNumber)
                    after_underscore = True
                else:
                    break
                index += 1
            if count == 0 or after_underscore:
                return Err(TomlFault.InvalidNumber)
            if whole and count > 1 and self.byte_at(start) == 48:
                return Err(TomlFault.InvalidNumber)
            Ok(index)

    def radix(self: &mut Parser, start: i64, end: i64, base: i64) -> Result[Toml, TomlFault]:
        # base is 2, 8 or 16, digit is 0..base-1. The guard proves multiply/add
        # fits i64.MAX; digit count is bounded by the held token length.
        unchecked:
            mut value = 0
            mut count = 0
            mut after_underscore = True
            for index in range(start, end):
                byte = self.byte_at(index)
                if byte == 95:
                    if after_underscore:
                        return Err(TomlFault.InvalidNumber)
                    after_underscore = True
                else:
                    digit = hex_value(byte)
                    if digit < 0 or digit >= base:
                        return Err(TomlFault.InvalidNumber)
                    if value > (i64.MAX - digit) // base:
                        return Err(TomlFault.NumberOutOfRange)
                    value = value * base + digit
                    count += 1
                    after_underscore = False
            if count == 0 or after_underscore:
                return Err(TomlFault.InvalidNumber)
            Ok(Toml.Int(value))

    # A date, time, or both. A fault is placed at the value's first byte.
    def moment(self: &mut Parser) -> Result[Toml, TomlFault]:
        start = self.at
        mut stamp = DateTime(DateTimeKind.LocalTime, 0, 0, 0, 0, 0, 0, 0, 0)
        outcome = self.moment_fields(&mut stamp)
        match outcome:
            case Ok(_):
                Ok(Toml.DateTime(stamp))
            case Err(fault):
                self.at = start
                Err(fault)

    def moment_fields(self: &mut Parser, stamp: &mut DateTime) -> Result[(), TomlFault]:
        # Cursor advances follow observed separators. fixed(2) gives 0..99;
        # validated zone hours <= 23 and minutes <= 59 yield +/-1439 at most.
        if self.peek(4) != 45:
            self.clock(stamp)?
            stamp.kind = DateTimeKind.LocalTime
            return Ok(())
        stamp.year = self.fixed(4)?
        self.expect(45)?
        stamp.month = self.fixed(2)?
        self.expect(45)?
        stamp.day = self.fixed(2)?
        if not valid_date(stamp.year, stamp.month, stamp.day):
            return Err(TomlFault.InvalidDateTime)
        stamp.kind = DateTimeKind.LocalDate
        delimiter = self.peek(0)
        # A space joins a time only when one follows; otherwise the date ends.
        spaced = delimiter == 32 and self.is_digit(1) and self.is_digit(2) and self.peek(3) == 58
        if delimiter != 84 and delimiter != 116 and not spaced:
            return Ok(())
        unchecked:
            self.at += 1
        self.clock(stamp)?
        stamp.kind = DateTimeKind.LocalDateTime
        sign = self.peek(0)
        if sign == 90 or sign == 122:
            unchecked:
                self.at += 1
            stamp.kind = DateTimeKind.OffsetDateTime
        elif sign == 43 or sign == 45:
            unchecked:
                self.at += 1
            hours = self.fixed(2)?
            self.expect(58)?
            minutes = self.fixed(2)?
            if hours > 23 or minutes > 59:
                return Err(TomlFault.InvalidDateTime)
            stamp.offset_minutes = unchecked:
                hours * 60 + minutes
            if sign == 45:
                stamp.offset_minutes = unchecked:
                    -stamp.offset_minutes
            stamp.kind = DateTimeKind.OffsetDateTime
        Ok(())

    # `HH:MM:SS` with optional fractional seconds. Digits past nanoseconds are
    # truncated, as TOML requires of an implementation with less precision.
    def clock(self: &mut Parser, stamp: &mut DateTime) -> Result[(), TomlFault]:
        # Digit count and cursor are bounded by the held input. Only the first
        # nine digits enter nanos (<= 999999999); padding stops at nine. ASCII
        # bias intermediates stay <= 1000000047, well within i64.
        stamp.hour = self.fixed(2)?
        self.expect(58)?
        stamp.minute = self.fixed(2)?
        self.expect(58)?
        stamp.second = self.fixed(2)?
        if self.peek(0) == 46:
            unchecked:
                self.at += 1
            mut count = 0
            mut nanos = 0
            while self.is_digit(0):
                if count < 9:
                    nanos = unchecked:
                        nanos * 10 + self.peek(0) - 48
                unchecked:
                    count += 1
                unchecked:
                    self.at += 1
            if count == 0:
                return Err(TomlFault.InvalidDateTime)
            while count < 9:
                unchecked:
                    nanos *= 10
                unchecked:
                    count += 1
            stamp.nanosecond = nanos
        if not valid_time(stamp.hour, stamp.minute, stamp.second, stamp.nanosecond):
            return Err(TomlFault.InvalidDateTime)
        Ok(())

    def fixed(self: &mut Parser, count: i64) -> Result[i64, TomlFault]:
        # Called only with 2 or 4 digits. Accumulator intermediates fit below
        # 10047; every cursor increment consumes an observed ASCII digit.
        mut value = 0
        for _ in range(count):
            if not self.is_digit(0):
                return Err(TomlFault.InvalidDateTime)
            value = unchecked:
                value * 10 + self.peek(0) - 48
            unchecked:
                self.at += 1
        Ok(value)

    def expect(self: &mut Parser, byte: i64) -> Result[(), TomlFault]:
        # The requested separator byte was observed within src.
        unchecked:
            if self.peek(0) != byte:
                return Err(TomlFault.InvalidDateTime)
            self.at += 1
            Ok(())

    # Recursion depth is the node's level, which `add` bounds.
    def build(self: &mut Parser, node: i64) -> Result[Toml, TomlFault]:
        kind = self.nodes[node].kind
        if kind == kind_value:
            return Ok(replace(self.nodes[node].value, Toml.Bool(False)))
        count = len(self.nodes[node].children)
        if kind == kind_table:
            mut entries = reserved(list[Entry]())?
            reserved(entries.reserve(count))?
            for position in range(count):
                child = self.nodes[node].children[position]
                value = self.build(child)?
                reserved(entries.append(Entry(self.nodes[child].key, value)))?
            return Ok(Toml.Table(entries))
        mut items = reserved(list[Toml]())?
        reserved(items.reserve(count))?
        for position in range(count):
            child = self.nodes[node].children[position]
            reserved(items.append(self.build(child)?))?
        Ok(Toml.Array(items))

def parser(source: Bytes, bounds: &Limits) -> Result[Parser, TomlFault]:
    mut nodes = reserved(list[Node]())?
    root = reserved(list[i64]())?
    reserved(nodes.append(Node(kind_table, origin_header, 0, "", Toml.Bool(False), root, -1)))?
    index = reserved(dict[(i64, str), i64]())?
    scratch = reserved(std.bytes.empty())?
    bare = bare_bytes()?
    basic_stop = control_bytes(34, 92)?
    literal_stop = control_bytes(39, -1)?
    comment_stop = control_bytes(-1, -1)?
    numeric = numeric_bytes()?
    statements = reserved(list[Statement]())?
    Ok(Parser(source, 0, nodes, index, 0, bounds.max_depth.get(), scratch, bare, basic_stop, literal_stop, comment_stop, numeric, False, statements, 0))

# Parses one document held in `source`, which the parser owns.
def run(source: Bytes, bounds: &Limits) -> Result[Toml, TomlError]:
    count = source.len()
    if count > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    mut state = started(parser(source, bounds))?
    valid_end = state.src.utf8_run(0, count)
    if valid_end != count:
        state.at = valid_end
        return Err(state.located(TomlFault.InvalidUtf8))
    match state.document():
        case Ok(_):
            pass
        case Err(fault):
            return Err(state.located(fault))
    match state.build(0):
        case Ok(value):
            Ok(value)
        case Err(fault):
            # Building happens after the whole document has been scanned.
            state.at = count
            Err(state.located(fault))

pub def parse(source: &[u8], bounds: &Limits) -> Result[Toml, TomlError]:
    check_depth(bounds)
    if len(source) > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    run(started(reserved(std.bytes.from_bytes(source)))?, bounds)

pub def parse_text(text: &str, bounds: &Limits) -> Result[Toml, TomlError]:
    check_depth(bounds)
    if text.byte_len() > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    run(started(reserved(std.bytes.from_text(text)))?, bounds)

# Reads `reader` to end of input, then parses. One byte past `max_input` is
# enough to tell a full document from an oversized one.
pub def read_value[R: Reader](reader: &mut R, bounds: &Limits) -> Result[Toml, TomlError]:
    check_depth(bounds)
    mut data = unplaced(reserved(std.bytes.empty()))?
    while True:
        have = data.len()
        extent = match read_extent(have, bounds.max_input.get()):
            case Ok(pair):
                pair
            case Err(fault):
                return Err(TomlError(fault, have, 0, 0))
        room, stop = extent
        match reserved(data.resize(stop, 0u8)):
            case Ok(_):
                pass
            case Err(fault):
                return Err(TomlError(fault, have, 0, 0))
        outcome = reader.read(&mut data, have, stop)
        match outcome:
            case Ok(count):
                if count < 0 or count > room:
                    return Err(TomlError(TomlFault.Stream(StreamError.InvalidProgress), have, 0, 0))
                # Validated count <= room; have + room was preflighted above.
                unchecked:
                    data.truncate(have + count)
                if count == 0:
                    break
                if data.len() > bounds.max_input.get():
                    return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
            case Err(cause):
                data.truncate(have)
                match cause:
                    case StreamError.Interrupted:
                        pass
                    case _:
                        return Err(TomlError(TomlFault.Stream(cause), have, 0, 0))
    run(data, bounds)

# The index of the first entry named `key`.
pub def find(entries: &list[Entry], key: &str) -> Option[i64]:
    for index in range(len(entries)):
        if entries[index].key == key:
            return Some(index)
    Nothing

# Values that need their own `[table]` or `[[array]]` section: tables, and
# non-empty arrays whose elements are all tables.
def sectioned(value: &Toml) -> bool:
    match value:
        case Toml.Table(_):
            True
        case Toml.Array(items):
            if len(items) == 0:
                return False
            for item in items:
                match item:
                    case Toml.Table(_):
                        pass
                    case _:
                        return False
            True
        case _:
            False

# A table holding only sections needs no header of its own.
def headed(entries: &list[Entry]) -> bool:
    if len(entries) == 0:
        return True
    for entry in entries:
        if not sectioned(&entry.value):
            return True
    False

# A table that names one key twice has no TOML text.
def unique(entries: &list[Entry]) -> Result[(), TomlFault]:
    if len(entries) < 2:
        return Ok(())
    mut seen = reserved(set[str]())?
    for entry in entries:
        if entry.key in seen:
            return Err(TomlFault.DuplicateKey)
        reserved(seen.add(entry.key))?
    Ok(())

def date_text_ok(stamp: &DateTime) -> bool:
    mut dated = True
    mut timed = True
    mut offset = False
    match stamp.kind:
        case DateTimeKind.OffsetDateTime:
            offset = True
        case DateTimeKind.LocalDateTime:
            pass
        case DateTimeKind.LocalDate:
            timed = False
        case DateTimeKind.LocalTime:
            dated = False
    if dated:
        if not valid_date(stamp.year, stamp.month, stamp.day):
            return False
    elif stamp.year != 0 or stamp.month != 0 or stamp.day != 0:
        return False
    if timed:
        if not valid_time(stamp.hour, stamp.minute, stamp.second, stamp.nanosecond):
            return False
    elif stamp.hour != 0 or stamp.minute != 0 or stamp.second != 0 or stamp.nanosecond != 0:
        return False
    if offset:
        return stamp.offset_minutes > -1440 and stamp.offset_minutes < 1440
    stamp.offset_minutes == 0

# Writes a tree as TOML text into an owned buffer. Plain entries come first in
# each table, then its tables and arrays of tables as sections. `path` holds
# the keys of the section being written.
class Emitter:
    out: Bytes
    path: list[str]
    bare: Bytes
    escaped: Bytes
    # Scratch for one integer's digits, so writing one allocates nothing.
    spelling: Bytes
    max_depth: i64
    max_output: i64

    def take(self: &mut Emitter) -> Result[Bytes, TomlFault]:
        fresh = reserved(std.bytes.empty())?
        Ok(replace(self.out, fresh))

    def put(self: &mut Emitter, byte: i64) -> Result[(), TomlFault]:
        if self.out.len() >= self.max_output:
            return Err(TomlFault.OutputTooLarge)
        push_byte(&mut self.out, byte)

    def extend(self: &mut Emitter, source: &[u8], start: i64, stop: i64) -> Result[(), TomlFault]:
        # start/stop are ordered offsets in a held source/spelling buffer;
        # 0 <= out.len() <= max_output, so both length differences fit i64.
        unchecked:
            if stop - start > self.max_output - self.out.len():
                return Err(TomlFault.OutputTooLarge)
            reserved(self.out.extend(&source[start:stop]))

    def raw(self: &mut Emitter, token: bytes) -> Result[(), TomlFault]:
        # 0 <= out.len() <= max_output; subtracting the remaining budget fits.
        unchecked:
            if token.len() > self.max_output - self.out.len():
                return Err(TomlFault.OutputTooLarge)
            reserved(self.out.extend(&token))

    def spelled(self: &mut Emitter, start: i64, stop: i64) -> Result[(), TomlFault]:
        # start/stop are ordered offsets in a held source/spelling buffer;
        # 0 <= out.len() <= max_output, so both length differences fit i64.
        unchecked:
            if stop - start > self.max_output - self.out.len():
                return Err(TomlFault.OutputTooLarge)
            reserved(self.out.extend(&self.spelling[start:stop]))

    def number(self: &mut Emitter, value: i64, width: i64) -> Result[(), TomlFault]:
        # Only validated date/time fields call this: width is 1..9 and value
        # is 0..999999999. Divisor grows at most to 10^8; divisions use positive
        # divisors, digits are 0..9, and divisor decreases to zero.
        unchecked:
            mut divisor = 1
            for _ in range(width - 1):
                divisor *= 10
            while divisor > 0:
                self.put(48 + (value // divisor) % 10)?
                divisor //= 10
            Ok(())

    # Digits come from the negated value, right to left, so `i64.MIN` needs no
    # special case. `//` and `%` floor, hence the digit arithmetic.
    def integer(self: &mut Emitter, value: i64) -> Result[(), TomlFault]:
        # rest stays nonpositive. Remainders are 0..9; digit 0..9 makes
        # rest + digit <= 0, including i64.MIN. Positive divisors cannot fail.
        # An i64 has at most 19 digits plus sign, within the 32-byte spelling.
        mut rest = value
        if rest > 0:
            rest = unchecked:
                -rest
        stop = self.spelling.len()
        mut at = stop
        while True:
            digit = unchecked:
                (10 - rest % 10) % 10
            unchecked:
                at -= 1
            unchecked:
                self.spelling.set(at, u8(48 + digit))
            rest = unchecked:
                (rest + digit) // 10
            if rest == 0:
                break
        if value < 0:
            unchecked:
                at -= 1
            self.spelling.set(at, u8(45))
        self.spelled(at, stop)

    # A basic string. `"`, `\`, and control characters are escaped; every
    # other scalar is written as UTF-8. The copy of `text` lets each unescaped
    # run be written at once; see the costs in book/src/design/stdlib/toml.md.
    def quote(self: &mut Emitter, text: &str) -> Result[(), TomlFault]:
        # Escaped byte is 0..31 or DEL (127): division/modulo by positive 16
        # and ASCII digit biases fit. index < count bounds run = index + 1.
        source = reserved(std.bytes.from_text(text))?
        count = source.len()
        self.put(34)?
        mut run = 0
        mut index = run_end(source.find_in(&self.escaped, 0, count), count)
        while index < count:
            byte = i64(source.get(index))
            self.extend(&source, run, index)?
            self.put(92)?
            if byte == 34 or byte == 92:
                self.put(byte)?
            elif byte == 8:
                self.put(98)?
            elif byte == 9:
                self.put(116)?
            elif byte == 10:
                self.put(110)?
            elif byte == 12:
                self.put(102)?
            elif byte == 13:
                self.put(114)?
            else:
                self.raw(b"u00")?
                unchecked:
                    self.put(48 + byte // 16)?
                digit = unchecked:
                    byte % 16
                if digit < 10:
                    unchecked:
                        self.put(48 + digit)?
                else:
                    unchecked:
                        self.put(55 + digit)?
            run = unchecked:
                index + 1
            index = run_end(source.find_in(&self.escaped, run, count), count)
        self.extend(&source, run, count)?
        self.put(34)

    # Bare when every byte is allowed in a bare key, otherwise quoted.
    def key(self: &mut Emitter, name: &str) -> Result[(), TomlFault]:
        source = reserved(std.bytes.from_text(name))?
        count = source.len()
        if count > 0 and run_end(source.find_not_in(&self.bare, 0, count), count) == count:
            return self.extend(&source, 0, count)
        self.quote(name)

    # ASCII text, all or none.
    def ascii(self: &mut Emitter, text: &str) -> Result[(), TomlFault]:
        # 0 <= out.len() <= max_output; subtracting the remaining budget fits.
        unchecked:
            if text.byte_len() > self.max_output - self.out.len():
                return Err(TomlFault.OutputTooLarge)
            for character in text:
                push_byte(&mut self.out, i64(ord(character).unwrap()))?
            Ok(())

    def decimal(self: &mut Emitter, value: f64) -> Result[(), TomlFault]:
        if value != value:
            return self.raw(b"nan")
        if value == f64.INF:
            return self.raw(b"inf")
        if value == -f64.INF:
            return self.raw(b"-inf")
        text = reserved(str.from(value))?
        self.ascii(&text)?
        if "." in text or "e" in text:
            return Ok(())
        self.raw(b".0")

    def moment(self: &mut Emitter, stamp: &DateTime) -> Result[(), TomlFault]:
        # date_text_ok validated nanos 0..999999999 and zone +/-1439.
        # Trailing-zero removal stops at a nonzero digit (width stays 1..9);
        # negation and positive-constant divisions of the zone fit i64.
        if not date_text_ok(stamp):
            return Err(TomlFault.InvalidDateTime)
        mut dated = True
        mut timed = True
        mut offset = False
        match stamp.kind:
            case DateTimeKind.OffsetDateTime:
                offset = True
            case DateTimeKind.LocalDateTime:
                pass
            case DateTimeKind.LocalDate:
                timed = False
            case DateTimeKind.LocalTime:
                dated = False
        if dated:
            self.number(stamp.year, 4)?
            self.put(45)?
            self.number(stamp.month, 2)?
            self.put(45)?
            self.number(stamp.day, 2)?
            if timed:
                self.put(84)?
        if timed:
            self.number(stamp.hour, 2)?
            self.put(58)?
            self.number(stamp.minute, 2)?
            self.put(58)?
            self.number(stamp.second, 2)?
            if stamp.nanosecond > 0:
                unchecked:
                    mut digits = stamp.nanosecond
                    mut width = 9
                    while digits % 10 == 0:
                        digits //= 10
                        width -= 1
                    self.put(46)?
                    self.number(digits, width)?
        if offset:
            unchecked:
                mut minutes = stamp.offset_minutes
                if minutes == 0:
                    return self.put(90)
                if minutes < 0:
                    self.put(45)?
                    minutes = -minutes
                else:
                    self.put(43)?
                self.number(minutes // 60, 2)?
                self.put(58)?
                self.number(minutes % 60, 2)?
        Ok(())

    def deeper(self, level: i64, extra: i64) -> Result[i64, TomlFault]:
        if level > self.max_depth:
            return Err(TomlFault.DepthExceeded)
        # level is nonnegative; extra is 1 or 2. Subtract before adding so
        # even an enormous edit path reports DepthExceeded, not overflow.
        unchecked:
            if extra > self.max_depth - level:
                return Err(TomlFault.DepthExceeded)
            Ok(level + extra)

    # A value on one line. `level` counts the containers around it.
    def inline(self: &mut Emitter, value: &Toml, level: i64) -> Result[(), TomlFault]:
        match value:
            case Toml.Bool(flag):
                if *flag:
                    self.raw(b"true")
                else:
                    self.raw(b"false")
            case Toml.Int(number):
                self.integer(*number)
            case Toml.Float(number):
                self.decimal(*number)
            case Toml.Text(text):
                self.quote(text)
            case Toml.DateTime(stamp):
                self.moment(stamp)
            case Toml.Array(items):
                child_level = self.deeper(level, 1)?
                self.put(91)?
                mut first = True
                for item in items:
                    if not first:
                        self.raw(b", ")?
                    first = False
                    self.inline(item, child_level)?
                self.put(93)
            case Toml.Table(entries):
                child_level = self.deeper(level, 1)?
                unique(entries)?
                if len(entries) == 0:
                    return self.raw(b"{}")
                self.raw(b"{ ")?
                mut first = True
                for entry in entries:
                    if not first:
                        self.raw(b", ")?
                    first = False
                    self.key(&entry.key)?
                    self.raw(b" = ")?
                    self.inline(&entry.value, child_level)?
                self.raw(b" }")

    def heading(self: &mut Emitter, array: bool) -> Result[(), TomlFault]:
        if self.out.len() > 0:
            self.put(10)?
        self.put(91)?
        if array:
            self.put(91)?
        for position in range(len(self.path)):
            if position > 0:
                self.put(46)?
            part = self.path[position]
            self.key(&part)?
        self.put(93)?
        if array:
            self.put(93)?
        self.put(10)

    # The entries of the table at `level`.
    def body(self: &mut Emitter, entries: &list[Entry], level: i64) -> Result[(), TomlFault]:
        unique(entries)?
        for entry in entries:
            if not sectioned(&entry.value):
                self.key(&entry.key)?
                self.raw(b" = ")?
                self.inline(&entry.value, level)?
                self.put(10)?
        for entry in entries:
            match &entry.value:
                case Toml.Table(inner):
                    child_level = self.deeper(level, 1)?
                    reserved(self.path.append(entry.key))?
                    if headed(inner):
                        self.heading(False)?
                    self.body(inner, child_level)?
                    drop(self.path.pop())
                case Toml.Array(items):
                    if sectioned(&entry.value):
                        child_level = self.deeper(level, 2)?
                        reserved(self.path.append(entry.key))?
                        for item in items:
                            match item:
                                case Toml.Table(inner):
                                    self.heading(True)?
                                    self.body(inner, child_level)?
                                case _:
                                    pass
                        drop(self.path.pop())
                case _:
                    pass
        Ok(())

def emitter(bounds: &Limits) -> Result[Emitter, TomlFault]:
    out = reserved(std.bytes.empty())?
    path = reserved(list[str]())?
    bare = bare_bytes()?
    mut escaped = control_bytes(34, 92)?
    push_byte(&mut escaped, 9)?
    # Longer than any i64 spelling.
    mut spelling = reserved(std.bytes.with_capacity(32))?
    reserved(spelling.resize(32, 0u8))?
    Ok(Emitter(out, path, bare, escaped, spelling, bounds.max_depth.get(), bounds.max_output.get()))

# The root must be a table. Errors carry the bytes produced so far.
pub def encode(value: &Toml, bounds: &Limits) -> Result[Bytes, TomlError]:
    check_depth(bounds)
    match value:
        case Toml.Table(entries):
            mut target = unplaced(emitter(bounds))?
            outcome = target.body(entries, 0)
            match outcome:
                case Ok(_):
                    match reserved(std.bytes.empty()):
                        case Ok(fresh):
                            Ok(replace(target.out, fresh))
                        case Err(fault):
                            Err(TomlError(fault, target.out.len(), 0, 0))
                case Err(fault):
                    Err(TomlError(fault, target.out.len(), 0, 0))
        case _:
            Err(TomlError(TomlFault.NotATable, 0, 0, 0))

pub def encode_text(value: &Toml, bounds: &Limits) -> Result[str, TomlError]:
    encoded = encode(value, bounds)?
    match faulted(encoded.to_text()):
        case Ok(text):
            Ok(text)
        case Err(fault):
            Err(TomlError(fault, encoded.len(), 0, 0))

# Encodes the whole value, then writes it. Does not flush. A stream error
# carries the bytes the writer accepted.
pub def write_value[W: Writer](writer: &mut W, value: &Toml, bounds: &Limits) -> Result[(), TomlError]:
    encoded = encode(value, bounds)?
    match std.io.write_all(writer, &encoded):
        case Ok(_):
            Ok(())
        case Err(partial):
            Err(TomlError(TomlFault.Stream(partial.cause), partial.completed, 0, 0))

# A validated source document. Edits prepare and reparse a candidate before
# replacing this state, so errors never leave a partially changed document.
pub class Document:
    state: Parser
    bounds: Limits

    pub def text(self) -> Result[str, TomlError]:
        unplaced(faulted(self.state.src.to_text()))

    pub def get(self, path: &list[str]) -> Result[Option[Toml], TomlError]:
        match unplaced(document_node(&self.state, path))?:
            case Nothing:
                Ok(Nothing)
            case Some(node):
                # Building consumes arena values; copy only the requested tree.
                Ok(Some(unplaced(document_value(&self.state, node))?))

    # Replace a value, or insert a missing one. Table values become sections;
    # replacing an assignment replaces only its value token (inline if a table).
    pub def set(self: &mut Document, path: &list[str], value: &Toml) -> Result[(), TomlError]:
        self.change(path, value, False)

    pub def insert(self: &mut Document, path: &list[str], value: &Toml) -> Result[(), TomlError]:
        self.change(path, value, True)

    pub def remove(self: &mut Document, path: &list[str]) -> Result[bool, TomlError]:
        if len(path) == 0:
            return Err(TomlError(TomlFault.KeyConflict, 0, 0, 0))
        match unplaced(document_node(&self.state, path))?:
            case Nothing:
                Ok(False)
            case Some(node):
                source = unplaced(document_without(&self.state, node, &self.bounds))?
                candidate = document_state(source, &self.bounds)?
                self.state = candidate
                Ok(True)

    def change(self: &mut Document, path: &list[str], value: &Toml, insert_only: bool) -> Result[(), TomlError]:
        if len(path) == 0:
            return Err(TomlError(TomlFault.KeyConflict, 0, 0, 0))
        # path is nonempty; subtracting one is representable.
        last = unchecked:
            len(path) - 1
        found = unplaced(document_node(&self.state, path))?
        match found:
            case Some(node):
                if insert_only:
                    return Err(TomlError(TomlFault.DuplicateKey, 0, 0, 0))
                mut value_start = -1
                mut value_stop = -1
                for statement in &self.state.statements:
                    if statement.node == node and not statement.header:
                        value_start = statement.value_start
                        value_stop = statement.value_stop
                if value_start >= 0:
                    mut target = unplaced(emitter(&self.bounds))?
                    unplaced(target.extend(&self.state.src, 0, value_start))?
                    parent = self.state.nodes[node].parent
                    unplaced(target.inline(value, self.state.nodes[parent].level))?
                    unplaced(target.extend(&self.state.src, value_stop, self.state.src.len()))?
                    candidate = document_state(unplaced(target.take())?, &self.bounds)?
                    self.state = candidate
                    return Ok(())
                # A section can be replaced with another table, but converting
                # it to a scalar could silently reparent subsequent statements.
                match value:
                    case Toml.Table(entries):
                        source = unplaced(document_without(&self.state, node, &self.bounds))?
                        mut target = unplaced(emitter(&self.bounds))?
                        unplaced(target.extend(&source, 0, source.len()))?
                        target.path = unplaced(reserved(copy(path)))?
                        unplaced(target.heading(False))?
                        unplaced(target.body(entries, len(path)))?
                        candidate = document_state(unplaced(target.take())?, &self.bounds)?
                        self.state = candidate
                        return Ok(())
                    case _:
                        return Err(TomlError(TomlFault.KeyConflict, 0, 0, 0))
            case Nothing:
                pass
        mut target = unplaced(emitter(&self.bounds))?
        match value:
            case Toml.Table(entries):
                unplaced(target.extend(&self.state.src, 0, self.state.src.len()))?
                target.path = unplaced(reserved(copy(path)))?
                unplaced(target.heading(False))?
                unplaced(target.body(entries, len(path)))?
            case _:
                parent_path = unplaced(reserved(path.slice(0, last)))?
                mut parent = 0
                match unplaced(document_node(&self.state, &parent_path))?:
                    case Some(node):
                        parent = node
                    case Nothing:
                        return Err(TomlError(TomlFault.KeyConflict, 0, 0, 0))
                if self.state.nodes[parent].kind != kind_table or self.state.nodes[parent].origin == origin_inline:
                    return Err(TomlError(TomlFault.KeyConflict, 0, 0, 0))
                # Dotted-key tables belong to the nearest enclosing section;
                # qualify the new key relative to that section, not the root.
                mut section = parent
                mut relative_start = last
                while self.state.nodes[section].origin == origin_dotted:
                    section = self.state.nodes[section].parent
                    # Each dotted ancestor consumes one component of parent_path.
                    unchecked:
                        relative_start -= 1
                mut at = self.state.src.len()
                mut active = section == 0
                mut located = active
                for statement in &self.state.statements:
                    if statement.header:
                        if active:
                            at = statement.start
                            break
                        if statement.node == section:
                            active = True
                            located = True
                if not located:
                    # An implicit parent can be made explicit at EOF.
                    unplaced(target.extend(&self.state.src, 0, self.state.src.len()))?
                    target.path = unplaced(reserved(copy(&parent_path)))?
                    unplaced(target.heading(False))?
                else:
                    unplaced(target.extend(&self.state.src, 0, at))?
                    unplaced(document_newline(&mut target))?
                    for position in range(relative_start, last):
                        part = path[position]
                        unplaced(target.key(&part))?
                        unplaced(target.put(46))?
                name = path[last]
                unplaced(target.key(&name))?
                unplaced(target.raw(b" = "))?
                unplaced(target.inline(value, last))?
                unplaced(target.put(10))?
                if located:
                    unplaced(target.extend(&self.state.src, at, self.state.src.len()))?
        candidate = document_state(unplaced(target.take())?, &self.bounds)?
        self.state = candidate
        Ok(())

def document_newline(target: &mut Emitter) -> Result[(), TomlFault]:
    # Short-circuit count > 0 guards the last-byte subtraction.
    unchecked:
        count = target.out.len()
        if count > 0 and target.out.get(count - 1) != 10u8:
            target.put(10)?
        Ok(())

# Paths address decoded table keys. Arrays (including arrays of tables) are
# atomic values: traversing one is ambiguous without an explicit row index.
def document_node(state: &Parser, path: &list[str]) -> Result[Option[i64], TomlFault]:
    mut node = 0
    for part in path:
        if state.nodes[node].kind != kind_table:
            return Err(TomlFault.KeyConflict)
        match state.index.get((node, *part)):
            case Some(child):
                node = child
            case Nothing:
                return Ok(Nothing)
    Ok(Some(node))

def document_value(state: &Parser, node: i64) -> Result[Toml, TomlFault]:
    if state.nodes[node].kind == kind_value:
        match &state.nodes[node].value:
            case Toml.Bool(value):
                return Ok(Toml.Bool(*value))
            case Toml.Int(value):
                return Ok(Toml.Int(*value))
            case Toml.Float(value):
                return Ok(Toml.Float(*value))
            case Toml.Text(value):
                return Ok(Toml.Text(*value))
            case Toml.DateTime(value):
                return Ok(Toml.DateTime(reserved(copy(value))?))
            case _:
                return Err(TomlFault.KeyConflict)
    if state.nodes[node].kind == kind_table:
        mut entries = reserved(list[Entry]())?
        for child in &state.nodes[node].children:
            reserved(entries.append(Entry(state.nodes[*child].key, document_value(state, *child)?)))?
        return Ok(Toml.Table(entries))
    mut values = reserved(list[Toml]())?
    for child in &state.nodes[node].children:
        reserved(values.append(document_value(state, *child)?))?
    Ok(Toml.Array(values))

def document_descendant(state: &Parser, child: i64, ancestor: i64) -> bool:
    mut node = child
    while node >= 0:
        if node == ancestor:
            return True
        node = state.nodes[node].parent
    False

def document_without(state: &Parser, node: i64, bounds: &Limits) -> Result[Bytes, TomlFault]:
    mut target = emitter(bounds)?
    mut at = 0
    mut found = False
    for statement in &state.statements:
        if document_descendant(state, statement.node, node):
            target.extend(&state.src, at, statement.start)?
            at = statement.stop
            found = True
    if not found:
        # Inline fields have no independent statement to delete safely.
        return Err(TomlFault.KeyConflict)
    target.extend(&state.src, at, state.src.len())?
    target.take()

def document_state(source: Bytes, bounds: &Limits) -> Result[Parser, TomlError]:
    check_depth(bounds)
    if source.len() > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    mut state = started(parser(source, bounds))?
    state.tracking = True
    count = state.src.len()
    valid_end = state.src.utf8_run(0, count)
    if valid_end != count:
        state.at = valid_end
        return Err(state.located(TomlFault.InvalidUtf8))
    match state.document():
        case Ok(_):
            Ok(state)
        case Err(fault):
            Err(state.located(fault))

pub def document(source: &[u8], bounds: &Limits) -> Result[Document, TomlError]:
    check_depth(bounds)
    if len(source) > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    state = document_state(started(reserved(std.bytes.from_bytes(source)))?, bounds)?
    Ok(Document(state, Limits(bounds.max_depth, bounds.max_input, bounds.max_output)))

pub def document_text(text: &str, bounds: &Limits) -> Result[Document, TomlError]:
    check_depth(bounds)
    if text.byte_len() > bounds.max_input.get():
        return Err(TomlError(TomlFault.InputTooLarge, bounds.max_input.get(), 0, 0))
    state = document_state(started(reserved(std.bytes.from_text(text)))?, bounds)?
    Ok(Document(state, Limits(bounds.max_depth, bounds.max_input, bounds.max_output)))

# Typed codecs use the same checked hooks as JSON. TOML has no null: a null
# class field is omitted, while null map entries, roots and array elements reject.
pub class TreeLimits:
    pub max_depth: NonNegative[i64] __max(1024)
    pub max_nodes: NonNegative[i64]
    pub max_text_bytes: NonNegative[i64]

pub def tree_limits() -> TreeLimits:
    TreeLimits(64, 1048576, 67108864)

pub class CodecOptions:
    pub limits: Limits
    pub tree_limits: TreeLimits
    pub unknown_fields: std.serial.UnknownFields

pub def codec_options() -> CodecOptions:
    CodecOptions(limits(), tree_limits(), std.serial.UnknownFields.Reject)

class CodecBudget:
    depth: i64
    nodes: i64
    text: i64
    max_depth: i64
    max_nodes: i64
    max_text: i64

    def node(self: &mut CodecBudget, text: i64 = 0) -> Result[(), TomlError]:
        unchecked:
            if self.nodes >= self.max_nodes or text > self.max_text - self.text:
                return Err(TomlError(TomlFault.OutputTooLarge, 0, 0, 0))
            self.nodes += 1
            self.text += text
        Ok(())

    def enter(self: &mut CodecBudget) -> Result[(), TomlError]:
        if self.depth >= self.max_depth:
            return Err(TomlError(TomlFault.DepthExceeded, 0, 0, 0))
        unchecked:
            self.depth += 1
        Ok(())

    def leave(self: &mut CodecBudget) -> ():
        unchecked:
            self.depth -= 1

def codec_budget(limits: &TreeLimits) -> CodecBudget:
    if limits.max_depth.get() > depth_ceiling:
        __trap("std.toml.tree_limits: max_depth is above 1024")
    CodecBudget(0, 0, 0, limits.max_depth.get(), limits.max_nodes.get(), limits.max_text_bytes.get())

def codec_invalid() -> TomlError:
    TomlError(TomlFault.InvalidState, 0, 0, 0)

def codec_fault(fault: std.serial.Fault) -> TomlError:
    TomlError(TomlFault.Serialization(fault), 0, 0, 0)

enum EncodeFrame:
    Items(list[Toml])
    Members(list[Entry], Option[str], bool, list[str])

pub class TreeEncoder:
    _root: Option[Toml]
    _frames: list[EncodeFrame]
    _budget: CodecBudget
    _done: bool

    pub def reject(self, fault: std.serial.Fault) -> TomlError:
        codec_fault(fault)

    pub def allocation(self, cause: AllocError) -> TomlError:
        TomlError(TomlFault.Allocation(cause), 0, 0, 0)

    def ready(self) -> Result[(), TomlError]:
        if self._done:
            return Err(codec_invalid())
        if len(self._frames) == 0:
            if self._root.is_some():
                return Err(codec_invalid())
        else:
            match &self._frames[-1]:
                case EncodeFrame.Members(_, name, _, _):
                    if name.is_none():
                        return Err(codec_invalid())
                case _:
                    pass
        Ok(())

    def attach(self: &mut TreeEncoder, value: Toml) -> Result[(), TomlError]:
        self.ready()?
        match self._frames.pop():
            case Nothing:
                self._root = Some(value)
            case Some(EncodeFrame.Items(values)):
                mut items = values
                unplaced(reserved(items.append(value)))?
                unplaced(reserved(self._frames.append(EncodeFrame.Items(items))))?
            case Some(EncodeFrame.Members(values, name, _, omitted)):
                mut entries = values
                match name:
                    case Some(key):
                        unplaced(reserved(entries.append(Entry(key, value))))?
                    case Nothing:
                        return Err(codec_invalid())
                unplaced(reserved(self._frames.append(EncodeFrame.Members(entries, Nothing, False, omitted))))?
        Ok(())

    def scalar(self: &mut TreeEncoder, value: Toml, text: i64 = 0) -> Result[(), TomlError]:
        self._budget.node(text)?
        self.attach(value)

    pub def null(self: &mut TreeEncoder) -> Result[(), TomlError]:
        self.ready()?
        self._budget.node()?
        match self._frames.pop():
            case Some(EncodeFrame.Members(entries, Some(name), True, omitted)):
                mut absent = omitted
                unplaced(reserved(absent.append(name)))?
                unplaced(reserved(self._frames.append(EncodeFrame.Members(entries, Nothing, False, absent))))
            case _:
                Err(codec_fault(std.serial.Fault.Unrepresentable))

    pub def boolean(self: &mut TreeEncoder, value: bool) -> Result[(), TomlError]:
        self.scalar(Toml.Bool(value))

    pub def integer(self: &mut TreeEncoder, value: i64) -> Result[(), TomlError]:
        self.scalar(Toml.Int(value))

    pub def unsigned(self: &mut TreeEncoder, value: u64) -> Result[(), TomlError]:
        if value > 9223372036854775807u64:
            return Err(codec_fault(std.serial.Fault.Unrepresentable))
        self.scalar(Toml.Int(i64(value)))

    pub def decimal(self: &mut TreeEncoder, value: f64) -> Result[(), TomlError]:
        self.scalar(Toml.Float(value))

    pub def text(self: &mut TreeEncoder, value: &str) -> Result[(), TomlError]:
        self.scalar(Toml.Text(*value), value.byte_len())

    pub def start_array(self: &mut TreeEncoder) -> Result[(), TomlError]:
        self.ready()?
        self._budget.node()?
        self._budget.enter()?
        values = unplaced(reserved(list[Toml]()))?
        unplaced(reserved(self._frames.append(EncodeFrame.Items(values))))

    pub def start_object(self: &mut TreeEncoder) -> Result[(), TomlError]:
        self.ready()?
        self._budget.node()?
        self._budget.enter()?
        entries = unplaced(reserved(list[Entry]()))?
        omitted = unplaced(reserved(list[str]()))?
        unplaced(reserved(self._frames.append(EncodeFrame.Members(entries, Nothing, False, omitted))))

    def named(self: &mut TreeEncoder, name: &str, field: bool) -> Result[(), TomlError]:
        if self._done:
            return Err(codec_invalid())
        self._budget.node(name.byte_len())?
        match self._frames.pop():
            case Some(EncodeFrame.Members(entries, Nothing, _, omitted)):
                if find(&entries, name).is_some():
                    return Err(codec_fault(std.serial.Fault.DuplicateField(*name)))
                for absent in &omitted:
                    if absent == name:
                        return Err(codec_fault(std.serial.Fault.DuplicateField(*name)))
                unplaced(reserved(self._frames.append(EncodeFrame.Members(entries, Some(*name), field, omitted))))
            case _:
                Err(codec_invalid())

    pub def key(self: &mut TreeEncoder, name: &str) -> Result[(), TomlError]:
        self.named(name, False)

    pub def field(self: &mut TreeEncoder, name: &str) -> Result[(), TomlError]:
        self.named(name, True)

    pub def end_array(self: &mut TreeEncoder) -> Result[(), TomlError]:
        if self._done:
            return Err(codec_invalid())
        match self._frames.pop():
            case Some(EncodeFrame.Items(values)):
                self._budget.leave()
                self.attach(Toml.Array(values))
            case _:
                Err(codec_invalid())

    pub def end_object(self: &mut TreeEncoder) -> Result[(), TomlError]:
        if self._done:
            return Err(codec_invalid())
        match self._frames.pop():
            case Some(EncodeFrame.Members(entries, Nothing, _, omitted)):
                self._budget.leave()
                self.attach(Toml.Table(entries))
            case _:
                Err(codec_invalid())

    pub def finish(self: &mut TreeEncoder) -> Result[Toml, TomlError]:
        if self._done or len(self._frames) != 0:
            return Err(codec_invalid())
        self._done = True
        match replace(self._root, Nothing):
            case Some(value):
                Ok(value)
            case Nothing:
                Err(codec_invalid())

pub def tree_encoder(limits: &TreeLimits) -> Result[TreeEncoder, TomlError]:
    budget = codec_budget(limits)
    frames = unplaced(reserved(list[EncodeFrame]()))?
    Ok(TreeEncoder(Nothing, frames, budget, False))

enum DecodeFrame:
    Items(list[Toml])
    Members(list[Entry])

# Own the tree: Plenty classes cannot retain a borrowed input reference.
pub class TreeDecoder:
    _value: Option[Toml]
    _frames: list[DecodeFrame]
    _budget: CodecBudget
    _unknown: std.serial.UnknownFields

    pub def reject(self, fault: std.serial.Fault) -> TomlError:
        codec_fault(fault)

    pub def allocation(self, cause: AllocError) -> TomlError:
        TomlError(TomlFault.Allocation(cause), 0, 0, 0)

    def take(self: &mut TreeDecoder) -> Result[Toml, TomlError]:
        match replace(self._value, Nothing):
            case Some(value):
                self._budget.node()?
                Ok(value)
            case Nothing:
                Err(codec_invalid())

    pub def null(self: &mut TreeDecoder) -> Result[bool, TomlError]:
        if self._value.is_none():
            return Err(codec_invalid())
        Ok(False)

    pub def boolean(self: &mut TreeDecoder) -> Result[bool, TomlError]:
        match self.take()?:
            case Toml.Bool(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def integer(self: &mut TreeDecoder) -> Result[i64, TomlError]:
        match self.take()?:
            case Toml.Int(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def unsigned(self: &mut TreeDecoder) -> Result[u64, TomlError]:
        value = self.integer()?
        if value < 0:
            return Err(self.reject(std.serial.Fault.OutOfRange))
        Ok(u64(value))

    pub def decimal(self: &mut TreeDecoder) -> Result[f64, TomlError]:
        match self.take()?:
            case Toml.Int(value):
                Ok(f64(value))
            case Toml.Float(value):
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def variant(self: &mut TreeDecoder) -> Result[(str, bool), TomlError]:
        match &self._value:
            case Some(Toml.Text(_)):
                return Ok((self.text()?, False))
            case _:
                pass
        self.start_object()?
        match self.next_key()?:
            case Some(tag):
                Ok((tag, True))
            case Nothing:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def text(self: &mut TreeDecoder) -> Result[str, TomlError]:
        match self.take()?:
            case Toml.Text(value):
                unchecked:
                    self._budget.nodes -= 1
                self._budget.node(value.byte_len())?
                Ok(value)
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def start_array(self: &mut TreeDecoder) -> Result[(), TomlError]:
        match self.take()?:
            case Toml.Array(values):
                self._budget.enter()?
                mut items = values
                items.reverse()
                unplaced(reserved(self._frames.append(DecodeFrame.Items(items))))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_element(self: &mut TreeDecoder) -> Result[bool, TomlError]:
        if self._value.is_some():
            return Err(codec_invalid())
        match self._frames.pop():
            case Some(DecodeFrame.Items(values)):
                mut items = values
                match items.pop():
                    case Some(value):
                        self._value = Some(value)
                        unplaced(reserved(self._frames.append(DecodeFrame.Items(items))))?
                        Ok(True)
                    case Nothing:
                        self._budget.leave()
                        Ok(False)
            case _:
                Err(codec_invalid())

    pub def start_object(self: &mut TreeDecoder) -> Result[(), TomlError]:
        match self.take()?:
            case Toml.Table(values):
                self._budget.enter()?
                mut entries = values
                entries.reverse()
                unplaced(reserved(self._frames.append(DecodeFrame.Members(entries))))
            case _:
                Err(self.reject(std.serial.Fault.UnexpectedKind))

    pub def next_key(self: &mut TreeDecoder) -> Result[Option[str], TomlError]:
        if self._value.is_some():
            return Err(codec_invalid())
        match self._frames.pop():
            case Some(DecodeFrame.Members(values)):
                mut entries = values
                match entries.pop():
                    case Some(entry):
                        self._budget.node(entry.key.byte_len())?
                        self._value = Some(entry.value)
                        unplaced(reserved(self._frames.append(DecodeFrame.Members(entries))))?
                        Ok(Some(entry.key))
                    case Nothing:
                        self._budget.leave()
                        Ok(Nothing)
            case _:
                Err(codec_invalid())

    pub def unknown_key(self: &mut TreeDecoder, name: &str) -> Result[(), TomlError]:
        if self._unknown == std.serial.UnknownFields.Reject:
            return Err(self.reject(std.serial.Fault.UnknownField(*name)))
        self.skip()

    def skip(self: &mut TreeDecoder) -> Result[(), TomlError]:
        # Reuse the owning traversal frames: nested unknown values must not
        # recurse on the native stack or consume the enclosing object's siblings.
        baseline = len(self._frames)
        while True:
            match &self._value:
                case Some(value):
                    match value:
                        case Toml.Array(_):
                            self.start_array()?
                        case Toml.Table(_):
                            self.start_object()?
                        case Toml.Text(_):
                            drop(self.text()?)
                        case _:
                            drop(self.take()?)
                case Nothing:
                    return Err(codec_invalid())
            while self._value.is_none():
                if len(self._frames) == baseline:
                    return Ok(())
                match &self._frames[-1]:
                    case DecodeFrame.Items(_):
                        drop(self.next_element()?)
                    case DecodeFrame.Members(_):
                        drop(self.next_key()?)
        Ok(())

    pub def finish(self: &mut TreeDecoder) -> Result[(), TomlError]:
        if self._value.is_some() or len(self._frames) != 0:
            return Err(codec_invalid())
        Ok(())

pub def tree_decoder(value: Toml, limits: &TreeLimits, unknown_fields: std.serial.UnknownFields = std.serial.UnknownFields.Reject) -> Result[TreeDecoder, TomlError]:
    budget = codec_budget(limits)
    frames = unplaced(reserved(list[DecodeFrame]()))?
    Ok(TreeDecoder(Some(value), frames, budget, unknown_fields))

pub def to_value[T](value: &T, limits: &TreeLimits) -> Result[Toml, std.serial.SerialError[TomlError]]:
    mut output = std.serial.wrap(tree_encoder(limits))?
    std.serial.encode[T, TomlError, TreeEncoder](value, &mut output)?
    std.serial.wrap(output.finish())

pub def from_value[T](value: Toml, limits: &TreeLimits, unknown_fields: std.serial.UnknownFields = std.serial.UnknownFields.Reject) -> Result[T, std.serial.SerialError[TomlError]]:
    mut source = std.serial.wrap(tree_decoder(value, limits, unknown_fields))?
    result = std.serial.decode[T, TomlError, TreeDecoder](&mut source)?
    std.serial.wrap(source.finish())?
    Ok(result)

pub def dump[T](value: &T, options: &CodecOptions) -> Result[str, std.serial.SerialError[TomlError]]:
    tree = to_value(value, &options.tree_limits)?
    std.serial.wrap(encode_text(&tree, &options.limits))

pub def load[T](text: &str, options: &CodecOptions) -> Result[T, std.serial.SerialError[TomlError]]:
    tree = std.serial.wrap(parse_text(text, &options.limits))?
    from_value[T](tree, &options.tree_limits, options.unknown_fields)
