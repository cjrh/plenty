# Pinned release build and test environments; see
# book/src/development/releasing.md. Update deliberately, then rebuild and
# rerun scripts/release/local-check.sh before releasing. Read by the release
# workflow and the local scripts, so keep plain KEY=VALUE lines.

# glibc 2.28 build environment (AlmaLinux 8.10, gcc-toolset-14).
# Tag 2026.10.16-1 at the time of pinning.
BUILD_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:1e7b8460ad8fb3fb0fbe1cd818845159ac896b4fd17452d56e892c291f3b97a8

# Rust toolchain that builds the compiler and its runtime archives.
RUST_VERSION=1.99.0
RUSTUP_INIT_VERSION=1.29.0
RUSTUP_INIT_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10

# Rootless linker installation shared by release host/container tests.
MOLD_VERSION=3.0.0
MOLD_SHA256=6c90d4a474c7c0409dfb575be03a5345878ac14fdba18de8b40fa58c60121189

# Clean user environments for the archive smoke test, with only the
# documented prerequisites installed. almalinux:8 is the glibc 2.28 baseline.
SMOKE_IMAGES="almalinux:8@sha256:8b469a3a78515e8a18ea8fc727e6a3679e1d0c5ba6f58d5b30be3d0d9b86cffe debian:12@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858 debian:13@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5 ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80 archlinux:latest@sha256:3c64b538588416593f69a1aebd2f2ec0f2541b29159f32556fa7def2167147a0"

# Native ARM64 release inputs, verified from upstream on 2026-10-30.
# manylinux tag 2026.10.16-1; ARMv8-A / glibc 2.28 baseline.
BUILD_IMAGE_AARCH64=quay.io/pypa/manylinux_2_28_aarch64@sha256:b873ffc316ffe8a154e3dc4872871de2ebd170db4876c8bbd983d42ff320001e
RUSTUP_INIT_SHA256_AARCH64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
MOLD_SHA256_AARCH64=52c759d3689babaea4c42af2f31062a74ab83e17ffb5a8090232534c67b70577

SMOKE_IMAGES_AARCH64="almalinux:8@sha256:29fdedeed8a6707558c9e03b5d3e8f09eac5307cdd0811218d7d55a2cc9ae522 debian:13@sha256:39f862f398f8ea1a2ffee9bbe02c649be6779244bd6a834c4f71155172f801f2"
