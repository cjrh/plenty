import std.dataframe as df
import std.test as test

def retained_query(strategy: df.AsOfStrategy = df.AsOfStrategy.Backward, tolerance: Option[i64] = Nothing, exact: bool = True) -> Result[df.Query, df.DataFrameError | AllocError]:
    left = df.frame([df.column_i64("key", [0, 2, 3, 4, 8, 9]?)?]?)?
    right = df.frame([
        df.column_i64("key", [1, 3, 3, 7]?)?,
        df.column_i64("value", [11, 31, 32, 70]?)?
    ]?)?
    left.lazy()?.join_asof(right.lazy()?, "key", "key", strategy=strategy, tolerance=tolerance, allow_exact_matches=exact)

def strategies() -> Result[(), df.DataFrameError | AllocError | test.TestError]:
    backward: list[Option[i64]] = [Nothing, Some(11), Some(32), Some(32), Some(70), Some(70)]?
    forward: list[Option[i64]] = [Some(11), Some(31), Some(31), Some(70), Nothing, Nothing]?
    nearest: list[Option[i64]] = [Some(11), Some(32), Some(32), Some(32), Some(70), Some(70)]?
    query = retained_query()?
    result = query.collect()?
    test.equal(result.values_i64("key")?, [0, 2, 3, 4, 8, 9]?)?
    test.equal(result.values_i64_nullable("value")?, backward)?
    test.equal(query.collect_streaming()?.values_i64_nullable("value")?, backward)?
    test.equal(retained_query(df.AsOfStrategy.Forward)?.collect()?.values_i64_nullable("value")?, forward)?
    test.equal(retained_query(df.AsOfStrategy.Nearest)?.collect_streaming()?.values_i64_nullable("value")?, nearest)?
    strict: list[Option[i64]] = [Nothing, Some(11), Some(11), Some(32), Some(70), Some(70)]?
    test.equal(retained_query(exact=False)?.collect()?.values_i64_nullable("value")?, strict)?
    bounded: list[Option[i64]] = [Nothing, Some(11), Some(32), Some(32), Some(70), Nothing]?
    test.equal(retained_query(tolerance=Some(1))?.collect_streaming()?.values_i64_nullable("value")?, bounded)?
    match query.join_asof(query, "key", "key", tolerance=Some(-1)):
        case Err(df.DataFrameError.Schema(_)):
            pass
        case _:
            test.fail("negative tolerance accepted")?
    Ok(())

def nulls_and_empty() -> Result[(), df.DataFrameError | AllocError | test.TestError]:
    left_keys: list[Option[i64]] = [Nothing, Some(1), Some(3)]?
    right_keys: list[Option[i64]] = [Nothing, Some(1), Some(2)]?
    left = df.frame([df.column_i64_nullable("key", left_keys)?]?)?
    right = df.frame([df.column_i64_nullable("key", right_keys)?, df.column_i64("value", [99, 11, 22]?)?]?)?
    expected: list[Option[i64]] = [Nothing, Some(11), Some(22)]?
    query = left.lazy()?.join_asof(right.lazy()?, "key", "key", suffix="_lookup")?
    result = query.collect()?
    test.equal(result.values_i64_nullable("key")?, left_keys)?
    test.equal(result.values_i64_nullable("value")?, expected)?
    test.equal(query.collect_streaming()?.values_i64_nullable("value")?, expected)?
    test.equal(result.get_i64("key_lookup", 2)?, Some(2))?
    empty: list[i64] = []?
    empty_left = df.frame([df.column_i64("key", empty)?]?)?
    empty_right = df.frame([df.column_i64("key", empty)?, df.column_i64("value", empty)?]?)?
    test.equal(empty_left.lazy()?.join_asof(right.lazy()?, "key", "key")?.collect()?.height()?, 0)?
    empty_result = left.lazy()?.join_asof(empty_right.lazy()?, "key", "key")?.collect_streaming()?
    test.equal(empty_result.height()?, 3)?
    test.check(empty_result.get_i64("value", 0)?.is_none(), "empty right is unmatched")?
    Ok(())

def errors_and_extremes() -> Result[(), df.DataFrameError | AllocError | test.TestError]:
    sorted = df.frame([df.column_i64("key", [1, 2]?)?]?)?
    unsorted = df.frame([df.column_i64("key", [2, 1]?)?]?)?
    match unsorted.lazy()?.join_asof(sorted.lazy()?, "key", "key")?.collect():
        case Err(df.DataFrameError.Query(_)):
            pass
        case _:
            test.fail("unsorted left accepted")?
    match sorted.lazy()?.join_asof(unsorted.lazy()?, "key", "key")?.collect_streaming():
        case Err(df.DataFrameError.Query(_)):
            pass
        case _:
            test.fail("unsorted right accepted")?
    floats = df.frame([df.column_f64("key", [1.0, 2.0]?)?]?)?
    match sorted.lazy()?.join_asof(floats.lazy()?, "key", "key"):
        case Err(df.DataFrameError.Schema(_)):
            pass
        case _:
            test.fail("floating key accepted")?
    left = df.frame([df.column_i64("key", [i64.MIN, 0, i64.MAX]?)?]?)?
    right = df.frame([df.column_i64("key", [i64.MIN, i64.MAX]?)?, df.column_i64("value", [1, 2]?)?]?)?
    nearest = left.lazy()?.join_asof(right.lazy()?, "key", "key", strategy=df.AsOfStrategy.Nearest)?
    test.equal(nearest.collect_streaming()?.values_i64("value")?, [1, 2, 2]?)?
    exact: list[Option[i64]] = [Some(1), Nothing, Some(2)]?
    test.equal(left.lazy()?.join_asof(right.lazy()?, "key", "key", tolerance=Some(0))?.collect()?.values_i64_nullable("value")?, exact)?
    Ok(())

def main() -> Result[(), df.DataFrameError | AllocError | test.TestError | IoError]:
    strategies()?
    nulls_and_empty()?
    errors_and_extremes()?
    print("dataframe asof ok")?
    Ok(())
