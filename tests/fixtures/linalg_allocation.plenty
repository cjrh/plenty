import std.linalg as la
import std.test as test

def attempt(operation: i64, a: &la.Matrix, b: &la.Matrix) -> Result[(), AllocError | la.LinalgError]:
    match operation:
        case 0:
            drop(a.matmul(b)?)
        case 1:
            drop(a.lu()?)
        case 2:
            drop(a.solve(b)?)
        case 3:
            drop(a.qr()?)
        case 4:
            drop(a.cholesky()?)
        case 5:
            drop(a.svd()?)
        case 6:
            drop(a.eigh()?)
        case 7:
            drop(a.eig()?)
        case 8:
            drop((a * b)?)
        case 9:
            drop((a + b)?)
        case 10:
            drop((a - b)?)
        case 11:
            drop((-a)?)
        case _:
            drop((2.0 * a)?)
    Ok(())

def main() -> Result[(), Failure]:
    a = la.matrix(2, 2, &[4.0, 2.0, 2.0, 3.0]?)?
    b = la.identity(2)?
    for operation in range(13):
        mut successes = 0
        mut failures = 0
        for budget in range(40):
            marker = f"__test_fail_allocations_after_{budget}__"?
            print(marker)?
            outcome = attempt(operation, &a, &b)
            print("__test_restore_allocations__")?
            match outcome:
                case Ok(_):
                    successes += 1
                case Err(error):
                    match error:
                        case cause: AllocError:
                            test.equal(cause, AllocError.OutOfMemory)?
                            failures += 1
                        case cause: la.LinalgError:
                            print(cause)?
                            test.fail("unexpected failure kind")?
            test.equal(a.get(0, 0)?, 4.0)?
            test.equal(a.get(1, 1)?, 3.0)?
        test.check(successes > 0 and failures > 0, "budgets cover failure and success")?
    print("linalg allocation ok")?
    Ok(())
