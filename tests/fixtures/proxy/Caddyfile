# Caddy in front of tests/fixtures/proxy/server.plenty, for
# tests/test_std_http_server_proxy.rs. The test replaces @UPSTREAM_PORT@,
# @HTTP_PORT@ and @TLS_PORT@ with free loopback ports and mounts the
# configuration and certificates at /etc/plenty-proxy.
{
	admin off
	auto_https off
	servers {
		timeouts {
			# Short enough for the slow-client test.
			read_header 2s
		}
	}
}

(upstream) {
	# Caddy streams request bodies, reuses upstream connections, passes Host
	# through and sets X-Forwarded-For and X-Forwarded-Proto by default.
	reverse_proxy 127.0.0.1:@UPSTREAM_PORT@ {
		flush_interval -1
		transport http {
			# Short enough for the slow-upstream test.
			response_header_timeout 2s
		}
	}
}

http://:@HTTP_PORT@ {
	bind 127.0.0.1
	import upstream
}

https://localhost:@TLS_PORT@ {
	bind 127.0.0.1
	tls /etc/plenty-proxy/leaf.pem /etc/plenty-proxy/leaf.key
	import upstream
}
