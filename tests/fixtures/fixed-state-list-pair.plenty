@copy
class B:
    x: f64
    v: f32

def update(xs: &mut list[f64], dt: f64, steps: i64) -> Result[(), AllocError | IoError]:
    mut bs = list[B].with_capacity(3)?
    for k in range(3):
        bs.append(B(0.1, 0.01f32))?
    n = len(xs)
    for _ in range(steps):
        for i in range(n):
            for j in range(n):
                xs[i] += dt * xs[j] - xs[i] * 0.25
                bs[j].x -= xs[i] * bs[i].x * dt
                bs[i].v *= 0.5f32 + bs[j].v
                xs[j] = -(xs[j] * xs[j] + bs[j].x * bs[j].x + 1.0).sqrt() * 1.0e-3
    for i in range(3):
        print(f"{bs[i].x:.17e} {bs[i].v:.9e}"?)?
    Ok(())

def main() -> Result[(), AllocError | IoError | ParseError]:
    argv = args()?
    steps = i64.parse(&argv[1])?
    mut xs = list[f64].with_capacity(3)?
    for k in range(3):
        xs.append(0.5 * f64(k) - 0.75)?
    update(&mut xs, 0.01, steps)?
    for i in range(3):
        print(f"{xs[i]:.17e}"?)?
    Ok(())
