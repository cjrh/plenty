    typed = df.frame([df.column_i64("v", [1, 2]?)?]?)?.lazy()?.select([df.col("v")?.cast(df.DType.F32)?]?)?.collect()?
    test.equal(typed.values_f32("v")?, [1f32, 2f32]?)?
    Ok(())

def unsigned_casts_and_float_specials() -> Result[(), df.DataFrameError | AllocError | test.TestError | IoError]:
    data = df.frame([df.column_u64("v", [0u64, u64.MAX]?)?]?)?
    query = data.lazy()?
    match query.select([df.col("v")?.cast(df.DType.I64)?]?)?.collect():
        case Err(_):
            pass
        case _:
            test.fail("u64 overflow accepted by strict cast")?
    casted = query.select([df.col("v")?.cast(df.DType.I64, strict=False)?]?)?.collect()?
    test.equal(casted.values_i64_nullable("v")?, [Some(0), Nothing]?)?
    floats = df.frame([df.column_f32("v", [f32.NAN, f32.INF, -f32.INF, -0f32]?)?]?)?
    floats.write_parquet("f32-special.parquet")?
    values = df.scan_parquet("f32-special.parquet")?.collect()?.values_f32("v")?
    test.check(values[0] != values[0], "NaN survives Parquet")?
    test.equal(values[1], f32.INF)?
    test.equal(values[2], -f32.INF)?
    test.equal(1f32 / values[3], -f32.INF)?
    df.frame([df.column_u64("id", [u64.MAX]?)?, df.column_f32("reading", [1.5f32]?)?]?)?.write_csv("numeric.csv")?
    schema = [df.Field("id", df.DType.U64), df.Field("reading", df.DType.F32)]?
    csv = df.scan_csv("numeric.csv", schema_overrides=Some(schema))?.collect()?
    test.equal(csv.get_u64("id", 0)?, Some(u64.MAX))?
    test.equal(csv.get_f32("reading", 0)?, Some(1.5f32))?
    Ok(())

def main() -> Result[(), df.DataFrameError | AllocError | test.TestError | IoError]:
    check_i8()?
    check_i16()?
    check_i32()?
    check_u8()?
    check_u16()?
    check_u32()?
    check_u64()?
    check_f32()?
    unsigned_casts_and_float_specials()?
    print("dataframe numeric types ok")?
    Ok(())

