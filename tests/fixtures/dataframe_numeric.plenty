    missing = df.frame([df.column_f32_nullable("v", nullable)?]?)?
    test.equal(missing.values_f32_nullable("v")?, nullable)?
    test.check(missing.get_f32("v", 1)?.is_none(), "null preserved")?
    missing.write_parquet("f32-nullable.parquet")?
