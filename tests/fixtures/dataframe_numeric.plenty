def check_f32() -> Result[(), df.DataFrameError | AllocError | test.TestError]:
    values = [-3.4028234663852886e38f32, 0f32, 3.4028234663852886e38f32]?
    query = df.frame([df.column_f32("v", values)?]?)?.lazy()?
    test.equal(query.schema()?[0].dtype, df.DType.F32)?
    data = query.collect()?
    test.equal(data.values_f32("v")?, values)?
    test.equal(data.get_f32("v", 2)?, Some(3.4028234663852886e38f32))?
    test.equal(data.lazy()?.select([df.lit_f32(3.4028234663852886e38f32)?.alias("v")?]?)?.collect()?.get_f32("v", 0)?, Some(3.4028234663852886e38f32))?
    data.write_parquet("f32.parquet")?
    restored = df.scan_parquet("f32.parquet")?.collect()?
    test.equal(restored.schema()?, data.schema()?)?
    test.equal(restored.values_f32("v")?, values)?
