import std.dataframe as df
import std.test as test

def check_i8() -> Result[(), df.DataFrameError | AllocError | test.TestError]:
    values = [i8.MIN, 0i8, i8.MAX]?
    query = df.frame([df.column_i8("v", values)?]?)?.lazy()?
    test.equal(query.schema()?[0].dtype, df.DType.I8)?
    data = query.collect()?
    test.equal(data.values_i8("v")?, values)?
    test.equal(data.get_i8("v", 2)?, Some(i8.MAX))?
    test.equal(data.lazy()?.select([df.lit_i8(i8.MAX)?.alias("v")?]?)?.collect()?.get_i8("v", 0)?, Some(i8.MAX))?
    data.write_parquet("i8.parquet")?
    restored = df.scan_parquet("i8.parquet")?.collect()?
    test.equal(restored.schema()?, data.schema()?)?
    test.equal(restored.values_i8("v")?, values)?
    nullable: list[Option[i8]] = [Some(i8.MIN), Nothing, Some(i8.MAX)]?
    missing = df.frame([df.column_i8_nullable("v", nullable)?]?)?
    test.equal(missing.values_i8_nullable("v")?, nullable)?
    test.check(missing.get_i8("v", 1)?.is_none(), "null preserved")?
    missing.write_parquet("i8-nullable.parquet")?
    test.equal(df.scan_parquet("i8-nullable.parquet")?.collect()?.values_i8_nullable("v")?, nullable)?
    match missing.values_i8("v"):
        case Err(df.DataFrameError.Null(_)):
            pass
        case _:
            test.fail("nullable i8 silently extracted as non-null")?
    match data.get_i8("v", -1):
        case Err(df.DataFrameError.Bounds(_)):
            pass
        case _:
            test.fail("negative i8 row accepted")?
    match data.values_i64("v"):
        case Err(_):
            pass
        case _:
            test.fail("i8 silently extracted as i64")?
    empty_values: list[i8] = []?
    empty = df.frame([df.column_i8("v", empty_values)?]?)?
    test.equal(empty.values_i8("v")?, empty_values)?
    test.equal(empty.schema()?[0].dtype, df.DType.I8)?
    nulls: list[Option[i8]] = [Nothing, Nothing]?
    all_null = df.frame([df.column_i8_nullable("v", nulls)?]?)?
    test.equal(all_null.values_i8_nullable("v")?, nulls)?
    test.equal(all_null.schema()?[0].dtype, df.DType.I8)?
    typed = df.frame([df.column_i64("v", [1, 2]?)?]?)?.lazy()?.select([df.col("v")?.cast(df.DType.I8)?]?)?.collect()?
    test.equal(typed.values_i8("v")?, [1i8, 2i8]?)?
    Ok(())

