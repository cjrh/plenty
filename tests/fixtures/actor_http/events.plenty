# A response larger than either output buffer resumes on Writable; /delay
# schedules a timer and remains live while another request initiates drain.
# Only the stalled-reader test observes retirement before releasing back-pressure.
const observe_blocked: bool = False

pub class App:
    pub mode: i64
    pub remaining: i64
    pub block: Bytes
    pub stopping: i64

    def __del__(self) -> ():
        if observe_blocked and self.mode == 3 and self.remaining > 0:
            print("blocked stopped").unwrap()

    pub def pump(self: &mut App, response: &mut Response) -> Result[(), AppError]:
        while self.remaining > 0:
            mut count = self.block.len()
            if count > self.remaining:
                count = self.remaining
            accepted = response.write(&self.block[:count])?
            self.remaining -= accepted
            if accepted == 0:
                return Ok(())
        response.finish()?
        self.mode = 0
        Ok(())

    pub def receive(self: &mut App, event: Event[i64], response: &mut Response, context: &mut Context[Notice[i64], ServerError]) -> Result[(), AppError]:
        match event:
            case Event.Head(_, target):
                if target.path == "/stop":
                    self.mode = 1
                elif target.path == "/delay":
                    self.mode = 2
                elif target.path == "/health":
                    self.mode = 4
                elif target.path == "/busy":
                    self.mode = 6
                elif target.path == "/blocked":
                    self.mode = 5
                else:
                    self.mode = 3
            case Event.End:
                if self.mode == 1:
                    response.shutdown_server()
                    response.send_text(200, "stopping")?
                elif self.mode == 2:
                    response.start(ResponseHead(1, 200, "OK", []?))?
                    response.write(b"first")?
                    drop(context.after(&std.time.milliseconds(300u32), 7).unwrap())
                elif self.mode == 6:
                    response.start(ResponseHead(1, 200, "OK", []?))?
                    response.write(b"busy")?
                    for _ in range(16):
                        drop(context.send(context.address(), Notice[i64].Message(1)))
                elif self.mode == 4:
                    response.send_text(200, "healthy")?
                else:
                    response.start(ResponseHead(1, 200, "OK", []?))?
                    self.remaining = 262144
                    if self.mode == 5:
                        self.remaining = 16777216
                        self.mode = 3
                        if observe_blocked:
                            print("blocked started").unwrap()
                    self.pump(response)?
            case Event.Writable:
                if self.mode == 3:
                    self.pump(response)?
            case Event.Stopping:
                self.stopping += 1
                if self.stopping != 1:
                    return Err(HttpError.Broken)
            case Event.Message(_):
                if self.mode == 6:
                    drop(context.send(context.address(), Notice[i64].Message(1)))
            case Event.Actor(mail):
                match mail:
                    case Mail.Timer(timer):
                        response.write(b"last")?
                        response.finish()?
                        self.mode = 0
                    case _:
                        pass
            case _:
                pass
        Ok(())

def factory() -> Result[App, AppError]:
    mut block = std.bytes.empty()?
    block.resize(1024, 120u8)?
    Ok(App(0, 0, block, 0))

def run(listener: std.net.TcpListener, config: &std.actor.http.server.Config, stop: &CancellationToken) -> std.actor.http.server.Report:
    std.actor.http.server.serve_events(listener, factory, config, stop).unwrap()
