    "threads": 1,
    "asterisk": false,
    "site_make": "/usr/bin/clang -pipe -Wall -O3 -fomit-frame-pointer -march=ivybridge  pidigits.c -o pidigits.clang_run -lgmp",
    "site_command": "./pidigits.clang_run 10000",
    "build": {
