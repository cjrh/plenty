    "site_make": "/opt/src/rust-1.84.1/bin/rustc -C opt-level=3 -C target-cpu=ivybridge -C codegen-units=1 -L /opt/src/rust-libs --extern num_cpus=/opt/src/rust-libs/libnum_cpus-24a145fc292277f3.rlib fasta.rs -o fasta.rust-3.rust_run",
    "site_command": "./fasta.rust-3.rust_run 25000000",
    "build": {
