def sum_to(n: i64, total: i64) -> i64:
    """Sum the integers from 1 through n without growing the call stack."""
    if n == 0:
        total
    else:
        sum_to(n - 1, total + n)

def main() -> Result[(), IoError]:
    mut answer = sum_to(100, 0)
    answer = answer + 1
    print(answer)?
    Ok(())
