def sum_to(n: i64, total: i64) -> Result[i64, OverflowError[i64]]:
    """Sum the integers from 1 through n without growing the call stack."""
    if n == 0:
        Ok(total)
    else:
        sum_to(n - 1, total + n)

def main() -> Result[(), IoError | OverflowError[i64]]:
    mut answer = sum_to(100, 0)?
    answer = answer + 1
    print(answer)?
    Ok(())
