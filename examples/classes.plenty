class Point:
    x: i64
    y: i64

    def squared_length(self) -> i64:
        self.x * self.x + self.y * self.y

    def shift(self: &mut Point, amount: i64) -> ():
        self.x = self.x + amount
        self.y = self.y + amount

class Resource:
    name: str

    def __del__(self) -> ():
        print(("release " + self.name).unwrap()).unwrap()

def work() -> ():
    resource = Resource("example").unwrap()
    print(resource).unwrap()

def main() -> ():
    mut point = Point(3, 4).unwrap()
    print(point.squared_length()).unwrap()
    point.shift(1)
    print(point).unwrap()

    work()
