class Point:
    x: i64
    y: i64

    def squared_length(self) -> Result[i64, OverflowError[i64]]:
        Ok(self.x * self.x + self.y * self.y)

    def shift(self: &mut Point, amount: i64) -> Result[(), OverflowError[i64]]:
        # Preflight both coordinates so a failed shift leaves the point intact.
        x = self.x + amount
        y = self.y + amount
        self.x = x
        self.y = y
        Ok(())

class Resource:
    name: str

    def __del__(self) -> ():
        print(("release " + self.name).unwrap()).unwrap()

def work() -> Result[(), IoError]:
    resource = Resource("example")
    print(resource)?
    Ok(())

def main() -> Result[(), IoError | OverflowError[i64]]:
    mut point = Point(3, 4)
    print(point.squared_length()?)?
    point.shift(1)?
    print(point)?

    work()?
    Ok(())
