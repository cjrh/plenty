def even_squares(limit: i64) -> list[i64]:
    [n * n for n in range(limit) if n % 2 == 0]

def main() -> ():
    squares = even_squares(10)
    by_value: dict[i64, i64] = {n: n * n for n in &squares}
    unique = set(copy(squares))

    print(squares)
    for n in &by_value:
        print(by_value[n])
    print(len(unique))
