import std.fs as fs
import std.path as pathmod
import matching

# Unix separators and wildcard tokens are ASCII bytes. Path spelling is never decoded.
def basename_start(path: &list[u8]) -> i64:
    mut start = 0
    for index in range(len(path)):
        if path[index] == 47u8:
            start = index + 1
    start

def is_hidden(path: &list[u8]) -> bool:
    mut length = 0
    mut begins_dot = False
    mut dots_only = True
    for byte in path:
        if byte == 47u8:
            if begins_dot and (length > 2 or not dots_only):
                return True
            length = 0
            begins_dot = False
            dots_only = True
        else:
            if length == 0:
                begins_dot = byte == 46u8
            length = length + 1
            dots_only = dots_only and byte == 46u8
    begins_dot and (length > 2 or not dots_only)

pub def glob_matches(pattern: &list[u8], path: &list[u8], start: i64) -> bool:
    mut p = 0
    mut t = start
    mut star = -1
    mut retry = start
    while t < len(path):
        if p < len(pattern) and pattern[p] == 42u8:
            star = p
            p = p + 1
            retry = t
        elif p < len(pattern) and (pattern[p] == 63u8 or pattern[p] == path[t]):
            p = p + 1
            t = t + 1
        elif star >= 0:
            retry = retry + 1
            t = retry
            p = star + 1
        else:
            return False
    while p < len(pattern) and pattern[p] == 42u8:
        p = p + 1
    p == len(pattern)

def literal_matches(pattern: &list[u8], path: &list[u8], start: i64) -> bool:
    for position in range(start, len(path) - len(pattern) + 1):
        mut index = 0
        while index < len(pattern) and path[position + index] == pattern[index]:
            index = index + 1
        if index == len(pattern):
            return True
    False

def search(pattern: &list[u8], glob: bool, full_path: bool, hidden: bool) -> Result[i32, IoError]:
    terminator = encode_utf8("\0")?
    while True:
        match input_bytes(0u8)?:
            case Some(path):
                if len(path) == 0:
                    continue
                if not hidden and is_hidden(&path):
                    continue
                start = 0 if full_path else basename_start(&path)
                matched = glob_matches(pattern, &path, start) if glob else literal_matches(pattern, &path, start)
                if matched:
                    write_stdout_bytes(&path)?
                    write_stdout_bytes(&terminator)?
            case Nothing:
                break
    flush_stdout()?
    Ok(0)

def emit(path: &pathmod.Path, pattern: &list[u8], glob: bool, full_path: bool, null: bool) -> Result[(), IoError]:
    bytes = path.as_bytes()
    if null:
        start = 0 if full_path else basename_start(bytes)
        matched = glob_matches(pattern, bytes, start) if glob else literal_matches(pattern, bytes, start)
        if matched:
            write_stdout_bytes(bytes)?
            write_stdout_bytes(encode_utf8("\0")?)?
    else:
        text = path.to_text()?
        needle = decode_utf8(pattern)?
        if matching.matches(&needle, &text, glob, full_path):
            print(text)?
    Ok(())

def allocated[T](result: Result[T, AllocError]) -> Result[T, IoError]:
    match result:
        case Ok(value):
            Ok(value)
        case Err(error):
            Err(IoError.Data(DataError.Allocation(error)))

def advance(walker: &mut fs.Walk) -> Result[bool, IoError]:
    match walker.next():
        case Ok(found):
            Ok(found)
        case Err(error):
            match error:
                case fs.WalkError.Io(at, operation, cause):
                    write_stderr("finder: ")?
                    write_stderr(operation)?
                    write_stderr(" \"")?
                    write_stderr(at.display()?)?
                    write_stderr("\"\n")?
                    Err(cause)
                case fs.WalkError.Allocation(cause):
                    Err(IoError.Data(DataError.Allocation(cause)))

pub def search_tree(root: &pathmod.Path, pattern: &list[u8], glob: bool, full_path: bool, hidden: bool, null: bool) -> Result[i32, IoError]:
    mut walker = allocated(fs.walk(root, True))?
    while advance(&mut walker)?:
        mut index = len(walker.current.directories) - 1
        while index >= 0:
            if not hidden and hidden_name(&walker.current.directories[index])?:
                drop(walker.current.directories.pop(index))
            index = index - 1
        for directory in &walker.current.directories:
            emit(&directory, pattern, glob, full_path, null)?
        for entry in &walker.current.files:
            path = entry.path()?
            if hidden or not hidden_name(&path)?:
                emit(&path, pattern, glob, full_path, null)?
    flush_stdout()?
    Ok(0)

def hidden_name(path: &pathmod.Path) -> Result[bool, IoError]:
    match path.file_name()?:
        case Some(name):
            Ok(is_hidden(name.as_bytes()))
        case Nothing:
            Ok(False)

pub def run(argv: &list[list[u8]]) -> Result[i32, IoError]:
    mut paths = False
    mut glob = False
    mut full_path = False
    mut hidden = False
    mut options = True
    mut pattern_index = -1
    mut root_index = -1
    for index in range(1, len(argv)):
        argument = &argv[index]
        if options and argument == encode_utf8("--")?:
            options = False
        elif options and argument == encode_utf8("--null")?:
            pass
        elif options and (argument == encode_utf8("--help")? or argument == encode_utf8("-h")?):
            print("Usage: finder --null [--paths] [--glob] [--full-path] [--hidden] [--] [PATTERN [ROOT]]")?
            print("Search a directory root, or filter stdin with --paths. NUL-framed Unix paths.")?
            return Ok(0)
        elif options and argument == encode_utf8("--paths")?:
            paths = True
        elif options and argument == encode_utf8("--glob")?:
            glob = True
        elif options and argument == encode_utf8("--full-path")?:
            full_path = True
        elif options and argument == encode_utf8("--hidden")?:
            hidden = True
        elif options and len(argument) > 0 and argument[0] == 45u8:
            write_stderr("finder: unknown option; see --help\n")?
            return Ok(2)
        elif root_index >= 0 or (paths and pattern_index >= 0):
            write_stderr("finder: expected a pattern and optional root; --paths accepts one pattern\n")?
            return Ok(2)
        elif pattern_index >= 0:
            root_index = index
        else:
            pattern_index = index
    if not paths:
        root_bytes = allocated(copy(argv[root_index]))? if root_index >= 0 else encode_utf8(".")?
        root = pathmod.from_bytes(root_bytes)
        pattern = allocated(copy(argv[pattern_index]))? if pattern_index >= 0 else encode_utf8("")?
        return search_tree(&root, &pattern, glob, full_path, hidden, True)
    if pattern_index < 0:
        empty = encode_utf8("")?
        Ok(search(&empty, False, full_path, hidden)?)
    else:
        Ok(search(&argv[pattern_index], glob, full_path, hidden)?)
