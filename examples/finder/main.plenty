import matching
import binary
import std.path as path

def usage() -> Result[(), IoError]:
    print("Usage: finder [--paths] [--null] [--glob] [--full-path] [--hidden] [--] [PATTERN [ROOT]]")?
    print("Search ROOT (default .), or filter UTF-8 stdin paths with --paths.")?
    print("Default: case-sensitive literal substring in the basename.")?
    print("--glob: whole-name match; * matches zero or more scalars, ? one scalar.")?
    print("--full-path: match the entire supplied path; wildcards may cross /.")?
    print("--hidden: include components beginning with a dot.")?
    print("--null: read/write NUL-delimited raw Unix paths; globs match bytes.")?
    print("Directory traversal does not follow discovered symlinks; errors are reported.")?
    Ok(())

def search(pattern: &str, glob: bool, full_path: bool, hidden: bool) -> Result[i32, IoError]:
    while True:
        match input()?:
            case Some(path):
                if len(path) == 0:
                    continue
                if not hidden and matching.is_hidden(&path):
                    continue
                if matching.matches(pattern, &path, glob, full_path):
                    print(path)?
            case Nothing:
                break
    flush_stdout()?
    Ok(0)

def main() -> Result[i32, IoError]:
    raw = args_bytes()?
    for index in range(1, len(raw)):
        if raw[index] == encode_utf8("--")?:
            break
        if raw[index] == encode_utf8("--null")?:
            return binary.run(&raw)
    argv = args()?
    mut paths = False
    mut glob = False
    mut full_path = False
    mut hidden = False
    mut options = True
    mut pattern_index = -1
    mut root_index = -1
    for index in range(1, len(argv)):
        argument = argv[index]
        if options and argument == "--":
            options = False
        elif options and (argument == "--help" or argument == "-h"):
            usage()?
            return Ok(0)
        elif options and argument == "--paths":
            paths = True
        elif options and argument == "--glob":
            glob = True
        elif options and argument == "--full-path":
            full_path = True
        elif options and argument == "--hidden":
            hidden = True
        elif options and argument.startswith("-"):
            write_stderr("finder: unknown option; see --help\n")?
            return Ok(2)
        elif root_index >= 0 or (paths and pattern_index >= 0):
            write_stderr("finder: expected a pattern and optional root; --paths accepts one pattern\n")?
            return Ok(2)
        elif pattern_index >= 0:
            root_index = index
        else:
            pattern_index = index
    if not paths:
        root_text = argv[root_index] if root_index >= 0 else "."
        root = path.from_text(&root_text)?
        pattern = encode_utf8(argv[pattern_index])? if pattern_index >= 0 else encode_utf8("")?
        return binary.search_tree(&root, &pattern, glob, full_path, hidden, False)
    if pattern_index < 0:
        Ok(search("", False, full_path, hidden)?)
    else:
        Ok(search(&argv[pattern_index], glob, full_path, hidden)?)
