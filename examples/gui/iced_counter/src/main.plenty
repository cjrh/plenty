import std.gui.retained.iced as iced

class State:
    count: i64
    def __init__(self) -> ():
        self.count = 0

def create() -> Result[State, AllocError]:
    Ok(State())

def view(state: &State, frame: &iced.Frame) -> Result[(), iced.IcedError]:
    frame.column()?
    frame.text(&"Plenty + iced")?
    label = f"Count: {state.count}".map_error(iced.allocation)?
    frame.text(&label)?
    frame.row()?
    frame.button(&"Increment", 1u64)?
    frame.button(&"Reset", 2u64)?
    frame.end()?
    frame.end()?
    Ok(())

def update(state: &mut State, action: u64) -> Result[(), iced.IcedError]:
    match action:
        case 1u64:
            # Bound the teaching example's counter instead of allowing overflow.
            if state.count == 1000000:
                return Err(iced.IcedError.LimitExceeded)
            incremented = checked:
                state.count + 1
            state.count = incremented.map_error(def(error: OverflowError[i64]) -> iced.IcedError: iced.IcedError.LimitExceeded)?
        case 2u64:
            state.count = 0
        case _:
            return Err(iced.IcedError.InvalidArgument)
    Ok(())

def main() -> Result[(), iced.IcedError]:
    iced.run(create=create, view=view, update=update)
