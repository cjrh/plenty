import std.gui.immediate.egui as egui

class State:
    name: str
    def __init__(self) -> ():
        self.name = "Ada"

export def create() -> Result[State, AllocError] = "egui_app_create":
    Ok(State())

export def draw(state: &mut State, token: u64) -> Result[(), egui.EguiError] = "egui_app_draw":
    ui = egui.Ui(token)
    if ui.text_edit(1u64, &mut state.name)?:
        ui.label(&"Submitted")?
    ui.label(&state.name)

def main() -> Result[(), egui.EguiError]:
    egui.run()
