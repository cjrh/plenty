import std.gui.immediate.egui as egui

class State:
    count: i64
    def __init__(self) -> ():
        self.count = 0

    def increment(self: &mut State) -> Result[(), OverflowError[i64]]:
        self.count += 1
        Ok(())

def count_limit(error: OverflowError[i64]) -> egui.EguiError:
    egui.EguiError.LimitExceeded

def create() -> Result[State, AllocError]:
    Ok(State())

def draw(state: &mut State, ui: &egui.Ui) -> Result[(), egui.EguiError]:
    if ui.button(&"Increment")?:
        state.increment().map_error(count_limit)?
    if ui.button(&"Reset")?:
        state.count = 0
    label = f"Count: {state.count}".map_error(egui.allocation)?
    ui.label(&label)

def main() -> Result[(), egui.EguiError]:
    egui.run(create=create, draw=draw)
