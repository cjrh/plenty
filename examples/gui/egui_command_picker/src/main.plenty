import std.gui.immediate.egui as egui

class State:
    query: str
    commands: list[str]
    selected: str
    def __init__(self) -> Result[(), AllocError]:
        self.query = ""
        self.commands = ["Open file", "Open folder", "Save file", "Close tab"]?
        self.selected = "None"
        Ok(())

def create() -> Result[State, AllocError]:
    State()

def draw(state: &mut State, ui: &egui.Ui) -> Result[(), egui.EguiError]:
    ui.label(&"Filter commands (Enter selects the first match)")?
    mut select = ui.text_edit(1u64, &mut state.query)?
    for command in &state.commands:
        if state.query in *command:
            ui.label(command)?
            if select:
                state.selected = *command
                select = False
    label = f"Selected: {state.selected}".map_error(egui.allocation)?
    ui.label(&label)

def main() -> Result[(), egui.EguiError]:
    egui.run(create=create, draw=draw)
