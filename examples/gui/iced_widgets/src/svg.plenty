import std.gui.retained.iced as iced

class State:
    title: str
    def __init__(self) -> ():
        self.title = "Mountain study"

def create() -> Result[State, AllocError]:
    Ok(State())

def view(state: &State, frame: &iced.Frame) -> Result[(), iced.IcedError]:
    frame.column()?
    frame.text(&state.title)?
    frame.svg(&"<svg xmlns='http://www.w3.org/2000/svg' width='180' height='100' viewBox='0 0 180 100'><rect width='180' height='100' fill='#16405b'/><path d='M20 80 L65 22 L98 67 L118 45 L155 80 Z' fill='#57cc99'/></svg>")?
    frame.end()

def main() -> Result[(), iced.IcedError]:
    iced.run(create=create, view=view)
