import std.gui.retained.iced as iced

class State:
    status: str
    def __init__(self) -> ():
        self.status = "Waiting"

def create() -> Result[State, AllocError]:
    Ok(State())

def view(state: &State, frame: &iced.Frame) -> Result[(), iced.IcedError]:
    frame.column()?
    frame.button(&"Approve", 1u64)?
    frame.text(&state.status)?
    frame.end()

def update(state: &mut State, action: u64) -> Result[(), iced.IcedError]:
    if action == 1u64:
        state.status = "Approved"
        return Ok(())
    Err(iced.IcedError.InvalidArgument)

def main() -> Result[(), iced.IcedError]:
    iced.run(create=create, view=view, update=update)
