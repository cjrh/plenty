import std.gui.retained.iced as iced

class State:
    notes: str
    def __init__(self) -> ():
        self.notes = "Review the agenda\nChoose a date"

def create() -> Result[State, AllocError]:
    Ok(State())

def view(state: &State, frame: &iced.Frame) -> Result[(), iced.IcedError]:
    frame.column()?
    frame.text(&"Meeting notes")?
    frame.text_editor(&state.notes, 1u64)?
    frame.text(&state.notes)?
    frame.end()

def update(state: &mut State, event: iced.Event) -> Result[(), iced.IcedError]:
    match event:
        case iced.Event.TextChanged(id, notes):
            if id != 1u64:
                return Err(iced.IcedError.InvalidArgument)
            state.notes = notes
            Ok(())
        case _:
            Err(iced.IcedError.InvalidArgument)

def main() -> Result[(), iced.IcedError]:
    iced.run_events(create=create, view=view, update=update)
