import report
import std.dataframe as df

def main() -> Result[i32, df.DataFrameError | AllocError | IoError]:
    argv = args()?
    if len(argv) == 2 and argv[1] == "--help":
        print("Usage: sales-report csv|parquet ORDERS PRODUCTS.csv OUTPUT_DIRECTORY")?
        print("CSV takes one file; Parquet accepts a quoted glob. Use a fresh output directory.")?
        Ok(0)
    elif len(argv) != 5:
        write_stderr("Usage: sales-report csv|parquet ORDERS PRODUCTS.csv OUTPUT_DIRECTORY\n")?
        Ok(2)
    else:
        if argv[1] != "csv" and argv[1] != "parquet":
            write_stderr("sales-report: input format must be csv or parquet\n")?
            return Ok(2)
        report.run(argv[1], argv[2], argv[3], argv[4])?
        Ok(0)
