def split_rows(rows: i64, row_bytes: i64, n: i64, start: i64, parts: i64) -> Result[list[(i64, i64, i64, i64)], AllocError]:
    # Each chunk is (offset, first row address, row size, item count): plain
    # integers, so the job owns its input while it reads rows the caller keeps
    # alive until every job has finished. Boundaries match split_range.
    count = parts if parts < n else n
    mut chunks = list[(i64, i64, i64, i64)].with_capacity(count)?
    if count == 0:
        return Ok(chunks)
    # 0 < count <= n <= i64.MAX; division and remainder are defined.
    base = unchecked:
        n // count
    extra = unchecked:
        n % count
    mut index = 0
    mut position = 0
    while index < count:
        # A nonzero remainder implies base < n, so base + 1 <= n.
        size = unchecked:
            base + 1 if index < extra else base
        # Enumerate indices deliberately trap on overflow, as serial enumerate
        # does; arbitrary start is NOT a bounded capacity or a sum error.
        offset = unchecked:
            start + position
        # Row addresses are pointer bit patterns, not signed scalar values.
        # position < n selects an allocated row in the contiguous source;
        # modular evaluation preserves its pointer even across the sign bit.
        address = rows.wrapping_add(position.wrapping_mul(row_bytes))
        chunks.append((offset, address, row_bytes, size))?
        # Disjoint chunks partition n rows; both counters end at <= n.
        unchecked:
            position += size
            index += 1
    Ok(chunks)

def split_range(first: i64, step: i64, n: i64, start: i64, parts: i64) -> Result[list[(i64, range[i64])], AllocError]:
    count = parts if parts < n else n
    mut chunks = list[(i64, range[i64])].with_capacity(count)?
    if count == 0:
        return Ok(chunks)
    # `step` is the step of an existing range, which is never zero.
    stride = NonZero.try_from(step).unwrap()
    # 0 < count <= n <= i64.MAX; division and remainder are defined.
    base = unchecked:
        n // count
    extra = unchecked:
        n % count
    mut index = 0
    mut position = 0
    while index < count:
        # Every chunk is nonempty and size <= n; extra > 0 implies base < n.
        size = unchecked:
            base + 1 if index < extra else base
        # These are members of the original range. Intermediate products may
        # leave i64 even though the final members fit: modular evaluation
        # preserves the exact final bit pattern without rejecting that range.
        low = first.wrapping_add(position.wrapping_mul(step))
        distance = unchecked:
            size - 1
        last = low.wrapping_add(distance.wrapping_mul(step))
        # Original ranges have representable exclusive stops. Their last item
        # is < MAX for positive steps, > MIN for negative ones.
        stop = unchecked:
            last + 1 if step > 0 else last - 1
        # Same deliberately trapping enumerate boundary as split_rows.
        offset = unchecked:
            start + position
        chunks.append((offset, range(low, stop, stride)))?
        # Sizes partition n, and count <= n <= MAX.
        unchecked:
            position += size
            index += 1
    Ok(chunks)

def collect[C, U, F: Callable[[C], Result[list[U], AllocError]]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[list[U], PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map_result(worker, inputs):
                case Ok(parts):
                    mut total = 0
                    for part in &parts:
                        # Storage extent failure belongs to Allocation, not
                        # to the scalar integer-sum error family.
                        extent = checked:
                            total + len(part)
                        match extent:
                            case Ok(value):
                                total = value
                            case Err(_):
                                return Err(PoolMapError.Allocation(AllocError.CapacityOverflow))
                    match list[U].with_capacity(total):
                        case Ok(reserved):
                            mut output = reserved
                            # Capacity is reserved, so moving each part's
                            # storage cannot fail.
                            for part in parts:
                                output.extend(part).unwrap()
                            Ok(output)
                        case Err(error):
                            Err(PoolMapError.Allocation(error))
                case Err(error):
                    match error:
                        case ParallelError.Worker(failure):
                            Err(PoolMapError.Allocation(failure))
                        case ParallelError.Allocation(failure):
                            Err(PoolMapError.Allocation(failure))
                        case ParallelError.Shutdown:
                            Err(PoolMapError.Shutdown)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def try_collect[C, U, E, F: Callable[[C], Result[list[U], E]]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[list[U], ParallelError[E]]:
    match chunks:
        case Ok(inputs):
            match pool.map_result(worker, inputs):
                case Ok(parts):
                    mut total = 0
                    for part in &parts:
                        extent = checked:
                            total + len(part)
                        match extent:
                            case Ok(value):
                                total = value
                            case Err(_):
                                return Err(ParallelError[E].Allocation(AllocError.CapacityOverflow))
                    match list[U].with_capacity(total):
                        case Ok(reserved):
                            mut output = reserved
                            # Capacity is reserved, so moving each part's
                            # storage cannot fail.
                            for part in parts:
                                output.extend(part).unwrap()
                            Ok(output)
                        case Err(error):
                            Err(ParallelError[E].Allocation(error))
                case Err(error):
                    Err(error)
        case Err(error):
            Err(ParallelError[E].Allocation(error))

def count[C, F: Callable[[C], i64]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[i64, PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    mut total = 0
                    for part in parts:
                        # map/filter do not expand: disjoint chunk counts
                        # sum to at most the source's representable length.
                        unchecked:
                            total += part
                    Ok(total)
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def any[C, F: Callable[[C], bool]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[bool, PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    mut found = False
                    for part in parts:
                        if part:
                            found = True
                    Ok(found)
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def all[C, F: Callable[[C], bool]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[bool, PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    mut every = True
                    for part in parts:
                        if not part:
                            every = False
                    Ok(every)
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def sum[C, T, F: Callable[[C], T]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[T, PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    Ok(iter(parts).sum())
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def integer_sum[C, T, F: Callable[[C], Result[list[T], AllocError]]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F) -> Result[T, PoolMapError | OverflowError[T]]:
    match chunks:
        case Ok(inputs):
            # map_result drains every accepted raw-row job, even on failure.
            # Only then may the caller drop its source or we report overflow.
            match pool.map_result(worker, inputs):
                case Ok(parts):
                    mut total = T(0)
                    for part in parts:
                        for value in part:
                            total += value
                    Ok(total)
                case Err(error):
                    match error:
                        case ParallelError.Worker(failure):
                            Err(PoolMapError.Allocation(failure))
                        case ParallelError.Allocation(failure):
                            Err(PoolMapError.Allocation(failure))
                        case ParallelError.Shutdown:
                            Err(PoolMapError.Shutdown)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def extremum[C, T, F: Callable[[C], Option[T]]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F, minimum: bool) -> Result[Option[T], PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    values = iter(parts).filter(def(part: &Option[T]) -> bool: part.is_some()).map(def(part: Option[T]) -> T: part.unwrap())
                    if minimum:
                        Ok(values.min())
                    else:
                        Ok(values.max())
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def reduce_chunks[C, T, F: Callable[[C], Option[T]], G: Callable[[T, T], T]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F, combine: G) -> Result[Option[T], PoolMapError]:
    match chunks:
        case Ok(inputs):
            match pool.map(worker, inputs):
                case Ok(parts):
                    # Chunk results in input order; empty chunks give Nothing.
                    mut total: Option[T] = Nothing
                    for part in parts:
                        total = match part:
                            case Some(value):
                                match total:
                                    case Some(left):
                                        Some(combine(left, value))
                                    case Nothing:
                                        Some(value)
                            case Nothing:
                                total
                    Ok(total)
                case Err(error):
                    Err(error)
        case Err(error):
            Err(PoolMapError.Allocation(error))

def reduce_empty[T]() -> Option[T]:
    Nothing

def reduce_step[T, E, G: Callable[[T, T], Result[T, E]]](combine: &G, left: Option[T], right: T) -> Result[Option[T], E]:
    match left:
        case Some(value):
            Ok(Some(combine(value, right)?))
        case Nothing:
            Ok(Some(right))

def try_reduce_chunks[C, T, E, F: Callable[[C], Result[Option[T], E]], G: Callable[[T, T], Result[T, E]]](pool: &ThreadPoolExecutor, chunks: Result[list[C], AllocError], worker: F, combine: G) -> Result[Option[T], PoolMapError | E]:
    inputs = chunks.map_error(PoolMapError.Allocation)?
    parts = pool.map(worker, inputs)?
    # Map drains before these owned results are inspected. Select the first
    # failed chunk before running any cross-chunk combining callback.
    mut failed = False
    for part in &parts:
        failed = failed or part.is_err()
    if failed:
        # Move, rather than copy, the selected error in the consuming pass.
        for result in parts:
            match result:
                case Err(error):
                    return Err(error)
                case Ok(value):
                    drop(value)
        return Ok(Nothing)
    mut total: Option[T] = Nothing
    for part in parts:
        match part?:
            case Some(value):
                total = match total:
                    case Some(left):
                        Some(combine(left, value)?)
                    case Nothing:
                        Some(value)
            case Nothing:
                pass
    Ok(total)
