def main() -> Result[(), IoError | AllocError]:
    value = iter(range(0u32, 1000u32)).map(def(x: u32) -> u32: x.wrapping_mul(3u32).wrapping_add(7u32)).fold(0u32, def(acc: u32, x: u32) -> u32: acc.wrapping_add(x))
    count = iter(range(0u32, 1000u32)).filter(def(x: &u32) -> bool: x & 1u32 == 0u32).count()
    values = [1e20f32, 1.0f32, -1e20f32, 1.0f32]?
    ordered = iter(&values).fold(0.0f32, def(acc: f32, x: &f32) -> f32: acc + x)
    print(value, count, ordered)?
    Ok(())
