class Row:
    value: i32

def simd_count(rows: &clist[Row], low: i32, high: i32) -> i64:
    rows.column(Row.value).filter(def [low, high](x: &i32) -> bool: *x >= low and *x < high).count()

def scalar_count(rows: &clist[Row], low: i32, high: i32) -> i64:
    mut count = 0
    for value in rows.column(Row.value):
        if value >= low and value < high:
            count += 1
    count

# The guard-page harness calls both counts from C, so each keeps its own
# body: passing it as a function value refers to it.
def run(count: Callable[[&clist[Row], i32, i32], i64], rows: &clist[Row]) -> i64:
    count(rows, -1073741824i32, 1073741824i32)

def main() -> Result[(), IoError]:
    rows = clist[Row]()
    print(run(simd_count, &rows), run(scalar_count, &rows))?
    Ok(())
