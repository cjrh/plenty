+/// Rewrites each operand the allocator left in a spill slot into a memory
+/// operand addressing that slot, as a reload from it would.
+pub(crate) struct SpillFolder<'a> {
+    pub frame: &'a crate::machinst::abi::FrameLayout,
+}
+
+impl SpillFolder<'_> {
+    /// The instruction to emit for `inst`.
+    pub(crate) fn fold(&mut self, inst: &AsmInst) -> AsmInst {
+        let mut inst = inst.clone();
+        inst.visit(self);
+        inst
+    }
+}
+
+impl asm::RegisterVisitor<CraneliftRegisters> for SpillFolder<'_> {
+    fn read_gpr(&mut self, _: &mut Gpr) {}
+    fn read_write_gpr(&mut self, _: &mut PairedGpr) {}
+    fn write_gpr(&mut self, _: &mut WritableGpr) {}
+    fn fixed_read_gpr(&mut self, _: &mut Gpr, _: u8) {}
+    fn fixed_read_write_gpr(&mut self, _: &mut PairedGpr, _: u8) {}
+    fn fixed_write_gpr(&mut self, _: &mut WritableGpr, _: u8) {}
+    fn read_xmm(&mut self, _: &mut Xmm) {}
+    fn read_write_xmm(&mut self, _: &mut PairedXmm) {}
+    fn write_xmm(&mut self, _: &mut WritableXmm) {}
+    fn fixed_read_xmm(&mut self, _: &mut Xmm, _: u8) {}
+    fn fixed_read_write_xmm(&mut self, _: &mut PairedXmm, _: u8) {}
+    fn fixed_write_xmm(&mut self, _: &mut WritableXmm, _: u8) {}
+
+    fn read_xmm_mem_foldable(&mut self, op: &mut asm::XmmMem<Xmm, Gpr>) {
+        let asm::XmmMem::Xmm(reg) = op else {
+            return;
+        };
+        let Some(slot) = reg.to_reg().to_spillslot() else {
+            return;
+        };
+        let offset = i32::try_from(self.frame.spillslot_offset(slot)).unwrap();
+        *op = asm::XmmMem::Mem(asm::Amode::ImmReg {
+            base: Gpr::RSP,
+            simm32: asm::AmodeOffsetPlusKnownOffset {
+                simm32: offset.into(),
+                offset: Some(offsets::KEY_SLOT_OFFSET),
+            },
+            trap: None,
+        });
+    }
 }
 
