# The prefix scanner's hot loop over a borrowed byte view. The production
# matcher now borrows text as this same byte view once per search.
def scan(data: &[u8], masks: &[i64], start: i64, width: i64, maximum: i64) -> (i64, i64):
    mut state = 0
    # Probe preconditions: start in 0..len(data), width in 1..8, maximum >= 0,
    # and 256 masks containing only their low eight bits.
    unchecked:
        accept = 1 << (width - 1)
        for index, byte in enumerate(&data[start:]):
            if index >= maximum:
                return (-2, index)
            state = ((state << 1) | 1) & masks[i64(*byte)]
            if state & accept != 0:
                return (start + index + 1 - width, index + 1)
        (-1, len(data) - start)

def scan_text(text: &str, masks: &[i64], start: i64, width: i64, maximum: i64) -> (i64, i64):
    scan(__regex_text_bytes(text), masks, start, width, maximum)

def main() -> Result[(), AllocError | IoError]:
    mut masks = list[i64].new()?
    for _ in range(256):
        masks.append(0)?
    masks[97] = 1
    masks[98] = 2
    print(scan_text("zzab", &masks, 0, 2, 100))?
    Ok(())
