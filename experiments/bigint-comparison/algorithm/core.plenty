            high[j] = transform_twiddle(difference - p if difference >= p else difference, roots[k], roots[len(roots) // 2 + k], p)
            k += step

def transform_inverse_block(low: &mut [u64], high: &mut [u64], roots: &[u64], step: i64, p: u64) -> ():
    unchecked:
        mut k = 0
        for j in range(len(low)):
            root = roots[0] if k == 0 else p - roots[len(roots) // 2 - k]
