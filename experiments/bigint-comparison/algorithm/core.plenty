# Decimation in frequency produces bit-reversed output. The inverse uses
# decimation in time, so no bit-reversal permutation or its scratch is needed.
def transform_forward(data: &mut [u64], roots: &[u64], p: u64) -> ():
    unchecked:
        n = len(data)
        mut width = n
        mut step = 1
        while width >= 2:
            half = width // 2
            mut start = 0
            while start < n:
                block = &mut data[start:start + width]
                transform_forward_block(&mut block[:half], &mut block[half:], roots, step, p)
                start += width
            width = half
            step *= 2

def transform_inverse(data: &mut [u64], roots: &[u64], p: u64) -> ():
    unchecked:
        n = len(data)
        mut width = 2
        mut step = n // 2
        while width <= n:
            half = width // 2
            mut start = 0
