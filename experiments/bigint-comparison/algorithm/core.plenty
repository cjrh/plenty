# Exact production helpers, repeated with all scratch allocated before timing.
def transform_copy(source: &[u64], out: &mut [u64]) -> ():
    for i in range(len(out)):
        out[i] = source[i]

# Montgomery reduction with R=2^32. Inputs are below p<2^30, so t+m*p
# is below 2^63. The low-word multiplication deliberately wraps modulo R.
def transform_multiply(a: u64, b: u64, p: u64, inverse: u64) -> u64:
    unchecked:
        t = a.wrapping_mul(b)
        m = t.wrapping_mul(inverse) & 4294967295u64
        value = t.wrapping_add(m.wrapping_mul(p)) >> 32u64
        value.wrapping_sub(p) if value >= p else value

def transform_power(base: u64, exponent: u64, p: u64) -> u64:
    unchecked:
        mut x = base
        mut power = exponent
        mut result = 1u64
        while power > 0u64:
            if power & 1u64 != 0u64:
                result = result * x % p
            x = x * x % p
            power >>= 1u64
        result

def transform_load(words: &[u64], out: &mut [u64]) -> ():
    unchecked:
        for i in range(len(words)):
            word = words[i]
            for j in range(4):
                out[4 * i + j] = (word >> (u64(j) * 16u64)) & 65535u64
        for i in range(4 * len(words), len(out)):
            out[i] = 0u64

def transform_product(a: &[u64], b: &[u64], x: &mut [u64], y: &mut [u64], roots: &mut [u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(x)
        r = 4294967296u64 % p
        root = transform_power(3u64, (p - 1u64) // u64(n), p) * r % p
        roots[0] = 1u64
        for i in range(1, len(roots) // 2):
            roots[i] = transform_multiply(roots[i - 1], root, p, inverse)
        for i in range(len(roots) // 2):
            roots[len(roots) // 2 + i] = (roots[i] << 32u64) // p
        transform_load(a, x)
        transform_load(b, y)
        transform_forward(x, roots, p)
        transform_forward(y, roots, p)
        for i in range(n):
