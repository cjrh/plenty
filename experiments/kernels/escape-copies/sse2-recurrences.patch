+test compile precise-output
+set opt_level=speed
+set regalloc_checker=true
+target x86_64
+
+;; The original and the square both cross the backedge. Keep the square in
+;; the real accumulator's register, save the unsquared update in its next
+;; iteration's register, and reuse the old imaginary register for the multiply.
+function %escape(f64, f64) -> i8 tail {
+    const0 = 0x00000000000000004010000000000000
+
+block0(v0: f64, v1: f64):
+    jump block2
+
+block3:
+    v4 = f64const 0.0
+    v9 = iconst.i64 50
+    v41 = f64const 0x1.0000000000000p2
+    v10 = iconst.i64 1
+    jump block4(v4, v4, v4, v4, v9)
+
+block4(v27: f64, v29: f64, v33: f64, v34: f64, v43: i64):
+    v35 = fsub v33, v34
+    v37 = fadd v35, v0
+    v38 = fmul v37, v37
+    v28 = fadd v27, v27
+    v30 = fmul v28, v29
+    v32 = fadd v30, v1
+    v39 = fmul v32, v32
+    v40 = fadd v38, v39
+    v105 = f64const 0x1.0000000000000p2
+    v106 = fcmp gt v40, v105
+    brif v106, block7, block8
+
+block7:
+    jump block1(v38, v39)
+
+block8:
+    jump block6
+
+block6:
+    jump block5
+
+block5:
+    v107 = iconst.i64 1
+    v108 = isub.i64 v43, v107
+    brif v108, block4(v37, v32, v38, v39, v108), block1(v38, v39)
+
+block2:
+    jump block3
+
+block1(v59: f64, v60: f64):
+    v61 = fadd v59, v60
+    v63 = vconst.f64x2 const0
+    v64 = extractlane v63, 0
+    v65 = fcmp le v61, v64
+    return v65
+}
