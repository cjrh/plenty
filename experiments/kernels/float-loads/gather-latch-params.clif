; gather-lowered.clif with the body merged and a bottom test block that
; receives the sum, index and count as parameters, so the fadd has one use.
; Cranelift removes the parameters of the single-predecessor block and places
; the fadd there again: still 7 instructions per pass, no fold.
function u0:60(i128, i128, i64) -> f64 tail {
block0(v0: i128, v1: i128, v2: i64):
    v3 = iconst.i64 0
    v72 = smax v3, v2
    v22 = icmp sle v72, v3
    v5 = f64const 0.0
    brif v22, block1(v5), block4(v5, v3, v72)

block4(v23: f64, v28: i64, v44: i64):
    v29, v30 = isplit.i128 v1
    v76 = iconst.i64 3
    v77 = ishl v28, v76
    v33 = iadd v29, v77
    v35 = load.i64 notrap aligned v33
    v36, v37 = isplit.i128 v0
    v78 = ishl v35, v76
    v40 = iadd v36, v78
    v42 = load.f64 notrap aligned v40
    v43 = fadd.f64 v23, v42
    v79 = iconst.i64 1
    v80 = isub.i64 v44, v79
    v83 = iadd.i64 v28, v79
    jump block5(v43, v83, v80)

block5(v50: f64, v51: i64, v52: i64):
    v81 = iconst.i64 0
    v82 = icmp sgt v52, v81
    brif v82, block4(v50, v51, v52), block1(v50)

block1(v56: f64):
    return v56
}
