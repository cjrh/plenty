+    /// Whether `value` can be computed at the current branch without
+    /// duplicating it for a preceding use in the same block. The branch's
+    /// successor arguments may still need the arithmetic result.
+    #[cfg(feature = "x86")]
+    pub(crate) fn pair_branch_result(&self, value: Value) -> Option<Value> {
+        let branch = self.cur_inst?;
+        let InstructionData::Brif { arg, .. } = self.f.dfg.insts[branch] else {
+            return None;
+        };
+        if arg != value {
+            return None;
+        }
+        let def = self.f.dfg.value_def(value).inst()?;
+        if self.f.layout.inst_block(def) != self.f.layout.inst_block(branch) {
+            return None;
+        }
+        let mut next = self.f.layout.next_inst(def);
+        while let Some(inst) = next {
+            if inst == branch {
+                return Some(value);
+            }
+            if self.f.dfg.inst_values(inst).any(|arg| arg == value) {
+                return None;
+            }
+            next = self.f.layout.next_inst(inst);
+        }
+        None
+    }
