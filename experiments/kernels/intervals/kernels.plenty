# Arithmetic the checker's intervals prove and code generation's own bounds do not.
def masked(xs: &[i64], out: &mut [i64]) -> Result[(), OverflowError[i64]]:
    for i in range(len(out)):
        out[i] = (xs[i] & 1023) * 1000 - 500000
    Ok(())


def widened(xs: &[i32], out: &mut [i64]) -> Result[(), OverflowError[i64]]:
    for i in range(len(out)):
        out[i] = i64(xs[i]) * 3 - 7
    Ok(())


def negated(xs: &[i64], out: &mut [i64]) -> Result[(), OverflowError[i64]]:
    for i in range(len(out)):
        out[i] = -(xs[i] % 1000) * 5
    Ok(())


def main() -> Result[(), AllocError | IoError | OverflowError[i64]]:
    xs = [5, -6, 7000, 8]?
    small = [5i32, -6i32, 7000i32, 8i32]?
    mut out = [0, 0, 0, 0]?
    masked(&xs, &mut out)?
    print(out)?
    widened(&small, &mut out)?
    print(out)?
    negated(&xs, &mut out)?
    print(out)?
    Ok(())
