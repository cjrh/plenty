; a: exact optimized baseline control flow
function %a(f64, f64) -> i8 tail {
    const0 = 0x00000000000000004010000000000000

block0(v0: f64, v1: f64):
    jump block2

block3:
    v4 = f64const 0.0
    v9 = iconst.i64 50
    v30 = vconst.f64x2 const0
    v31 = extractlane v30, 0
    v10 = iconst.i64 1
    v2 = iconst.i64 0
    jump block4(v4, v4, v4, v4, v9)

block4(v26: f64, v27: f64, v34: f64, v36: f64, v45: i64):
    v28 = fadd v26, v27
    v32 = fcmp le v28, v31
    brif v32, block7, block8

block7:
    jump block6

block8:
    jump block1(v26, v27)

block6:
    jump block5

block5:
    v105 = iconst.i64 1
    v106 = isub.i64 v45, v105
    v107 = iconst.i64 0
    v108 = icmp sgt v106, v107
    v40 = fsub.f64 v26, v27
    v42 = fadd v40, v0
    v43 = fmul v42, v42
    v35 = fadd.f64 v34, v34
    v37 = fmul v35, v36
    v39 = fadd v37, v1
    v44 = fmul v39, v39
    brif v108, block4(v43, v44, v42, v39, v106), block1(v43, v44)

block2:
    jump block3

block1(v61: f64, v62: f64):
    v63 = fadd v61, v62
    v67 = fcmp le v63, v31
    return v67
}

