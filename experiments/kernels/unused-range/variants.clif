; a: unused element v9 is a cyclic block parameter even after optimization.
function %a(i64, f64) -> f64 tail {
block0(v0: i64, v1: f64):
    v2 = iconst.i64 0
    v3 = smax v2, v0
    v4 = icmp sle v3, v2
    brif v4, block2(v1), block1(v1, v3, v2)
block1(v5: f64, v6: i64, v9: i64):
    v7 = iconst.i64 1
    v8 = isub v6, v7
    v10 = f64const 0x1.000001ad7f29bp0
    v11 = fmul v5, v10
    v12 = f64const 0x1.0000000000000p-1
    v13 = fadd v11, v12
    v14 = iadd v9, v7
    v15 = icmp sgt v8, v2
    brif v15, block1(v13, v8, v14), block2(v13)
block2(v16: f64):
    return v16
}

; b: omit stores to the unused element; no cyclic block parameter.
function %b(i64, f64) -> f64 tail {
block0(v0: i64, v1: f64):
    v2 = iconst.i64 0
    v3 = smax v2, v0
    v4 = icmp sle v3, v2
    brif v4, block2(v1), block1(v1, v3)
block1(v5: f64, v6: i64):
    v7 = iconst.i64 1
    v8 = isub v6, v7
    v10 = f64const 0x1.000001ad7f29bp0
    v11 = fmul v5, v10
    v12 = f64const 0x1.0000000000000p-1
    v13 = fadd v11, v12
    v15 = icmp sgt v8, v2
    brif v15, block1(v13, v8), block2(v13)
block2(v16: f64):
    return v16
}
