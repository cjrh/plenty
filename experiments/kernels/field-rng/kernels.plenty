# fasta's linear congruential generator: a class field updated through a
# `&mut` receiver by a small fallible method, called with `?` in a loop.

const IM: i64 = 139968
const IA: i64 = 3877
const IC: i64 = 29573


class Rng:
    seed: i64

    def next(self: &mut Rng) -> Result[i64, OverflowError[i64] | ZeroDivisionError]:
        self.seed = (self.seed * IA + IC) % IM
        Ok(self.seed)


# The generator inlined into a loop that stores each value.
def fill(rng: &mut Rng, out: &mut [i64]) -> Result[(), OverflowError[i64] | ZeroDivisionError]:
    for i in range(len(out)):
        out[i] = rng.next()?
    Ok(())


type Seed = Bounded[i64, 0, 139967]


class BoundedRng:
    seed: Seed

    def next(self: &mut BoundedRng) -> i64:
        value = (self.seed.get() * IA + IC) % IM
        self.seed = Seed.from(value)
        value


# `fill` with the field's range in its type. The checker's interval for
# `seed.get() * IA + IC` fits i64, so neither function returns an error
# (issue #952).
def fill_bounded(rng: &mut BoundedRng, out: &mut [i64]) -> ():
    for i in range(len(out)):
        out[i] = rng.next()


# The same recurrence on a local: the remainder bounds the carried value.
def fill_local(seed: i64, out: &mut [i64]) -> Result[i64, OverflowError[i64] | ZeroDivisionError]:
    mut s = seed % IM
    for i in range(len(out)):
        s = (s * IA + IC) % IM
        out[i] = s
    Ok(s)


# Two arms store remainders by different constants.
def fill_arms(seed: i64, out: &mut [i64]) -> Result[i64, OverflowError[i64] | ZeroDivisionError]:
    mut s = seed % IM
    for i in range(len(out)):
        if i % 2 == 0:
            s = (s * IA + IC) % IM
        else:
            s = (s * 3 + 1) % 1000
        out[i] = s
    Ok(s)


# The carried local is written only in an inner loop.
def fill_inner(seed: i64, out: &mut [i64], rounds: i64) -> Result[i64, OverflowError[i64] | ZeroDivisionError]:
    mut s = seed % IM
    for _ in range(rounds):
        for i in range(len(out)):
            s = (s * IA + IC) % IM
            out[i] = s
    Ok(s)


# One write is not a remainder, so the local has no bound and keeps its checks.
def fill_unbounded(seed: i64, out: &mut [i64]) -> Result[i64, OverflowError[i64] | ZeroDivisionError]:
    mut s = seed % IM
    for i in range(len(out)):
        s = (s * IA + IC) % IM
        if s == 7:
            s = s + i
        out[i] = s
    Ok(s)


type TimingError = AllocError | IoError | ParseError | OverflowError[i64] | ZeroDivisionError


# `kernels KERNEL ROUNDS`: run one kernel ROUNDS times over 4096 elements.
def time(kernel: &str, rounds: i64) -> Result[(), TimingError]:
    mut out = list[i64]()?
    for _ in range(4096):
        out.append(0)?
    mut last = 42
    if kernel == "fill":
        mut rng = Rng(42)
        for _ in range(rounds):
            fill(&mut rng, &mut out)?
        last = rng.seed
    elif kernel == "fill_bounded":
        mut rng = BoundedRng(42)
        for _ in range(rounds):
            fill_bounded(&mut rng, &mut out)
        last = rng.seed.get()
    elif kernel == "fill_local":
        for _ in range(rounds):
            last = fill_local(last, &mut out)?
    elif kernel == "fill_arms":
        for _ in range(rounds):
            last = fill_arms(last, &mut out)?
    elif kernel == "fill_inner":
        last = fill_inner(last, &mut out, rounds)?
    elif kernel == "fill_unbounded":
        for _ in range(rounds):
            last = fill_unbounded(last, &mut out)?
    print(kernel, last)?
    Ok(())


def main() -> Result[(), TimingError]:
    argv = args()?
    if len(argv) > 2:
        return time(&argv[1], i64.parse(&argv[2])?)
    mut rng = Rng(42)
    mut out = [0, 0, 0, 0]?
    fill(&mut rng, &mut out)?
    last = fill_local(42, &mut out)?
    mut bounded = BoundedRng(42)
    fill_bounded(&mut bounded, &mut out)
    print(out, bounded.seed.get())?
    arms = fill_arms(42, &mut out)?
    inner = fill_inner(42, &mut out, 3)?
    unbounded = fill_unbounded(42, &mut out)?
    print(out, last, rng.seed, arms, inner, unbounded)?
    Ok(())
