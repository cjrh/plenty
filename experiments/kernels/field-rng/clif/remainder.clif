; `fill_local` in ../kernels.plenty: the remainder by a constant in a loop
; that stores it (issues #953 and #954). v0 is the seed, v1 the `&mut [i64]`
; (address, length). Each variant changes one IR shape.

; a: the loop as Plenty's optimized CLIF has it at 39506d02: the quotient is
; the high product shifted, the remainder is `x - q * d`.
function %a_as_dumped(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 0
    jump block1(v0, v3)

block1(v30: i64, v39: i64):
    v1001 = iconst.i64 3877
    v107 = imul v30, v1001
    v1002 = iconst.i64 0x7385
    v109 = iadd v107, v1002
    v110 = iconst.i64 0x3bee_ad01_fd6c_be91
    v111 = umulhi v109, v110
    v1003 = iconst.i64 15
    v113 = ushr v111, v1003
    v1004 = iconst.i64 0x0002_22c0
    v115 = imul v113, v1004
    v99 = isub v109, v115
    v1005 = iconst.i64 3
    v117 = ishl v39, v1005
    v46 = iadd v1, v117
    store notrap aligned v99, v46
    v1006 = iconst.i64 1
    v119 = iadd v39, v1006
    v53 = icmp slt v119, v2
    brif v53, block1(v99, v119), block2(v99)

block2(v58: i64):
    return v58
}

; b: the multiplier for a dividend below 2^30: no shift.
function %b_no_shift(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 0
