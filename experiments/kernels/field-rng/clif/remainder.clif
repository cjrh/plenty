; e: as a, the remainder is `q * (-d) + x`, an add with the dividend second.
function %e_negated_product(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 0
    jump block1(v0, v3)

block1(v30: i64, v39: i64):
    v1023 = iconst.i64 3877
    v107 = imul v30, v1023
    v1024 = iconst.i64 0x7385
    v109 = iadd v107, v1024
    v110 = iconst.i64 0x3bee_ad01_fd6c_be91
    v111 = umulhi v109, v110
    v1025 = iconst.i64 15
    v113 = ushr v111, v1025
    v1026 = iconst.i64 -139968
    v115 = imul v113, v1026
    v99 = iadd v115, v109
    v1027 = iconst.i64 3
    v117 = ishl v39, v1027
    v46 = iadd v1, v117
    store notrap aligned v99, v46
    v1028 = iconst.i64 1
    v119 = iadd v39, v1028
    v53 = icmp slt v119, v2
    brif v53, block1(v99, v119), block2(v99)

block2(v58: i64):
    return v58
}

; f: straight line, no loop: one remainder stored and returned.
function %f_straight(i64, i64) -> i64 tail {
block0(v0: i64, v1: i64):
    v1029 = iconst.i64 3877
    v107 = imul v0, v1029
    v1030 = iconst.i64 0x7385
    v109 = iadd v107, v1030
    v110 = iconst.i64 0x3bee_ad01_fd6c_be91
    v111 = umulhi v109, v110
    v1031 = iconst.i64 15
    v113 = ushr v111, v1031
    v1032 = iconst.i64 0x0002_22c0
    v115 = imul v113, v1032
    v99 = isub v109, v115
    store notrap aligned v99, v1
    return v99
}
