; Probes of what the list-index cold blocks can pass without adding moves
; to the reversal loop (variant d in reverse.clif). Counts per iteration are
; in ../README.md.

; n: d's cold blocks calling a helper whose only argument is a fresh symbol address.
function %n_call_no_args(i128, i64) tail {
    gv0 = symbol colocated u1:0
    sig0 = (i64) system_v
    fn0 = colocated u0:53 sig0

block0(v0: i128, v1: i64):
    v13, v14 = isplit.i128 v0
    v4 = iconst.i64 1
    v6, v7 = ssub_overflow v1, v4
    trapnz v7, user4
    v10 = icmp slt v4, v6
    brif v10, block4(v4, v6), block5

block4(v8: i64, v9: i64):
    v15 = icmp.i64 ult v8, v14
    brif v15, block7, block6

block6 cold:
    v16 = symbol_value.i64 gv0
    call fn0(v16)
    trap user3

block7:
    v53 = iconst.i64 3
    v54 = ishl.i64 v8, v53
    v21 = iadd.i64 v13, v54
    v23 = load.i64 notrap aligned v21
    v29 = icmp.i64 ult v9, v14
    brif v29, block9, block8

block8 cold:
    v58 = symbol_value.i64 gv0
    call fn0(v58)
    trap user3

block9:
    v55 = ishl.i64 v9, v53
    v25 = iadd.i64 v13, v55
    v39 = load.i64 notrap aligned v25
    store notrap aligned v39, v21
    store.i64 notrap aligned v23, v25
    v75 = iconst.i64 1
    v60 = iadd.i64 v8, v75
    v61 = isub.i64 v9, v75
    v62 = icmp slt v60, v61
    brif v62, block4(v60, v61), block5

block5:
    return
}

; o: d's cold blocks with only a trap.
function %o_trap_only(i128, i64) tail {
block0(v0: i128, v1: i64):
    v13, v14 = isplit.i128 v0
    v4 = iconst.i64 1
    v6, v7 = ssub_overflow v1, v4
    trapnz v7, user4
    v10 = icmp slt v4, v6
    brif v10, block4(v4, v6), block5

block4(v8: i64, v9: i64):
    v15 = icmp.i64 ult v8, v14
    brif v15, block7, block6

block6 cold:
    trap user5

block7:
    v53 = iconst.i64 3
    v54 = ishl.i64 v8, v53
    v21 = iadd.i64 v13, v54
    v23 = load.i64 notrap aligned v21
    v29 = icmp.i64 ult v9, v14
    brif v29, block9, block8

block8 cold:
    trap user6

block9:
    v55 = ishl.i64 v9, v53
    v25 = iadd.i64 v13, v55
    v39 = load.i64 notrap aligned v25
    store notrap aligned v39, v21
    store.i64 notrap aligned v23, v25
    v75 = iconst.i64 1
    v60 = iadd.i64 v8, v75
    v61 = isub.i64 v9, v75
    v62 = icmp slt v60, v61
    brif v62, block4(v60, v61), block5

block5:
    return
}

; p: the index stored to a stack slot, then a trap.
function %p_store_index_trap(i128, i64) tail {
    ss0 = explicit_slot 16
block0(v0: i128, v1: i64):
    v13, v14 = isplit.i128 v0
    v4 = iconst.i64 1
    v6, v7 = ssub_overflow v1, v4
    trapnz v7, user4
