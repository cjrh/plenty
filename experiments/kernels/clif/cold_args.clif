    v54 = ishl.i64 v8, v53
    v21 = iadd.i64 v13, v54
    v23 = load.i64 notrap aligned v21
    v29 = icmp.i64 ult v9, v14
    brif v29, block9, block8

block8 cold:
    v81 = stack_addr.i64 ss0
    store notrap aligned v9, v81
    trap user6

block9:
    v55 = ishl.i64 v9, v53
    v25 = iadd.i64 v13, v55
    v39 = load.i64 notrap aligned v25
    store notrap aligned v39, v21
    store.i64 notrap aligned v23, v25
    v75 = iconst.i64 1
    v60 = iadd.i64 v8, v75
    v61 = isub.i64 v9, v75
    v62 = icmp slt v60, v61
    brif v62, block4(v60, v61), block5

block5:
    return
}

