; The reversal loop, `reverse` in ../kernels.plenty. v0 is the `&mut [i64]`
; (address, length); v1 is `first`. Each variant changes one IR shape.

; a: Plenty's optimized CLIF as dumped (`--release --dump clif-opt`).
function %reverse_a_plenty(i128, i64) tail {
    gv0 = symbol colocated u1:0
    sig0 = (i64, i64, i64) system_v
    fn0 = colocated u0:52 sig0

block0(v0: i128, v1: i64):
    v4 = iconst.i64 1
    v6, v7 = ssub_overflow v1, v4
    trapnz v7, user4
    jump block3(v4, v6)

block3(v8: i64, v9: i64):
    v10 = icmp slt v8, v9
    brif v10, block4, block5

block4:
    v13, v14 = isplit.i128 v0
    v15 = icmp.i64 ult v8, v14
    brif v15, block7, block6

block6 cold:
    v16 = symbol_value.i64 gv0
    call fn0(v8, v14, v16)
    trap user3

block7:
    v53 = iconst.i64 3
    v54 = ishl.i64 v8, v53
    v21 = iadd.i64 v13, v54
    v23 = load.i64 notrap aligned v21
    v29 = icmp.i64 ult v9, v14
    v55 = ishl.i64 v9, v53
    v28 = iadd.i64 v13, v55
    brif v29, block9(v28), block10

block10 cold:
    v30 = iadd.i64 v9, v14
    v31 = icmp ult v30, v14
    v57 = ishl v30, v53
    v34 = iadd.i64 v13, v57
    brif v31, block9(v34), block8

block8 cold:
    v58 = symbol_value.i64 gv0
    call fn0(v9, v14, v58)
    trap user3

block9(v25: i64):
    v39 = load.i64 notrap aligned v25
    store notrap aligned v39, v21
    store.i64 notrap aligned v23, v25
    v900 = iconst.i64 1
    v60 = iadd.i64 v8, v900
    v901 = iconst.i64 1
    v61 = isub.i64 v9, v901
    jump block3(v60, v61)

block5:
    return
}

