@copy
class Vec3:
    data: array[f64, 3]

    def scaled(self, factor: f64) -> Vec3:
        Vec3([self.data[0] * factor, self.data[1] * factor, self.data[2] * factor])

    def add(self, other: &Vec3) -> Vec3:
        Vec3([self.data[0] + other.data[0], self.data[1] + other.data[1], self.data[2] + other.data[2]])

def advance(value: Vec3, delta: &Vec3, factor: f64, steps: i64) -> Vec3:
    mut current = value
    for _ in range(steps):
        current = current.scaled(factor).add(delta)
    current

def main() -> Result[(), AllocError | IoError | ParseError]:
    argv = args()?
    steps = if len(argv) > 1:
        i64.parse(&argv[1])?
    else:
        10000
    initial = Vec3([1.0, 2.0, 3.0])
    delta = Vec3([0.0001, -0.0002, 0.0003])
    result = advance(initial, &delta, 0.9999995, steps)
    print(result.data[0], result.data[1], result.data[2])?
    Ok(())
