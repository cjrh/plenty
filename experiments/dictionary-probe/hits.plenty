# Repeated successful updates: no key construction or growth in the hot loop.
def main() -> Result[(), AllocError | IoError | OverflowError[i64]]:
    mut counts: dict[str, i64] = {"GGTATTTTAATTTATAGT": 0}?
    for i in range(1000000):
        *counts.get_or_insert("GGTATTTTAATTTATAGT", 0)? += 1
    print(counts["GGTATTTTAATTTATAGT"])?
    Ok(())
