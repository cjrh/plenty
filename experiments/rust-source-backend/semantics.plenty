class Trace:
    tag: i64

    def __del__(self) -> ():
        print(self.tag).unwrap()

enum Stop:
    Now

def failure() -> Result[(), Stop]:
    Err(Stop.Now)

def leave_early() -> Result[(), Stop]:
    first = Trace(1)
    second = Trace(2)
    failure()?
    Ok(())

def main() -> ():
    mut values = [10, 20].unwrap()
    first = &mut values[0]
    second = &mut values[1]
    *first += 1
    *second += 2
    print(values[0] + values[1]).unwrap()
    result = leave_early()
    moved = Trace(3)
    drop(moved)
    print(4).unwrap()
