# Miss-only dictionary updates: every 7-byte window of a pseudo-random
# sequence is a new key, looked up by its bytes (issue #949).
import std.bytes

def main() -> Result[(), AllocError | IoError | OverflowError[i64] | DataError]:
    mut sequence = std.bytes.with_capacity(400000 + 7)?
    mut state = 42
    for i in range(400000 + 7):
        state = (state * 1103515245 + 12345) % 2147483648
        sequence.push(u8(65 + state // 65536 % 26))?
    mut counts: dict[str, i64] = {}?
    for i in range(400000):
        *counts.get_or_insert_bytes(&sequence[i:i + 7], 0)? += 1
    print(len(counts))?
    Ok(())
