# Hit-only dictionary updates with an owned 18-byte key: no key construction
# or growth in the loop.
def main() -> Result[(), AllocError | IoError | OverflowError[i64]]:
    mut counts: dict[str, i64] = {"GGTATTTTAATTTATAGT": 0, "ACG": 0, "TTTATAGTGGTATTTTAA": 0}?
    for i in range(2000000):
        *counts.get_or_insert("GGTATTTTAATTTATAGT", 0)? += 1
    print(counts["GGTATTTTAATTTATAGT"])?
    Ok(())
